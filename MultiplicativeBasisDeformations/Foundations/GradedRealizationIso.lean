import MultiplicativeBasisDeformations.Foundations.GradedRealization
import MultiplicativeBasisDeformations.Foundations.MeshCorrections

/-!
# Proposition 2.6(3), assembled

The realization of the path category on radical layers descends to linear
isomorphisms `φ_d : C_d(x, y) ≃ J^d/J^{d+1}` from the path-degree parts of
`k(Γ_A) = C(Γ_A, c)` (`GradedRealization.lean`: well-definedness from the
mesh relations, surjectivity, injectivity). They send arrows to the chosen
basis vectors and are compatible with composition. The Hom spaces of
`k(Γ_A)` are the internal direct sums of their degree parts, because the mesh
ideal is generated by homogeneous relations.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option linter.unusedSectionVars false

noncomputable section

open CategoryTheory CategoryTheory.Limits
open scoped ModuleCat.Algebra

attribute [local instance] HasFiniteBiproducts.of_hasFiniteProducts

namespace MultiplicativeBasisDeformations.IndSkeleton

universe w

variable {k A : Type w} [Field k] [IsAlgClosed k] [Ring A] [Algebra k A] [FiniteDimensional k A]
  [IsNoetherianRing Aᵐᵒᵖ] (S : IndSkeleton k A) (b : S.ArrowBases)

/-- The quotient functor `kQ → k(Γ_A)`. -/
abbrev meshQuot := RelationCategory.functor k (meshRelations (S.arCoefficients b))

/-- The quotient map on Hom spaces. -/
abbrev meshQuotL (x y : S.ARVertex) :=
  (S.meshQuot b).mapLinearMap k (X := LinearPaths.obj (k := k) x) (Y := LinearPaths.obj y)

theorem meshQuot_map_eq_zero_iff {x y : S.ARVertex}
    (F : LinearPaths.obj (k := k) x ⟶ LinearPaths.obj y) :
    (S.meshQuot b).map F = 0 ↔ F ∈ (S.meshIdeal b).hom _ _ :=
  RelationCategory.functor_map_eq_zero_iff _ F

/-- The quotient map restricted to degree `d`. -/
abbrev qd (d : ℕ) (x y : S.ARVertex) :=
  (S.meshQuotL b x y).submoduleMap (LinearPaths.degreePart (k := k) d x y)

/-- The realization on degree `d`, followed by the class in `J^d/J^{d+1}`. -/
def psi (d : ℕ) (x y : S.ARVertex) :
    LinearPaths.degreePart (k := k) d x y →ₗ[k] S.layer d (S.label x) (S.label y) where
  toFun F := S.layerClass (S.realize b x y F.1) (S.realize_mem b F.2)
  map_add' F G := by
    simp only [Submodule.coe_add, map_add]
    rfl
  map_smul' c F := by
    simp only [Submodule.coe_smul, map_smul]
    rfl

theorem psi_eq_zero_iff {d : ℕ} {x y : S.ARVertex} (F : LinearPaths.degreePart (k := k) d x y) :
    S.psi b d x y F = 0 ↔ S.realize b x y F.1 ∈ S.radPow (d + 1) _ _ :=
  Submodule.Quotient.mk_eq_zero _

theorem ker_qd_eq_ker_psi (d : ℕ) (x y : S.ARVertex) :
    LinearMap.ker (S.qd b d x y) = LinearMap.ker (S.psi b d x y) := by
  ext F
  rw [LinearMap.mem_ker, LinearMap.mem_ker, S.psi_eq_zero_iff]
  have hq : S.qd b d x y F = 0 ↔ (S.meshQuot b).map F.1 = 0 := by
    constructor
    · intro h; exact congrArg Subtype.val h
    · intro h; exact Subtype.ext h
  rw [hq, S.meshQuot_map_eq_zero_iff]
  constructor
  · intro h
    have := S.realize_proj_mem_of_mem_ideal b d h
    rwa [(LinearPaths.mem_degreePart_iff _).1 F.2] at this
  · exact S.mem_meshIdeal_of_realize_mem b d F.2

theorem psi_surjective (d : ℕ) (x y : S.ARVertex) : Function.Surjective (S.psi b d x y) := by
  intro v
  obtain ⟨⟨f, hf⟩, rfl⟩ := Submodule.Quotient.mk_surjective _ v
  obtain ⟨F, hF, hdiff⟩ := S.exists_realize_sub_mem b d f hf
  refine ⟨⟨F, hF⟩, ?_⟩
  symm
  exact (Submodule.Quotient.eq _).2 hdiff

/-- `φ_d : C_d(x, y) ≃ J^d/J^{d+1}`. -/
def phi (d : ℕ) (x y : S.ARVertex) :
    ScalarMeshCategory.degreePart (S.arCoefficients b) d x y ≃ₗ[k]
      S.layer d (S.label x) (S.label y) :=
  ((S.qd b d x y).quotKerEquivOfSurjective (LinearMap.submoduleMap_surjective _ _)).symm.trans
    ((Submodule.quotEquivOfEq _ _ (S.ker_qd_eq_ker_psi b d x y)).trans
      ((S.psi b d x y).quotKerEquivOfSurjective (S.psi_surjective b d x y)))

theorem phi_qd (d : ℕ) (x y : S.ARVertex) (F : LinearPaths.degreePart (k := k) d x y) :
    S.phi b d x y (S.qd b d x y F) = S.psi b d x y F := by
  have h1 : ((S.qd b d x y).quotKerEquivOfSurjective
      (LinearMap.submoduleMap_surjective _ _)).symm (S.qd b d x y F) = Submodule.Quotient.mk F := by
    rw [LinearEquiv.symm_apply_eq]; rfl
  rw [phi, LinearEquiv.trans_apply, LinearEquiv.trans_apply]
  erw [h1]
  rw [Submodule.quotEquivOfEq_mk, LinearMap.quotKerEquivOfSurjective_apply_mk]

end MultiplicativeBasisDeformations.IndSkeleton

namespace MultiplicativeBasisDeformations.IndSkeleton

universe w

variable {k A : Type w} [Field k] [IsAlgClosed k] [Ring A] [Algebra k A] [FiniteDimensional k A]
  [IsNoetherianRing Aᵐᵒᵖ] (S : IndSkeleton k A) (b : S.ArrowBases)

theorem meshQuotL_surjective (x y : S.ARVertex) : Function.Surjective (S.meshQuotL b x y) :=
  fun g ↦ (S.meshQuot b).map_surjective g

theorem ker_meshQuotL_le (d : ℕ) (x y : S.ARVertex) :
    LinearMap.ker (S.meshQuotL b x y) ≤
      LinearMap.ker ((S.meshQuotL b x y).comp (LinearPaths.proj (k := k) d x y)) := by
  intro F hF
  rw [LinearMap.mem_ker] at hF ⊢
  change (S.meshQuot b).map F = 0 at hF
  change (S.meshQuot b).map (LinearPaths.proj d x y F) = 0
  rw [S.meshQuot_map_eq_zero_iff] at hF ⊢
  exact LinearPaths.proj_mem_linearSpan (V := S.ARVertex) _
    (meshRelations_homogeneous (V := S.ARVertex) (Q := S.arTranslationQuiver)
      (S.arCoefficients b)) d hF

/-- The degree-`d` projection on the Hom spaces of `k(Γ_A)`. -/
def meshProj (d : ℕ) (x y : S.ARVertex) :
    ((S.meshQuot b).obj (LinearPaths.obj (k := k) x) ⟶
        (S.meshQuot b).obj (LinearPaths.obj (k := k) y)) →ₗ[k]
      ((S.meshQuot b).obj (LinearPaths.obj (k := k) x) ⟶
        (S.meshQuot b).obj (LinearPaths.obj (k := k) y)) :=
  ((LinearMap.ker (S.meshQuotL b x y)).liftQ _ (S.ker_meshQuotL_le b d x y)).comp
    ((S.meshQuotL b x y).quotKerEquivOfSurjective (S.meshQuotL_surjective b x y)).symm.toLinearMap

theorem meshProj_apply (d : ℕ) {x y : S.ARVertex} (F : LinearPaths.obj (k := k) x ⟶ LinearPaths.obj y) :
    S.meshProj b d x y ((S.meshQuot b).map F) = (S.meshQuot b).map (LinearPaths.proj d x y F) := by
  have h1 : ((S.meshQuotL b x y).quotKerEquivOfSurjective (S.meshQuotL_surjective b x y)).symm
      ((S.meshQuot b).map F) = Submodule.Quotient.mk F := by
    rw [LinearEquiv.symm_apply_eq]; rfl
  simp only [meshProj, LinearMap.comp_apply, LinearEquiv.coe_coe]
  erw [h1]
  rfl

/-- The Hom spaces of `k(Γ_A)` are the internal direct sums of their path-degree
parts. -/
theorem isInternal_degreePart (x y : S.ARVertex) :
    DirectSum.IsInternal fun d ↦ ScalarMeshCategory.degreePart (S.arCoefficients b) d x y := by
  apply DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
  · rw [iSupIndep_def]
    intro d
    rw [Submodule.disjoint_def]
    intro g hd hsup
    -- the projection fixes `C_d` and kills the other degree parts
    have hfix : ∀ e, ∀ g' ∈ ScalarMeshCategory.degreePart (S.arCoefficients b) e x y,
        S.meshProj b d x y g' = if e = d then g' else 0 := by
      intro e g' hg'
      obtain ⟨F, hF, rfl⟩ := hg'
      change S.meshProj b d x y ((S.meshQuot b).map F) = _
      rw [S.meshProj_apply, LinearPaths.proj_of_mem hF]
      split_ifs <;> simp
    have hle : (⨆ e, ⨆ (_ : e ≠ d), ScalarMeshCategory.degreePart (S.arCoefficients b) e x y) ≤
        LinearMap.ker (S.meshProj b d x y) := by
      refine iSup₂_le fun e he g' hg' ↦ ?_
      rw [LinearMap.mem_ker, hfix e g' hg', if_neg he]
    have h1 := hfix d g hd
    rw [if_pos rfl] at h1
    have h2 : S.meshProj b d x y g = 0 := hle hsup
    rw [← h1, h2]
  · rw [eq_top_iff]
    intro g _
    obtain ⟨F, rfl⟩ := S.meshQuotL_surjective b x y g
    obtain ⟨N, hN⟩ := LinearPaths.eq_sum_proj (k := k) F
    rw [hN, map_sum]
    exact Submodule.sum_mem _ fun d _ ↦ Submodule.mem_iSup_of_mem d
      ⟨_, LinearPaths.proj_mem F, rfl⟩

end MultiplicativeBasisDeformations.IndSkeleton

namespace MultiplicativeBasisDeformations.IndSkeleton

universe w

variable {k A : Type w} [Field k] [IsAlgClosed k] [Ring A] [Algebra k A] [FiniteDimensional k A]
  [IsNoetherianRing Aᵐᵒᵖ] (S : IndSkeleton k A) (b : S.ArrowBases)

theorem phi_arrow {x y : S.ARVertex} (a : x ⟶ y)
    (ha : ScalarMeshCategory.arrowMor (S.arCoefficients b) a ∈
      ScalarMeshCategory.degreePart (S.arCoefficients b) 1 x y) :
    S.phi b 1 x y ⟨_, ha⟩ = b x y a := by
  have e : (⟨_, ha⟩ : ScalarMeshCategory.degreePart (S.arCoefficients b) 1 x y) =
      S.qd b 1 x y ⟨LinearPaths.arrow a, LinearPaths.arrow_mem_degreePart a⟩ := rfl
  rw [e, S.phi_qd]
  change S.layerClass (S.realize b x y (LinearPaths.arrow a)) _ = _
  simp only [realize_arrow]
  exact S.irrClass_rep b a

theorem phi_comp {d e : ℕ} {x y z : S.ARVertex}
    (f : ScalarMeshCategory.degreePart (S.arCoefficients b) d x y)
    (g : ScalarMeshCategory.degreePart (S.arCoefficients b) e y z)
    (f' : S.label x ⟶ S.label y) (hf' : f' ∈ S.radPow d _ _)
    (g' : S.label y ⟶ S.label z) (hg' : g' ∈ S.radPow e _ _)
    (hf : S.phi b d x y f = S.layerClass f' hf') (hg : S.phi b e y z g = S.layerClass g' hg') :
    ∃ (hfg : (f : S.meshObj b x ⟶ S.meshObj b y) ≫ g ∈
        ScalarMeshCategory.degreePart (S.arCoefficients b) (d + e) x z)
      (hfg' : f' ≫ g' ∈ S.radPow (d + e) _ _),
      S.phi b (d + e) x z ⟨_, hfg⟩ = S.layerClass (f' ≫ g') hfg' := by
  obtain ⟨F, rfl⟩ := LinearMap.submoduleMap_surjective (S.meshQuotL b x y) _ f
  obtain ⟨G, rfl⟩ := LinearMap.submoduleMap_surjective (S.meshQuotL b y z) _ g
  have hFG : F.1 ≫ G.1 ∈ LinearPaths.degreePart (k := k) (d + e) x z :=
    LinearPaths.comp_mem_degreePart F.2 G.2
  refine ⟨⟨F.1 ≫ G.1, hFG, (S.meshQuot b).map_comp _ _⟩, S.comp_mem_radPow hf' hg', ?_⟩
  refine (congrArg (S.phi b (d + e) x z)
    (Subtype.ext ((S.meshQuot b).map_comp F.1 G.1).symm :
      (⟨_, ⟨F.1 ≫ G.1, hFG, (S.meshQuot b).map_comp _ _⟩⟩ :
        ScalarMeshCategory.degreePart (S.arCoefficients b) (d + e) x z) =
        S.qd b (d + e) x z ⟨F.1 ≫ G.1, hFG⟩)).trans ?_
  rw [S.phi_qd]
  rw [S.phi_qd] at hf hg
  change S.layerClass (S.realize b x z (F.1 ≫ G.1)) _ = _
  have hF' : S.realize b x y F.1 - f' ∈ S.radPow (d + 1) _ _ :=
    (Submodule.Quotient.eq ((S.radPow (d + 1) _ _).comap (S.radPow d _ _).subtype)).1 hf
  have hG' : S.realize b y z G.1 - g' ∈ S.radPow (e + 1) _ _ :=
    (Submodule.Quotient.eq ((S.radPow (e + 1) _ _).comap (S.radPow e _ _).subtype)).1 hg
  apply (Submodule.Quotient.eq ((S.radPow (d + e + 1) _ _).comap (S.radPow (d + e) _ _).subtype)).2
  change S.realize b x z (F.1 ≫ G.1) - f' ≫ g' ∈ S.radPow (d + e + 1) _ _
  rw [S.realize_comp]
  have e2 : S.realize b x y F.1 ≫ S.realize b y z G.1 - f' ≫ g' =
      (S.realize b x y F.1 - f') ≫ S.realize b y z G.1 + f' ≫ (S.realize b y z G.1 - g') := by
    simp only [Preadditive.sub_comp, Preadditive.comp_sub]; abel
  rw [e2]
  refine add_mem ?_ ?_
  · have := S.comp_mem_radPow hF' (S.realize_mem b G.2)
    rwa [show d + 1 + e = d + e + 1 by omega] at this
  · have := S.comp_mem_radPow hf' hG'
    rwa [show d + (e + 1) = d + e + 1 by omega] at this

/-- **Proposition 2.6(3)** (`prop:graded-realization`). -/
theorem gradedRealization_full :
    (∀ x y : S.ARVertex,
      DirectSum.IsInternal fun d ↦ ScalarMeshCategory.degreePart (S.arCoefficients b) d x y) ∧
    ∃ φ : ∀ (d : ℕ) (x y : S.ARVertex),
        ScalarMeshCategory.degreePart (S.arCoefficients b) d x y ≃ₗ[k]
          S.layer d (S.label x) (S.label y),
      (∀ (x y : S.ARVertex) (a : x ⟶ y)
        (ha : ScalarMeshCategory.arrowMor (S.arCoefficients b) a ∈
          ScalarMeshCategory.degreePart (S.arCoefficients b) 1 x y),
        φ 1 x y ⟨_, ha⟩ = b x y a) ∧
      ∀ (d e : ℕ) (x y z : S.ARVertex)
        (f : ScalarMeshCategory.degreePart (S.arCoefficients b) d x y)
        (g : ScalarMeshCategory.degreePart (S.arCoefficients b) e y z)
        (f' : S.label x ⟶ S.label y) (hf' : f' ∈ S.radPow d _ _)
        (g' : S.label y ⟶ S.label z) (hg' : g' ∈ S.radPow e _ _),
        φ d x y f = S.layerClass f' hf' → φ e y z g = S.layerClass g' hg' →
        ∃ (hfg : (f : S.meshObj b x ⟶ S.meshObj b y) ≫ g ∈
            ScalarMeshCategory.degreePart (S.arCoefficients b) (d + e) x z)
          (hfg' : f' ≫ g' ∈ S.radPow (d + e) _ _),
          φ (d + e) x z ⟨_, hfg⟩ = S.layerClass (f' ≫ g') hfg' :=
  ⟨S.isInternal_degreePart b, S.phi b, fun _ _ a ha ↦ S.phi_arrow b a ha,
    fun _ _ _ _ _ f g f' hf' g' hg' hf hg ↦ S.phi_comp b f g f' hf' g' hg' hf hg⟩

end MultiplicativeBasisDeformations.IndSkeleton
