import MultiplicativeBasisDeformations.Foundations.MeshCategory

/-!
# The mesh derivative and the brick hypothesis

Section 5 of the frozen manuscript (`mesh-deformations.tex`).

* The derivative `D_m` (`eq:mesh-derivative`): for a family `f = (f_a)_a` of
  morphisms parallel to the arrows,
  `(D_m f)_x = ∑_{a : y → x} c_{x,a} (f_{σ a} a + (σ a) f_a)`.
  It is recorded here as a function on all parallel families; the manuscript
  restricts it to families of path degree `m`, with values of degree `m + 1`.
* The object quotient `C/[Σ]` by the ideal generated by the identities of a set
  `Σ` of objects, and the brick hypothesis (Subsection 5.2): every object
  quotient that is not zero has an object whose endomorphism ring is `k`.
-/

set_option autoImplicit false

noncomputable section

open CategoryTheory

namespace MultiplicativeBasisDeformations

universe u v w

variable {k : Type u} [CommRing k] {V : Type v} [Quiver.{w} V]
  {Q : TranslationQuiver V} [∀ x : V, Fintype (Σ y : V, y ⟶ x)]

namespace ScalarMeshCategory

variable (c : MeshCoefficients k Q)

/-- The image of an arrow in the scalar mesh category. -/
def arrowMor {x y : V} (a : x ⟶ y) : obj c x ⟶ obj c y :=
  (RelationCategory.functor k (meshRelations c)).map (LinearPaths.arrow a)

/-- A family of morphisms parallel to the arrows of `Q`. -/
abbrev ArrowFamily := ∀ a : Σ x y : V, x ⟶ y, obj c a.1 ⟶ obj c a.2.1

/-- A family of morphisms `τ x ⟶ x` at the nonprojective vertices. -/
abbrev MeshFamily := ∀ x : Q.nonprojective, obj c (Q.tau x).1 ⟶ obj c x.1

/-- The mesh derivative `(D f)_x = ∑_{a : y → x} c_{x,a} (f_{σ a} a + (σ a) f_a)`
(`eq:mesh-derivative`). -/
def meshDerivative (f : ArrowFamily c) : MeshFamily c :=
  fun x ↦ ∑ a : Σ y : V, y ⟶ x.1,
    ((c x a.1 a.2 : kˣ) : k) •
      (f ⟨(Q.tau x).1, a.1, Q.mate x a.1 a.2⟩ ≫ arrowMor c a.2 +
        arrowMor c (Q.mate x a.1 a.2) ≫ f ⟨a.1, x.1, a.2⟩)

/-- The derivative `D_m` is surjective in degree `m`: every family of
degree-`(m+1)` mesh errors is `D f` for a family `f` of degree `m`. -/
def MeshDerivativeSurjective (m : ℕ) : Prop :=
  ∀ g : MeshFamily c, (∀ x, g x ∈ degreePart c (m + 1) (Q.tau x).1 x.1) →
    ∃ f : ArrowFamily c, (∀ a, f a ∈ degreePart c m a.1 a.2.1) ∧
      meshDerivative c f = g

/-- The relations killing the identities of the objects in a set `D` (the manuscript's `Σ`). -/
def identityRelations (D : Set V) :
    ∀ X Y : ScalarMeshCategory k Q c, Set (X ⟶ Y) :=
  fun X Y ↦ {f | ∃ s ∈ D, ∃ (hX : X = obj c s) (hY : Y = obj c s),
    f = eqToHom (hX.trans hY.symm)}

/-- The object quotient `C/[D]`: the quotient by the ideal of morphisms that
factor through finite sums of objects of `D`. -/
abbrev ObjectQuotient (D : Set V) := RelationCategory k (identityRelations c D)

/-- The image of a vertex in an object quotient. -/
abbrev ObjectQuotient.obj (D : Set V) (x : V) : ObjectQuotient c D :=
  (RelationCategory.functor k (identityRelations c D)).obj (ScalarMeshCategory.obj c x)

/-- The brick hypothesis: every object quotient with a nonzero object has an
object whose endomorphism ring is `k`. -/
def BrickHypothesis : Prop :=
  ∀ D : Set V, (∃ x, 𝟙 (ObjectQuotient.obj c D x) ≠ 0) →
    ∃ x, Module.finrank k (ObjectQuotient.obj c D x ⟶ ObjectQuotient.obj c D x) = 1

end ScalarMeshCategory

end MultiplicativeBasisDeformations
