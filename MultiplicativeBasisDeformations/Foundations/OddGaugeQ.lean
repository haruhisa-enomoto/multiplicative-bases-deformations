module

public import MultiplicativeBasisDeformations.Foundations.OddGauge
public import MultiplicativeBasisDeformations.Foundations.GaugeDescent
public import MultiplicativeBasisDeformations.Foundations.StarAut
public import MultiplicativeBasisDeformations.Foundations.ReRoot

/-!
# Lemma A.1(2) on `Q`

For a covering `π : ℤA_{2h} → Q` whose deck group is generated by
`g (d, s) = (2h - 1 - d, s + c₀)` (`c₀` odd), every coefficient system on `Q`
becomes the system with all coefficients one after rescaling arrows and entire
mesh relations.
-/

@[expose] public section

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option backward.isDefEq.respectTransparency false

noncomputable section

open CategoryTheory

namespace MultiplicativeBasisDeformations

universe u v' w

namespace OddGauge

open OrientedTree StarGauge

variable {L : Fin 1 → ℕ}

/-- The vertex at a given depth (the centre outside the range). -/
def vd (L : Fin 1 → ℕ) (d : ℕ) : StarV L := if hd : d ≤ L 0 + 1 then ofDep L d hd else none

theorem vd_depth (v : StarV L) : vd L (starDepth v) = v := by
  unfold vd
  rw [dif_pos (depth_le v)]
  exact depth_injective (starDepth_ofDep _ _)

theorem depth_vd (d : ℕ) (hd : d ≤ L 0 + 1) : starDepth (vd L d) = d := by
  unfold vd; rw [dif_pos hd, starDepth_ofDep]

variable {V : Type v'} [Quiver.{w} V] [∀ x y : V, Subsingleton (x ⟶ y)] {Q : TranslationQuiver V}
  (hQ : Q.IsStable) (π : (starTree L).ZVert ⥤q V) (hπ : π.IsCovering)
  {k : Type u} [Field k] [∀ x : V, Fintype (Σ y : V, y ⟶ x)] (c : MeshCoefficients k Q)
  (σ : StarV L ≃ StarV L) (hσ : ∀ a b, (starTree L).G.Adj (σ a) (σ b) ↔ (starTree L).G.Adj a b)
  (c0 : ℕ) (hσp : ∀ v, (starTree L).par (σ v) = (starTree L).par v + ((c0 : ℤ) : ZMod 2))
  (hdeck : ∀ Z, π.obj (((starTree L).zAct σ hσ (c0 : ℤ) hσp).obj Z) = π.obj Z)
  (h : ℕ) (hh : 1 ≤ h) (hL : L 0 = 2 * h - 2)
  (hrev : ∀ x, starDepth (σ x) + starDepth x = L 0 + 1)

/-- The coefficients of `Q` by depths. -/
def Cd (a b : ℕ) (s : ℤ) : kˣ := Cf hQ π c (vd L a) (vd L b) s

include hrev hL hh in
theorem σ_vd (a : ℕ) (ha : a < 2 * h) : σ (vd L a) = vd L (2 * h - 1 - a) := by
  have := hrev (vd L a)
  rw [depth_vd a (by omega), hL] at this
  rw [← vd_depth (σ (vd L a))]
  congr 1; omega

include hrev hL hh hdeck in
theorem Cd_inv (a b : ℕ) (s : ℤ) (ha : a < 2 * h) (hb : b < 2 * h) :
    Cd hQ π c (2 * h - 1 - a) (2 * h - 1 - b) (s + c0) = Cd hQ π c a b s := by
  unfold Cd
  rw [← σ_vd σ h hh hL hrev a ha, ← σ_vd σ h hh hL hrev b hb]
  exact Cf_inv hQ π c σ hσ c0 hσp hdeck _ _ _

include hrev hL hdeck in
theorem Cd_per (a b : ℕ) (s : ℤ) :
    Cd hQ π c a b (s + (2 * c0 : ℕ)) = Cd hQ π c a b s := by
  unfold Cd
  have hinv : ∀ v, σ (σ v) = v := by
    intro v
    apply depth_injective
    have h1 := hrev (σ v); have h2 := hrev v; omega
  rw [← Cf_inv hQ π c σ hσ c0 hσp hdeck (vd L a) (vd L b) s,
    ← Cf_inv hQ π c σ hσ c0 hσp hdeck (σ (vd L a)) (σ (vd L b)) (s + c0), hinv, hinv]
  congr 1; push_cast; ring

/-- The relation scales on `ℤΔ`. -/
def EZ (X : (starTree L).ZVert) : kˣ := Nd h (Cd hQ π c) c0 (starDepth X.v) X.t

open Classical in
/-- The arrow scales on `ℤΔ`. -/
def FZ (Y X : (starTree L).ZVert) : kˣ :=
  if starDepth X.v = starDepth Y.v + 1 ∨ starDepth Y.v = starDepth X.v + 1 then
    Md h (Cd hQ π c) c0 (min (starDepth Y.v) (starDepth X.v)) Y.t
  else 1

include hrev hL hh hdeck in
theorem EZ_inv (hodd : Odd c0) (X : (starTree L).ZVert) :
    EZ hQ π c c0 h (gZ σ hσ c0 hσp X) = EZ hQ π c c0 h X := by
  unfold EZ
  have hd := hrev X.v
  have hle := depth_le X.v
  change Nd h (Cd hQ π c) c0 (starDepth (σ X.v)) (X.t + c0) = _
  rw [show starDepth (σ X.v) = 2 * h - 1 - starDepth X.v by omega]
  exact Nd_inv h (Cd hQ π c) c0 (by obtain ⟨r, hr⟩ := hodd; omega)
    (Cd_per hQ π c σ hσ c0 hσp hdeck h hL hrev) _ (by omega) _

include hrev hL hh hdeck in
theorem FZ_inv (hodd : Odd c0) (Y X : (starTree L).ZVert) :
    FZ hQ π c c0 h (gZ σ hσ c0 hσp Y) (gZ σ hσ c0 hσp X) = FZ hQ π c c0 h Y X := by
  unfold FZ
  have hdX := hrev X.v
  have hdY := hrev Y.v
  have hleX := depth_le X.v
  have hleY := depth_le Y.v
  change (if starDepth (σ X.v) = starDepth (σ Y.v) + 1 ∨ starDepth (σ Y.v) = starDepth (σ X.v) + 1
    then Md h (Cd hQ π c) c0 (min (starDepth (σ Y.v)) (starDepth (σ X.v))) (Y.t + c0) else 1) = _
  rw [show starDepth (σ X.v) = 2 * h - 1 - starDepth X.v by omega,
    show starDepth (σ Y.v) = 2 * h - 1 - starDepth Y.v by omega]
  by_cases hadj : starDepth X.v = starDepth Y.v + 1 ∨ starDepth Y.v = starDepth X.v + 1
  · rw [if_pos (by omega), if_pos hadj]
    rw [show min (2 * h - 1 - starDepth Y.v) (2 * h - 1 - starDepth X.v) =
      2 * h - 2 - min (starDepth Y.v) (starDepth X.v) by
        rcases hadj with h1 | h1 <;> simp only [min_def] <;> split_ifs <;> omega]
    exact Md_inv h (Cd hQ π c) c0 (by obtain ⟨r, hr⟩ := hodd; omega)
      (Cd_per hQ π c σ hσ c0 hσp hdeck h hL hrev) _ (by omega) _
  · rw [if_neg (by omega), if_neg hadj]

include hrev hL hh hdeck in
/-- **The gauge equations on `ℤΔ`**, with all target coefficients one. -/
theorem zEq_one (hodd : Odd c0) (X : (starTree L).zQuiver.nonprojective) (Y : (starTree L).ZVert)
    (A : Y ⟶ X.1) :
    (1 : kˣ) = EZ hQ π c c0 h X.1 * (starTree L).pullCoeff hQ π c X Y A *
      FZ hQ π c c0 h ((starTree L).zQuiver.tau X).1 Y * FZ hQ π c c0 h Y X.1 := by
  rw [pullCoeff_eq]
  obtain ⟨⟨wv, s, hs⟩, hX⟩ := X
  obtain ⟨wv', s', hs'⟩ := Y
  obtain ⟨hadj, ht⟩ := A.down
  change s = s' + 1 at ht
  subst ht
  change starAdj wv' wv at hadj
  rw [ReRoot.adj_one] at hadj
  have hle := depth_le wv
  have hle' := depth_le wv'
  have hpar : ((s' + 1 - 2 : ℤ) : ZMod 2) = ((starDepth wv : ℕ) : ZMod 2) := by
    rw [← show (starTree L).par wv = ((starDepth wv : ℕ) : ZMod 2) from rfl, ← hs]
    push_cast; rw [show (2 : ZMod 2) = 0 from rfl, sub_zero]
  have key := eqn h (Cd hQ π c) c0 (by obtain ⟨r, hr⟩ := hodd; omega)
    (Cd_per hQ π c σ hσ c0 hσp hdeck h hL hrev) hh
    (fun a b s ha hb ↦ Cd_inv hQ π c σ hσ c0 hσp hdeck h hh hL hrev a b s ha hb) hodd
    (starDepth wv) (starDepth wv') (by omega) (by omega) (by omega) (s' + 1 - 2) hpar
  unfold EZ FZ Cd at *
  rw [vd_depth, vd_depth] at key
  simp only [OrientedTree.zQuiver_tau_v, OrientedTree.zQuiver_tau_t]
  rw [if_pos (by omega), if_pos (by omega), min_comm (starDepth wv') (starDepth wv)]
  rw [show s' + 1 - 2 + 2 = s' + 1 by ring, show s' + 1 - 2 + 1 = s' by ring] at key
  rw [← key]

variable (hτ : ∀ Y, π.obj ((starTree L).ztau Y) = hQ.tauE (π.obj Y))
  (hsurj : ∀ x : V, ∃ X, π.obj X = x)
  (hfib : ∀ X Y : (starTree L).ZVert, π.obj X = π.obj Y →
    ∃ n : ℕ, Y = (gZ σ hσ c0 hσp)^[n] X ∨ X = (gZ σ hσ c0 hσp)^[n] Y)

include hrev hL hh hdeck hτ hπ hsurj hfib in
/-- **Lemma A.1(2)**: on an odd quotient of even `A`, every coefficient system
becomes the system with all coefficients one after rescaling arrows and entire
mesh relations. -/
theorem exists_one_gauge (hodd : Odd c0) :
    ∃ (μ : ∀ {x y : V}, (x ⟶ y) → kˣ) (η : Q.nonprojective → kˣ),
      (starTree L).pullCoeff hQ π (fun x y a ↦ η x * c x y a * μ (Q.mate x y a) * μ a) =
        fun _ _ _ ↦ 1 := by
  have hE := EZ_inv hQ π c σ hσ c0 hσp hdeck h hh hL hrev hodd
  have hF := FZ_inv hQ π c σ hσ c0 hσp hdeck h hh hL hrev hodd
  refine ⟨fun a ↦ μD π hπ hsurj (FZ hQ π c c0 h) a, ηD π hsurj (EZ hQ π c c0 h), ?_⟩
  funext X Y A
  rw [zEq_one hQ π c σ hσ c0 hσp hdeck h hh hL hrev hodd X Y A]
  change ηD π hsurj (EZ hQ π c c0 h) ⟨π.obj X.1, hQ.mem_nonprojective _⟩ * _ *
    μD π hπ hsurj (FZ hQ π c c0 h) _ * μD π hπ hsurj (FZ hQ π c c0 h) (π.map A) = _
  rw [ηD_eq hQ π σ hσ c0 hσp hsurj hfib _ hE,
    μD_eq π hπ σ hσ c0 hσp hdeck hsurj hfib _ hF A,
    μD_congr π hπ hsurj _ _ (π.map ((starTree L).zQuiver.mate X Y A)) (hτ X.1).symm rfl,
    μD_eq π hπ σ hσ c0 hσp hdeck hsurj hfib _ hF]
  rfl

end OddGauge

end MultiplicativeBasisDeformations
