import MultiplicativeBasisDeformations.Foundations.Criterion

/-!
# Evaluation at the projective labels: full faithfulness (Lemma 2.9)

Construction 2.8 (`con:projective-algebra`): `A₀ = ⊕_{x,y} D(P_y, P_x)`, the
category algebra of the projective labels, and evaluation sends `X` to the
module with components `C(P_x, X)`. Lemma 2.9 (first part,
`graded-category.tex:440–470`): under the vanishings for modules killed by `e`,
"`P ↦ Pe` is fully faithful on `proj Λ`". The manuscript proves this with the
multiplication map `(Me) ⊗_{Λ_e} eΛ → M`, whose kernel and cokernel are killed
by `e`, and the vanishings. We use the same two steps without the tensor
product: a map `g` on the `e`-parts is defined on the submodule generated by
the `e`-part by `∑ λ_i m_i ↦ ∑ λ_i g(m_i)`, well defined because the
discrepancy generates a submodule killed by `e` (Hom-vanishing), and it extends
to the whole module because the quotient is killed by `e` (Ext¹-vanishing).

`add C` is represented by finite families of labels; maps between families are
matrices of morphisms.
-/

set_option autoImplicit false

noncomputable section

open CategoryTheory

namespace MultiplicativeBasisDeformations

universe u v w

namespace CatAlg

variable {k : Type u} [Field k] {𝒞 : Type v} [Category.{w} 𝒞] [Preadditive 𝒞] [Linear k 𝒞]
  {ι : Type} [Fintype ι] [DecidableEq ι] {F : ι → 𝒞}
  {L : LocalFamily (k := k) F} (D : MeshData F L)

namespace MeshData

/-- The projective labels. -/
abbrev PV := {x : ι // D.proj x}

/-- The projective labels as a family of objects. -/
abbrev F0 : D.PV → 𝒞 := fun p ↦ F p.1

/-- Extension by zero from the projective labels. -/
def extZ (X : 𝒞) : Rep D.F0 X →ₗ[k] Rep F X where
  toFun m y := if h : D.proj y then m ⟨y, h⟩ else 0
  map_add' m n := by
    ext y
    change (if h : D.proj y then (m + n) ⟨y, h⟩ else (0 : F y ⟶ X)) =
      (if h : D.proj y then m ⟨y, h⟩ else (0 : F y ⟶ X)) +
        (if h : D.proj y then n ⟨y, h⟩ else (0 : F y ⟶ X))
    split_ifs <;> simp [Rep.add_apply]
  map_smul' c m := by
    ext y
    change (if h : D.proj y then (c • m) ⟨y, h⟩ else (0 : F y ⟶ X)) =
      c • (if h : D.proj y then m ⟨y, h⟩ else (0 : F y ⟶ X))
    split_ifs <;> simp [Rep.smul_apply']

/-- Restriction to the projective labels. -/
def restr (X : 𝒞) : Rep F X →ₗ[k] Rep D.F0 X where
  toFun m p := m p.1
  map_add' m n := rfl
  map_smul' c m := rfl

@[simp] theorem extZ_apply {X : 𝒞} (m : Rep D.F0 X) (y : ι) :
    D.extZ X m y = if h : D.proj y then m ⟨y, h⟩ else 0 := rfl

@[simp] theorem restr_apply {X : 𝒞} (m : Rep F X) (p : D.PV) : D.restr X m p = m p.1 := rfl

theorem sum_proj {T : Type*} [AddCommMonoid T] (G : ι → T) (hG : ∀ z, ¬ D.proj z → G z = 0) :
    ∑ z, G z = ∑ q : D.PV, G q.1 := by
  rw [← Finset.sum_subtype (Finset.univ.filter D.proj) (by simp) G, Finset.sum_filter]
  refine Finset.sum_congr rfl fun z _ ↦ ?_
  split_ifs with h
  · rfl
  · exact hG z h

theorem restr_extZ (X : 𝒞) (m : Rep D.F0 X) : D.restr X (D.extZ X m) = m := by
  ext p
  change (if h : D.proj p.1 then m ⟨p.1, h⟩ else 0) = m p
  rw [dif_pos p.2]

theorem extZ_injective (X : 𝒞) : Function.Injective (D.extZ X) := fun m n h ↦ by
  rw [← D.restr_extZ X m, ← D.restr_extZ X n, h]

/-- The `P × P` block of an element of `Λ`. -/
def resAlg (μ : Alg F) : Alg D.F0 := fun p q ↦ μ p.1 q.1

theorem resAlg_add (μ ν : Alg F) : D.resAlg (μ + ν) = D.resAlg μ + D.resAlg ν := rfl

theorem resAlg_mul_of_rows (μ ν : Alg F) (hμ : ∀ y z, ¬ D.proj z → μ y z = 0) :
    D.resAlg (μ * ν) = D.resAlg μ * D.resAlg ν := by
  ext p q
  simp only [resAlg, mul_apply]
  rw [← Finset.sum_subtype (Finset.univ.filter D.proj) (by simp)
    (fun z ↦ μ p.1 z ≫ ν z q.1), Finset.sum_filter]
  refine Finset.sum_congr rfl fun z _ ↦ ?_
  split_ifs with hz
  · rfl
  · rw [hμ _ _ hz, Limits.zero_comp]

/-- **Elements with rows in `P` act on the `e`-part through their `P × P`
block.** -/
theorem smul_extZ {X : 𝒞} (μ : Alg F) (hμ : ∀ y z, ¬ D.proj y → μ y z = 0) (m : Rep D.F0 X) :
    μ • D.extZ X m = D.extZ X (D.resAlg μ • m) := by
  ext y
  rw [Rep.smul_apply, extZ_apply]
  by_cases hy : D.proj y
  · rw [dif_pos hy, Rep.smul_apply,
      D.sum_proj (fun z ↦ μ y z ≫ D.extZ X m z) (fun z hz ↦ by rw [extZ_apply, dif_neg hz,
        Limits.comp_zero])]
    refine Finset.sum_congr rfl fun q _ ↦ ?_
    rw [extZ_apply, dif_pos q.2]
    rfl
  · rw [dif_neg hy]
    exact Finset.sum_eq_zero fun z _ ↦ by rw [hμ y z hy, Limits.zero_comp]

theorem idem_mul_rows (p : D.PV) (a : Alg F) : ∀ y z, ¬ D.proj y → (idem (F := F) p.1 * a) y z = 0 := by
  intro y z hy
  rw [mul_apply]
  refine Finset.sum_eq_zero fun t _ ↦ ?_
  simp only [idem, colAlg, unit]
  rw [idTo_ne (fun h ↦ hy (by rw [h]; exact p.2)), Limits.zero_comp, Limits.zero_comp]

/-- `e_p m` lies in the image of extension by zero. -/
theorem idem_smul_eq_extZ {X : 𝒞} (p : D.PV) (m : Rep F X) :
    idem (F := F) p.1 • m = D.extZ X (D.restr X (idem (F := F) p.1 • m)) := by
  ext y
  rw [extZ_apply]
  split_ifs with h
  · rfl
  · rw [idem_smul_rep, if_neg]
    rintro rfl
    exact h p.2

/-! ### Finite families -/

section Families

variable {κ κ' : Type} [Fintype κ] [DecidableEq κ] [Fintype κ'] [DecidableEq κ']

variable (F) in
/-- `R_Z = ⊕_j R_{Z j}` for a family of labels. -/
abbrev RZ (Z : κ → ι) := ∀ j, Rep F (F (Z j))

/-- The evaluation `⊕_j C(P_-, Z j)` of a family. -/
abbrev EZ (Z : κ → ι) := ∀ j, Rep D.F0 (F (Z j))

variable (F) in
/-- Matrices of morphisms between families. -/
abbrev Mat (Z : κ → ι) (Z' : κ' → ι) := ∀ j j', F (Z j) ⟶ F (Z' j')

/-- The `Λ`-linear map of a matrix. -/
def bigMap {Z : κ → ι} {Z' : κ' → ι} (f : Mat F Z Z') : RZ F Z →ₗ[Alg F] RZ F Z' :=
  LinearMap.pi fun j' ↦ ∑ j, (repMap (f j j')).comp (LinearMap.proj j)

/-- The `A₀`-linear map of a matrix: evaluation. -/
def evMap {Z : κ → ι} {Z' : κ' → ι} (f : Mat F Z Z') : D.EZ Z →ₗ[Alg D.F0] D.EZ Z' :=
  LinearMap.pi fun j' ↦ ∑ j, (repMap (F := D.F0) (f j j')).comp (LinearMap.proj j)

theorem bigMap_apply {Z : κ → ι} {Z' : κ' → ι} (f : Mat F Z Z') (m : RZ F Z) (j' : κ') :
    bigMap f m j' = ∑ j, repMap (f j j') (m j) := by
  simp [bigMap, LinearMap.sum_apply]

theorem evMap_apply {Z : κ → ι} {Z' : κ' → ι} (f : Mat F Z Z') (m : D.EZ Z) (j' : κ') :
    D.evMap f m j' = ∑ j, repMap (F := D.F0) (f j j') (m j) := by
  simp [evMap, LinearMap.sum_apply]

/-- Extension by zero, componentwise. -/
def extZs (Z : κ → ι) : D.EZ Z →ₗ[k] RZ F Z :=
  LinearMap.pi fun j ↦ (D.extZ (F (Z j))).comp (LinearMap.proj j)

theorem extZs_apply (Z : κ → ι) (m : D.EZ Z) (j : κ) : D.extZs Z m j = D.extZ _ (m j) := rfl

theorem extZs_injective (Z : κ → ι) : Function.Injective (D.extZs Z) := fun m n h ↦ by
  funext j
  exact D.extZ_injective _ (congrFun h j)

theorem repMap_extZ {X Y : 𝒞} (f : X ⟶ Y) (m : Rep D.F0 X) :
    repMap f (D.extZ X m) = D.extZ Y (repMap (F := D.F0) f m) := by
  ext y
  rw [repMap_apply, extZ_apply, extZ_apply]
  split_ifs <;> simp

theorem bigMap_extZs {Z : κ → ι} {Z' : κ' → ι} (f : Mat F Z Z') (m : D.EZ Z) :
    bigMap f (D.extZs Z m) = D.extZs Z' (D.evMap f m) := by
  funext j'
  rw [bigMap_apply, extZs_apply, evMap_apply, map_sum]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [extZs_apply, repMap_extZ]

/-- The matrix of a `Λ`-linear map between families (Yoneda). -/
def yonMat {Z : κ → ι} {Z' : κ' → ι} (Φ : RZ F Z →ₗ[Alg F] RZ F Z') : Mat F Z Z' := fun j j' ↦
  ((Φ (Pi.single j (unit (Z j)))) j') (Z j)

theorem eq_bigMap {Z : κ → ι} {Z' : κ' → ι} (Φ : RZ F Z →ₗ[Alg F] RZ F Z') : Φ = bigMap (yonMat Φ) := by
  refine LinearMap.pi_ext' fun j ↦ ?_
  ext1 m
  funext j'
  simp only [LinearMap.comp_apply]
  rw [bigMap_apply, Finset.sum_eq_single j]
  · have h := eq_repMap ((LinearMap.proj j').comp (Φ.comp (LinearMap.single (Alg F)
      (fun j ↦ Rep F (F (Z j))) j)))
    have := LinearMap.congr_fun h m
    simp only [LinearMap.comp_apply, LinearMap.proj_apply] at this
    rw [this]
    simp [yonMat]
  · intro i _ hi; simp [Pi.single_apply, hi]
  · simp

theorem bigMap_injective {Z : κ → ι} {Z' : κ' → ι} {f g : Mat F Z Z'} (h : bigMap (F := F) f = bigMap g) :
    f = g := by
  funext j j'
  have := congrFun (LinearMap.congr_fun h (Pi.single j (unit (Z j)))) j'
  rw [bigMap_apply, bigMap_apply, Finset.sum_eq_single j, Finset.sum_eq_single j] at this
  · simp only [Pi.single_eq_same] at this
    have h2 := congrArg (fun r : Rep F (F (Z' j')) ↦ r (Z j)) this
    change (repMap (f j j') (unit (Z j))) (Z j) = (repMap (g j j') (unit (Z j))) (Z j) at h2
    rwa [unit_comp_apply, unit_comp_apply] at h2
  all_goals first | (intro i _ hi; simp [Pi.single_apply, hi]) | simp

theorem bigMap_zero {Z : κ → ι} {Z' : κ' → ι} : bigMap (F := F) (0 : Mat F Z Z') = 0 :=
  LinearMap.ext fun m ↦ funext fun j' ↦ by
    rw [bigMap_apply]
    simp only [Pi.zero_apply, repMap_zero, LinearMap.zero_apply, Finset.sum_const_zero]

/-- The `e`-part of a family generates a submodule whose quotient is killed by `e`. -/
theorem killedSub_span (Z : κ → ι) :
    D.KilledSub (Submodule.span (Alg F) (Set.range (D.extZs Z))) := by
  intro x hx m
  apply Submodule.subset_span
  refine ⟨fun j ↦ D.restr _ (idem (F := F) x • m j), ?_⟩
  funext j
  rw [extZs_apply]
  exact (D.idem_smul_eq_extZ ⟨x, hx⟩ (m j)).symm

theorem smul_extZs {Z : κ → ι} (μ : Alg F) (hμ : ∀ y z, ¬ D.proj y → μ y z = 0) (m : D.EZ Z) :
    μ • D.extZs Z m = D.extZs Z (D.resAlg μ • m) := by
  funext j
  exact D.smul_extZ μ hμ (m j)

variable [hfd : ∀ x y : ι, FiniteDimensional k (F x ⟶ F y)]

/-- **Evaluation is faithful** on `add C` (Lemma 2.9). -/
theorem evMap_injective {Z : κ → ι} {Z' : κ' → ι} {f : Mat F Z Z'} (h : D.evMap f = 0) : f = 0 := by
  set N := Submodule.span (Alg F) (Set.range (D.extZs Z))
  have hvan : N ≤ LinearMap.ker (bigMap f) := by
    rw [Submodule.span_le]
    rintro _ ⟨m, rfl⟩
    rw [SetLike.mem_coe, LinearMap.mem_ker, bigMap_extZs, h, LinearMap.zero_apply, map_zero]
  set θ := N.liftQ (bigMap f) hvan
  have hkilled : ∀ x, D.proj x → ∀ t : RZ F Z ⧸ N, idem (F := F) x • t = 0 := by
    intro x hx t
    obtain ⟨m, rfl⟩ := Submodule.mkQ_surjective N t
    rw [← map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact D.killedSub_span Z x hx m
  have hθ : θ = 0 := LinearMap.ext fun t ↦ funext fun j' ↦ by
    have := D.hom_eq_zero_of_killed hkilled (Z' j') ((LinearMap.proj j').comp θ)
    exact congrFun (congrArg DFunLike.coe this) t
  have hbig : bigMap f = bigMap (0 : Mat F Z Z') := by
    rw [bigMap_zero]
    refine LinearMap.ext fun m ↦ ?_
    have := LinearMap.congr_fun hθ (N.mkQ m)
    rw [Submodule.mkQ_apply, Submodule.liftQ_apply] at this
    exact this
  exact bigMap_injective hbig

/-- **Evaluation is full** on `add C` (Lemma 2.9). -/
theorem evMap_surjective {Z : κ → ι} {Z' : κ' → ι} (g : D.EZ Z →ₗ[Alg D.F0] D.EZ Z') :
    ∃ f : Mat F Z Z', D.evMap f = g := by
  classical
  set Φ : (D.EZ Z →₀ Alg F) →ₗ[Alg F] RZ F Z := Finsupp.linearCombination (Alg F) (D.extZs Z)
  set Ψ : (D.EZ Z →₀ Alg F) →ₗ[Alg F] RZ F Z' :=
    Finsupp.linearCombination (Alg F) (fun m ↦ D.extZs Z' (g m))
  -- the discrepancy generates a submodule killed by `e`
  have hker : LinearMap.ker Φ ≤ LinearMap.ker Ψ := by
    intro c hc
    rw [LinearMap.mem_ker] at hc ⊢
    set q := Ψ c
    have hkill : ∀ (p : D.PV) (a : Alg F), idem (F := F) p.1 • (a • q) = 0 := by
      intro p a
      set μ := idem (F := F) p.1 * a
      have hrows : ∀ b : Alg F, ∀ y z, ¬ D.proj y → (μ * b) y z = 0 := fun b ↦ by
        rw [show μ * b = idem (F := F) p.1 * (a * b) from mul_assoc _ _ _]
        exact D.idem_mul_rows p (a * b)
      have hq : μ • q = D.extZs Z' (g (c.sum fun m b ↦ D.resAlg (μ * b) • m)) := by
        simp only [q, Ψ, Finsupp.linearCombination_apply, Finsupp.smul_sum, smul_smul]
        rw [map_finsuppSum, map_finsuppSum]
        refine Finsupp.sum_congr fun m _ ↦ ?_
        rw [D.smul_extZs _ (hrows _), LinearMap.map_smul g]
      have hzero : (c.sum fun m b ↦ D.resAlg (μ * b) • m) = 0 := by
        apply D.extZs_injective Z
        rw [map_zero, map_finsuppSum]
        have : μ • Φ c = 0 := by rw [hc, smul_zero]
        rw [← this]
        simp only [Φ, Finsupp.linearCombination_apply, Finsupp.smul_sum, smul_smul]
        refine Finsupp.sum_congr fun m _ ↦ ?_
        rw [D.smul_extZs _ (hrows _)]
      rw [smul_smul, hq, hzero, map_zero, map_zero]
    set T := Submodule.span (Alg F) {q}
    haveI : FiniteDimensional k T :=
      Module.Finite.of_injective ((T.subtype).restrictScalars k) Subtype.val_injective
    have hT : ∀ x, D.proj x → ∀ t : T, idem (F := F) x • t = 0 := by
      intro x hx t
      obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.1 t.2
      apply Subtype.ext
      rw [Submodule.coe_smul, ← ha]
      exact hkill ⟨x, hx⟩ a
    funext j'
    have := D.hom_eq_zero_of_killed hT (Z' j') ((LinearMap.proj j').comp T.subtype)
    exact congrFun (congrArg DFunLike.coe this) ⟨q, Submodule.mem_span_singleton_self q⟩
  -- the map on the submodule generated by the `e`-part
  set φ₀ : LinearMap.range Φ →ₗ[Alg F] RZ F Z' :=
    ((LinearMap.ker Φ).liftQ Ψ hker).comp Φ.quotKerEquivRange.symm.toLinearMap
  have hφ₀ : ∀ m : D.EZ Z, φ₀ ⟨D.extZs Z m, Finsupp.single m 1, by simp [Φ]⟩ = D.extZs Z' (g m) := by
    intro m
    have : Φ.quotKerEquivRange.symm ⟨D.extZs Z m, Finsupp.single m 1, by simp [Φ]⟩ =
        Submodule.Quotient.mk (Finsupp.single m 1) := by
      rw [LinearEquiv.symm_apply_eq]
      apply Subtype.ext
      simp [Φ]
    simp only [φ₀, LinearMap.comp_apply, LinearEquiv.coe_coe]
    rw [this, Submodule.liftQ_apply]
    simp [Ψ]
  have hrange : LinearMap.range Φ = Submodule.span (Alg F) (Set.range (D.extZs Z)) :=
    Finsupp.range_linearCombination (Alg F)
  have hK : D.KilledSub (LinearMap.range Φ) := hrange ▸ D.killedSub_span Z
  -- extend componentwise
  choose ψ hψ using fun j' ↦ D.extP_top_of_killed (Z' j') (LinearMap.range Φ) hK
    ((LinearMap.proj j').comp φ₀)
  set Φbig : RZ F Z →ₗ[Alg F] RZ F Z' :=
    LinearMap.pi fun j' ↦ (ψ j').comp (LinearEquiv.ofTop (⊤ : Submodule (Alg F) (RZ F Z)) rfl).symm.toLinearMap
  refine ⟨yonMat Φbig, ?_⟩
  refine LinearMap.ext fun m ↦ D.extZs_injective Z' ?_
  rw [← bigMap_extZs, ← eq_bigMap]
  funext j'
  have := LinearMap.congr_fun (hψ j') ⟨D.extZs Z m, Finsupp.single m 1, by simp [Φ]⟩
  simp only [LinearMap.comp_apply, LinearMap.proj_apply] at this
  rw [hφ₀] at this
  rw [← this]
  rfl

end Families

end MeshData

end CatAlg

end MultiplicativeBasisDeformations
