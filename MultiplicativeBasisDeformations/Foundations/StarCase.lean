module

public import MultiplicativeBasisDeformations.Foundations.StarRows
public import MultiplicativeBasisDeformations.Foundations.StarGaugeQ
public import MultiplicativeBasisDeformations.Foundations.StarArms
public import MultiplicativeBasisDeformations.Foundations.GaugeTransfer
public import MultiplicativeBasisDeformations.Foundations.TraceAlgebra
public import MultiplicativeBasisDeformations.Foundations.TraceTypesAD

/-!
# Mesh corrections on a periodic star model

Assembly of Appendix A for a periodic component covered by a star model whose
deck group is generated by `g (v, t) = (ρ v, t + c₀)` with `ρ` fixing the centre
(`periodic-mesh-calculations.tex`): normalize the coefficients
(Lemma A.1(1)), lift the rows of degree `m + 1` (they exist only when
`c₀ ∣ m - 1`), express them as twisted traces of words at the centre (Lemmas A.2
and A.4), and conclude from the vanishing of the traces.
-/

@[expose] public section

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option backward.isDefEq.respectTransparency false

noncomputable section

open CategoryTheory

namespace MultiplicativeBasisDeformations

universe u v' w

namespace StarTrace

open OrientedTree StarCorner ScalarMeshCategory

variable {t : ℕ} {L : Fin t → ℕ}
  {V : Type v'} [Quiver.{w} V] [∀ x y : V, Subsingleton (x ⟶ y)] {Q : TranslationQuiver V}
  (hQ : Q.IsStable) (π : (starTree L).ZVert ⥤q V)
  {k : Type u} [CommRing k] [∀ x : V, Fintype (Σ y : V, y ⟶ x)] (c : MeshCoefficients k Q)
  [DecidableEq V] [∀ x y : V, DecidableEq (x ⟶ y)] [DecidablePred (· ∈ Q.nonprojective)]
  (σ : StarV L ≃ StarV L) (hσ : ∀ a b, (starTree L).G.Adj (σ a) (σ b) ↔ (starTree L).G.Adj a b)
  (m : ℕ) (s : ℤ) (hσp : ∀ v, (starTree L).par (σ v) = (starTree L).par v + s)
  (hπ : π.IsCovering) (hτ : ∀ Y, π.obj ((starTree L).ztau Y) = hQ.tauE (π.obj Y))
  (hsig : (starTree L).pullCoeff hQ π c = (starTree L).zSigned k) (hc : OppositeOnMates c hQ)
  (hdeck : ∀ Z, π.obj (((starTree L).zAct σ hσ s hσp).obj Z) = π.obj Z)
  (hs : (m : ℤ) + 1 = 2 + s)
  (hσo : σ none = none) (θ : Equiv.Perm (Fin t)) (hL : ∀ i, L (θ i) = L i)
  (hθ : ∀ i j (hj : j ≤ L i), σ (av L i j hj) = av L (θ i) j (hj.trans (hL i).ge))

include hπ hτ hsig hc hdeck hs hθ in
/-- The word traces form a twisted trace in the sense of `TraceAlg`. -/
def traceData : TraceAlg.TraceData L (Coker c m) where
  tr := wordTr hQ π c σ hσ m hσo
  θ := θ
  hL := hL
  rotate := wordTr_rotate hQ π c σ hσ m s hσp hτ hc hdeck hs hσo θ hL hθ
  centre := wordTr_centre hQ π c σ hσ m hπ hτ hsig hσo
  arm := wordTr_arm hQ π c σ hσ m hπ hτ hsig hσo
  fixed := fun i hi q hq ↦ wordTr_replicate hQ π c σ hσ m s hσp hπ hτ hsig hc hdeck hs hσo θ hL hθ
    hi q hq

include hπ hτ hsig hc hdeck hs hθ in
/-- **Vanishing traces kill the cokernel.** If all word traces of length at least
two vanish, every row of degree `m + 1 = 2 + s` lies in the image of `D_m`. -/
theorem rowClass_eq_zero (hm : 2 ≤ m) (hsurj : ∀ x : V, ∃ X, π.obj X = x)
    (hfib : ∀ X E : (starTree L).ZVert, π.obj E = π.obj X → E.t = X.t + s →
      E = ((starTree L).zAct σ hσ s hσp).obj X)
    (hvan : ∀ w : List (Fin t), 2 ≤ w.length → 2 * w.length = m + 1 →
      (traceData hQ π c σ hσ m s hσp hπ hτ hsig hc hdeck hs hσo θ hL hθ).tr w = 0)
    (x : Q.nonprojective) (p : Quiver.Path (Q.tau x).1 x.1) (hp : p.length = m + 1) :
    rowClass c m x p = 0 := by
  have hmem := rowClass_mem_span hQ π c σ hσ m s hσp hπ hτ hsig hc hdeck hs hσo θ hL hθ hsurj hfib
    x p hp
  have hzero : ∀ w', wordTr hQ π c σ hσ m hσo w' = 0 := by
    intro w'
    by_cases hd : 2 * w'.length = m + 1
    · exact hvan w' (by omega) hd
    · unfold wordTr; rw [if_neg hd]
  have : Set.range (wordTr hQ π c σ hσ m hσo) ⊆ {0} := by
    rintro _ ⟨w', rfl⟩; exact hzero w'
  have := Submodule.span_mono (R := k) this hmem
  rwa [Submodule.span_singleton_eq_bot.2 rfl, Submodule.mem_bot] at this

end StarTrace

namespace OrientedTree

variable {D : Type*} (T : OrientedTree D) [Fintype D] [DecidableEq D] [DecidableRel T.orient]
  {V : Type v'} [Quiver.{w} V] [∀ x y : V, Subsingleton (x ⟶ y)] {Q : TranslationQuiver V}
  (hQ : Q.IsStable) (π : T.ZVert ⥤q V)
  {k : Type u} [CommRing k] [∀ x : V, Fintype (Σ y : V, y ⟶ x)] (c : MeshCoefficients k Q)

/-- **Signed coefficients are opposite on mates** ("the two mesh coefficients of
the corresponding tree edge … are opposite", proof of Lemma A.2). -/
theorem oppositeOnMates_of_signed (hπ : π.IsCovering)
    (hτ : ∀ Y, π.obj (T.ztau Y) = hQ.tauE (π.obj Y)) (hsurj : ∀ x : V, ∃ X, π.obj X = x)
    (hsig : T.pullCoeff hQ π c = T.zSigned k) : ScalarMeshCategory.OppositeOnMates c hQ := by
  intro x y a
  obtain ⟨X, hX⟩ := hsurj x.1
  obtain ⟨⟨Y, A⟩, hYA⟩ := (hπ.costar_bijective X).2 ⟨y, Quiver.Hom.cast rfl hX.symm a⟩
  have hY : π.obj Y = y := congrArg Sigma.fst hYA
  have e1 : c x y a = T.pullCoeff hQ π c ⟨X, trivial⟩ Y A :=
    StarGauge.c_congr c (Subtype.ext hX.symm) hY.symm _ _
  have e2 : c ⟨y, hQ.mem_nonprojective y⟩ (Q.tau x).1 (Q.mate x y a) =
      T.pullCoeff hQ π c ⟨Y, trivial⟩ (T.zQuiver.tau ⟨X, trivial⟩).1
        (T.zQuiver.mate ⟨X, trivial⟩ Y A) :=
    StarGauge.c_congr c (Subtype.ext hY.symm)
      (by change _ = π.obj (T.ztau X); rw [hτ, hX]; rfl) _ _
  rw [e1, e2, hsig]
  exact T.sgn_swap k A.down.1.symm

end OrientedTree

namespace StarTrace

open OrientedTree StarCorner ScalarMeshCategory StarGauge

variable {t : ℕ} {L : Fin t → ℕ}
  {V : Type v'} [Quiver.{w} V] [∀ x y : V, Subsingleton (x ⟶ y)] {Q : TranslationQuiver V}
  (hQ : Q.IsStable) (π : (starTree L).ZVert ⥤q V)
  {k : Type u} [CommRing k] [∀ x : V, Fintype (Σ y : V, y ⟶ x)]
  [DecidableEq V] [∀ x y : V, DecidableEq (x ⟶ y)] [DecidablePred (· ∈ Q.nonprojective)]
  [Fintype Q.nonprojective]

/-- Powers of a graph automorphism. -/
theorem adj_pow (ρ : StarV L ≃ StarV L)
    (hρ : ∀ a b, (starTree L).G.Adj (ρ a) (ρ b) ↔ (starTree L).G.Adj a b) (n : ℕ) :
    ∀ a b, (starTree L).G.Adj ((ρ ^ n) a) ((ρ ^ n) b) ↔ (starTree L).G.Adj a b := by
  induction n with
  | zero => intro a b; rfl
  | succ n ih => intro a b; rw [pow_succ', Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, hρ, ih]

theorem depth_pow (ρ : StarV L ≃ StarV L) (hd : ∀ v, starDepth (ρ v) = starDepth v) (n : ℕ)
    (v : StarV L) : starDepth ((ρ ^ n) v) = starDepth v := by
  induction n with
  | zero => rfl
  | succ n ih => rw [pow_succ', Equiv.Perm.mul_apply, hd, ih]

variable (hπ : π.IsCovering) (hτ : ∀ Y, π.obj ((starTree L).ztau Y) = hQ.tauE (π.obj Y))
  (hsurj : ∀ x : V, ∃ X, π.obj X = x)
  (ρ : StarV L ≃ StarV L) (hρ : ∀ a b, (starTree L).G.Adj (ρ a) (ρ b) ↔ (starTree L).G.Adj a b)
  (h0 : ρ none = none) (θ : Equiv.Perm (Fin t)) (hL : ∀ i, L (θ i) = L i)
  (hθ : ∀ i j (hj : j ≤ L i), ρ (ch i j hj) = ch (θ i) j (hj.trans (hL i).ge))
  (c0 : ℕ) (hρp : ∀ v, (starTree L).par (ρ v) = (starTree L).par v + ((c0 : ℤ) : ZMod 2))
  (hdeck : ∀ Z, π.obj (((starTree L).zAct ρ hρ (c0 : ℤ) hρp).obj Z) = π.obj Z)
  (hfib : ∀ X Y : (starTree L).ZVert, π.obj X = π.obj Y →
    ∃ n : ℕ, Y = (gZ ρ hρ c0 hρp)^[n] X ∨ X = (gZ ρ hρ c0 hρp)^[n] Y)

include hρ h0 hθ in
theorem depth_ρ (v : StarV L) : starDepth (ρ v) = starDepth v :=
  depth_σ ρ θ hL h0 hθ v

include hθ in
theorem pow_ch' (n : ℕ) (i : Fin t) (j : ℕ) (hj : j ≤ L i) :
    (ρ ^ n) (av L i j hj) = av L ((θ ^ n) i) j (by rw [L_pow θ hL]; exact hj) :=
  StarGauge.pow_ch θ hL ρ hθ n i j hj

include hπ hτ hsurj hρ h0 hθ hdeck hfib in
/-- **Mesh corrections vanish on a periodic star model** when the word traces
vanish in the degrees where rows occur: a word of length `l` with twist `θ^n`
matters only when `2 l = 2 + n c₀` (Lemma A.2(1)). -/
theorem star_surjective_deg (hc0 : 0 < c0)
    (hvan : ∀ (M : Type (max u v' w)) [AddCommGroup M] [Module k M]
      (D : TraceAlg.TraceData L M) (n : ℕ), D.θ = θ ^ n →
        ∀ w : List (Fin t), 2 ≤ w.length → 2 * w.length = 2 + n * c0 → D.tr w = 0)
    (c : MeshCoefficients k Q) (m : ℕ) (hm : 2 ≤ m) : MeshDerivativeSurjective c m := by
  -- `c₀` is even: `ρ` fixes the centre
  have hc0e : Even c0 := by
    have := hρp none
    rw [h0, left_eq_add] at this
    exact (ZMod.natCast_eq_zero_iff_even).1 (by exact_mod_cast this)
  -- normalize the coefficients
  obtain ⟨μ, η, hsig⟩ := exists_signed_gauge hQ π c ρ hρ c0 hρp hdeck θ hL h0 hθ hπ hsurj hfib hτ
    hc0 hc0e
  set c' : MeshCoefficients k Q := fun x y a ↦ η x * c x y a * μ (Q.mate x y a) * μ a
  have hgauge : ∀ (x : Q.nonprojective) (y : V) (a : y ⟶ x.1),
      c x y a = (η x)⁻¹ * c' x y a * (μ (Q.mate x y a))⁻¹ * (μ a)⁻¹ :=
    gauge_symm (fun a ↦ μ a) η c c' (fun _ _ _ ↦ rfl)
  refine surjective_gauge (fun a ↦ (μ a)⁻¹) (fun x ↦ (η x)⁻¹) c' c hgauge ?_
  have hc' : OppositeOnMates c' hQ :=
    (starTree L).oppositeOnMates_of_signed hQ π c' hπ hτ hsurj hsig
  rw [surjective_iff_rows]
  intro x p hp
  rw [← Submodule.Quotient.mk_eq_zero]
  change rowClass c' m x p = 0
  -- lift the row to find the deck transformation of its degree
  obtain ⟨X, hX⟩ := hsurj x.1
  have e1 : π.obj ((starTree L).ztau X) = (Q.tau x).1 := by rw [hτ, hX]; rfl
  obtain ⟨E, hE, P, hP⟩ := RelSystem.exists_lift π hπ ((starTree L).ztau X) (p.cast e1.symm rfl)
  have hPlen : P.length = m + 1 := by
    rw [← LinearPaths.length_mapPath π P, hP, length_cast, length_cast, hp]
  have hEt : E.t = X.t + (m - 1 : ℤ) := by
    have := (starTree L).t_path P
    rw [hPlen] at this; simp only [ztau] at this; push_cast at this; omega
  have hgt : ∀ (n : ℕ) (Z : (starTree L).ZVert), ((gZ ρ hρ c0 hρp)^[n] Z).t = Z.t + n * c0 :=
    fun n Z ↦ (gZ_iter ρ hρ c0 hρp n Z).2
  obtain ⟨n, hn⟩ : ∃ n : ℕ, (n : ℤ) * c0 = m - 1 := by
    obtain ⟨n, hn | hn⟩ := hfib X E (hE.trans hX.symm).symm
    · exact ⟨n, by have := hgt n X; rw [← hn] at this; omega⟩
    · exfalso
      have := hgt n E; rw [← hn] at this
      have : (0 : ℤ) ≤ n * c0 := by positivity
      omega
  set s : ℤ := n * c0
  have hσ' := adj_pow ρ hρ n
  have hd : ∀ v, starDepth ((ρ ^ n) v) = starDepth v :=
    depth_pow ρ (depth_ρ ρ hρ h0 θ hL hθ) n
  have hseven : ((s : ℤ) : ZMod 2) = 0 := by
    obtain ⟨r, hr⟩ := hc0e
    simp only [s, hr]; push_cast; rw [← two_mul, show (2 : ZMod 2) = 0 from rfl]; ring
  have hσp' : ∀ v, (starTree L).par ((ρ ^ n) v) = (starTree L).par v + s := by
    intro v; rw [hseven, add_zero]; change ((starDepth _ : ℕ) : ZMod 2) = _; rw [hd]; rfl
  have hiter : ∀ Z, ((starTree L).zAct (ρ ^ n) hσ' s hσp').obj Z = (gZ ρ hρ c0 hρp)^[n] Z := by
    intro Z
    apply OrientedTree.ZVert.ext
    · exact (gZ_iter ρ hρ c0 hρp n Z).1.symm
    · exact (hgt n Z).symm
  have hdeck' : ∀ Z, π.obj (((starTree L).zAct (ρ ^ n) hσ' s hσp').obj Z) = π.obj Z := by
    intro Z; rw [hiter]; exact π_gZ_iter π ρ hρ c0 hρp hdeck n Z
  have hfib' : ∀ X' E' : (starTree L).ZVert, π.obj E' = π.obj X' → E'.t = X'.t + s →
      E' = ((starTree L).zAct (ρ ^ n) hσ' s hσp').obj X' := by
    intro X' E' h1 h2
    rw [hiter]
    obtain ⟨n', hn' | hn'⟩ := hfib X' E' h1.symm
    · have := hgt n' X'
      rw [← hn', h2] at this
      have : n' = n := by
        have h3 : (n' : ℤ) * c0 = n * c0 := by omega
        exact_mod_cast mul_right_cancel₀ (by positivity) h3
      subst this; exact hn'
    · have := hgt n' E'
      rw [← hn', h2] at this
      have h4 : (0 : ℤ) ≤ n * c0 := by positivity
      have h5 : (0 : ℤ) ≤ n' * c0 := by positivity
      have hn0 : n = 0 := by
        by_contra hne
        have : (0 : ℤ) < n * c0 := by positivity
        omega
      subst hn0
      have hn'0 : n' = 0 := by
        by_contra hne
        have : (0 : ℤ) < n' * c0 := by positivity
        omega
      subst hn'0
      exact hn'.symm
  have hs' : (m : ℤ) + 1 = 2 + s := by simp only [s]; omega
  have hσo' : (ρ ^ n) none = none := by
    clear_value s
    clear hσ' hσp' hiter hdeck' hfib' hs' hseven hd hn
    induction n with
    | zero => rfl
    | succ n ih => rw [pow_succ', Equiv.Perm.mul_apply, ih, h0]
  have hL' : ∀ i, L ((θ ^ n) i) = L i := L_pow θ hL n
  have hθ' := pow_ch' ρ θ hL hθ n
  exact rowClass_eq_zero hQ π c' (ρ ^ n) hσ' m s hσp' hπ hτ hsig hc' hdeck' hs' hσo' (θ ^ n) hL'
    hθ' hm hsurj hfib' (fun w hw hw' ↦ hvan _ _ n rfl w hw (by omega)) x p hp

include hπ hτ hsurj hρ h0 hθ hdeck hfib in
/-- **Mesh corrections vanish on a periodic star model** when all word traces of
length at least two vanish, for every twist `θ^l`. -/
theorem star_surjective (hc0 : 0 < c0)
    (hvan : ∀ (M : Type (max u v' w)) [AddCommGroup M] [Module k M]
      (D : TraceAlg.TraceData L M), (∃ l : ℕ, D.θ = θ ^ l) →
        ∀ w : List (Fin t), 2 ≤ w.length → D.tr w = 0)
    (c : MeshCoefficients k Q) (m : ℕ) (hm : 2 ≤ m) : MeshDerivativeSurjective c m :=
  star_surjective_deg hQ π hπ hτ hsurj ρ hρ h0 θ hL hθ c0 hρp hdeck hfib hc0
    (fun M _ _ D n hn w hw _ ↦ hvan M D ⟨n, hn⟩ w hw) c m hm

omit [∀ x y : V, Subsingleton (x ⟶ y)] in
include hπ hτ hsurj in
/-- **Mesh corrections vanish on a periodic star model whose deck generator fixes
the centre**, given the vanishing of the twisted traces for the induced arm
permutation. -/
theorem surjective_of_fixed_centre [∀ x y : V, Subsingleton (x ⟶ y)]
    (ρ : StarV L ≃ StarV L) (hρ : ∀ a b, (starTree L).G.Adj (ρ a) (ρ b) ↔ (starTree L).G.Adj a b)
    (hρ' : ∀ a b, starAdj a b ↔ starAdj (ρ a) (ρ b)) (h0 : ρ none = none)
    (c0 : ℕ) (hc0 : 0 < c0)
    (hρp : ∀ v, (starTree L).par (ρ v) = (starTree L).par v + ((c0 : ℤ) : ZMod 2))
    (hdeck : ∀ Z, π.obj (((starTree L).zAct ρ hρ (c0 : ℤ) hρp).obj Z) = π.obj Z)
    (hfib : ∀ X Y : (starTree L).ZVert, π.obj X = π.obj Y →
      ∃ n : ℕ, Y = (gZ ρ hρ c0 hρp)^[n] X ∨ X = (gZ ρ hρ c0 hρp)^[n] Y)
    (hvan : ∀ θ : Equiv.Perm (Fin t), (∀ i, L (θ i) = L i) →
      ∀ (M : Type (max u v' w)) [AddCommGroup M] [Module k M] (D : TraceAlg.TraceData L M),
        (∃ l : ℕ, D.θ = θ ^ l) → ∀ w : List (Fin t), 2 ≤ w.length → D.tr w = 0)
    (c : MeshCoefficients k Q) (m : ℕ) (hm : 2 ≤ m) : MeshDerivativeSurjective c m := by
  obtain ⟨θ, hL, hθ⟩ := arm_perm ρ hρ' h0
  have hθ' : ∀ i j (hj : j ≤ L i), ρ (ch i j hj) = ch (θ i) j (by rw [hL]; exact hj) := by
    intro i j hj
    obtain ⟨_, h⟩ := hθ i j (Nat.lt_succ_iff.2 hj)
    exact h
  exact star_surjective hQ π hπ hτ hsurj ρ hρ h0 θ hL hθ' c0 hρp hdeck hfib hc0 (hvan θ hL) c m hm

end StarTrace

namespace TraceAlg

theorem two_cancel {k : Type*} [Field k] (h2 : (2 : k) ≠ 0) {M : Type*} [AddCommGroup M]
    [Module k M] (x : M) (hx : x + x = 0) : x = 0 := by
  have : (2 : k) • x = 0 := by rw [two_smul]; exact hx
  exact (smul_eq_zero.1 this).resolve_left h2

/-- **Type `D` with any twist preserving the arm lengths**: all traces of length
at least two vanish (twists of a `D_n` with `n ≥ 5` fix the long arm; for `D_4`
a twist fixing an arm is handled as a short-arm interchange, and a fixed-point
free twist is a three-cycle). -/
theorem trace_D_any {M : Type*} [AddCommGroup M] {L : Fin 3 → ℕ} (D : TraceData L M)
    (h2 : ∀ m : M, m + m = 0 → m = 0) {a b c : Fin 3} (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c)
    (hLa : L a = 0) (hLb : L b = 0) {w : List (Fin 3)} (hw : 2 ≤ w.length) : D.tr w = 0 := by
  have hne : w ≠ [] := by rintro rfl; simp at hw
  -- the twist permutes the arms preserving their lengths
  have hθL := D.hL
  by_cases hLc : L c = 0
  · -- `D_4`
    have hall : ∀ i, L i = 0 := fun i ↦ by
      rcases fin_three_cases hab hac hbc i with rfl | rfl | rfl <;> assumption
    by_cases hfix : ∃ e, D.θ e = e
    · obtain ⟨e, he⟩ := hfix
      -- the two other arms
      obtain ⟨a', b', ha'b', ha'e, hb'e, hcov⟩ : ∃ a' b' : Fin 3, a' ≠ b' ∧ a' ≠ e ∧ b' ≠ e ∧
          ∀ i, i = a' ∨ i = b' ∨ i = e := by
        fin_cases e
        · exact ⟨1, 2, by decide, by decide, by decide, fun i ↦ by fin_cases i <;> simp⟩
        · exact ⟨0, 2, by decide, by decide, by decide, fun i ↦ by fin_cases i <;> simp⟩
        · exact ⟨0, 1, by decide, by decide, by decide, fun i ↦ by fin_cases i <;> simp⟩
      refine trace_D D h2 ha'b' ha'e hb'e (hall a') (hall b') he ?_ hne
      have ha' : D.θ a' ≠ e := fun h ↦ ha'e (D.θ.injective (h.trans he.symm))
      have hb' : D.θ b' ≠ e := fun h ↦ hb'e (D.θ.injective (h.trans he.symm))
      rcases hcov (D.θ a') with h1 | h1 | h1
      · left; refine ⟨h1, ?_⟩
        rcases hcov (D.θ b') with h3 | h3 | h3
        · exact absurd (D.θ.injective (h3.trans h1.symm)) (Ne.symm ha'b')
        · exact h3
        · exact absurd h3 hb'
      · right; refine ⟨h1, ?_⟩
        rcases hcov (D.θ b') with h3 | h3 | h3
        · exact h3
        · exact absurd (D.θ.injective (h3.trans h1.symm)) (Ne.symm ha'b')
        · exact absurd h3 hb'
      · exact absurd h1 ha'
    · push_neg at hfix
      exact trace_D4_cycle hall D hfix hw
  · -- `D_n` with `n ≥ 5`: the twist fixes the long arm
    have hθc : D.θ c = c := by
      rcases fin_three_cases hab hac hbc (D.θ c) with h | h | h
      · exact absurd ((hθL c).symm.trans (h ▸ hLa)) hLc
      · exact absurd ((hθL c).symm.trans (h ▸ hLb)) hLc
      · exact h
    have ha : D.θ a ≠ c := fun h ↦ hac (D.θ.injective (h.trans hθc.symm))
    have hb : D.θ b ≠ c := fun h ↦ hbc (D.θ.injective (h.trans hθc.symm))
    refine trace_D D h2 hab hac hbc hLa hLb hθc ?_ hne
    rcases fin_three_cases hab hac hbc (D.θ a) with h1 | h1 | h1
    · left; refine ⟨h1, ?_⟩
      rcases fin_three_cases hab hac hbc (D.θ b) with h3 | h3 | h3
      · exact absurd (D.θ.injective (h3.trans h1.symm)) (Ne.symm hab)
      · exact h3
      · exact absurd h3 hb
    · right; refine ⟨h1, ?_⟩
      rcases fin_three_cases hab hac hbc (D.θ b) with h3 | h3 | h3
      · exact h3
      · exact absurd (D.θ.injective (h3.trans h1.symm)) (Ne.symm hab)
      · exact absurd h3 hb
    · exact absurd h1 ha

end TraceAlg

end MultiplicativeBasisDeformations
