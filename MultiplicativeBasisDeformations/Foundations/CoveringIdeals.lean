import MultiplicativeBasisDeformations.Foundations.PathMaps
import MultiplicativeBasisDeformations.Foundations.HomIdeal
import Mathlib.Combinatorics.Quiver.Covering

/-!
# Relations along quiver coverings

Proof of Proposition 4.1, Step 1 (`periodic-mesh-calculations.tex`):
"Paths lift uniquely from a chosen start. Contextual mesh relations lift to
contextual mesh relations with a common endpoint for all terms. Conversely every
upstairs relation projects to one downstairs. The direct sum of the upstairs
path spaces from a fixed start, modulo relations, is therefore the
corresponding space downstairs."

A *relation system* on a quiver is a family of morphisms `rel i : s i → t i` of
the linear path category. Its contextual ideal is spanned by the composites
`q ≫ rel i ≫ q'` (`RelSystem.ideal`). Let `φ` be a covering of quivers and let
relations of the cover map onto relations of the base, every base relation
starting at `φ X` lifting to one starting at `X`. Then `φ` preserves and
reflects ideal membership (`mapPaths_mem_ideal_iff`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option backward.isDefEq.respectTransparency false

noncomputable section

open CategoryTheory Function

namespace MultiplicativeBasisDeformations

universe u v w v' w'

variable (k : Type u) [CommRing k]

/-- A family of relations `rel i : s i → t i` in the linear path category. -/
structure RelSystem (V : Type v) [Quiver.{w} V] where
  I : Type v
  s : I → V
  t : I → V
  rel : ∀ i, LinearPaths.obj (k := k) (s i) ⟶ LinearPaths.obj (k := k) (t i)

namespace RelSystem

variable {k} {V : Type v} [Quiver.{w} V] (R : RelSystem k V)

/-- The relations, as a family indexed by their endpoints. -/
def rels : ∀ X Y : LinearPaths k V, Set (X ⟶ Y) :=
  fun X Y ↦ {f | ∃ (i : R.I) (hX : X = LinearPaths.obj (R.s i)) (hY : Y = LinearPaths.obj (R.t i)),
    f = eqToHom hX ≫ R.rel i ≫ eqToHom hY.symm}

/-- The contextual ideal generated by the relations. -/
abbrev ideal (X Y : LinearPaths k V) : Submodule k (X ⟶ Y) :=
  CategoricalIdeal.HomIdeal.generatedHomSubmodule k R.rels X Y

theorem comp_rel_comp_mem {X Y : V} (i : R.I) (q : LinearPaths.obj (k := k) X ⟶ LinearPaths.obj (R.s i))
    (q' : LinearPaths.obj (k := k) (R.t i) ⟶ LinearPaths.obj Y) :
    q ≫ R.rel i ≫ q' ∈ R.ideal _ _ :=
  Submodule.subset_span ⟨_, _, R.rel i, ⟨i, rfl, rfl, by simp⟩, q, q', rfl⟩

theorem comp_mem_ideal {X Y Z : LinearPaths k V} (f : X ⟶ Y) {g : Y ⟶ Z}
    (hg : g ∈ R.ideal Y Z) : f ≫ g ∈ R.ideal X Z :=
  (CategoricalIdeal.HomIdeal.linearSpan k R.rels).precomp f hg

theorem mem_ideal_comp {X Y Z : LinearPaths k V} {f : X ⟶ Y} (hf : f ∈ R.ideal X Y)
    (g : Y ⟶ Z) : f ≫ g ∈ R.ideal X Z :=
  (CategoricalIdeal.HomIdeal.linearSpan k R.rels).postcomp g hf

/-- Induction principle for the ideal: it suffices to treat path contexts. -/
theorem ideal_induction {X Y : V} {P : (LinearPaths.obj (k := k) X ⟶ LinearPaths.obj Y) → Prop}
    (h0 : P 0) (hadd : ∀ f g, P f → P g → P (f + g)) (hsmul : ∀ (c : k) f, P f → P (c • f))
    (hgen : ∀ (i : R.I) (p : Quiver.Path X (R.s i)) (p' : Quiver.Path (R.t i) Y),
      P (LinearPaths.path p ≫ R.rel i ≫ LinearPaths.path p'))
    {f : LinearPaths.obj (k := k) X ⟶ LinearPaths.obj Y} (hf : f ∈ R.ideal _ _) : P f := by
  induction hf using Submodule.span_induction with
  | mem g hg =>
      obtain ⟨A, B, r, hr, q, q', rfl⟩ := hg
      obtain ⟨i, hX, hY, rfl⟩ := hr
      obtain ⟨A', rfl⟩ : ∃ A' : V, LinearPaths.obj (k := k) A' = A := ⟨A, rfl⟩
      obtain ⟨B', rfl⟩ : ∃ B' : V, LinearPaths.obj (k := k) B' = B := ⟨B, rfl⟩
      change A' = R.s i at hX
      change B' = R.t i at hY
      subst hX hY
      simp only [eqToHom_refl, Category.id_comp, Category.comp_id]
      induction q using LinearPaths.induction_on with
      | h0 => simpa using h0
      | hadd q₁ q₂ h₁ h₂ => rw [Preadditive.add_comp]; exact hadd _ _ h₁ h₂
      | hsingle p c =>
          induction q' using LinearPaths.induction_on with
          | h0 => simpa using h0
          | hadd q₁ q₂ h₁ h₂ => rw [Preadditive.comp_add, Preadditive.comp_add]; exact hadd _ _ h₁ h₂
          | hsingle p' c' =>
              rw [Linear.smul_comp, Linear.comp_smul, Linear.comp_smul]
              exact hsmul _ _ (hsmul _ _ (hgen i p p'))
  | zero => exact h0
  | add f g _ _ hf hg => exact hadd _ _ hf hg
  | smul c f _ hf => exact hsmul _ _ hf

end RelSystem

namespace RelSystem

variable {k} {V : Type v} [Quiver.{w} V] {W : Type v'} [Quiver.{w'} W]

/-- Morphisms from `X`, all targets at once: finitely supported functions on the
paths starting at `X`. -/
abbrev StarSpace (X : V) := Quiver.PathStar X →₀ k

/-- A morphism `X → Y`, placed among all morphisms from `X`. -/
def toStar {X : V} (Y : V) : (LinearPaths.obj (k := k) X ⟶ LinearPaths.obj Y) →ₗ[k] StarSpace (k := k) X :=
  Finsupp.lmapDomain k k (fun p : Quiver.Path X Y ↦ (⟨Y, p⟩ : Quiver.PathStar X)) ∘ₗ
    (LinearPaths.finsuppEquiv (k := k) X Y).toLinearMap

theorem toStar_path {X Y : V} (p : Quiver.Path X Y) :
    toStar (k := k) Y (LinearPaths.path p) = Finsupp.single ⟨Y, p⟩ 1 := by
  simp [toStar, LinearPaths.finsuppEquiv]

open Classical in
/-- The component of target `Y`. -/
def ofStar {X : V} (Y : V) : StarSpace (k := k) X →ₗ[k] (LinearPaths.obj (k := k) X ⟶ LinearPaths.obj Y) :=
  Finsupp.linearCombination k fun e : Quiver.PathStar X ↦
    if h : e.1 = Y then LinearPaths.path (h ▸ e.2) else 0

theorem ofStar_toStar {X Y : V} (f : LinearPaths.obj (k := k) X ⟶ LinearPaths.obj Y) :
    ofStar Y (toStar (k := k) Y f) = f := by
  induction f using LinearPaths.induction_on with
  | h0 => simp
  | hadd f g hf hg => rw [map_add, map_add, hf, hg]
  | hsingle p c =>
      rw [map_smul, map_smul, toStar_path]
      simp [ofStar]

theorem ofStar_toStar_ne {X Y Y' : V} (h : Y' ≠ Y)
    (f : LinearPaths.obj (k := k) X ⟶ LinearPaths.obj Y') : ofStar Y (toStar (k := k) Y' f) = 0 := by
  induction f using LinearPaths.induction_on with
  | h0 => simp
  | hadd f g hf hg => rw [map_add, map_add, hf, hg, add_zero]
  | hsingle p c =>
      rw [map_smul, map_smul, toStar_path]
      simp [ofStar, h]

variable (φ : W ⥤q V)

/-- Lifting all paths from `φ X` to paths from `X`, along a covering. -/
def liftStar (hφ : φ.IsCovering) (X : W) : StarSpace (k := k) (φ.obj X) →ₗ[k] StarSpace (k := k) X :=
  Finsupp.lmapDomain k k (Equiv.ofBijective _ (hφ.pathStar_bijective X)).symm

theorem liftStar_toStar_mapPaths (hφ : φ.IsCovering) {X Y : W}
    (f : LinearPaths.obj (k := k) X ⟶ LinearPaths.obj Y) :
    liftStar φ hφ X (toStar (φ.obj Y) (LinearPaths.mapPaths (k := k) φ X Y f)) = toStar Y f := by
  induction f using LinearPaths.induction_on with
  | h0 => simp
  | hadd f g hf hg => rw [map_add, map_add, map_add, hf, hg, map_add]
  | hsingle p c =>
      rw [map_smul, map_smul, map_smul, map_smul, LinearPaths.mapPaths_path, toStar_path,
        toStar_path]
      congr 1
      simp only [liftStar, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]
      congr 1
      rw [Equiv.symm_apply_eq]
      rfl

variable (RW : RelSystem k W) (RV : RelSystem k V)

/-- **Coverings reflect relations.** Let `φ` be a covering, and let every
contextual relation of the base starting at `φ X` be the image of a contextual
relation of the cover starting at `X`. If the image of `f : X → Y` lies in the
ideal of the base, then `f` lies in the ideal of the cover. -/
theorem mem_ideal_of_mapPaths_mem (hφ : φ.IsCovering)
    (hL : ∀ (X : W) (i' : RV.I) (p : Quiver.Path (φ.obj X) (RV.s i')) {y : V}
      (p' : Quiver.Path (RV.t i') y), ∃ (Y : W) (e : φ.obj Y = y)
        (g : LinearPaths.obj (k := k) X ⟶ LinearPaths.obj Y), g ∈ RW.ideal _ _ ∧
        LinearPaths.mapPaths φ X Y g =
          (LinearPaths.path p ≫ RV.rel i' ≫ LinearPaths.path p') ≫ eqToHom (by rw [e]))
    {X Y : W} {f : LinearPaths.obj (k := k) X ⟶ LinearPaths.obj Y}
    (hf : LinearPaths.mapPaths φ X Y f ∈ RV.ideal _ _) : f ∈ RW.ideal _ _ := by
  classical
  let G : Submodule k (StarSpace (k := k) X) :=
    Submodule.span k {F | ∃ (Y' : W) (g : LinearPaths.obj (k := k) X ⟶ LinearPaths.obj Y'),
      g ∈ RW.ideal _ _ ∧ F = toStar Y' g}
  -- the lift of every base relation from `φ X` lies in `G`
  have hB : ∀ {y : V} {F : LinearPaths.obj (k := k) (φ.obj X) ⟶ LinearPaths.obj y},
      F ∈ RV.ideal _ _ → liftStar φ hφ X (toStar y F) ∈ G := by
    intro y F hF
    refine RV.ideal_induction (P := fun F ↦ liftStar φ hφ X (toStar y F) ∈ G) ?_ ?_ ?_ ?_ hF
    · simp
    · intro f g hf hg; rw [map_add, map_add]; exact add_mem hf hg
    · intro c f hf; rw [map_smul, map_smul]; exact Submodule.smul_mem _ c hf
    · intro i' p p'
      obtain ⟨Y', e, g, hg, hmap⟩ := hL X i' p p'
      subst e
      simp only [eqToHom_refl, Category.comp_id] at hmap
      rw [← hmap, liftStar_toStar_mapPaths]
      exact Submodule.subset_span ⟨Y', g, hg, rfl⟩
  have h1 := hB hf
  rw [liftStar_toStar_mapPaths] at h1
  -- the component of target `Y` of `G` lies in the ideal
  have hC : ∀ F ∈ G, ofStar Y F ∈ RW.ideal (LinearPaths.obj X) (LinearPaths.obj Y) := by
    intro F hF
    induction hF using Submodule.span_induction with
    | mem F hF =>
        obtain ⟨Y', g, hg, rfl⟩ := hF
        by_cases hY : Y' = Y
        · subst hY; rw [ofStar_toStar]; exact hg
        · rw [ofStar_toStar_ne hY]; exact zero_mem _
    | zero => simp
    | add a b _ _ ha hb => rw [map_add]; exact add_mem ha hb
    | smul c a _ ha => rw [map_smul]; exact Submodule.smul_mem _ c ha
  have := hC _ h1
  rwa [ofStar_toStar] at this

end RelSystem

namespace RelSystem

variable {k} {V : Type v} [Quiver.{w} V] {W : Type v'} [Quiver.{w'} W]

/-- The mesh relations of a translation quiver, as a relation system. -/
def mesh {Q : TranslationQuiver V} [∀ x : V, Fintype (Σ y : V, y ⟶ x)]
    (c : MeshCoefficients k Q) : RelSystem k V where
  I := Q.nonprojective
  s x := (Q.tau x).1
  t x := x.1
  rel x := meshRelation c x

@[simp] theorem mesh_rel {Q : TranslationQuiver V} [∀ x : V, Fintype (Σ y : V, y ⟶ x)]
    (c : MeshCoefficients k Q) (x : Q.nonprojective) : (mesh c).rel x = meshRelation c x := rfl

theorem mesh_rels {Q : TranslationQuiver V} [∀ x : V, Fintype (Σ y : V, y ⟶ x)]
    (c : MeshCoefficients k Q) : (mesh c).rels = meshRelations c := rfl

/-- Images of relations in path context are relations: the ideal is
preserved. -/
theorem mapPaths_mem_ideal (φ : W ⥤q V) (RW : RelSystem k W) (RV : RelSystem k V)
    (hP : ∀ {X Y : W} (i : RW.I) (p : Quiver.Path X (RW.s i)) (p' : Quiver.Path (RW.t i) Y),
      LinearPaths.mapPaths φ X Y (LinearPaths.path p ≫ RW.rel i ≫ LinearPaths.path p') ∈
        RV.ideal _ _)
    {X Y : W} {f : LinearPaths.obj (k := k) X ⟶ LinearPaths.obj Y} (hf : f ∈ RW.ideal _ _) :
    LinearPaths.mapPaths φ X Y f ∈ RV.ideal _ _ :=
  RW.ideal_induction (P := fun f ↦ LinearPaths.mapPaths φ X Y f ∈ RV.ideal _ _)
    (by simp) (fun f g hf hg ↦ by rw [map_add]; exact add_mem hf hg)
    (fun c f hf ↦ by rw [map_smul]; exact Submodule.smul_mem _ c hf) (fun i p p' ↦ hP i p p') hf

/-- Path lifting along a covering. -/
theorem exists_lift (φ : W ⥤q V) (hφ : φ.IsCovering) (X : W) {y : V}
    (p : Quiver.Path (φ.obj X) y) :
    ∃ (Y : W) (e : φ.obj Y = y) (P : Quiver.Path X Y), φ.mapPath P = p.cast rfl e.symm := by
  obtain ⟨⟨Y, P⟩, hP⟩ := (hφ.pathStar_bijective X).2 ⟨y, p⟩
  rw [Prefunctor.pathStar_apply] at hP
  obtain ⟨h1, h2⟩ := Sigma.mk.inj_iff.1 hP
  subst h1
  exact ⟨Y, rfl, P, by simpa using eq_of_heq h2⟩

end RelSystem

namespace RelSystem

variable {k} {V : Type v} [Quiver.{w} V] {W : Type v'} [Quiver.{w'} W]

theorem path_cast {u u' w w' : V} (hu : u = u') (hw : w = w') (p : Quiver.Path u w) :
    LinearPaths.path (k := k) (p.cast hu hw) =
      eqToHom (by rw [hu]) ≫ LinearPaths.path p ≫ eqToHom (by rw [hw]) := by
  subst hu hw
  simp

/-- The lifting condition of `mem_ideal_of_mapPaths_mem`, from the lifting of
single relations. -/
theorem lift_condition (φ : W ⥤q V) (hφ : φ.IsCovering) (RW : RelSystem k W)
    (RV : RelSystem k V)
    (hrel : ∀ (Z : W) (i' : RV.I) (h : RV.s i' = φ.obj Z), ∃ (i : RW.I) (hs : RW.s i = Z)
      (ht : RV.t i' = φ.obj (RW.t i)),
      LinearPaths.mapPaths φ _ _ (RW.rel i) = eqToHom (by rw [hs, h]) ≫ RV.rel i' ≫ eqToHom (by rw [ht]))
    (X : W) (i' : RV.I) (p : Quiver.Path (φ.obj X) (RV.s i')) {y : V}
    (p' : Quiver.Path (RV.t i') y) : ∃ (Y : W) (e : φ.obj Y = y)
      (g : LinearPaths.obj (k := k) X ⟶ LinearPaths.obj Y), g ∈ RW.ideal _ _ ∧
      LinearPaths.mapPaths φ X Y g =
        (LinearPaths.path p ≫ RV.rel i' ≫ LinearPaths.path p') ≫ eqToHom (by rw [e]) := by
  obtain ⟨Z, e, P, hP⟩ := exists_lift φ hφ X p
  obtain ⟨i, hs, ht, hmap⟩ := hrel Z i' e.symm
  subst hs
  obtain ⟨Y, e', P', hP'⟩ := exists_lift φ hφ (RW.t i) (p'.cast ht rfl)
  refine ⟨Y, e', LinearPaths.path P ≫ RW.rel i ≫ LinearPaths.path P', RW.comp_rel_comp_mem i _ _, ?_⟩
  rw [LinearPaths.mapPaths_comp, LinearPaths.mapPaths_comp, LinearPaths.mapPaths_path,
    LinearPaths.mapPaths_path, hP, hP', hmap, path_cast, path_cast, path_cast]
  simp only [Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]

end RelSystem

end MultiplicativeBasisDeformations
