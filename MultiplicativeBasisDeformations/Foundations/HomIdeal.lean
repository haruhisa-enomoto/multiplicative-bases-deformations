import Mathlib

/-!
# Two-sided Hom ideals and their linear quotients

A two-sided additive ideal of morphisms in a preadditive category, the
quotient category it defines, and the ideal linearly generated by a family of
relations. These are generic foundations; the scalar mesh categories of
Definition 2.4 are quotients of this form.

Borrowed from `formalization/magnitude_conjecture`, files
`QuotientSubmoduleEquidistribution/CategoryTheory/{HomIdeal,IdealQuotient,
LinearGeneratedHomIdeal}.lean` (last changed at commit `2659d1755`), with the
namespace changed, the radical-morphism lemmas omitted, and no change of
statements or proofs.
-/

set_option autoImplicit false

noncomputable section

open CategoryTheory

namespace MultiplicativeBasisDeformations.CategoricalIdeal

universe w v u

variable (C : Type u) [Category.{v} C] [Preadditive C]

/-- A two-sided additive ideal in a preadditive category. -/
structure HomIdeal where
  hom : ∀ X Y : C, AddSubgroup (X ⟶ Y)
  precomp :
    ∀ {X Y Z : C} (f : X ⟶ Y) {g : Y ⟶ Z},
      g ∈ hom Y Z → f ≫ g ∈ hom X Z
  postcomp :
    ∀ {X Y Z : C} {f : X ⟶ Y} (g : Y ⟶ Z),
      f ∈ hom X Y → f ≫ g ∈ hom X Z

namespace HomIdeal

variable {C} (I : HomIdeal C)

/-- Congruence modulo the given Hom ideal. -/
def rel : HomRel C :=
  fun {X Y} f g ↦ f - g ∈ I.hom X Y

instance : Congruence I.rel where
  equivalence := {
    refl := fun f ↦ by simp [rel]
    symm := by
      intro f g h
      have h' := (I.hom _ _).neg_mem h
      simpa [rel, neg_sub] using h'
    trans := by
      intro f g h hfg hgh
      have h' := (I.hom _ _).add_mem hfg hgh
      simpa [rel] using h' }
  comp_left := by
    intro X Y Z f g g' h
    simpa [rel] using I.precomp f h
  comp_right := by
    intro X Y Z f f' g h
    simpa [rel] using I.postcomp g h

theorem add_compatible
    {X Y : C} (f₁ f₂ g₁ g₂ : X ⟶ Y)
    (hf : I.rel f₁ f₂) (hg : I.rel g₁ g₂) :
    I.rel (f₁ + g₁) (f₂ + g₂) := by
  have h := (I.hom X Y).add_mem hf hg
  change (f₁ + g₁) - (f₂ + g₂) ∈ I.hom X Y
  convert h using 1
  all_goals abel

/-- The induced preadditive structure on the category quotient. -/
abbrev quotientPreadditive :
    Preadditive (CategoryTheory.Quotient I.rel) :=
  CategoryTheory.Quotient.preadditive I.rel
    (fun {_ _} f₁ f₂ g₁ g₂ hf hg ↦
      I.add_compatible f₁ f₂ g₁ g₂ hf hg)

/-- The quotient functor kills exactly the given Hom ideal. -/
theorem map_eq_zero_iff {X Y : C} (f : X ⟶ Y) :
    letI : Preadditive (CategoryTheory.Quotient I.rel) :=
      I.quotientPreadditive
    letI : (CategoryTheory.Quotient.functor I.rel).Additive :=
      CategoryTheory.Quotient.functor_additive I.rel
        (fun {_ _} f₁ f₂ g₁ g₂ hf hg ↦
          I.add_compatible f₁ f₂ g₁ g₂ hf hg)
    (CategoryTheory.Quotient.functor I.rel).map f = 0 ↔
      f ∈ I.hom X Y := by
  letI : Preadditive (CategoryTheory.Quotient I.rel) :=
    I.quotientPreadditive
  letI : (CategoryTheory.Quotient.functor I.rel).Additive :=
    CategoryTheory.Quotient.functor_additive I.rel
      (fun {_ _} f₁ f₂ g₁ g₂ hf hg ↦
        I.add_compatible f₁ f₂ g₁ g₂ hf hg)
  rw [← (CategoryTheory.Quotient.functor I.rel).map_zero X Y,
    CategoryTheory.Quotient.functor_map_eq_iff]
  simp [rel]

end HomIdeal

variable {K : Type w} {C}
  [Ring K] [Linear K C]

namespace HomIdeal

/-- Morphisms obtained by composing a specified relation on both sides. -/
def twoSidedCompositeSet
    (R : ∀ X Y : C, Set (X ⟶ Y)) (X Y : C) : Set (X ⟶ Y) :=
  {f | ∃ (A B : C) (r : A ⟶ B), r ∈ R A B ∧
      ∃ (a : X ⟶ A) (b : B ⟶ Y), f = a ≫ r ≫ b}

/-- The linear span of all two-sided composites through a relation generator. -/
def generatedHomSubmodule
    (𝕜 : Type w) [Ring 𝕜] [Linear 𝕜 C]
    (R : ∀ X Y : C, Set (X ⟶ Y)) (X Y : C) : Submodule 𝕜 (X ⟶ Y) :=
  Submodule.span 𝕜 (twoSidedCompositeSet R X Y)

/-- The two-sided additive Hom ideal linearly generated by `R`. -/
def linearSpan
    (𝕜 : Type w) [Ring 𝕜] [Linear 𝕜 C]
    (R : ∀ X Y : C, Set (X ⟶ Y)) : HomIdeal C where
  hom X Y := (generatedHomSubmodule 𝕜 R X Y).toAddSubgroup
  precomp := by
    intro X Y Z f g hg
    change f ≫ g ∈ generatedHomSubmodule 𝕜 R X Z
    change g ∈ generatedHomSubmodule 𝕜 R Y Z at hg
    induction hg using Submodule.span_induction with
    | mem g hg =>
        rcases hg with ⟨A, B, r, hr, a, b, rfl⟩
        apply Submodule.subset_span
        exact ⟨A, B, r, hr, f ≫ a, b, by simp [Category.assoc]⟩
    | zero => simp
    | add g h _ _ hg hh =>
        simpa using (generatedHomSubmodule 𝕜 R X Z).add_mem hg hh
    | smul k g _ hg =>
        simpa using (generatedHomSubmodule 𝕜 R X Z).smul_mem k hg
  postcomp := by
    intro X Y Z f g hf
    change f ≫ g ∈ generatedHomSubmodule 𝕜 R X Z
    change f ∈ generatedHomSubmodule 𝕜 R X Y at hf
    induction hf using Submodule.span_induction with
    | mem f hf =>
        rcases hf with ⟨A, B, r, hr, a, b, rfl⟩
        apply Submodule.subset_span
        exact ⟨A, B, r, hr, a, b ≫ g, by simp [Category.assoc]⟩
    | zero => simp
    | add f h _ _ hf hh =>
        simpa using (generatedHomSubmodule 𝕜 R X Z).add_mem hf hh
    | smul k f _ hf =>
        simpa using (generatedHomSubmodule 𝕜 R X Z).smul_mem k hf

@[simp]
theorem linearSpan_hom
    (R : ∀ X Y : C, Set (X ⟶ Y)) (X Y : C) :
    (linearSpan K R).hom X Y =
      (generatedHomSubmodule K R X Y).toAddSubgroup :=
  rfl

/-- Every specified relation belongs to its generated Hom ideal. -/
theorem relation_mem_linearSpan
    (R : ∀ X Y : C, Set (X ⟶ Y))
    {X Y : C} {r : X ⟶ Y} (hr : r ∈ R X Y) :
    r ∈ (linearSpan K R).hom X Y := by
  apply Submodule.subset_span
  exact ⟨X, Y, r, hr, 𝟙 X, 𝟙 Y, by simp⟩

/-- Every two-sided composite through a relation belongs to the generated ideal. -/
theorem composite_mem_linearSpan
    (R : ∀ X Y : C, Set (X ⟶ Y))
    {X Y A B : C} (a : X ⟶ A) {r : A ⟶ B} (hr : r ∈ R A B)
    (b : B ⟶ Y) :
    a ≫ r ≫ b ∈ (linearSpan K R).hom X Y := by
  apply Submodule.subset_span
  exact ⟨A, B, r, hr, a, b, rfl⟩

/-- A Hom ideal in a linear category is automatically closed under scalars. -/
theorem smul_mem
    (I : HomIdeal C) {X Y : C} (k : K) {f : X ⟶ Y}
    (hf : f ∈ I.hom X Y) :
    k • f ∈ I.hom X Y := by
  simpa using I.precomp (k • 𝟙 X) hf

/-- Minimality of the linearly generated Hom ideal. -/
theorem linearSpan_le
    (R : ∀ X Y : C, Set (X ⟶ Y)) (I : HomIdeal C)
    (hR : ∀ {X Y : C} {r : X ⟶ Y}, r ∈ R X Y → r ∈ I.hom X Y) :
    ∀ {X Y : C} {f : X ⟶ Y},
      f ∈ (linearSpan K R).hom X Y → f ∈ I.hom X Y := by
  intro X Y f hf
  change f ∈ generatedHomSubmodule K R X Y at hf
  induction hf using Submodule.span_induction with
  | mem f hf =>
      rcases hf with ⟨A, B, r, hr, a, b, rfl⟩
      simpa [Category.assoc] using I.postcomp b (I.precomp a (hR hr))
  | zero => exact (I.hom X Y).zero_mem
  | add f g _ _ hf hg => exact (I.hom X Y).add_mem hf hg
  | smul k f _ hf => exact I.smul_mem k hf

/-- Universal property of the generated ideal. -/
theorem linearSpan_le_iff
    (R : ∀ X Y : C, Set (X ⟶ Y)) (I : HomIdeal C) :
    (∀ {X Y : C} {f : X ⟶ Y},
        f ∈ (linearSpan K R).hom X Y → f ∈ I.hom X Y) ↔
      ∀ {X Y : C} {r : X ⟶ Y}, r ∈ R X Y → r ∈ I.hom X Y := by
  constructor
  · intro h X Y r hr
    exact h (relation_mem_linearSpan R hr)
  · exact linearSpan_le R I

/-- Congruence modulo a Hom ideal is compatible with scalar multiplication. -/
theorem rel_smul_compatible
    (I : HomIdeal C) (k : K) {X Y : C} (f g : X ⟶ Y)
    (hfg : I.rel f g) :
    I.rel (k • f) (k • g) := by
  change k • f - k • g ∈ I.hom X Y
  rw [← smul_sub]
  exact I.smul_mem k hfg

/-- The induced linear structure on a Hom-ideal quotient. -/
abbrev quotientLinear (I : HomIdeal C) :
    letI : Preadditive (CategoryTheory.Quotient I.rel) := I.quotientPreadditive
    letI : (CategoryTheory.Quotient.functor I.rel).Additive :=
      CategoryTheory.Quotient.functor_additive I.rel
        (fun {_ _} f₁ f₂ g₁ g₂ hf hg ↦
          I.add_compatible f₁ f₂ g₁ g₂ hf hg)
    Linear K (CategoryTheory.Quotient I.rel) :=
  letI : Preadditive (CategoryTheory.Quotient I.rel) := I.quotientPreadditive
  letI : (CategoryTheory.Quotient.functor I.rel).Additive :=
    CategoryTheory.Quotient.functor_additive I.rel
      (fun {_ _} f₁ f₂ g₁ g₂ hf hg ↦
        I.add_compatible f₁ f₂ g₁ g₂ hf hg)
  CategoryTheory.Quotient.linear K I.rel
    (fun k {_ _} f g hfg ↦ I.rel_smul_compatible k f g hfg)

/-- The quotient functor is linear for the induced quotient structure. -/
abbrev quotientFunctorLinear (I : HomIdeal C) :
    letI : Preadditive (CategoryTheory.Quotient I.rel) := I.quotientPreadditive
    letI : (CategoryTheory.Quotient.functor I.rel).Additive :=
      CategoryTheory.Quotient.functor_additive I.rel
        (fun {_ _} f₁ f₂ g₁ g₂ hf hg ↦
          I.add_compatible f₁ f₂ g₁ g₂ hf hg)
    letI : Linear K (CategoryTheory.Quotient I.rel) := I.quotientLinear
    (CategoryTheory.Quotient.functor I.rel).Linear K :=
  letI : Preadditive (CategoryTheory.Quotient I.rel) := I.quotientPreadditive
  letI : (CategoryTheory.Quotient.functor I.rel).Additive :=
    CategoryTheory.Quotient.functor_additive I.rel
      (fun {_ _} f₁ f₂ g₁ g₂ hf hg ↦
        I.add_compatible f₁ f₂ g₁ g₂ hf hg)
  letI : Linear K (CategoryTheory.Quotient I.rel) := I.quotientLinear
  CategoryTheory.Quotient.linear_functor K I.rel
    (fun k {_ _} f g hfg ↦ I.rel_smul_compatible k f g hfg)

end HomIdeal

end MultiplicativeBasisDeformations.CategoricalIdeal
