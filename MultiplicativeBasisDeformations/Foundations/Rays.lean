module

public import MultiplicativeBasisDeformations.Foundations.NormedBasis

/-!
# Rays of an algebra

Section 3 of the manuscript (`projective-rays.tex`). Fix a complete set
of primitive orthogonal idempotents `e_x` and put `A(x, y) = e_x A e_y` and
`R_x = e_x A e_x`.

* Definition 3.2 (`def:rays`): the ray of `0 ≠ f ∈ A(x, y)` is the orbit
  `[f] = {u f v : u ∈ R_x^*, v ∈ R_y^*}`; `U(f) = R_x f R_y` and
  `R(f) = (rad R_x) f R_y + R_x f (rad R_y)`.
* Definition 3.4 (`def:ray-product`): `M(f, h) = R_x f (rad R_y) h R_z`; the ray
  product `[f][h]` is `[fh]` if `fh ∉ M(f, h)` and `0` otherwise.

Formal choices: the units of `R_x` are the elements of `R_x` with a two-sided
inverse in `R_x` (identity `e_x`); `rad R_x` is `R_x ∩ rad A`, which is the
radical of `R_x = e_x A e_x`; subbimodules generated by sets are `k`-spans.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace MultiplicativeBasisDeformations

universe u v

variable (k : Type u) [Field k] (A : Type v) [Ring A] [Algebra k A]

/-- A chosen complete set of primitive orthogonal idempotents `e_x`. -/
structure PrimitiveIdempotents where
  /-- The number of idempotents. -/
  m : ℕ
  /-- The idempotents. -/
  e : Fin m → A
  complete : CompleteOrthogonalIdempotents e
  primitive : ∀ x, IsPrimitiveIdempotent (e x)

variable {k A}

namespace PrimitiveIdempotents

variable (F : PrimitiveIdempotents A)

/-- The corner `A(x, y) = e_x A e_y`, as a `k`-subspace. -/
def corner (x y : Fin F.m) : Submodule k A :=
  LinearMap.range ((LinearMap.mulLeft k (F.e x)).comp (LinearMap.mulRight k (F.e y)))

/-- `rad R_x = R_x ∩ rad A`. -/
def cornerRadical (x : Fin F.m) : Submodule k A :=
  F.corner x x ⊓ algebraRadical k A

/-- `u` is a unit of the local corner `R_x`. -/
def IsCornerUnit (x : Fin F.m) (u : A) : Prop :=
  u ∈ F.corner (k := k) x x ∧
    ∃ u' ∈ F.corner (k := k) x x, u * u' = F.e x ∧ u' * u = F.e x

/-- Definition 3.2: the ray `[f] = {u f v}` of `f ∈ A(x, y)`. -/
def ray (x y : Fin F.m) (f : A) : Set A :=
  {g | ∃ u w, F.IsCornerUnit (k := k) x u ∧ F.IsCornerUnit (k := k) y w ∧
    g = u * f * w}

/-- Definition 3.2: the endpoint subbimodule `U(f) = R_x f R_y`. -/
def endpointSpan (x y : Fin F.m) (f : A) : Submodule k A :=
  Submodule.span k
    {g | ∃ a ∈ F.corner (k := k) x x, ∃ b ∈ F.corner (k := k) y y, g = a * f * b}

/-- Definition 3.2: `R(f) = (rad R_x) f R_y + R_x f (rad R_y)`. -/
def endpointRadical (x y : Fin F.m) (f : A) : Submodule k A :=
  Submodule.span k
    ({g | ∃ a ∈ F.cornerRadical (k := k) x, ∃ b ∈ F.corner (k := k) y y,
        g = a * f * b} ∪
      {g | ∃ a ∈ F.corner (k := k) x x, ∃ b ∈ F.cornerRadical (k := k) y,
        g = a * f * b})

/-- Definition 3.4: `M(f, h) = R_x f (rad R_y) h R_z`. -/
def insertionSpan (x y z : Fin F.m) (f h : A) : Submodule k A :=
  Submodule.span k
    {g | ∃ a ∈ F.corner (k := k) x x, ∃ r ∈ F.cornerRadical (k := k) y,
      ∃ b ∈ F.corner (k := k) z z, g = a * f * r * h * b}

/-- An `R_x`--`R_y`-subbimodule of the corner `A(x, y)`. -/
def IsEndpointSubbimodule (x y : Fin F.m) (N : Submodule k A) : Prop :=
  N ≤ F.corner x y ∧
    (∀ a ∈ F.corner (k := k) x x, ∀ n ∈ N, a * n ∈ N) ∧
      ∀ b ∈ F.corner (k := k) y y, ∀ n ∈ N, n * b ∈ N

/-- A nonzero ray: the ray of some nonzero element of a corner. -/
def IsNonzeroRay (s : Set A) : Prop :=
  ∃ x y f, f ∈ F.corner (k := k) x y ∧ f ≠ 0 ∧ s = F.ray (k := k) x y f

variable (k) in
/-- The set of nonzero rays. -/
def NonzeroRay : Type v := {s : Set A // F.IsNonzeroRay (k := k) s}

/-- A choice of one element of every nonzero ray, using `e_x` for the identity
ray `[e_x]`. -/
def IsRayTransversal (b : F.NonzeroRay k → A) : Prop :=
  (∀ r, b r ∈ r.1) ∧ ∀ r x, F.e x ∈ r.1 → b r = F.e x

/-- The representatives `b` induce an algebra isomorphism `k ray A ≅ A`
(Theorem 11.7(3)): products of representatives whose ray product is zero,
that is, which lie in `M(f, h)`, vanish. Together with a multiplicative ray
transversal this says that `b_r b_s = b_{rs}` when `rs ≠ 0` and `b_r b_s = 0`
otherwise. -/
def KillsZeroRayProducts (b : F.NonzeroRay k → A) : Prop :=
  ∀ (r s : F.NonzeroRay k) (x y z : Fin F.m),
    b r ∈ F.corner (k := k) x y → b s ∈ F.corner (k := k) y z →
      b r * b s ∈ F.insertionSpan (k := k) x y z (b r) (b s) → b r * b s = 0

end PrimitiveIdempotents

end MultiplicativeBasisDeformations
