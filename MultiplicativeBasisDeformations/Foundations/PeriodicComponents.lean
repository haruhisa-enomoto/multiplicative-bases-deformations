import MultiplicativeBasisDeformations.Foundations.ComponentTransfer

/-!
# Periodic components and the reduction of `D_m` to them

Proposition 5.1 (`prop:periodic-localization`) and the first paragraph of
Appendix A.2 (`periodic-mesh-calculations.tex`): the cokernel of `D_m`
is computed on the periodic components.

`T` is the set of `τ`-periodic vertices. A *periodic component* is a class of
the equivalence relation on `T` generated by the arrows between vertices of
`T` and by `v ~ τ v` (the translation edges of the complex `K` of Subsection
4.1). Each component is closed under `τ` and `τ⁻¹` (`isTauClosed_component`),
and a path with all vertices in `T` stays in one component.

`meshDerivativeSurjective_of_components`: if `D_m` is surjective on every
periodic component, it is surjective on `C(Q, c)`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option backward.isDefEq.respectTransparency false

noncomputable section

open CategoryTheory

namespace MultiplicativeBasisDeformations

universe u v w

namespace TranslationQuiver

variable {V : Type v} [Quiver.{w} V] (Q : TranslationQuiver V)

/-- The `τ`-periodic vertices. -/
def periodic : Set V := {v | Q.IsTauPeriodic v}

variable {Q}

theorem isTauPeriodic_iff (v : V) :
    Q.IsTauPeriodic v ↔ ∃ h : v ∈ Q.nonprojective, Q.IsTauPeriodic (Q.tau ⟨v, h⟩).1 := by
  constructor
  · intro hv
    obtain ⟨h, -⟩ := hv 1
    refine ⟨h, fun n ↦ ?_⟩
    obtain ⟨h', hn⟩ := hv (n + 1)
    exact hn
  · rintro ⟨h, hv⟩ n
    cases n with
    | zero => trivial
    | succ n => exact ⟨h, hv n⟩

variable (Q)

/-- Adjacency in the periodic part: an arrow, or a translation edge. -/
def PeriodicAdj (u v : V) : Prop :=
  u ∈ Q.periodic ∧ v ∈ Q.periodic ∧
    (Nonempty (u ⟶ v) ∨ ∃ hu : u ∈ Q.nonprojective, (Q.tau ⟨u, hu⟩).1 = v)

/-- The periodic component of a vertex. -/
def component (x : V) : Set V := {v | v ∈ Q.periodic ∧ Relation.EqvGen (Q.PeriodicAdj) x v}

variable {Q}

theorem mem_component_self {x : V} (hx : x ∈ Q.periodic) : x ∈ Q.component x :=
  ⟨hx, Relation.EqvGen.refl x⟩

theorem component_subset_periodic (x : V) : Q.component x ⊆ Q.periodic := fun _ h ↦ h.1

/-- **Periodic components are closed under `τ` and `τ⁻¹`.** -/
theorem isTauClosed_component (x : V) : Q.IsTauClosed (Q.component x) := by
  intro z hz
  constructor
  · rintro ⟨hzT, hxz⟩
    obtain ⟨h, hτT⟩ := (isTauPeriodic_iff z).1 hzT
    exact ⟨hτT, Relation.EqvGen.trans _ _ _ hxz
      (Relation.EqvGen.rel _ _ ⟨hzT, hτT, Or.inr ⟨hz, rfl⟩⟩)⟩
  · rintro ⟨hτT, hxτ⟩
    have hzT : z ∈ Q.periodic := (isTauPeriodic_iff z).2 ⟨hz, hτT⟩
    exact ⟨hzT, Relation.EqvGen.trans _ _ _ hxτ (Relation.EqvGen.symm _ _
      (Relation.EqvGen.rel _ _ ⟨hzT, hτT, Or.inr ⟨hz, rfl⟩⟩))⟩

/-- A path whose vertices are periodic and which starts in a component stays in
it. -/
theorem vertices_mem_component {x a : V} (ha : a ∈ Q.component x) :
    ∀ {b : V} (p : Quiver.Path a b), (∀ v ∈ p.vertices, v ∈ Q.periodic) →
      ∀ v ∈ p.vertices, v ∈ Q.component x
  | _, Quiver.Path.nil, _, v, hv => by
      simp only [Quiver.Path.vertices_nil, List.mem_singleton] at hv
      exact hv ▸ ha
  | _, Quiver.Path.cons p e, hT, v, hv => by
      have hT' : ∀ v ∈ p.vertices, v ∈ Q.periodic := fun v hv ↦ hT v (by
        rw [Quiver.Path.vertices_cons, List.concat_eq_append]
        exact List.mem_append_left _ hv)
      rw [Quiver.Path.vertices_cons, List.concat_eq_append, List.mem_append,
        List.mem_singleton] at hv
      rcases hv with hv | rfl
      · exact vertices_mem_component ha p hT' v hv
      · have hc := vertices_mem_component ha p hT' _ (Quiver.Path.end_mem_vertices p)
        have hvT : _ ∈ Q.periodic := hT _ (Quiver.Path.end_mem_vertices _)
        exact ⟨hvT, Relation.EqvGen.trans _ _ _ hc.2
          (Relation.EqvGen.rel _ _ ⟨hc.1, hvT, Or.inl ⟨e⟩⟩)⟩

end TranslationQuiver

open ScalarMeshCategory TranslationQuiver

variable {k : Type u} [Field k] {V : Type v} [Quiver.{w} V] {Q : TranslationQuiver V}
  [∀ x : V, Fintype (Σ y : V, y ⟶ x)] (c : MeshCoefficients k Q)
  [DecidableEq V] [∀ x y : V, DecidableEq (x ⟶ y)] [DecidablePred (· ∈ Q.nonprojective)]
  [Fintype V]

/-- **Proposition 5.1** (`prop:periodic-localization`), in the form used for the
vanishing (Appendix A.2): if `D_m` is surjective on the scalar mesh category of
every periodic component, it is surjective on `C(Q, c)`. -/
theorem meshDerivativeSurjective_of_components (m : ℕ)
    (H : ∀ x ∈ Q.periodic,
      MeshDerivativeSurjective (c.restrict (isTauClosed_component (Q := Q) x)) m) :
    MeshDerivativeSurjective c m := by
  classical
  rw [surjective_iff_rows]
  intro x w hw
  by_cases hT : ∀ v ∈ w.vertices, v ∈ Q.periodic
  swap
  · push_neg at hT
    obtain ⟨v, hv, hvT⟩ := hT
    exact row_mem_imageD_of_not_periodic c x w hw hv hvT
  have hxT : x.1 ∈ Q.periodic := hT _ (Quiver.Path.end_mem_vertices w)
  refine row_mem_imageD_of_restrict (isTauClosed_component x.1) c (H x.1 hxT) ?_ x
    (mem_component_self hxT) w hw
  intro x' w' hw' hx' hout
  by_cases hT' : ∀ v ∈ w'.vertices, v ∈ Q.periodic
  · exfalso
    obtain ⟨v, hv, hvK⟩ := hout
    have hstart : (Q.tau x').1 ∈ Q.component x.1 :=
      ((isTauClosed_component x.1) x'.1 x'.2).1 hx'
    exact hvK (vertices_mem_component hstart w' hT' v hv)
  · push_neg at hT'
    obtain ⟨v, hv, hvT⟩ := hT'
    exact row_mem_imageD_of_not_periodic c x' w' hw' hv hvT

end MultiplicativeBasisDeformations
