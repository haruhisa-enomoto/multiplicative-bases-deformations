module

public import MultiplicativeBasisDeformations.Foundations.UnequalAction
public import MultiplicativeBasisDeformations.Foundations.TableTree
public import MultiplicativeBasisDeformations.Foundations.RayOp

/-!
# Lemma 8.11: opposite controls

`lem:opposite-controls` (`local-ray-geometry.tex`): generating rays `f : b → c` and
`g : c → a` whose Homs are cyclic at `c` but not at their other endpoints. Here: the setting,
the inclusions (`eq:opposite-control-inclusions`)

`(rad R_b) f ⊆ f q² R_c`, `A₀(c, b) f ⊆ (q²)`, and their duals for `g`,

and the four-leaf star of Case 1, which gives the strong star vanishing
(`eq:strong-star-vanishing`, `local-ray-restrictions.tex`): if `fq, qg, q² ≠ 0` then
`fg = 0`.
-/

@[expose] public section

set_option autoImplicit false
set_option linter.unusedSectionVars false

noncomputable section

namespace MultiplicativeBasisDeformations

universe u

namespace RaySys

namespace Sys

variable {V R L : Type} [AddCommGroup L] [DecidableEq L] [Fintype V] [DecidableEq V] [Fintype R]
  [DecidableEq R] (S : Sys V R L)

local notation:max "⌜" r "⌝" => Sys.rr S r

/-- A loop Hom is cyclic at its source, generated by the identity. -/
theorem cycL_e (x : V) : S.CycL (S.P.e x) := by
  intro s h1 h2
  rw [S.P.src_e] at h1 ⊢
  rw [S.P.tgt_e] at h2
  obtain ⟨j, hj, -⟩ := S.local_eq s (h1.trans h2.symm)
  refine ⟨j, ?_⟩
  rw [← hj, h1]

/-- A generating loop is the identity. -/
theorem gen_loop {f : R} (hf : S.IsGen f) (h : S.P.src f = S.P.tgt f) : f = S.P.e (S.P.src f) :=
  S.gen_unique hf (S.isGen_of_cycL (S.cycL_e _)) (S.P.src_e _).symm (by rw [S.P.tgt_e, h])

section Setting

variable {f : R} (hfR : S.CycR f) (hfL : ¬ S.CycL f)

include hfR hfL in
/-- The two endpoints of a ray generated only at its target differ. -/
theorem src_ne_tgt_of_cycR : S.P.src f ≠ S.P.tgt f := by
  intro h
  have := S.gen_loop (S.isGen_of_cycR hfR) h
  apply hfL
  rw [this]
  exact S.cycL_e _

include hfR hfL in
/-- A ray generated only at its target has `f q ≠ 0`. -/
theorem mul_q_ne_of_cycR : ⌜f⌝ * S.q (S.P.tgt f) ≠ 0 := by
  intro h0
  apply hfL
  intro s h1 h2
  obtain ⟨j, hj⟩ := hfR s h1 h2
  refine ⟨0, ?_⟩
  rcases Nat.eq_zero_or_pos j with rfl | hj0
  · rw [hj, pow_zero, mul_one, pow_zero, one_mul]
  · exfalso
    rw [show j = (j - 1) + 1 by omega, pow_succ', ← mul_assoc, h0, zero_mul] at hj
    exact S.rr_ne s hj

include hfR hfL in
/-- **`(rad R_b) f ⊆ f q² R_c`** (first inclusion of `eq:opposite-control-inclusions`). -/
theorem rad_src_mul_of_cycR : S.q (S.P.src f) * ⌜f⌝ = 0 ∨
    ∃ m, 2 ≤ m ∧ S.q (S.P.src f) * ⌜f⌝ = ⌜f⌝ * S.q (S.P.tgt f) ^ m := by
  by_cases h0 : S.q (S.P.src f) * ⌜f⌝ = 0
  · exact Or.inl h0
  right
  obtain ⟨g0, hg0, g01, g02, g03⟩ := (S.q_cases (S.P.src f)).resolve_left
    (fun h' ↦ h0 (by rw [h', zero_mul]))
  replace hg0 : S.q (S.P.src f) = ⌜g0⌝ := hg0
  rw [hg0] at h0 ⊢
  obtain ⟨s, hs⟩ := S.ray_of_mul_ne h0
  obtain ⟨s1, s2, -, s4⟩ := S.prod_of hs
  obtain ⟨m, hm⟩ := hfR s (by rw [s1, g01]) s2
  have hw : S.P.wt s = S.P.wt f + m • S.χ (S.P.tgt f) := by
    have := congrArg S.wtM hm
    rw [wtM_rr, S.wtM_mul _ _ (by rw [← hm]; exact S.rr_ne s), wtM_rr,
      S.wtM_qpow _ _ (fun h' ↦ S.rr_ne s (by rw [hm, h', mul_zero]))] at this
    exact this
  have hg0d : 0 < S.P.deg (S.P.wt g0) := S.P.deg_pos g0 (by rw [g01]; exact g03)
  refine ⟨m, ?_, by rw [hs, hm]⟩
  by_contra hm2
  interval_cases m
  · -- `q_b f = f`
    rw [s4, zero_smul, add_zero] at hw
    have := congrArg S.P.deg hw
    rw [map_add] at this
    omega
  · -- `q_b f = f q`: the Hom is cyclic at `b`
    apply hfL
    have hq1 : ⌜f⌝ * S.q (S.P.tgt f) = S.q (S.P.src f) * ⌜f⌝ := by
      rw [hg0, hs, hm, pow_one]
    have key : ∀ j : ℕ, ⌜f⌝ * S.q (S.P.tgt f) ^ j = S.q (S.P.src f) ^ j * ⌜f⌝ := by
      intro j
      induction j with
      | zero => simp
      | succ j ih =>
        rw [pow_succ, ← mul_assoc, ih, mul_assoc, hq1, ← mul_assoc, ← pow_succ]
    intro s' h1 h2
    obtain ⟨j, hj⟩ := hfR s' h1 h2
    exact ⟨j, by rw [hj, key]⟩

include hfR hfL in
/-- Powers of the source radical: `q_b^j f ∈ f q² R_c` for `j ≥ 1`. -/
theorem rad_src_pow_mul_of_cycR (j : ℕ) (hj : 1 ≤ j) : S.q (S.P.src f) ^ j * ⌜f⌝ = 0 ∨
    ∃ m, 2 ≤ m ∧ S.q (S.P.src f) ^ j * ⌜f⌝ = ⌜f⌝ * S.q (S.P.tgt f) ^ m := by
  induction j with
  | zero => omega
  | succ j ih =>
    rcases Nat.eq_zero_or_pos j with rfl | hj0
    · rw [zero_add, pow_one]; exact S.rad_src_mul_of_cycR hfR hfL
    · rw [pow_succ', mul_assoc]
      rcases ih hj0 with h | ⟨m, hm, h⟩
      · left; rw [h, mul_zero]
      · rw [h, ← mul_assoc]
        rcases S.rad_src_mul_of_cycR hfR hfL with h' | ⟨m', hm', h'⟩
        · left; rw [h', zero_mul]
        · right; exact ⟨m' + m, by omega, by rw [h', mul_assoc, ← pow_add]⟩

include hfR hfL in
/-- **`A₀(c, b) f ⊆ (q²)`** (second inclusion of `eq:opposite-control-inclusions`). -/
theorem rev_mul_of_cycR (h : R) (hh : ⌜h⌝ * ⌜f⌝ ≠ 0) (hsrc : S.P.src h = S.P.tgt f) :
    ∃ m, 2 ≤ m ∧ ⌜h⌝ * ⌜f⌝ = S.q (S.P.tgt f) ^ m * ⌜S.P.e (S.P.tgt f)⌝ := by
  have hbc := S.src_ne_tgt_of_cycR hfR hfL
  have hfq := S.mul_q_ne_of_cycR hfR hfL
  have hfpos : 0 < S.P.deg (S.P.wt f) := S.deg_pos_of_ne hbc
  obtain ⟨t, ht⟩ := S.ray_of_mul_ne hh
  obtain ⟨t1, t2, t3, t4⟩ := S.prod_of ht
  have htloop : S.P.src t = S.P.tgt t := by rw [t1, t2, hsrc]
  obtain ⟨m, hm, hmw⟩ := S.local_eq t htloop
  rw [t1, hsrc] at hm hmw
  refine ⟨m, ?_, by rw [ht, hm]⟩
  by_contra hm2
  interval_cases m
  · -- `h f` is the identity
    rw [zero_smul, t4] at hmw
    have := congrArg S.P.deg hmw
    rw [map_add, map_zero] at this
    have := S.P.deg_nonneg h
    omega
  · -- `h f = q`
    have e1 : ⌜f⌝ * (⌜h⌝ * ⌜f⌝) = ⌜f⌝ * S.q (S.P.tgt f) := by
      rw [ht, ← hm, pow_one, S.q_mul_e]
    have hfh : ⌜f⌝ * ⌜h⌝ ≠ 0 := fun h0 ↦ hfq (by rw [← e1, ← mul_assoc, h0, zero_mul])
    obtain ⟨u, hu⟩ := S.ray_of_mul_ne hfh
    obtain ⟨u1, u2, -, u4⟩ := S.prod_of hu
    have hmid := S.src_of_mul_ne hh
    have huloop : S.P.src u = S.P.tgt u := by rw [u1, u2, hmid]
    obtain ⟨j, hj, hjw⟩ := S.local_eq u huloop
    rw [u1] at hj hjw
    have hj1 : 1 ≤ j := by
      by_contra hj0
      have : j = 0 := by omega
      subst this
      rw [zero_smul, u4] at hjw
      have := congrArg S.P.deg hjw
      rw [map_add, map_zero] at this
      have := S.P.deg_nonneg h
      omega
    have e2 : ⌜u⌝ * ⌜f⌝ = S.q (S.P.src f) ^ j * ⌜f⌝ := by
      rw [← hj, mul_assoc, S.e_mul_rr]
    have e3 : S.q (S.P.src f) ^ j * ⌜f⌝ = ⌜f⌝ * S.q (S.P.tgt f) := by
      rw [← e2, ← hu, mul_assoc, e1]
    rcases S.rad_src_pow_mul_of_cycR hfR hfL j hj1 with h0 | ⟨m', hm', h'⟩
    · exact hfq (by rw [← e3, h0])
    · rw [e3] at h'
      have hq : S.q (S.P.tgt f) ≠ 0 := fun h0 ↦ hfq (by rw [h0, mul_zero])
      have hd := S.χ_deg_pos _ hq
      have := congrArg (fun a ↦ S.P.deg (S.wtM a)) h'
      change S.P.deg (S.wtM (⌜f⌝ * S.q (S.P.tgt f))) =
        S.P.deg (S.wtM (⌜f⌝ * S.q (S.P.tgt f) ^ m')) at this
      rw [S.wtM_mul _ _ hfq, S.wtM_mul _ _ (h' ▸ hfq),
        S.wtM_qpow _ _ (fun h0 ↦ hfq (by rw [h', h0, mul_zero])), map_add, map_add, map_nsmul,
        nsmul_eq_mul] at this
      change S.P.deg (S.wtM ⌜f⌝) + S.P.deg (S.χ (S.P.tgt f)) = _ at this
      have : (1 : ℤ) * S.P.deg (S.χ (S.P.tgt f)) = m' * S.P.deg (S.χ (S.P.tgt f)) := by linarith
      have := mul_right_cancel₀ hd.ne' this
      omega

end Setting

/-! ### The dual statements for `g` -/

section Dual

variable {g : R} (hgL : S.CycL g) (hgR : ¬ S.CycR g)

include hgL hgR in
theorem op_hyp_of_cycL : S.op.CycR g ∧ ¬ S.op.CycL g :=
  ⟨(S.op_cycR_iff g).2 hgL, fun h ↦ hgR ((S.op_cycL_iff g).1 h)⟩

include hgL hgR in
theorem src_ne_tgt_of_cycL : S.P.src g ≠ S.P.tgt g := fun h ↦
  S.op.src_ne_tgt_of_cycR (S.op_hyp_of_cycL hgL hgR).1 (S.op_hyp_of_cycL hgL hgR).2 h.symm

include hgL hgR in
theorem q_mul_ne_of_cycL : S.q (S.P.src g) * ⌜g⌝ ≠ 0 := by
  have := S.op.mul_q_ne_of_cycR (S.op_hyp_of_cycL hgL hgR).1 (S.op_hyp_of_cycL hgL hgR).2
  intro h0
  apply this
  show S.P.toOp ⌜g⌝ * S.P.toOp (S.q (S.P.src g)) = 0
  rw [← Tab.toOp_mul, h0]; rfl

include hgL hgR in
/-- **`g rad R_a ⊆ R_c q² g`**. -/
theorem rad_tgt_mul_of_cycL : ⌜g⌝ * S.q (S.P.tgt g) = 0 ∨
    ∃ m, 2 ≤ m ∧ ⌜g⌝ * S.q (S.P.tgt g) = S.q (S.P.src g) ^ m * ⌜g⌝ := by
  rcases S.op.rad_src_mul_of_cycR (S.op_hyp_of_cycL hgL hgR).1 (S.op_hyp_of_cycL hgL hgR).2 with
    h | ⟨m, hm, h⟩
  · left
    apply S.P.toOp_injective
    rw [Tab.toOp_mul]
    exact h
  · right
    refine ⟨m, hm, S.P.toOp_injective ?_⟩
    rw [Tab.toOp_mul, Tab.toOp_mul, Tab.toOp_pow]
    exact h

include hgL hgR in
/-- **`g A₀(a, c) ⊆ (q²)`**. -/
theorem rev_mul_of_cycL (h : R) (hh : ⌜g⌝ * ⌜h⌝ ≠ 0) (htgt : S.P.tgt h = S.P.src g) :
    ∃ m, 2 ≤ m ∧ ⌜g⌝ * ⌜h⌝ = S.q (S.P.src g) ^ m * ⌜S.P.e (S.P.src g)⌝ := by
  have hh' : S.op.rr h * S.op.rr g ≠ 0 := by
    intro h0; apply hh
    apply S.P.toOp_injective
    rw [Tab.toOp_mul]; exact h0
  obtain ⟨m, hm, e⟩ := S.op.rev_mul_of_cycR (S.op_hyp_of_cycL hgL hgR).1
    (S.op_hyp_of_cycL hgL hgR).2 h hh' htgt
  refine ⟨m, hm, S.P.toOp_injective ?_⟩
  rw [Tab.toOp_mul, Tab.toOp_mul, Tab.toOp_pow]
  have e' : S.P.toOp ⌜h⌝ * S.P.toOp ⌜g⌝ =
      S.P.toOp (S.q (S.P.src g)) ^ m * S.P.toOp ⌜S.P.e (S.P.src g)⌝ := e
  rw [e', ← Tab.toOp_pow, ← Tab.toOp_mul, ← Tab.toOp_mul, S.qpow_comm_e]

end Dual

/-! ### The four-leaf star -/

/-- The table of the four-leaf star `l, u → c → r, d` (indices `0..4` are `l u c r d`). -/
def tStar : Fin 5 → Fin 5 → Bool := fun i j ↦
  i == j || ((i.val == 0 || i.val == 1) && (j.val == 2 || j.val == 3 || j.val == 4)) ||
    (i.val == 2 && (j.val == 3 || j.val == 4))

instance : Fact (PosetRep.Ax tStar) := ⟨by unfold PosetRep.Ax; decide⟩

theorem tStar_uniq : PosetRep.UniqOK tStar := by unfold PosetRep.UniqOK; decide

theorem tStar_count : PosetRep.CountOK tStar ![1, 1, 2, 1, 1] := by
  unfold PosetRep.CountOK; decide

/-- A ray of negative degree does not exist. -/
theorem no_neg {h : R} {X : L} (hw : S.P.wt h = -X) (hX : 0 < S.P.deg X) : False := by
  have := S.P.deg_nonneg h
  rw [hw, map_neg] at this
  omega

section StarConf

variable {b c a : V} {f g q0 fg fq qg q2 : R}
  (f1 : S.P.src f = b) (f2 : S.P.tgt f = c) (g1 : S.P.src g = c) (g2 : S.P.tgt g = a)
  (q01 : S.P.src q0 = c) (q02 : S.P.tgt q0 = c)
  (hfg : S.P.mul f g = some fg) (hfq : S.P.mul f q0 = some fq) (hqg : S.P.mul q0 g = some qg)
  (hq2 : S.P.mul q0 q0 = some q2)
  (hdf : 0 < S.P.deg (S.P.wt f)) (hdg : 0 < S.P.deg (S.P.wt g)) (hdq : 0 < S.P.deg (S.P.wt q0))
  (R1 : ∀ h, S.P.src h = a → S.P.tgt h = c → S.P.wt h = S.P.wt q0 - S.P.wt g →
    S.P.mul g h ≠ some q0)
  (R2 : ∀ h, S.P.src h = c → S.P.tgt h = a → S.P.wt h = S.P.wt g - S.P.wt q0 →
    S.P.mul q0 h ≠ some g)
  (R3 : ∀ h, S.P.src h = c → S.P.tgt h = b → S.P.wt h = -S.P.wt f + S.P.wt q0 →
    S.P.mul h f ≠ some q0)
  (R4 : ∀ h, S.P.src h = b → S.P.tgt h = c → S.P.wt h = -S.P.wt q0 + S.P.wt f →
    S.P.mul h q0 ≠ some f)

/-- The objects of the star. -/
def starV (b c a : V) : Fin 5 → V := ![b, c, c, a, c]

/-- The weights of the star. -/
def starG (f g q0 : R) : Fin 5 → L := ![-S.P.wt f, -S.P.wt q0, 0, S.P.wt g, S.P.wt q0]

/-- The rays of the star. -/
def starρ (b c a : V) (f g q0 fg fq qg q2 : R) : Fin 5 → Fin 5 → R :=
  ![![S.P.e b, S.P.e b, f, fg, fq], ![S.P.e b, S.P.e c, q0, qg, q2],
    ![S.P.e b, S.P.e b, S.P.e c, g, q0], ![S.P.e b, S.P.e b, S.P.e b, S.P.e a, S.P.e b],
    ![S.P.e b, S.P.e b, S.P.e b, S.P.e b, S.P.e c]]

include f1 g1 q01 hfg hfq hqg hq2 in
theorem star_src : ∀ i j, tStar i j = true →
    S.P.src (S.starρ b c a f g q0 fg fq qg q2 i j) = starV b c a i := by
  have e1 := S.P.mul_src _ _ _ hfg
  have e2 := S.P.mul_src _ _ _ hfq
  have e3 := S.P.mul_src _ _ _ hqg
  have e4 := S.P.mul_src _ _ _ hq2
  intro i j hij
  fin_cases i <;> fin_cases j <;> simp [tStar] at hij <;>
    simp [starV, starρ, S.P.src_e, e1, e2, e3, e4, f1, g1, q01]

include f2 g2 q02 hfg hfq hqg hq2 in
theorem star_tgt : ∀ i j, tStar i j = true →
    S.P.tgt (S.starρ b c a f g q0 fg fq qg q2 i j) = starV b c a j := by
  have e1 := S.P.mul_tgt _ _ _ hfg
  have e2 := S.P.mul_tgt _ _ _ hfq
  have e3 := S.P.mul_tgt _ _ _ hqg
  have e4 := S.P.mul_tgt _ _ _ hq2
  intro i j hij
  fin_cases i <;> fin_cases j <;> simp [tStar] at hij <;>
    simp [starV, starρ, S.P.tgt_e, e1, e2, e3, e4, f2, g2, q02]

include hfg hfq hqg hq2 in
theorem star_wt : ∀ i j, tStar i j = true →
    S.P.wt (S.starρ b c a f g q0 fg fq qg q2 i j) = S.starG f g q0 j - S.starG f g q0 i := by
  have e1 := S.P.wt_mul _ _ _ hfg
  have e2 := S.P.wt_mul _ _ _ hfq
  have e3 := S.P.wt_mul _ _ _ hqg
  have e4 := S.P.wt_mul _ _ _ hq2
  intro i j hij
  fin_cases i <;> fin_cases j <;> simp [tStar] at hij <;>
    simp [starG, starρ, S.P.wt_e, e1, e2, e3, e4] <;> abel

theorem star_e : ∀ i, S.starρ b c a f g q0 fg fq qg q2 i i = S.P.e (starV b c a i) := by
  intro i; fin_cases i <;> rfl

include hfg hfq hqg hq2 in
theorem star_mul : ∀ i j l, tStar i j = true → tStar j l = true → i ≠ j → j ≠ l →
    S.P.mul (S.starρ b c a f g q0 fg fq qg q2 i j) (S.starρ b c a f g q0 fg fq qg q2 j l) =
      some (S.starρ b c a f g q0 fg fq qg q2 i l) := by
  intro i j l h1 h2 h3 h4
  fin_cases i <;> fin_cases j <;> fin_cases l <;> simp [tStar] at h1 h2 h3 h4 <;>
    simp only [starρ, Fin.isValue, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Fin.zero_eta, Fin.mk_one,
      Fin.reduceFinMk] <;> assumption

set_option maxHeartbeats 1000000 in
include hdf hdg hdq R1 R2 in
theorem star_retL : ∀ i j l (h : R), PosetRep.covB tStar i j = true → tStar i l = true →
    S.P.src h = starV b c a j → S.P.tgt h = starV b c a l →
    S.P.wt h = S.starG f g q0 l - S.starG f g q0 j →
    S.P.mul (S.starρ b c a f g q0 fg fq qg q2 i j) h =
      some (S.starρ b c a f g q0 fg fq qg q2 i l) → tStar j l = true := by
  intro i j l h hcv hil h1 h2 h3 hm
  fin_cases i <;> fin_cases j <;> fin_cases l
  all_goals first
    | decide
    | exact absurd hcv (by decide)
    | exact absurd hil (by decide)
    | skip
  all_goals simp [starV, starG, starρ] at h1 h2 h3 hm
  all_goals first
    | exact (S.no_neg h3 hdf).elim
    | exact (S.no_neg h3 hdg).elim
    | exact (S.no_neg h3 hdq).elim
    | exact (R1 h h1 h2 h3 hm).elim
    | exact (R2 h h1 h2 h3 hm).elim
    | skip

set_option maxHeartbeats 1000000 in
include hdf hdg hdq R3 R4 in
theorem star_retR : ∀ i j l (h : R), PosetRep.covB tStar i j = true → tStar l j = true →
    S.P.src h = starV b c a l → S.P.tgt h = starV b c a i →
    S.P.wt h = S.starG f g q0 i - S.starG f g q0 l →
    S.P.mul h (S.starρ b c a f g q0 fg fq qg q2 i j) =
      some (S.starρ b c a f g q0 fg fq qg q2 l j) → tStar l i = true := by
  intro i j l h hcv hlj h1 h2 h3 hm
  fin_cases i <;> fin_cases j <;> fin_cases l
  all_goals first
    | decide
    | exact absurd hcv (by decide)
    | exact absurd hlj (by decide)
    | skip
  all_goals simp [starV, starG, starρ] at h1 h2 h3 hm
  all_goals first
    | exact (S.no_neg h3 hdf).elim
    | exact (S.no_neg h3 hdg).elim
    | exact (S.no_neg h3 hdq).elim
    | exact (R3 h h1 h2 h3 hm).elim
    | exact (R4 h h1 h2 h3 hm).elim
    | skip

variable (k : Type u) [Field k] [IsAlgClosed k]

include f1 f2 g1 g2 q01 q02 hfg hfq hqg hq2 hdf hdg hdq R1 R2 R3 R4 in
/-- **The four-leaf star is excluded.** -/
theorem star_false (hfin : IsRepresentationFinite k (S.P.Lin k)) : False :=
  S.P.table_false (starV b c a) (S.starG f g q0) (S.starρ b c a f g q0 fg fq qg q2)
    (S.star_src f1 g1 q01 hfg hfq hqg hq2) (S.star_tgt f2 g2 q02 hfg hfq hqg hq2)
    (S.star_wt hfg hfq hqg hq2)
    (S.P.hmul_of_strict (starV b c a) (S.starρ b c a f g q0 fg fq qg q2)
      (S.star_src f1 g1 q01 hfg hfq hqg hq2) (S.star_tgt f2 g2 q02 hfg hfq hqg hq2)
      S.star_e (S.star_mul hfg hfq hqg hq2))
    (S.star_retL hdf hdg hdq R1 R2) (S.star_retR hdf hdg hdq R3 R4) k hfin ![1, 1, 2, 1, 1]
    tStar_uniq tStar_count

end StarConf

variable (k : Type u) [Field k] [IsAlgClosed k]

/-- **Strong star vanishing** (`eq:strong-star-vanishing`; Case 1 of Lemma 8.11): for `f`
generated only at its target and `g` generated only at its source, with `q² ≠ 0` at the
middle vertex, `fg = 0`. -/
theorem strong_star (hfin : IsRepresentationFinite k (S.P.Lin k)) {f g : R}
    (hfR : S.CycR f) (hfL : ¬ S.CycL f) (hgL : S.CycL g) (hgR : ¬ S.CycR g)
    (hfg : S.P.tgt f = S.P.src g) (hq2 : S.q (S.P.tgt f) * S.q (S.P.tgt f) ≠ 0) :
    ⌜f⌝ * ⌜g⌝ = 0 := by
  by_contra hfg0
  have hfq := S.mul_q_ne_of_cycR hfR hfL
  have hqg := S.q_mul_ne_of_cycL hgL hgR
  rw [← hfg] at hqg
  have hqc : S.q (S.P.tgt f) ≠ 0 := fun h0 ↦ hfq (by rw [h0, mul_zero])
  obtain ⟨q0, hq0, q01, q02, q03⟩ := (S.q_cases (S.P.tgt f)).resolve_left hqc
  replace hq0 : S.q (S.P.tgt f) = ⌜q0⌝ := hq0
  have hχ : S.χ (S.P.tgt f) = S.P.wt q0 := by rw [χ, hq0]; rfl
  rw [hq0] at hfq hqg hq2
  obtain ⟨fg, hfgr⟩ := S.ray_of_mul_ne hfg0
  obtain ⟨fq, hfqr⟩ := S.ray_of_mul_ne hfq
  obtain ⟨qg, hqgr⟩ := S.ray_of_mul_ne hqg
  obtain ⟨q2, hq2r⟩ := S.ray_of_mul_ne hq2
  have hdf : 0 < S.P.deg (S.P.wt f) := S.deg_pos_of_ne (S.src_ne_tgt_of_cycR hfR hfL)
  have hdg : 0 < S.P.deg (S.P.wt g) := S.deg_pos_of_ne (S.src_ne_tgt_of_cycL hgL hgR)
  have hdq : 0 < S.P.deg (S.P.wt q0) := S.P.deg_pos q0 (by rw [q01]; exact q03)
  -- `q0 = q^m e` forces `m = 1`
  have hm1 : ∀ m, ⌜q0⌝ = S.q (S.P.tgt f) ^ m * ⌜S.P.e (S.P.tgt f)⌝ → m = 1 := by
    intro m hm
    have := S.deg_wt_qpow_e hm
    rw [hχ] at this
    have : ((1 : ℕ) : ℤ) * S.P.deg (S.P.wt q0) = m * S.P.deg (S.P.wt q0) := by
      push_cast; linarith
    exact_mod_cast (mul_right_cancel₀ hdq.ne' this).symm
  refine S.star_false (b := S.P.src f) (c := S.P.tgt f) (a := S.P.tgt g) rfl rfl hfg.symm rfl
    q01 q02 (S.P.rr_mul_rr_eq_rr.1 hfgr) (S.P.rr_mul_rr_eq_rr.1 hfqr)
    (S.P.rr_mul_rr_eq_rr.1 hqgr) (S.P.rr_mul_rr_eq_rr.1 hq2r) hdf hdg hdq ?_ ?_ ?_ ?_ k hfin
  · intro h h1 h2 h3 hm
    have hm' : ⌜g⌝ * ⌜h⌝ = ⌜q0⌝ := S.P.rr_mul_rr_eq_rr.2 hm
    obtain ⟨m, hm2, e⟩ := S.rev_mul_of_cycL hgL hgR h (by rw [hm']; exact S.rr_ne q0)
      (by rw [h2, hfg])
    rw [hm', ← hfg] at e
    have := hm1 m e
    omega
  · intro h h1 h2 h3 hm
    obtain ⟨j, hj⟩ := hgL h (by rw [h1, hfg]) h2
    have := S.deg_wt_qpow_mul hj
    rw [h3, map_sub, ← hfg, hχ] at this
    have : (0 : ℤ) ≤ j * S.P.deg (S.P.wt q0) := by positivity
    linarith
  · intro h h1 h2 h3 hm
    have hm' : ⌜h⌝ * ⌜f⌝ = ⌜q0⌝ := S.P.rr_mul_rr_eq_rr.2 hm
    obtain ⟨m, hm2, e⟩ := S.rev_mul_of_cycR hfR hfL h (by rw [hm']; exact S.rr_ne q0) h1
    rw [hm'] at e
    have := hm1 m e
    omega
  · intro h h1 h2 h3 hm
    obtain ⟨j, hj⟩ := hfR h h1 h2
    have := congrArg (fun a ↦ S.P.deg (S.wtM a)) hj
    change S.P.deg (S.P.wt h) = S.P.deg (S.wtM (⌜f⌝ * S.q (S.P.tgt f) ^ j)) at this
    rw [S.wtM_mul _ _ (hj ▸ S.rr_ne h), S.wtM_qpow _ _ (fun h0 ↦ S.rr_ne h
      (by rw [hj, h0, mul_zero])), wtM_rr, h3, map_add, map_add, map_neg, map_nsmul, hχ,
      nsmul_eq_mul] at this
    have : (0 : ℤ) ≤ j * S.P.deg (S.P.wt q0) := by positivity
    linarith

end Sys

end RaySys

end MultiplicativeBasisDeformations
