module

public import MultiplicativeBasisDeformations.Foundations.HomIdeal

/-!
# Translation quivers and scalar mesh categories

Definitions 2.3 and 2.4 of the manuscript
(`graded-category.tex`).

* The `k`-linear path category of a quiver is `Free k (Paths Q)`: morphisms
  `x ⟶ y` are finite linear combinations of paths from `x` to `y`, and
  `p ≫ q` is the path `p` followed by `q`. This matches the manuscript's
  left-to-right path products.
* A quotient of the path category by the two-sided ideal linearly generated by
  a family of relations is `RelationCategory`.
* A translation quiver carries a bijection `τ` from the nonprojective onto the
  noninjective vertices, and mates `σ a : τ x ⟶ y` for every arrow
  `a : y ⟶ x` with `x` nonprojective. The mate bijection is recorded
  separately for each pair `(x, y)`; this is the same as one bijection from the
  arrows ending at nonprojective vertices onto the arrows starting at
  noninjective vertices with the stated endpoints.
* The scalar mesh category `C(Q,c)` is the quotient by the mesh relations
  `r_x = ∑_{a : y → x} c_{x,a} (σ a) a`.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

open CategoryTheory

namespace MultiplicativeBasisDeformations

universe u v w

section PathCategory

variable (k : Type u) [CommRing k] (V : Type v) [Quiver.{w} V]

/-- The `k`-linear path category of the quiver `V`. -/
abbrev LinearPaths := Free k (Paths V)

variable {k V}

/-- The vertex `x`, as an object of the linear path category. -/
abbrev LinearPaths.obj (x : V) : LinearPaths k V := (x : Paths V)

/-- The morphism of the linear path category given by a single path. -/
def LinearPaths.path {x y : V} (p : Quiver.Path x y) :
    LinearPaths.obj (k := k) x ⟶ LinearPaths.obj (k := k) y :=
  Finsupp.single p 1

/-- The morphism of the linear path category given by a single arrow. -/
def LinearPaths.arrow {x y : V} (a : x ⟶ y) :
    LinearPaths.obj (k := k) x ⟶ LinearPaths.obj (k := k) y :=
  LinearPaths.path a.toPath

/-- The path-degree-`n` part of `kQ(x, y)`: the span of the paths of length
`n`. -/
def LinearPaths.degreePart (n : ℕ) (x y : V) :
    Submodule k (LinearPaths.obj (k := k) x ⟶ LinearPaths.obj (k := k) y) :=
  Submodule.span k
    {f | ∃ p : Quiver.Path x y, p.length = n ∧ f = LinearPaths.path p}

end PathCategory

section RelationCategory

open CategoricalIdeal

variable (k : Type u) [CommRing k] {C : Type v} [Category.{w} C] [Preadditive C]
  [Linear k C]

/-- The quotient of a linear category by the two-sided ideal linearly generated
by the relations `R`. -/
def RelationCategory (R : ∀ X Y : C, Set (X ⟶ Y)) :=
  CategoryTheory.Quotient (HomIdeal.linearSpan k R).rel

variable (R : ∀ X Y : C, Set (X ⟶ Y))

instance : Category (RelationCategory k R) :=
  inferInstanceAs (Category (CategoryTheory.Quotient (HomIdeal.linearSpan k R).rel))

instance : Preadditive (RelationCategory k R) :=
  (HomIdeal.linearSpan k R).quotientPreadditive

instance : Linear k (RelationCategory k R) :=
  (HomIdeal.linearSpan k R).quotientLinear

/-- The quotient functor onto a relation category. -/
def RelationCategory.functor : C ⥤ RelationCategory k R :=
  CategoryTheory.Quotient.functor (HomIdeal.linearSpan k R).rel

instance : (RelationCategory.functor k R).Full :=
  inferInstanceAs (CategoryTheory.Quotient.functor (HomIdeal.linearSpan k R).rel).Full

instance : (RelationCategory.functor k R).Additive :=
  CategoryTheory.Quotient.functor_additive _
    (fun {_ _} f₁ f₂ g₁ g₂ hf hg ↦
      (HomIdeal.linearSpan k R).add_compatible f₁ f₂ g₁ g₂ hf hg)

instance : (RelationCategory.functor k R).Linear k :=
  (HomIdeal.linearSpan k R).quotientFunctorLinear

end RelationCategory

section TranslationQuiver

variable (V : Type v) [Quiver.{w} V]

/-- Definition 2.3 (`def:translation-quiver`). A translation quiver structure
on the quiver `V`. -/
structure TranslationQuiver where
  /-- The nonprojective vertices. -/
  nonprojective : Set V
  /-- The noninjective vertices. -/
  noninjective : Set V
  /-- The translation, a bijection from nonprojective onto noninjective
  vertices. -/
  tau : nonprojective ≃ noninjective
  /-- The mate bijection: `σ a : τ x ⟶ y` for `a : y ⟶ x`. -/
  mate : ∀ (x : nonprojective) (y : V), (y ⟶ x.1) ≃ ((tau x).1 ⟶ y)

variable {V}

/-- A translation quiver is stable if every vertex is nonprojective and
noninjective. -/
def TranslationQuiver.IsStable (Q : TranslationQuiver V) : Prop :=
  Q.nonprojective = Set.univ ∧ Q.noninjective = Set.univ

/-- At most one arrow between each ordered pair of vertices. -/
def HasAtMostOneArrow (V : Type v) [Quiver.{w} V] : Prop :=
  ∀ x y : V, Subsingleton (x ⟶ y)

end TranslationQuiver

section ScalarMesh

variable (k : Type u) [CommRing k] {V : Type v} [Quiver.{w} V]
  (Q : TranslationQuiver V)

/-- A coefficient system: a nonzero scalar `c_{x,a}` for each nonprojective
vertex `x` and each arrow `a` ending at `x`. -/
def MeshCoefficients :=
  ∀ (x : Q.nonprojective) (y : V), (y ⟶ x.1) → kˣ

variable {k Q}
variable [∀ x : V, Fintype (Σ y : V, y ⟶ x)]

/-- The mesh relation `r_x = ∑_{a : y → x} c_{x,a} (σ a) a` at a
nonprojective vertex `x`. -/
def meshRelation (c : MeshCoefficients k Q) (x : Q.nonprojective) :
    LinearPaths.obj (k := k) (Q.tau x).1 ⟶ LinearPaths.obj (k := k) x.1 :=
  ∑ a : Σ y : V, y ⟶ x.1,
    ((c x a.1 a.2 : kˣ) : k) •
      LinearPaths.path ((Q.mate x a.1 a.2).toPath.comp a.2.toPath)

/-- The family of all mesh relations, indexed by their endpoints. -/
def meshRelations (c : MeshCoefficients k Q) :
    ∀ X Y : LinearPaths k V, Set (X ⟶ Y) :=
  fun X Y ↦ {f | ∃ (x : Q.nonprojective)
    (hX : X = LinearPaths.obj (Q.tau x).1) (hY : Y = LinearPaths.obj x.1),
    f = eqToHom hX ≫ meshRelation c x ≫ eqToHom hY.symm}

variable (k Q)

/-- Definition 2.4 (`def:scalar-mesh-category`). The scalar mesh category
`C(Q, c) = kQ / ⟨r_x : x nonprojective⟩`. -/
abbrev ScalarMeshCategory (c : MeshCoefficients k Q) :=
  RelationCategory k (meshRelations c)

variable {k Q}

/-- The vertex `x` as an object of `C(Q, c)`. -/
abbrev ScalarMeshCategory.obj (c : MeshCoefficients k Q) (x : V) :
    ScalarMeshCategory k Q c :=
  (RelationCategory.functor k (meshRelations c)).obj (LinearPaths.obj x)

/-- The path-degree-`n` part `C_n(x, y)` of the scalar mesh category, the image
of the paths of length `n`. -/
def ScalarMeshCategory.degreePart (c : MeshCoefficients k Q) (n : ℕ) (x y : V) :
    Submodule k (ScalarMeshCategory.obj c x ⟶ ScalarMeshCategory.obj c y) :=
  (LinearPaths.degreePart n x y).map
    ((RelationCategory.functor k (meshRelations c)).mapLinearMap k
      (X := LinearPaths.obj x) (Y := LinearPaths.obj y))

end ScalarMesh

end MultiplicativeBasisDeformations

namespace MultiplicativeBasisDeformations

open CategoryTheory CategoricalIdeal

universe u' v' w'

variable {k : Type u'} [CommRing k] {C : Type v'} [Category.{w'} C] [Preadditive C] [Linear k C]

/-- The quotient functor onto a relation category kills exactly the generated
ideal. -/
theorem RelationCategory.functor_map_eq_zero_iff (R : ∀ X Y : C, Set (X ⟶ Y)) {X Y : C}
    (f : X ⟶ Y) :
    (RelationCategory.functor k R).map f = 0 ↔ f ∈ (HomIdeal.linearSpan k R).hom X Y :=
  (HomIdeal.linearSpan k R).map_eq_zero_iff f

theorem RelationCategory.functor_map_surjective (R : ∀ X Y : C, Set (X ⟶ Y)) {X Y : C}
    (g : (RelationCategory.functor k R).obj X ⟶ (RelationCategory.functor k R).obj Y) :
    ∃ f : X ⟶ Y, (RelationCategory.functor k R).map f = g :=
  (RelationCategory.functor k R).map_surjective g

end MultiplicativeBasisDeformations
