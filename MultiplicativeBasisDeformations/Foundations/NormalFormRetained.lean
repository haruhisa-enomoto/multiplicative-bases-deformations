import MultiplicativeBasisDeformations.Foundations.NormalFormGeneral

/-!
# Proposition 12.2 in its general form

`deformation-refinements.tex` (`prop:characteristic-two-normal-form`): "Let
`C = kQ/(r_v : v ∈ V)` be a finite-dimensional graded algebra over any field, with `Q` finite and
the `r_v` homogeneous quadratic relations. For each `q ≥ 3`, choose homogeneous path tuples `p_i`
of degree `d_i = q` whose classes form a basis of `coker D_{q-1}`. […] Every algebra `E` with a
finite filtration and a specified identification `gr E = C` has a presentation
`E ≅ kQ/(𝔪^{N+1}, r_v − Σ_i λ_i (p_i)_v)` for some scalars `λ_i`. The isomorphism induces the
specified identification on the associated grading."

In the setting of the general Proposition 5.4 (`NormalFormGeneral.lean`: `E` a finite filtered
`k`-linear category on the vertices with symbols realizing `gr E = C`), with retained tuples
`p_j` of degrees `≥ 3` whose classes together with `im D_{q-1}` span (the basis hypothesis is
stronger), there are scalars `λ` and arrow lifts satisfying `r_v = Σ λ_j (p_j)_v` exactly
(`exists_retained`); the realization `kQ → E` is onto every Hom space, its kernel is the ideal
generated by `r_v − Σ λ_j (p_j)_v` and the paths of length `> N` for any `N` with `F^N = 0`, and
it induces the identification on the associated grading (`normalFormRetained`). The proof is the
source's: in increasing degree `q`, split the degree-`q` errors as `D_{q-1}(f) + Σ c_j [p_j]`,
retain the `c_j` and change the arrows by lifts of `f`; a retained word of degree `d_j ≥ 3`
changes only in degree `≥ q + d_j − 2 > q`, and the two-correction terms have degree `2q − 2`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

noncomputable section

open CategoryTheory CategoryTheory.Limits

namespace MultiplicativeBasisDeformations

namespace GeneralNormalForm

universe u v w u' w'

variable {k : Type u} [Field k] {V : Type v} [Quiver.{w} V]
  {𝓔 : Type u'} [Category.{w'} 𝓔] [Preadditive 𝓔] [Linear k 𝓔] {O : V → 𝓔}
  {ι : Type} {s t : ι → V} {r : ∀ i, LinearPaths.obj (k := k) (s i) ⟶ LinearPaths.obj (k := k) (t i)}
  {E : FilteredId O s t r}

namespace Lifts

/-! ### Changing the arrows -/

/-- **The arrow change** `a ↦ L a − ft a` by maps of filtration degree `q' ≥ 2`. -/
def sub (L : Lifts E) {q' : ℕ} (hq : 2 ≤ q') (ft : ∀ {x y : V}, (x ⟶ y) → (O x ⟶ O y))
    (hft : ∀ {x y : V} (a : x ⟶ y), ft a ∈ E.F q' x y) : Lifts E where
  L a := L.L a - ft a
  mem a := sub_mem (L.mem a) (E.F_anti (by omega) _ _ (hft a))
  sym a := by
    rw [map_sub, L.sym a, E.σ_eq_zero (E.F_anti (show 1 + 1 ≤ q' by omega) _ _ (hft a)), sub_zero]

@[simp] theorem sub_L (L : Lifts E) {q' : ℕ} (hq : 2 ≤ q')
    (ft : ∀ {x y : V}, (x ⟶ y) → (O x ⟶ O y)) (hft : ∀ {x y : V} (a : x ⟶ y), ft a ∈ E.F q' x y)
    {x y : V} (a : x ⟶ y) : (L.sub hq ft hft).L a = L.L a - ft a := rfl

/-- A path changes by maps of filtration degree `length − 1 + q'` under an arrow change of
degree `q'`. -/
theorem pathMap_sub_mem (L L' : Lifts E) {q' : ℕ}
    (hd : ∀ {x y : V} (a : x ⟶ y), L'.L a - L.L a ∈ E.F q' x y) {x y : V} (p : Quiver.Path x y) :
    pathMap L'.L p - pathMap L.L p ∈ E.F (p.length - 1 + q') x y := by
  induction p with
  | nil => simp
  | cons p a ih =>
      rw [pathMap_cons, pathMap_cons, Quiver.Path.length_cons]
      have e : pathMap L'.L p ≫ L'.L a - pathMap L.L p ≫ L.L a =
          (pathMap L'.L p - pathMap L.L p) ≫ L'.L a + pathMap L.L p ≫ (L'.L a - L.L a) := by
        simp only [Preadditive.sub_comp, Preadditive.comp_sub]; abel
      rw [e]
      refine add_mem (E.F_anti (by omega) _ _ (E.F_comp _ 1 ih (L'.mem a))) ?_
      exact E.F_anti (by omega) _ _ (E.F_comp _ _ (L.pathMap_mem p).1 (hd a))

theorem realize_sub_mem (L L' : Lifts E) {q' : ℕ}
    (hd : ∀ {x y : V} (a : x ⟶ y), L'.L a - L.L a ∈ E.F q' x y) {d : ℕ} {x y : V}
    {P : LinearPaths.obj (k := k) x ⟶ LinearPaths.obj y}
    (hP : P ∈ LinearPaths.degreePart (k := k) d x y) :
    realize L'.L x y P - realize L.L x y P ∈ E.F (d - 1 + q') x y := by
  induction hP using Submodule.span_induction with
  | mem g hg =>
      obtain ⟨p, rfl, rfl⟩ := hg
      rw [realize_path, realize_path]
      exact pathMap_sub_mem L L' hd p
  | zero => simp
  | add a c _ _ ha hc =>
      have e : realize L'.L x y (a + c) - realize L.L x y (a + c) =
          (realize L'.L x y a - realize L.L x y a) + (realize L'.L x y c - realize L.L x y c) := by
        rw [map_add, map_add]; abel
      rw [e]; exact add_mem ha hc
  | smul c a _ ha =>
      rw [map_smul, map_smul, ← smul_sub]; exact Submodule.smul_mem _ c ha

/-- The change of a quadratic relation under the arrow change `L.sub` (as in
`exists_correction`). -/
theorem sub_key (L : Lifts E) {q' : ℕ} (hq : 2 ≤ q') (ft : ∀ {x y : V}, (x ⟶ y) → (O x ⟶ O y))
    (hft : ∀ {x y : V} (a : x ⟶ y), ft a ∈ E.F q' x y)
    (f : ∀ {x y : V}, (x ⟶ y) →
      ((cl s t r).obj (LinearPaths.obj x) ⟶ (cl s t r).obj (LinearPaths.obj y)))
    (hσ : ∀ {x y : V} (a : x ⟶ y), E.σ q' x y (ft a) = f a) {x y : V}
    {P : LinearPaths.obj (k := k) x ⟶ LinearPaths.obj y}
    (hP : P ∈ LinearPaths.degreePart (k := k) 2 x y) :
    realize (L.sub hq ft hft).L x y P - realize L.L x y P ∈ E.F (q' + 1) x y ∧
      E.σ (q' + 1) x y (realize (L.sub hq ft hft).L x y P - realize L.L x y P) =
        -derL f x y P := by
  induction hP using Submodule.span_induction with
  | mem g hg =>
      obtain ⟨p, hp, rfl⟩ := hg
      rcases p with _ | ⟨p₁, b⟩
      · simp at hp
      rcases p₁ with _ | ⟨p₀, a⟩
      · simp at hp
      rcases p₀ with _ | ⟨p₀, c⟩
      swap
      · simp at hp
      rw [realize_path, realize_path, derL_path]
      simp only [pathMap_cons, pathMap_nil, Category.id_comp, pathDer, Limits.zero_comp,
        zero_add, sub_L]
      have e : (L.L a - ft a) ≫ (L.L b - ft b) - L.L a ≫ L.L b =
          -(ft a ≫ L.L b) - L.L a ≫ ft b + ft a ≫ ft b := by
        simp only [Preadditive.sub_comp, Preadditive.comp_sub]; abel
      rw [e]
      have m1 : ft a ≫ L.L b ∈ E.F (q' + 1) _ _ := E.F_comp q' 1 (hft a) (L.mem b)
      have m2 : L.L a ≫ ft b ∈ E.F (q' + 1) _ _ := by
        rw [add_comm]; exact E.F_comp 1 q' (L.mem a) (hft b)
      have m3 : ft a ≫ ft b ∈ E.F (q' + 2) _ _ :=
        E.F_anti (show q' + 2 ≤ q' + q' by omega) _ _ (E.F_comp q' q' (hft a) (hft b))
      refine ⟨add_mem (sub_mem (neg_mem m1) m2) (E.F_succ_le _ _ _ m3), ?_⟩
      rw [map_add, map_sub, map_neg, E.σ_eq_zero m3, add_zero,
        E.σ_comp q' 1 _ _ (hft a) (L.mem b), hσ, L.sym b]
      rw [show q' + 1 = 1 + q' by omega, E.σ_comp 1 q' _ _ (L.mem a) (hft b), hσ, L.sym a]
      have hnil : (cl s t r).map (LinearPaths.path (k := k) (Quiver.Path.nil : Quiver.Path x x)) =
          𝟙 _ := CategoryTheory.Functor.map_id (cl s t r) (LinearPaths.obj x)
      rw [hnil, Category.id_comp]
      change _ = -(f a ≫ (cl s t r).map (LinearPaths.arrow b) +
        (cl s t r).map (LinearPaths.arrow a) ≫ f b)
      abel
  | zero => simp
  | add P₁ P₂ _ _ h₁ h₂ =>
      have e : realize (L.sub hq ft hft).L x y (P₁ + P₂) - realize L.L x y (P₁ + P₂) =
          (realize (L.sub hq ft hft).L x y P₁ - realize L.L x y P₁) +
            (realize (L.sub hq ft hft).L x y P₂ - realize L.L x y P₂) := by
        rw [map_add, map_add]; abel
      rw [e, map_add, h₁.2, h₂.2, map_add, neg_add]
      exact ⟨add_mem h₁.1 h₂.1, rfl⟩
  | smul c P₁ _ h₁ =>
      rw [map_smul, map_smul, ← smul_sub, map_smul, h₁.2, map_smul, smul_neg]
      exact ⟨Submodule.smul_mem _ c h₁.1, rfl⟩

end Lifts

/-! ### Retained tuples -/

section Retained

variable {J : Type} [Fintype J] (deg : J → ℕ)
  (p : J → ∀ i, LinearPaths.obj (k := k) (s i) ⟶ LinearPaths.obj (k := k) (t i))

variable (r) in
/-- The perturbed relations `r_v − Σ_j λ_j (p_j)_v`. -/
def relRet (lam : J → k) (i : ι) : LinearPaths.obj (k := k) (s i) ⟶ LinearPaths.obj (k := k) (t i) :=
  r i - ∑ j, lam j • p j i

theorem relRet_zero (i : ι) : relRet r p 0 i = r i := by simp [relRet]

variable {deg p}

/-- **One correction step with retained tuples**: if the errors of the perturbed relations lie in
`F^{q'+1}` and their symbols are `D_{q'}(f) + Σ_j c_j [p_j]` with `c` supported in degree
`q'+1`, retaining `c` and changing the arrows by lifts of `f` pushes the errors into `F^{q'+2}`. -/
theorem step_retained (hdeg : ∀ j, 3 ≤ deg j)
    (hp : ∀ j i, p j i ∈ LinearPaths.degreePart (k := k) (deg j) (s i) (t i))
    (hr : ∀ i, r i ∈ LinearPaths.degreePart (k := k) 2 (s i) (t i))
    (L : Lifts E) (lam : J → k) {q' : ℕ} (hq : 2 ≤ q')
    (hL : ∀ i, realize L.L (s i) (t i) (relRet r p lam i) ∈ E.F (q' + 1) (s i) (t i))
    (f : ∀ {x y : V}, (x ⟶ y) →
      ((cl s t r).obj (LinearPaths.obj x) ⟶ (cl s t r).obj (LinearPaths.obj y)))
    (hf : ∀ {x y : V} (a : x ⟶ y), f a ∈ Cdeg s t r q' x y)
    (c : J → k) (hc : ∀ j, deg j ≠ q' + 1 → c j = 0)
    (hD : ∀ i, E.σ (q' + 1) _ _ (realize L.L (s i) (t i) (relRet r p lam i)) =
      Dmap f i + ∑ j, c j • (cl s t r).map (p j i)) :
    ∃ L' : Lifts E, ∀ i, realize L'.L (s i) (t i) (relRet r p (lam + c) i) ∈ E.F (q' + 2) (s i) (t i) := by
  have hft : ∀ (x y : V) (a : x ⟶ y), ∃ g ∈ E.F q' x y, E.σ q' x y g = f a :=
    fun x y a ↦ E.σ_surj q' x y _ (hf a)
  choose ft hft1 hft2 using hft
  set L' := L.sub hq (fun {x y} a ↦ ft x y a) (fun {x y} a ↦ hft1 x y a)
  refine ⟨L', fun i ↦ ?_⟩
  obtain ⟨hr1, hr2⟩ := L.sub_key hq (fun {x y} a ↦ ft x y a) (fun {x y} a ↦ hft1 x y a) f
    (fun {x y} a ↦ hft2 x y a) (hr i)
  have hdiff : ∀ {x y : V} (a : x ⟶ y), L'.L a - L.L a ∈ E.F q' x y := fun a ↦ by
    rw [Lifts.sub_L, sub_sub_cancel_left]; exact neg_mem (hft1 _ _ a)
  -- the retained terms
  have hΔ : ∀ j, realize L'.L _ _ (p j i) - realize L.L _ _ (p j i) ∈ E.F (q' + 2) (s i) (t i) :=
    fun j ↦ E.F_anti (by have := hdeg j; omega) _ _ (L.realize_sub_mem L' hdiff (hp j i))
  have hB : ∀ j, c j • realize L.L _ _ (p j i) ∈ E.F (q' + 1) (s i) (t i) ∧
      E.σ (q' + 1) _ _ (c j • realize L.L _ _ (p j i)) = c j • (cl s t r).map (p j i) := by
    intro j
    by_cases hj : deg j = q' + 1
    · obtain ⟨m1, m2⟩ := L.realize_mem (hp j i)
      rw [hj] at m1 m2
      exact ⟨Submodule.smul_mem _ _ m1, by rw [map_smul, m2]⟩
    · rw [hc j hj, zero_smul, zero_smul, map_zero]; exact ⟨zero_mem _, rfl⟩
  set A := realize L.L (s i) (t i) (relRet r p lam i)
  set Δr := realize L'.L (s i) (t i) (r i) - realize L.L (s i) (t i) (r i)
  set B := ∑ j, c j • realize L.L (s i) (t i) (p j i)
  set C := ∑ j, (lam j + c j) • (realize L'.L (s i) (t i) (p j i) - realize L.L (s i) (t i) (p j i))
  have e : realize L'.L (s i) (t i) (relRet r p (lam + c) i) = A + Δr - B - C := by
    simp only [A, Δr, B, C, relRet, map_sub, map_add, map_sum, map_smul, Pi.add_apply, add_smul,
      Finset.sum_add_distrib, smul_sub, Finset.sum_sub_distrib]
    abel
  have hBm : B ∈ E.F (q' + 1) (s i) (t i) := sum_mem fun j _ ↦ (hB j).1
  have hCm : C ∈ E.F (q' + 2) (s i) (t i) := sum_mem fun j _ ↦ Submodule.smul_mem _ _ (hΔ j)
  have hm : realize L'.L (s i) (t i) (relRet r p (lam + c) i) ∈ E.F (q' + 1) (s i) (t i) := by
    rw [e]; exact sub_mem (sub_mem (add_mem (hL i) hr1) hBm) (E.F_succ_le _ _ _ hCm)
  refine (E.σ_ker (q' + 1) _ _ _ hm).1 ?_
  rw [e, map_sub, map_sub, map_add, hD i, hr2, E.σ_eq_zero hCm, map_sum,
    Finset.sum_congr rfl fun j _ ↦ (hB j).2, Dmap]
  abel

/-- **Exact relations with retained tuples**: if the classes of the retained tuples together with
`im D_{q-1}` span the degree-`q` relation families for every `q ≥ 3`, there are scalars `λ` and
arrow lifts satisfying `r_v = Σ λ_j (p_j)_v`. -/
theorem exists_retained (hdeg : ∀ j, 3 ≤ deg j)
    (hp : ∀ j i, p j i ∈ LinearPaths.degreePart (k := k) (deg j) (s i) (t i))
    (hr : ∀ i, r i ∈ LinearPaths.degreePart (k := k) 2 (s i) (t i))
    (hspan : ∀ q', 2 ≤ q' → ∀ g : ∀ i, (cl s t r).obj (LinearPaths.obj (s i)) ⟶
        (cl s t r).obj (LinearPaths.obj (t i)), (∀ i, g i ∈ Cdeg s t r (q' + 1) (s i) (t i)) →
      ∃ (f : ∀ {x y : V}, (x ⟶ y) →
          ((cl s t r).obj (LinearPaths.obj x) ⟶ (cl s t r).obj (LinearPaths.obj y))) (c : J → k),
        (∀ {x y : V} (a : x ⟶ y), f a ∈ Cdeg s t r q' x y) ∧ (∀ j, deg j ≠ q' + 1 → c j = 0) ∧
        ∀ i, g i = Dmap f i + ∑ j, c j • (cl s t r).map (p j i)) :
    ∃ (lam : J → k) (L : Lifts E), ∀ i, realize L.L (s i) (t i) (relRet r p lam i) = 0 := by
  have hstep : ∀ n, ∃ (lam : J → k) (L : Lifts E),
      ∀ i, realize L.L (s i) (t i) (relRet r p lam i) ∈ E.F (n + 3) (s i) (t i) := by
    intro n
    induction n with
    | zero =>
        obtain ⟨L⟩ := Lifts.exists_lifts (E := E)
        exact ⟨0, L, fun i ↦ by rw [relRet_zero]; exact L.error_mem_three hr i⟩
    | succ n ih =>
        obtain ⟨lam, L, hL⟩ := ih
        obtain ⟨f, c, hf, hc, hD⟩ := hspan (n + 2) (by omega)
          (fun i ↦ E.σ (n + 3) _ _ (realize L.L (s i) (t i) (relRet r p lam i)))
          (fun i ↦ E.σ_mem _ _ _ _ (hL i))
        obtain ⟨L', hL'⟩ := step_retained hdeg hp hr L lam (q' := n + 2) (by omega) hL f hf c hc
          (fun i ↦ hD i)
        exact ⟨lam + c, L', hL'⟩
  obtain ⟨lam, L, hL⟩ := hstep E.N
  refine ⟨lam, L, fun i ↦ ?_⟩
  have := E.F_anti (show E.N ≤ E.N + 3 by omega) _ _ (hL i)
  rwa [E.F_N, Submodule.mem_bot] at this

/-! ### The presentation -/

variable (r p) in
/-- The relations of the presentation: the perturbed relations and the paths of length `> N`. -/
def RelRet (lam : J → k) (N : ℕ) : ∀ X Y : LinearPaths k V, Set (X ⟶ Y) :=
  fun X Y ↦ {f | (∃ (i : ι) (hX : X = LinearPaths.obj (s i)) (hY : Y = LinearPaths.obj (t i)),
      f = eqToHom hX ≫ relRet r p lam i ≫ eqToHom hY.symm) ∨
    ∃ (x y : V) (hX : X = LinearPaths.obj x) (hY : Y = LinearPaths.obj y) (q : Quiver.Path x y),
      N + 1 ≤ q.length ∧ f = eqToHom hX ≫ LinearPaths.path q ≫ eqToHom hY.symm}

open CategoricalIdeal in
theorem relRet_mem (lam : J → k) (N : ℕ) (i : ι) :
    relRet r p lam i ∈ (HomIdeal.linearSpan k (RelRet r p lam N)).hom _ _ := by
  change _ ∈ HomIdeal.generatedHomSubmodule k _ _ _
  exact Submodule.subset_span ⟨_, _, relRet r p lam i, Or.inl ⟨i, rfl, rfl, by simp⟩, 𝟙 _, 𝟙 _,
    by simp⟩

open CategoricalIdeal in
theorem path_mem_relRet (lam : J → k) (N : ℕ) {x y : V} (q : Quiver.Path x y)
    (hq : N + 1 ≤ q.length) :
    LinearPaths.path (k := k) q ∈ (HomIdeal.linearSpan k (RelRet r p lam N)).hom _ _ := by
  change _ ∈ HomIdeal.generatedHomSubmodule k _ _ _
  exact Submodule.subset_span ⟨_, _, LinearPaths.path q,
    Or.inr ⟨x, y, rfl, rfl, q, hq, by simp⟩, 𝟙 _, 𝟙 _, by simp⟩

open CategoricalIdeal in
/-- Morphisms with all components of degree `> N` lie in the ideal. -/
theorem mem_relRet_of_high (lam : J → k) (N : ℕ) {x y : V}
    {G : LinearPaths.obj (k := k) x ⟶ LinearPaths.obj y}
    (hG : ∀ e < N + 1, LinearPaths.proj e x y G = 0) :
    G ∈ (HomIdeal.linearSpan k (RelRet r p lam N)).hom _ _ := by
  obtain ⟨M, hM⟩ := LinearPaths.eq_sum_proj (k := k) G
  rw [hM]
  refine sum_mem fun e _ ↦ ?_
  by_cases he : e < N + 1
  · rw [hG e he]; exact zero_mem _
  · have hmem := LinearPaths.proj_mem (k := k) (d := e) G
    refine (Submodule.span_le.2 ?_) hmem
    rintro _ ⟨q, hq, rfl⟩
    exact path_mem_relRet lam N q (by omega)

open CategoricalIdeal in
/-- **The realization kills the presentation ideal.** -/
theorem realize_eq_zero_of_relRet (L : Lifts E) (lam : J → k)
    (hL : ∀ i, realize L.L (s i) (t i) (relRet r p lam i) = 0) {N : ℕ}
    (hN : ∀ x y, E.F N x y = ⊥) {x y : V} {G : LinearPaths.obj (k := k) x ⟶ LinearPaths.obj y}
    (hG : G ∈ (HomIdeal.linearSpan k (RelRet r p lam N)).hom _ _) : realize L.L x y G = 0 := by
  change G ∈ HomIdeal.generatedHomSubmodule k _ _ _ at hG
  induction hG using Submodule.span_induction with
  | mem g hg =>
      obtain ⟨X, Y, rr, hrr, a, a', rfl⟩ := hg
      rcases hrr with ⟨i, rfl, rfl, rfl⟩ | ⟨x', y', hX, hY, q, hq, rfl⟩
      · simp only [eqToHom_refl, Category.id_comp, Category.comp_id]
        rw [realize_comp, realize_comp, hL i, Limits.zero_comp, Limits.comp_zero]
      · have h0 : realize L.L x' y' (LinearPaths.path (k := k) q) = 0 := by
          have := E.F_anti (show N ≤ q.length by omega) _ _
            (L.realize_mem (LinearPaths.path_mem_degreePart (k := k) q)).1
          rwa [hN, Submodule.mem_bot] at this
        rw [show a ≫ (eqToHom hX ≫ LinearPaths.path (k := k) q ≫ eqToHom hY.symm) ≫ a' =
          (a ≫ eqToHom hX) ≫ LinearPaths.path q ≫ (eqToHom hY.symm ≫ a') by
            simp only [Category.assoc], realize_comp, realize_comp, h0, Limits.zero_comp,
          Limits.comp_zero]
  | zero => simp
  | add a c _ _ ha hc => rw [map_add, ha, hc, add_zero]
  | smul c a _ ha => rw [map_smul, ha, smul_zero]

open CategoricalIdeal in
/-- Replacing the quadratic relations by the perturbed ones in a homogeneous component. -/
theorem exists_replace (hdeg : ∀ j, 3 ≤ deg j)
    (hp : ∀ j i, p j i ∈ LinearPaths.degreePart (k := k) (deg j) (s i) (t i))
    (hr : ∀ i, r i ∈ LinearPaths.degreePart (k := k) 2 (s i) (t i))
    (lam : J → k) (N : ℕ) {x y : V} {G : LinearPaths.obj (k := k) x ⟶ LinearPaths.obj y}
    (hG : G ∈ (HomIdeal.linearSpan k (Rel s t r)).hom _ _) (d : ℕ) :
    ∃ H ∈ (HomIdeal.linearSpan k (RelRet r p lam N)).hom _ _,
      ∀ e ≤ d, LinearPaths.proj e x y (LinearPaths.proj d x y G - H) = 0 := by
  change G ∈ HomIdeal.generatedHomSubmodule k _ _ _ at hG
  induction hG using Submodule.span_induction with
  | mem g hg =>
      obtain ⟨X, Y, rr, hrr, a, a', rfl⟩ := hg
      obtain ⟨i, hX, hY, rfl⟩ := hrr
      subst hX hY
      simp only [eqToHom_refl, Category.id_comp, Category.comp_id]
      induction a using LinearPaths.induction_on with
      | h0 => exact ⟨0, zero_mem _, fun e _ ↦ by simp⟩
      | hadd a₁ a₂ h₁ h₂ =>
          obtain ⟨H₁, hH₁, e₁⟩ := h₁
          obtain ⟨H₂, hH₂, e₂⟩ := h₂
          refine ⟨H₁ + H₂, add_mem hH₁ hH₂, fun e he ↦ ?_⟩
          rw [Preadditive.add_comp, map_add, show LinearPaths.proj d x y (a₁ ≫ r i ≫ a') +
            LinearPaths.proj d x y (a₂ ≫ r i ≫ a') - (H₁ + H₂) =
            (LinearPaths.proj d x y (a₁ ≫ r i ≫ a') - H₁) +
              (LinearPaths.proj d x y (a₂ ≫ r i ≫ a') - H₂) by abel, map_add, e₁ e he, e₂ e he,
            add_zero]
      | hsingle q₁ c₁ =>
          induction a' using LinearPaths.induction_on with
          | h0 => exact ⟨0, zero_mem _, fun e _ ↦ by simp⟩
          | hadd b₁ b₂ h₁ h₂ =>
              obtain ⟨H₁, hH₁, e₁⟩ := h₁
              obtain ⟨H₂, hH₂, e₂⟩ := h₂
              refine ⟨H₁ + H₂, add_mem hH₁ hH₂, fun e he ↦ ?_⟩
              rw [Preadditive.comp_add, Preadditive.comp_add, map_add,
                show LinearPaths.proj d x y ((c₁ • LinearPaths.path q₁) ≫ r i ≫ b₁) +
                  LinearPaths.proj d x y ((c₁ • LinearPaths.path q₁) ≫ r i ≫ b₂) - (H₁ + H₂) =
                  (LinearPaths.proj d x y ((c₁ • LinearPaths.path q₁) ≫ r i ≫ b₁) - H₁) +
                    (LinearPaths.proj d x y ((c₁ • LinearPaths.path q₁) ≫ r i ≫ b₂) - H₂) by abel,
                map_add, e₁ e he, e₂ e he, add_zero]
          | hsingle q₂ c₂ =>
              have hdeg2 : LinearPaths.path (k := k) q₁ ≫ r i ≫ LinearPaths.path q₂ ∈
                  LinearPaths.degreePart (k := k) (q₁.length + 2 + q₂.length) x y := by
                simpa [Category.assoc] using LinearPaths.comp_mem_degreePart
                  (LinearPaths.comp_mem_degreePart (LinearPaths.path_mem_degreePart q₁) (hr i))
                  (LinearPaths.path_mem_degreePart q₂)
              have e0 : (c₁ • LinearPaths.path (k := k) q₁) ≫ r i ≫ (c₂ • LinearPaths.path q₂) =
                  (c₁ * c₂) • (LinearPaths.path (k := k) q₁ ≫ r i ≫ LinearPaths.path q₂) := by
                simp only [Linear.smul_comp, Linear.comp_smul, smul_smul, mul_comm]
              rw [e0, map_smul, LinearPaths.proj_of_mem hdeg2]
              by_cases hd : q₁.length + 2 + q₂.length = d
              · rw [if_pos hd]
                refine ⟨(c₁ * c₂) • (LinearPaths.path (k := k) q₁ ≫ relRet r p lam i ≫
                  LinearPaths.path q₂), Submodule.smul_mem _ _ ?_, fun e he ↦ ?_⟩
                · change _ ∈ HomIdeal.generatedHomSubmodule k _ _ _
                  exact Submodule.subset_span ⟨_, _, relRet r p lam i,
                    Or.inl ⟨i, rfl, rfl, by simp⟩, LinearPaths.path q₁, LinearPaths.path q₂,
                    by simp⟩
                · rw [← smul_sub, ← Preadditive.comp_sub, ← Preadditive.sub_comp, relRet,
                    sub_sub_cancel, Preadditive.sum_comp, Preadditive.comp_sum, Finset.smul_sum,
                    map_sum]
                  refine Finset.sum_eq_zero fun j _ ↦ ?_
                  have hj : LinearPaths.path (k := k) q₁ ≫ (lam j • p j i) ≫ LinearPaths.path q₂ ∈
                      LinearPaths.degreePart (k := k) (q₁.length + deg j + q₂.length) x y := by
                    simpa [Category.assoc] using LinearPaths.comp_mem_degreePart
                      (LinearPaths.comp_mem_degreePart (LinearPaths.path_mem_degreePart q₁)
                        (Submodule.smul_mem _ _ (hp j i))) (LinearPaths.path_mem_degreePart q₂)
                  rw [map_smul, LinearPaths.proj_of_mem hj, if_neg (by have := hdeg j; omega),
                    smul_zero]
              · rw [if_neg hd, smul_zero]
                exact ⟨0, zero_mem _, fun e _ ↦ by simp⟩
  | zero => exact ⟨0, zero_mem _, fun e _ ↦ by simp⟩
  | add a c _ _ ha hc =>
      obtain ⟨H₁, hH₁, e₁⟩ := ha
      obtain ⟨H₂, hH₂, e₂⟩ := hc
      refine ⟨H₁ + H₂, add_mem hH₁ hH₂, fun e he ↦ ?_⟩
      rw [map_add, show LinearPaths.proj d x y a + LinearPaths.proj d x y c - (H₁ + H₂) =
        (LinearPaths.proj d x y a - H₁) + (LinearPaths.proj d x y c - H₂) by abel, map_add,
        e₁ e he, e₂ e he, add_zero]
  | smul c a _ ha =>
      obtain ⟨H, hH, e₁⟩ := ha
      refine ⟨c • H, Submodule.smul_mem _ _ hH, fun e he ↦ ?_⟩
      rw [map_smul, ← smul_sub, map_smul, e₁ e he, smul_zero]

open CategoricalIdeal in
/-- **The kernel of the realization is the presentation ideal** `(𝔪^{N+1}, r_v − Σ λ_j (p_j)_v)`. -/
theorem mem_relRet_of_realize (hdeg : ∀ j, 3 ≤ deg j)
    (hp : ∀ j i, p j i ∈ LinearPaths.degreePart (k := k) (deg j) (s i) (t i))
    (hr : ∀ i, r i ∈ LinearPaths.degreePart (k := k) 2 (s i) (t i))
    (L : Lifts E) (lam : J → k) (hL : ∀ i, realize L.L (s i) (t i) (relRet r p lam i) = 0)
    {N : ℕ} (hN : ∀ x y, E.F N x y = ⊥) {x y : V}
    {G : LinearPaths.obj (k := k) x ⟶ LinearPaths.obj y} (hG : realize L.L x y G = 0) :
    G ∈ (HomIdeal.linearSpan k (RelRet r p lam N)).hom _ _ := by
  classical
  -- components of degree `≥ d` realize into `F^d`
  have hhigh : ∀ (d : ℕ) (G : LinearPaths.obj (k := k) x ⟶ LinearPaths.obj y),
      (∀ e < d, LinearPaths.proj e x y G = 0) → realize L.L x y G ∈ E.F d x y := by
    intro d G hG
    obtain ⟨M, hM⟩ := LinearPaths.eq_sum_proj (k := k) G
    rw [hM, map_sum]
    refine sum_mem fun e _ ↦ ?_
    by_cases he : e < d
    · rw [hG e he, map_zero]; exact zero_mem _
    · exact E.F_anti (by omega) _ _ (L.realize_mem (LinearPaths.proj_mem (d := e) G)).1
  have claim : ∀ j d, N + 1 ≤ d + j → ∀ G : LinearPaths.obj (k := k) x ⟶ LinearPaths.obj y,
      realize L.L x y G = 0 → (∀ e < d, LinearPaths.proj e x y G = 0) →
      G ∈ (HomIdeal.linearSpan k (RelRet r p lam N)).hom _ _ := by
    intro j
    induction j with
    | zero =>
        intro d hd G _ hGd
        exact mem_relRet_of_high lam N fun e he ↦ hGd e (by omega)
    | succ j ih =>
        intro d hd G hG0 hGd
        set Gd := LinearPaths.proj d x y G
        have hrest : ∀ e < d + 1, LinearPaths.proj e x y (G - Gd) = 0 := by
          intro e he
          rw [map_sub, LinearPaths.proj_of_mem (LinearPaths.proj_mem (d := d) G)]
          rcases Nat.lt_succ_iff_lt_or_eq.1 he with he | rfl
          · rw [hGd e he, if_neg (by omega), sub_zero]
          · rw [if_pos rfl, sub_self]
        -- the leading component lies in the quadratic relation ideal
        have h1 : realize L.L x y Gd ∈ E.F (d + 1) x y := by
          have e : realize L.L x y Gd = -realize L.L x y (G - Gd) := by
            rw [map_sub, hG0, zero_sub, neg_neg]
          rw [e]; exact neg_mem (hhigh (d + 1) _ hrest)
        obtain ⟨-, h2⟩ := L.realize_mem (LinearPaths.proj_mem (d := d) G)
        rw [E.σ_eq_zero h1] at h2
        have hGd : Gd ∈ (HomIdeal.linearSpan k (Rel s t r)).hom _ _ :=
          (RelationCategory.functor_map_eq_zero_iff (k := k) _ _).1 h2.symm
        obtain ⟨H, hH, hHd⟩ := exists_replace hdeg hp hr lam N hGd d
        rw [LinearPaths.proj_of_mem (LinearPaths.proj_mem (d := d) G), if_pos rfl] at hHd
        have hH0 : realize L.L x y H = 0 := realize_eq_zero_of_relRet L lam hL hN hH
        have hnext : G - H ∈ (HomIdeal.linearSpan k (RelRet r p lam N)).hom _ _ := by
          refine ih (d + 1) (by omega) _ (by rw [map_sub, hG0, hH0, sub_zero]) fun e he ↦ ?_
          rw [show G - H = (G - Gd) + (Gd - H) by abel, map_add, hrest e he,
            hHd e (by omega), add_zero]
        have := add_mem hnext hH
        rwa [sub_add_cancel] at this
  exact claim (N + 1) 0 (by omega) G hG fun e he ↦ absurd he (Nat.not_lt_zero e)

open CategoricalIdeal in
/-- **Proposition 12.2** (`prop:characteristic-two-normal-form`), general form: for quadratic
relations `r_v`, retained tuples `p_j` of degrees `≥ 3` whose classes together with
`im D_{q-1}` span the degree-`q` relation families (`q ≥ 3`; a basis of the cokernel in the
source), and any finite filtered category `E` on the vertices with `gr E = C`, there are scalars
`λ` and arrow lifts satisfying `r_v = Σ λ_j (p_j)_v`; the realization `kQ → E` is onto every Hom
space, its kernel is the ideal `(𝔪^{N+1}, r_v − Σ λ_j (p_j)_v)` for every `N` with `F^N = 0`, so
`E ≅ kQ/(𝔪^{N+1}, r_v − Σ λ_j (p_j)_v)` (full and faithful `Φ`), and it induces the given
identification `gr E = C`. -/
theorem normalFormRetained (hdeg : ∀ j, 3 ≤ deg j)
    (hp : ∀ j i, p j i ∈ LinearPaths.degreePart (k := k) (deg j) (s i) (t i))
    (hr : ∀ i, r i ∈ LinearPaths.degreePart (k := k) 2 (s i) (t i))
    (hspan : ∀ q', 2 ≤ q' → ∀ g : ∀ i, (cl s t r).obj (LinearPaths.obj (s i)) ⟶
        (cl s t r).obj (LinearPaths.obj (t i)), (∀ i, g i ∈ Cdeg s t r (q' + 1) (s i) (t i)) →
      ∃ (f : ∀ {x y : V}, (x ⟶ y) →
          ((cl s t r).obj (LinearPaths.obj x) ⟶ (cl s t r).obj (LinearPaths.obj y))) (c : J → k),
        (∀ {x y : V} (a : x ⟶ y), f a ∈ Cdeg s t r q' x y) ∧ (∀ j, deg j ≠ q' + 1 → c j = 0) ∧
        ∀ i, g i = Dmap f i + ∑ j, c j • (cl s t r).map (p j i)) :
    ∃ (lam : J → k) (L : Lifts E), (∀ i, realize L.L (s i) (t i) (relRet r p lam i) = 0) ∧
      (∀ {x y : V} (f : O x ⟶ O y), ∃ G : LinearPaths.obj (k := k) x ⟶ LinearPaths.obj y,
        realize L.L x y G = f) ∧
      (∀ N : ℕ, (∀ x y, E.F N x y = ⊥) →
        (∀ {x y : V} (G : LinearPaths.obj (k := k) x ⟶ LinearPaths.obj y),
          realize L.L x y G = 0 ↔ G ∈ (HomIdeal.linearSpan k (RelRet r p lam N)).hom _ _) ∧
        ∃ Φ : RelationCategory k (RelRet r p lam N) ⥤ 𝓔,
          RelationCategory.functor k (RelRet r p lam N) ⋙ Φ = pathFunctor L.L ∧
            Φ.Full ∧ Φ.Faithful) ∧
      ∀ (d : ℕ) {x y : V} (P : LinearPaths.obj (k := k) x ⟶ LinearPaths.obj y),
        P ∈ LinearPaths.degreePart (k := k) d x y →
        realize L.L x y P ∈ E.F d x y ∧ E.σ d x y (realize L.L x y P) = (cl s t r).map P := by
  obtain ⟨lam, L, hL⟩ := exists_retained (E := E) hdeg hp hr hspan
  refine ⟨lam, L, hL, fun f ↦ L.exists_realize_eq f, fun N hN ↦ ?_,
    fun d x y P hP ↦ L.realize_mem hP⟩
  have hker : ∀ {x y : V} (G : LinearPaths.obj (k := k) x ⟶ LinearPaths.obj y),
      realize L.L x y G = 0 ↔ G ∈ (HomIdeal.linearSpan k (RelRet r p lam N)).hom _ _ :=
    fun G ↦ ⟨fun h ↦ mem_relRet_of_realize hdeg hp hr L lam hL hN h,
      fun h ↦ realize_eq_zero_of_relRet L lam hL hN h⟩
  let Φ : RelationCategory k (RelRet r p lam N) ⥤ 𝓔 :=
    CategoryTheory.Quotient.lift _ (pathFunctor L.L) fun x y f₁ f₂ h ↦ by
      have h0 := (hker (f₁ - f₂)).2 h
      rw [map_sub, sub_eq_zero] at h0
      exact h0
  refine ⟨hker, Φ, CategoryTheory.Quotient.lift_spec _ _ _, ⟨fun {a a'} f ↦ ?_⟩,
    ⟨fun {a a'} f g h ↦ ?_⟩⟩
  · obtain ⟨G, hG⟩ := L.exists_realize_eq (x := a.as) (y := a'.as) f
    exact ⟨(RelationCategory.functor k (RelRet r p lam N)).map G, hG⟩
  · obtain ⟨F, rfl⟩ := (RelationCategory.functor k (RelRet r p lam N)).map_surjective
      (X := a.as) (Y := a'.as) f
    obtain ⟨G, rfl⟩ := (RelationCategory.functor k (RelRet r p lam N)).map_surjective
      (X := a.as) (Y := a'.as) g
    change realize L.L a.as a'.as F = realize L.L a.as a'.as G at h
    apply CategoryTheory.Quotient.sound
    change F - G ∈ (HomIdeal.linearSpan k (RelRet r p lam N)).hom _ _
    exact (hker (F - G)).1 (by rw [map_sub, h, sub_self])

end Retained

