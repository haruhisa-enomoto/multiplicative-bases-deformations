module

public import MultiplicativeBasisDeformations.Foundations.ExtOne

/-!
# Evaluated projectives (Lemma 6.3)

`positive-deformations.tex`: "The projectives are included with their
regular gradings. […] Projective summands contribute zero." At a projective label
`p`, the evaluated module `M_p = R⁰_{F p}` is the cyclic graded projective
`e_p A₀` generated in degree `0` by `1_p` (Yoneda: `colAlg`, `colAlg_smul_unit`),
so all its higher `Ext` groups vanish (`extVanish_proj`).
-/

@[expose] public section

set_option autoImplicit false
set_option linter.unusedSectionVars false

noncomputable section

open CategoryTheory

namespace MultiplicativeBasisDeformations

universe u

namespace MeshWalk

open ScalarMeshCategory CatAlg CatAlg.MeshData

attribute [local instance] Classical.decEq

variable {k : Type u} [Field k] {V : Type} [Quiver.{0} V] [Fintype V] [DecidableEq V]
  {Q : TranslationQuiver V} [∀ x : V, Fintype (Σ y : V, y ⟶ x)] {c : MeshCoefficients k Q}
  {L : LocalFamily (k := k) (meshFam Q c)} (D : MeshData (meshFam Q c) L)
  (hfin : ∀ x y : V, FiniteDimensional k (obj c x ⟶ obj c y))

/-- **`M_p` is cyclic projective**, generated by `1_p` in degree `0`. -/
def cycProj (p : D.PV) : GExt.CycProj (gmodEv D hfin p.1) where
  e := MulOpposite.op (idem (F := D.F0) p)
  g := unit (F := D.F0) p
  b := 0
  hg := by
    change (zgrEv D hfin p.1).IsHom ((0 : ℕ) : ℤ) _
    rw [zgrEv_isHom]
    intro y
    exact idTo_mem_degreePart D y p
  ψ :=
    { toFun := fun m ↦ MulOpposite.op (colAlg (F := D.F0) p m)
      map_add' := fun m m' ↦ by rw [colAlg_add, MulOpposite.op_add]
      map_smul' := fun c m ↦ by rw [colAlg_smul', MulOpposite.op_smul]; rfl }
  ψ_act m a := by
    change MulOpposite.op (colAlg (F := D.F0) p (a.unop • m)) = _
    rw [colAlg_smul, MulOpposite.op_mul]
    rfl
  act_ψ m := colAlg_smul_unit (F := D.F0) p m
  ψ_deg q m hm := by
    rw [sub_zero]
    rcases lt_or_ge q 0 with hq | hq
    · change (zgrEv D hfin p.1).IsHom _ m at hm
      rw [(zgrEv_isHom_neg D hfin p.1 hq m).1 hm]
      simp only [LinearMap.coe_mk, AddHom.coe_mk]
      rw [show colAlg (F := D.F0) p (0 : Rep D.F0 (D.F0 p)) = 0 by
        rw [← zero_smul k (0 : Rep D.F0 (D.F0 p)), colAlg_smul', zero_smul], MulOpposite.op_zero]
      exact GExt.ZGr.isHom_zero _ _
    obtain ⟨q', rfl⟩ := Int.eq_ofNat_of_zero_le hq
    change (zgrEv D hfin p.1).IsHom _ m at hm
    rw [zgrEv_isHom] at hm
    rw [galgA0_isHom]
    intro y z
    have := comp_mem_degreePart' c (hm y) (idTo_mem_degreePart D p z)
    rwa [add_zero] at this

/-- **`Ext` out of an evaluated projective vanishes.** -/
theorem extVanish_proj (p : D.PV) {N : Type*} [AddCommGroup N] [Module k N]
    (NN : GExt.GMod (galgA0 D hfin) N) (n : ℕ) (t : ℤ) :
    GExt.ExtVanish (gmodEv D hfin p.1) NN n t :=
  (cycProj D hfin p).extVanish NN n t

end MeshWalk

end MultiplicativeBasisDeformations
