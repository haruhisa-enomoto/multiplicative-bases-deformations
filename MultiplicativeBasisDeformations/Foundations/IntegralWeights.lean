module

public import MultiplicativeBasisDeformations.Foundations.Exhaustion

/-!
# Integral weights on thin categories (Proposition 7.2, first part)

`weights-and-parameters.tex` (`prop:integral-ray-weights`): "For a finite
directed thin representation-finite category `T` […] let `U(T)` be the abelian
group generated by symbols `[r]` for the nonidentity morphism lines `r` of `T`,
with relations `[rr'] = [r] + [r']` whenever `rr' ≠ 0`. For a source `s`, put
`T' = T ∖ {s}` and form the category `R` of Lemma 4.11 […] Lemma 4.9 gives object
values `u_y ∈ U(T')`, normalized to zero at one root `y_D` in each connected
component `D` of `R`. The new nonzero-product relations are exactly
`[sy] + [b_yz] = [sz]`. They have the universal solutions `[sy] = c_D + u_y`. […]
Thus `U(T) ≅ U(T') ⊕ ℤ^{π₀(R)}`, preserving the old generators. The sink assertion
follows by opposites. […] a nonzero element of the free group `U(L)` has a
nonzero integer coordinate `m`, detected by a character to `k*` […] But Lemma 4.13
says that every such character is an object ratio".

Formalization. Weights are recorded additively (`IsAddWeight`), a `k*`-weight
being an `Additive kˣ`-valued one. The induction over sources and sinks proves the
separation property `Sep T`: an integer combination of lines killed by every
`k*`-weight is killed by every weight with values in any abelian group. This is
the form in which the freeness of `U(T)` and of its split extensions is used for
the detection by characters: the universal solutions `[sy] = c_D + u_y` appear
as the decomposition `ev_insert_source`, the summand `ℤ^{π₀(R)}` as the free
constants `c_D` (`extW`), and the character detecting a nonzero coordinate as
`exists_zpow_ne_one`. Combined with Lemma 4.13 this gives Proposition 7.2(2)
(`addWeight_eq_diff`).
-/

@[expose] public section

set_option autoImplicit false
set_option linter.unusedSectionVars false

noncomputable section

open CategoryTheory Opposite

namespace MultiplicativeBasisDeformations

universe u v w z z₂

namespace Thin

variable {k : Type u} [Field k] {O : Type v} [Category.{w} O] [Preadditive O] [Linear k O]

/-- A nonzero morphism line `o → o'`. -/
def Line (o o' : O) : Prop := ∃ f : o ⟶ o', f ≠ 0

/-- An additive weight on the lines of `S`. -/
structure IsAddWeight {M : Type*} [AddCommGroup M] (S : Set O) (w : O → O → M) : Prop where
  mul : ∀ o ∈ S, ∀ o' ∈ S, ∀ o'' ∈ S, ∀ (f : o ⟶ o') (g : o' ⟶ o''), f ≫ g ≠ 0 →
    w o o'' = w o o' + w o' o''

theorem IsAddWeight.mono {M : Type*} [AddCommGroup M] {S S' : Set O} {w : O → O → M}
    (hw : IsAddWeight S w) (h : S' ⊆ S) : IsAddWeight S' w :=
  ⟨fun o ho o' ho' o'' ho'' f g hfg ↦ hw.mul o (h ho) o' (h ho') o'' (h ho'') f g hfg⟩

theorem IsAddWeight.self {M : Type*} [AddCommGroup M] {S : Set O} {w : O → O → M}
    (hw : IsAddWeight S w) {o : O} (ho : o ∈ S) (h1 : 𝟙 o ≠ 0) : w o o = 0 := by
  have := hw.mul o ho o ho o ho (𝟙 o) (𝟙 o) (by rwa [Category.comp_id])
  exact left_eq_add.1 this

/-- Evaluation of a weight on an integer combination of lines. -/
def ev {M : Type*} [AddCommGroup M] (w : O → O → M) (u : O × O →₀ ℤ) : M :=
  u.sum fun p n ↦ n • w p.1 p.2

section Ev

variable {M : Type*} [AddCommGroup M] (w : O → O → M)

@[simp] theorem ev_zero : ev w 0 = 0 := by simp [ev]

theorem ev_add (u u' : O × O →₀ ℤ) : ev w (u + u') = ev w u + ev w u' := by
  unfold ev
  rw [Finsupp.sum_add_index'] <;> simp [add_smul]

@[simp] theorem ev_single (p : O × O) (n : ℤ) : ev w (Finsupp.single p n) = n • w p.1 p.2 := by
  simp [ev]

theorem ev_smul (n : ℤ) (u : O × O →₀ ℤ) : ev w (n • u) = n • ev w u := by
  unfold ev
  rw [Finsupp.sum_smul_index']
  · rw [Finsupp.smul_sum]
    exact Finset.sum_congr rfl fun p _ ↦ by simp only [mul_smul, smul_eq_mul]
  · intro p; exact zero_smul ℤ _

theorem ev_neg (u : O × O →₀ ℤ) : ev w (-u) = -ev w u := by
  rw [← neg_one_smul ℤ u, ev_smul, neg_one_smul]

theorem ev_sub (u u' : O × O →₀ ℤ) : ev w (u - u') = ev w u - ev w u' := by
  rw [sub_eq_add_neg, ev_add, ev_neg, ← sub_eq_add_neg]

theorem ev_sum {ι : Type*} (s : Finset ι) (u : ι → O × O →₀ ℤ) :
    ev w (∑ i ∈ s, u i) = ∑ i ∈ s, ev w (u i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, ev_add, ih]

theorem ev_add_weight (w w' : O → O → M) (u : O × O →₀ ℤ) : ev (w + w') u = ev w u + ev w' u := by
  simp [ev, Finsupp.sum_add, smul_add]

theorem ev_congr {w w' : O → O → M} {u : O × O →₀ ℤ}
    (h : ∀ p ∈ u.support, w p.1 p.2 = w' p.1 p.2) : ev w u = ev w' u :=
  Finset.sum_congr rfl fun p hp ↦ by simp only; rw [h p hp]

theorem ev_eq_sum [DecidableEq O] {T : Finset O} {u : O × O →₀ ℤ}
    (hu : ∀ p ∈ u.support, p.1 ∈ T ∧ p.2 ∈ T) :
    ev w u = ∑ o ∈ T, ∑ o' ∈ T, u (o, o') • w o o' := by
  unfold ev Finsupp.sum
  rw [← Finset.sum_product' (f := fun o o' ↦ u (o, o') • w o o')]
  refine Finset.sum_subset (fun p hp ↦ Finset.mem_product.2 (hu p hp)) fun p _ hp ↦ ?_
  simp [Finsupp.notMem_support_iff.1 hp]

end Ev

/-- `u` is a combination of lines of `S`. -/
def Supp (S : Set O) (u : O × O →₀ ℤ) : Prop :=
  ∀ p ∈ u.support, p.1 ∈ S ∧ p.2 ∈ S ∧ Line p.1 p.2

/-- `u` is killed by every `k*`-weight on `S`. -/
def KillsK (k : Type u) [Field k] [Linear k O] (S : Set O) (u : O × O →₀ ℤ) : Prop :=
  ∀ w : O → O → Additive kˣ, IsAddWeight S w → ev w u = 0

/-- `u` is killed by every weight on `S` with values in an abelian group of universe `z`. -/
def KillsAll (S : Set O) (u : O × O →₀ ℤ) : Prop :=
  ∀ (M : Type z) [AddCommGroup M] (w : O → O → M), IsAddWeight S w → ev w u = 0

variable (k) in
/-- **Separation**: on `S`, `k*`-weights detect all weights. -/
def Sep (S : Set O) : Prop :=
  ∀ u, Supp S u → KillsK k S u → KillsAll.{v, w, z} S u

theorem sep_empty : Sep.{u, v, w, z} k (∅ : Set O) := by
  intro u hu _ M _ w _
  have : u = 0 := by
    ext p
    by_contra hp
    exact (hu p (Finsupp.mem_support_iff.2 hp)).1
  rw [this, ev_zero]

/-- A unit of an infinite field which is not an `m`-th root of unity. -/
theorem exists_zpow_ne_one [Infinite k] {m : ℤ} (hm : m ≠ 0) : ∃ t : kˣ, t ^ m ≠ 1 := by
  classical
  have hn : 0 < m.natAbs := Int.natAbs_pos.2 hm
  obtain ⟨t, ht⟩ := Infinite.exists_notMem_finset
    (insert (0 : k) (Polynomial.nthRoots m.natAbs (1 : k)).toFinset)
  rw [Finset.mem_insert, not_or, Multiset.mem_toFinset, Polynomial.mem_nthRoots hn] at ht
  obtain ⟨τ, hτ⟩ : ∃ τ : kˣ, (τ : k) = t := ⟨Units.mk0 t ht.1, rfl⟩
  refine ⟨τ, fun h ↦ ht.2 ?_⟩
  rw [← hτ]
  have h' : τ ^ m.natAbs = 1 := by
    rcases Int.natAbs_eq m with hm' | hm'
    · rw [hm'] at h; exact_mod_cast h
    · rw [hm', zpow_neg, inv_eq_one] at h; exact_mod_cast h
  have := congrArg Units.val h'
  simpa using this

/-! ### The universal group of a finite set -/

section Universal

open Classical

/-- The lines of `S`. -/
def lineSet (S : Set O) : Set (O × O) := {p | p.1 ∈ S ∧ p.2 ∈ S ∧ Line p.1 p.2}

/-- Generators of the relations of `U(S)`; pairs that are not lines are killed. -/
def relGens (S : Set O) : Set (O × O →₀ ℤ) :=
  {r | ∃ o ∈ S, ∃ o' ∈ S, ∃ o'' ∈ S, ∃ (f : o ⟶ o') (g : o' ⟶ o''), f ≫ g ≠ 0 ∧
    r = Finsupp.single (o, o'') 1 - Finsupp.single (o, o') 1 - Finsupp.single (o', o'') 1} ∪
  {r | ∃ p, p ∉ lineSet S ∧ r = Finsupp.single p 1}

/-- The relations of `U(S)`. -/
def RelS (S : Set O) : AddSubgroup (O × O →₀ ℤ) := AddSubgroup.closure (relGens S)

/-- The universal group `U(S)` of additive weights on `S`. -/
abbrev US (S : Set O) := (O × O →₀ ℤ) ⧸ RelS S

/-- A weight, set to zero off the lines of `S`. -/
def nw {M : Type*} [AddCommGroup M] (S : Set O) (w : O → O → M) : O → O → M :=
  fun o o' ↦ if (o, o') ∈ lineSet S then w o o' else 0

theorem ev_nw {M : Type*} [AddCommGroup M] {S : Set O} (w : O → O → M) {u : O × O →₀ ℤ}
    (hu : Supp S u) : ev (nw S w) u = ev w u :=
  ev_congr fun p hp ↦ by simp only [nw, if_pos (show p ∈ lineSet S from hu p hp)]

theorem ev_nw_rel {M : Type*} [AddCommGroup M] {S : Set O} {w : O → O → M}
    (hw : IsAddWeight S w) : ∀ r ∈ RelS S, ev (nw S w) r = 0 := by
  intro r hr
  induction hr using AddSubgroup.closure_induction with
  | mem r hr =>
    rcases hr with ⟨o, ho, o', ho', o'', ho'', f, g, hfg, rfl⟩ | ⟨p, hp, rfl⟩
    · have hf : f ≠ 0 := fun h ↦ hfg (by rw [h, Limits.zero_comp])
      have hg : g ≠ 0 := fun h ↦ hfg (by rw [h, Limits.comp_zero])
      simp only [ev_sub, ev_single, one_smul, nw, lineSet, Set.mem_setOf_eq]
      rw [if_pos ⟨ho, ho'', _, hfg⟩, if_pos ⟨ho, ho', _, hf⟩, if_pos ⟨ho', ho'', _, hg⟩,
        hw.mul o ho o' ho' o'' ho'' f g hfg]
      abel
    · simp [nw, hp]
  | zero => exact ev_zero _
  | add r r' _ _ h h' => rw [ev_add, h, h', add_zero]
  | neg r _ h => rw [ev_neg, h, neg_zero]

/-- The homomorphism `U(S) → M` of a weight. -/
def liftW {M : Type*} [AddCommGroup M] {S : Set O} {w : O → O → M} (hw : IsAddWeight S w) :
    US S →+ M :=
  QuotientAddGroup.lift (RelS S) (AddMonoidHom.mk' (ev (nw S w)) (ev_add _))
    (fun r hr ↦ ev_nw_rel hw r hr)

theorem liftW_mk {M : Type*} [AddCommGroup M] {S : Set O} {w : O → O → M}
    (hw : IsAddWeight S w) (u : O × O →₀ ℤ) :
    liftW hw (QuotientAddGroup.mk u) = ev (nw S w) u := rfl

/-- The part of `u` on the lines of `S`. -/
def toLines (S : Set O) (u : O × O →₀ ℤ) : O × O →₀ ℤ := u.filter (· ∈ lineSet S)

theorem supp_toLines (S : Set O) (u : O × O →₀ ℤ) : Supp S (toLines S u) := by
  intro p hp
  rw [toLines, Finsupp.support_filter, Finset.mem_filter] at hp
  exact hp.2

theorem sub_toLines_mem (S : Set O) (u : O × O →₀ ℤ) : u - toLines S u ∈ RelS S := by
  have : u - toLines S u = u.filter (· ∉ lineSet S) := by
    rw [toLines, sub_eq_iff_eq_add, add_comm, Finsupp.filter_pos_add_filter_neg]
  rw [this, ← Finsupp.sum_single (u.filter _)]
  refine AddSubgroup.sum_mem _ fun p hp ↦ ?_
  rw [Finsupp.support_filter, Finset.mem_filter] at hp
  rw [← Finsupp.smul_single_one]
  have hmem : Finsupp.single p (1 : ℤ) ∈ RelS S :=
    AddSubgroup.subset_closure (Or.inr ⟨p, hp.2, rfl⟩)
  exact AddSubgroup.zsmul_mem (RelS S) hmem _

theorem mk_toLines (S : Set O) (u : O × O →₀ ℤ) :
    (QuotientAddGroup.mk (toLines S u) : US S) = QuotientAddGroup.mk u :=
  (QuotientAddGroup.eq.2 (by
    have := sub_toLines_mem S u
    rw [← neg_mem_iff, neg_sub] at this
    simpa [sub_eq_neg_add] using this)).symm

end Universal

/-! ### Extension over a source -/

section Source

open Classical

variable (hT : IsThin k O) (s : O) (S : Finset O)

/-- The support order `y ≤ z` of the source `s`. -/
def SLe (y z : O) : Prop := y = z ∨ ∃ g : y ⟶ z, fvec s y ≫ g ≠ 0

variable {s S}

include hT in
theorem comp_ne_of_sle {y z x : O} (hy : y ∈ supp s S) (h₁ : ∃ g : y ⟶ z, fvec s y ≫ g ≠ 0)
    (h₂ : ∃ g : z ⟶ x, fvec s z ≫ g ≠ 0) (hz : z ∈ supp s S) :
    ∃ (g : y ⟶ z) (g' : z ⟶ x), g ≫ g' ≠ 0 := by
  obtain ⟨g, hg⟩ := h₁
  obtain ⟨g', hg'⟩ := h₂
  refine ⟨g, g', fun h0 ↦ ?_⟩
  obtain ⟨c, hc⟩ := exists_smul hT (fvec_ne s S hz) (fvec s y ≫ g)
  have hc0 : c ≠ 0 := by rintro rfl; rw [zero_smul] at hc; exact hg hc
  apply hg'
  have : fvec s y ≫ g ≫ g' = c • (fvec s z ≫ g') := by
    rw [← Category.assoc, hc, Linear.smul_comp]
  rw [h0, Limits.comp_zero] at this
  exact (smul_eq_zero.1 this.symm).resolve_left hc0

theorem one_ne_of_mem_supp {y : O} (hy : y ∈ supp s S) : 𝟙 y ≠ 0 := fun h ↦
  fvec_ne s S hy (by rw [← Category.comp_id (fvec s y), h, Limits.comp_zero])

theorem line_of_sle {y z : O} (hy : y ∈ supp s S) (h : SLe s y z) : Line y z := by
  rcases h with rfl | ⟨g, hg⟩
  · exact ⟨𝟙 y, one_ne_of_mem_supp hy⟩
  · exact ⟨g, fun h0 ↦ hg (by rw [h0, Limits.comp_zero])⟩

theorem mem_S_of_supp {y : O} (hy : y ∈ supp s S) : y ∈ S := (Finset.mem_filter.1 hy).1

include hT in
/-- **Universal object values on the support poset** (Lemma 4.9 applied to the
universal weight `[y z]` with values in `U(S)`): fixed integer combinations `zz y`
of lines of `S` with `w(y,z) = w(zz z) − w(zz y)` for every weight `w`. -/
theorem exists_zz [Infinite k]
    (hrep : SupRepFinite hT (s := s) (P := supp s S) (fv := fvec s) (fun y hy ↦ fvec_ne s S hy)) :
    ∃ zz : O → (O × O →₀ ℤ), (∀ y, Supp (S : Set O) (zz y)) ∧
      ∀ y ∈ supp s S, ∀ x ∈ supp s S, SLe s y x →
        (QuotientAddGroup.mk (Finsupp.single (y, x) (1 : ℤ)) : US (S : Set O)) =
          QuotientAddGroup.mk (zz x) - QuotientAddGroup.mk (zz y) := by
  set P := supp s S
  have hfv : ∀ y ∈ P, fvec s y ≠ 0 := fun y hy ↦ fvec_ne s S hy
  letI : PartialOrder (SupP s P (fvec s)) := supOrder hT hfv
  letI : LocallyFiniteOrder (SupP s P (fvec s)) := Fintype.toLocallyFiniteOrder
  let wt : SupP s P (fvec s) → SupP s P (fvec s) → US (S : Set O) := fun y x ↦
    QuotientAddGroup.mk (Finsupp.single (y.1, x.1) 1)
  have hself : ∀ y : SupP s P (fvec s), wt y y = 0 := fun y ↦ by
    have hy1 := one_ne_of_mem_supp y.2
    have hmem : -Finsupp.single (y.1, y.1) (1 : ℤ) ∈ RelS (S : Set O) := by
      refine AddSubgroup.subset_closure (Or.inl ⟨y.1, mem_S_of_supp y.2, y.1, mem_S_of_supp y.2,
        y.1, mem_S_of_supp y.2, 𝟙 _, 𝟙 _, by rwa [Category.comp_id], ?_⟩)
      abel
    exact (QuotientAddGroup.eq_zero_iff _).2 (by simpa using hmem)
  have hwt : ∀ a b c : SupP s P (fvec s), a ≤ b → b ≤ c → wt a c = wt a b + wt b c := by
    intro a b c hab hbc
    rcases hab with rfl | hab
    · rw [hself, zero_add]
    rcases hbc with rfl | hbc
    · rw [hself, add_zero]
    obtain ⟨g, g', hgg⟩ := comp_ne_of_sle hT a.2 hab hbc b.2
    have hmem : Finsupp.single (a.1, c.1) (1 : ℤ) - Finsupp.single (a.1, b.1) 1 -
        Finsupp.single (b.1, c.1) 1 ∈ RelS (S : Set O) :=
      AddSubgroup.subset_closure (Or.inl ⟨a.1, mem_S_of_supp a.2, b.1, mem_S_of_supp b.2,
        c.1, mem_S_of_supp c.2, g, g', hgg, rfl⟩)
    have := (QuotientAddGroup.eq_zero_iff _).2 hmem
    simp only [QuotientAddGroup.mk_sub] at this
    change wt a c - wt a b - wt b c = 0 at this
    rw [← sub_eq_zero, ← this]; abel
  obtain ⟨ζ, hζ⟩ : ∃ ζ : SupP s P (fvec s) → US (S : Set O),
      ∀ a b : SupP s P (fvec s), a ≤ b → wt a b = ζ b - ζ a := by
    rcases hrep with h | h
    · exact posetWeights_of h wt hwt
    · obtain ⟨ζ', hζ'⟩ := posetWeights_of h (fun a b ↦ wt (OrderDual.ofDual b) (OrderDual.ofDual a))
        (fun a b c hab hbc ↦ by rw [add_comm]; exact hwt _ _ _ hbc hab)
      refine ⟨fun a ↦ -ζ' (OrderDual.toDual a), fun a b hab ↦ ?_⟩
      have := hζ' (OrderDual.toDual b) (OrderDual.toDual a) (OrderDual.toDual_le_toDual.2 hab)
      simp only [OrderDual.ofDual_toDual] at this
      simp only [this]
      abel
  let pick : SupP s P (fvec s) → (O × O →₀ ℤ) := fun y ↦
    Classical.choose (QuotientAddGroup.mk_surjective (ζ y))
  have hpick : ∀ y, (QuotientAddGroup.mk (pick y) : US (S : Set O)) = ζ y := fun y ↦
    Classical.choose_spec (QuotientAddGroup.mk_surjective (ζ y))
  let mkP : ∀ y, y ∈ P → SupP s P (fvec s) := fun y h ↦ ⟨y, h⟩
  refine ⟨fun y ↦ if h : y ∈ P then toLines S (pick (mkP y h)) else 0,
    fun y ↦ ?_, fun y hy x hx hyx ↦ ?_⟩
  · by_cases h : y ∈ P
    · simp only [dif_pos h]; exact supp_toLines _ _
    · simp only [dif_neg h]; intro p hp; simp at hp
  · simp only [dif_pos hy, dif_pos hx, mk_toLines, hpick]
    exact hζ (mkP y hy) (mkP x hx) (by
      rcases hyx with rfl | h
      · exact le_rfl
      · exact Or.inr h)

/-- The values `w(zz y)` are object values of every weight on the support poset. -/
theorem zz_eval {zz : O → (O × O →₀ ℤ)} (hzz₁ : ∀ y, Supp (S : Set O) (zz y))
    (hzzU : ∀ y ∈ supp s S, ∀ x ∈ supp s S, SLe s y x →
      (QuotientAddGroup.mk (Finsupp.single (y, x) (1 : ℤ)) : US (S : Set O)) =
        QuotientAddGroup.mk (zz x) - QuotientAddGroup.mk (zz y))
    {M : Type*} [AddCommGroup M] {w : O → O → M} (hw : IsAddWeight (S : Set O) w)
    {y x : O} (hy : y ∈ supp s S) (hx : x ∈ supp s S) (hyx : SLe s y x) :
    w y x = ev w (zz x) - ev w (zz y) := by
  have h := congrArg (liftW hw) (hzzU y hy x hx hyx)
  rw [map_sub, liftW_mk, liftW_mk, liftW_mk, ev_nw _ (hzz₁ x), ev_nw _ (hzz₁ y)] at h
  rw [← h]
  simp only [ev_single, one_smul, nw, lineSet, Set.mem_setOf_eq]
  rw [if_pos ⟨mem_S_of_supp hy, mem_S_of_supp hx, line_of_sle hy hyx⟩]

/-- **Roots of the components** of the support poset. -/
theorem exists_root : ∃ root : O → O, (∀ y ∈ supp s S, root y ∈ supp s S) ∧
    (∀ y ∈ supp s S, ∀ x ∈ supp s S, SLe s y x → root y = root x) ∧
    (∀ y ∈ supp s S, root (root y) = root y) ∧
    (∀ y ∈ supp s S, Relation.EqvGen (fun a b ↦ a ∈ supp s S ∧ b ∈ supp s S ∧ SLe s a b)
      y (root y)) := by
  set P := supp s S
  let r : SupP s P (fvec s) → SupP s P (fvec s) → Prop := fun a b ↦ SLe s a.1 b.1
  let st : Setoid (SupP s P (fvec s)) := Relation.EqvGen.setoid r
  let root : O → O := fun y ↦
    if h : y ∈ P then (Quotient.mk st (show SupP s P (fvec s) from ⟨y, h⟩)).out.1 else y
  have hroot : ∀ y (h : y ∈ P),
      root y = (Quotient.mk st (show SupP s P (fvec s) from ⟨y, h⟩)).out.1 := fun y h ↦ dif_pos h
  have hmemr : ∀ y ∈ P, root y ∈ P := fun y h ↦ by
    rw [hroot y h]; exact (Quotient.mk st (show SupP s P (fvec s) from ⟨y, h⟩)).out.2
  have hrel : ∀ y (h : y ∈ P), st.r (show SupP s P (fvec s) from ⟨root y, hmemr y h⟩)
      (show SupP s P (fvec s) from ⟨y, h⟩) := fun y h ↦ by
    have : (show SupP s P (fvec s) from ⟨root y, hmemr y h⟩) =
        (Quotient.mk st (show SupP s P (fvec s) from ⟨y, h⟩)).out := Subtype.ext (hroot y h)
    rw [this]
    exact Quotient.exact (Quotient.out_eq _)
  have hmap : ∀ {a b : SupP s P (fvec s)}, Relation.EqvGen r a b →
      Relation.EqvGen (fun a b ↦ a ∈ P ∧ b ∈ P ∧ SLe s a b) a.1 b.1 := by
    intro a b h
    induction h with
    | rel a b h => exact Relation.EqvGen.rel _ _ ⟨a.2, b.2, h⟩
    | refl a => exact Relation.EqvGen.refl _
    | symm a b _ ih => exact Relation.EqvGen.symm _ _ ih
    | trans a b c _ _ ih ih' => exact Relation.EqvGen.trans _ _ _ ih ih'
  refine ⟨root, hmemr, fun y hy x hx hyx ↦ ?_, fun y hy ↦ ?_, fun y hy ↦ ?_⟩
  · rw [hroot y hy, hroot x hx,
      Quotient.sound (s := st) (show st.r (show SupP s P (fvec s) from ⟨y, hy⟩)
        (show SupP s P (fvec s) from ⟨x, hx⟩) from Relation.EqvGen.rel _ _ hyx)]
  · calc root (root y)
        = (Quotient.mk st (show SupP s P (fvec s) from ⟨root y, hmemr y hy⟩)).out.1 :=
          hroot _ _
      _ = (Quotient.mk st (show SupP s P (fvec s) from ⟨y, hy⟩)).out.1 := by
          rw [Quotient.sound (hrel y hy)]
      _ = root y := (hroot y hy).symm
  · exact Relation.EqvGen.symm _ _ (hmap (hrel y hy))

variable {zz : O → (O × O →₀ ℤ)} {root : O → O}

/-- The weight on `S ∪ {s}` extending `w₀` with constants `a` on the components. -/
def extW {M : Type*} [AddCommGroup M] (s : O) (S : Finset O) (zz : O → (O × O →₀ ℤ))
    (root : O → O) (w₀ : O → O → M) (a : O → M) : O → O → M := fun o o' ↦
  if o = s then (if o' ∈ supp s S then a (root o') + ev w₀ (zz o') else 0) else w₀ o o'

variable (hsS : s ∉ S) (hsrc : ∀ o ∈ S, ∀ f : o ⟶ s, f = 0)
  (hzz₁ : ∀ y, Supp (S : Set O) (zz y))
  (hzz₂ : ∀ y ∈ supp s S, ∀ x ∈ supp s S, SLe s y x →
      (QuotientAddGroup.mk (Finsupp.single (y, x) (1 : ℤ)) : US (S : Set O)) =
        QuotientAddGroup.mk (zz x) - QuotientAddGroup.mk (zz y))
  (hr₁ : ∀ y ∈ supp s S, root y ∈ supp s S)
  (hr₂ : ∀ y ∈ supp s S, ∀ x ∈ supp s S, SLe s y x → root y = root x)
  (hr₃ : ∀ y ∈ supp s S, root (root y) = root y)
  (hr₄ : ∀ y ∈ supp s S, Relation.EqvGen (fun a b ↦ a ∈ supp s S ∧ b ∈ supp s S ∧ SLe s a b)
      y (root y))

include hsS in
theorem ev_extW {M : Type*} [AddCommGroup M] (w₀ : O → O → M) (a : O → M) {v : O × O →₀ ℤ}
    (hv : Supp (S : Set O) v) : ev (extW s S zz root w₀ a) v = ev w₀ v :=
  ev_congr fun p hp ↦ by
    have h1 := (hv p hp).1
    have : p.1 ≠ s := fun h ↦ hsS (h ▸ h1)
    simp only [extW, if_neg this]

include hT hsS hsrc hzz₁ hzz₂ hr₂ in
theorem extW_isAddWeight {M : Type*} [AddCommGroup M] {w₀ : O → O → M}
    (hw₀ : IsAddWeight (S : Set O) w₀) (a : O → M) :
    IsAddWeight (insert s (S : Set O)) (extW s S zz root w₀ a) := by
  refine ⟨fun o ho o' ho' o'' ho'' f g hfg ↦ ?_⟩
  have hf : f ≠ 0 := fun h ↦ hfg (by rw [h, Limits.zero_comp])
  have hg : g ≠ 0 := fun h ↦ hfg (by rw [h, Limits.comp_zero])
  have hsP : s ∉ supp s S := fun h ↦ hsS (mem_S_of_supp h)
  by_cases h1 : o = s
  · subst o
    by_cases h2 : o' = s
    · subst o'
      simp only [extW, if_true, if_neg hsP, zero_add]
    · have ho'S : o' ∈ S := (Set.mem_insert_iff.1 ho').resolve_left h2
      by_cases h3 : o'' = s
      · subst o''
        exact absurd (hsrc _ ho'S g) hg
      · have ho''S : o'' ∈ S := (Set.mem_insert_iff.1 ho'').resolve_left h3
        have hp1 : o' ∈ supp s S := Finset.mem_filter.2 ⟨ho'S, f, hf⟩
        have hp2 : o'' ∈ supp s S := Finset.mem_filter.2 ⟨ho''S, f ≫ g, hfg⟩
        have hle : SLe s o' o'' := by
          right
          refine ⟨g, fun h0 ↦ hfg ?_⟩
          obtain ⟨c, hc⟩ := exists_smul hT (fvec_ne s S hp1) f
          rw [hc, Linear.smul_comp, h0, smul_zero]
        simp only [extW, if_true, if_neg h2, if_pos hp1, if_pos hp2]
        rw [hr₂ o' hp1 o'' hp2 hle, zz_eval hzz₁ hzz₂ hw₀ hp1 hp2 hle]
        abel
  · have hoS : o ∈ S := (Set.mem_insert_iff.1 ho).resolve_left h1
    by_cases h2 : o' = s
    · subst o'
      exact absurd (hsrc _ hoS f) hf
    · have ho'S : o' ∈ S := (Set.mem_insert_iff.1 ho').resolve_left h2
      by_cases h3 : o'' = s
      · subst o''
        exact absurd (hsrc _ ho'S g) hg
      · have ho''S : o'' ∈ S := (Set.mem_insert_iff.1 ho'').resolve_left h3
        simp only [extW, if_neg h1, if_neg h2]
        exact hw₀.mul o hoS o' ho'S o'' ho''S f g hfg

include hT hsS hsrc hzz₁ hzz₂ hr₄ in
/-- **The universal solutions** `[sy] = c_D + u_y`: decomposition of a combination
of lines of `S ∪ {s}`. -/
theorem ev_insert_source {M : Type*} [AddCommGroup M] {w : O → O → M}
    (hw : IsAddWeight (insert s (S : Set O)) w) {u : O × O →₀ ℤ}
    (hu : Supp (insert s (S : Set O)) u) :
    ev w u = ev w (toLines S u + ∑ y ∈ supp s S, u (s, y) • zz y) +
      ∑ r ∈ (supp s S).image root, (∑ y ∈ supp s S with root y = r, u (s, y)) •
        (w s r - ev w (zz r)) := by
  have hwS : IsAddWeight (S : Set O) w := hw.mono (Set.subset_insert _ _)
  -- the decomposition of `u`
  have hdec : u = toLines S u + Finsupp.single (s, s) (u (s, s)) +
      ∑ y ∈ supp s S, Finsupp.single (s, y) (u (s, y)) := by
    ext ⟨a, b⟩
    simp only [Finsupp.add_apply, Finsupp.finsetSum_apply, toLines, Finsupp.filter_apply,
      Finsupp.single_apply, Prod.mk.injEq]
    by_cases hp : (a, b) ∈ lineSet (S : Set O)
    · have h1 : s ≠ a := fun h ↦ hsS (h ▸ hp.1)
      simp [hp, h1]
    rw [if_neg hp, zero_add]
    by_cases ha : a = s
    · subst a
      by_cases hb : b = s
      · subst b
        simp only [and_self, if_true]
        rw [Finset.sum_eq_zero, add_zero]
        intro y hy
        split_ifs with h
        · exfalso
          apply hsS
          have : y = s := by simp_all
          exact this ▸ mem_S_of_supp hy
        · rfl
      · simp only [true_and, if_neg (Ne.symm hb), zero_add]
        by_cases hbP : b ∈ supp s S
        · rw [Finset.sum_eq_single b (fun y _ hy ↦ by simp [hy]) (fun h ↦ absurd hbP h)]
          simp
        · rw [Finset.sum_eq_zero fun y hy ↦ by
            split_ifs with h
            · exact absurd (h ▸ hy) hbP
            · rfl]
          by_contra hne
          obtain ⟨h1, h2, hl⟩ := hu (s, b) (Finsupp.mem_support_iff.2 hne)
          rcases h2 with h2 | h2
          · exact hb h2
          · exact hbP (Finset.mem_filter.2 ⟨h2, hl⟩)
    · simp only [Ne.symm ha, false_and, if_false, Finset.sum_const_zero, add_zero]
      by_contra hne
      obtain ⟨h1, h2, hl⟩ := hu (a, b) (Finsupp.mem_support_iff.2 hne)
      have h1' : a ∈ S := (Set.mem_insert_iff.1 h1).resolve_left ha
      rcases h2 with h2 | h2
      · obtain ⟨f, hf⟩ := hl
        simp only at h2 f hf
        subst b
        exact hf (hsrc a h1' f)
      · exact hp ⟨h1', h2, hl⟩
  -- the constants are constant on components
  have hconst : ∀ y ∈ supp s S, w s y - ev w (zz y) = w s (root y) - ev w (zz (root y)) := by
    intro y hy
    have key : ∀ a b, Relation.EqvGen (fun a b ↦ a ∈ supp s S ∧ b ∈ supp s S ∧ SLe s a b) a b →
        w s a - ev w (zz a) = w s b - ev w (zz b) := by
      intro a b h
      induction h with
      | rel a b h =>
        obtain ⟨ha, hb, hab⟩ := h
        have hwab := zz_eval hzz₁ hzz₂ hwS ha hb hab
        rcases hab with rfl | ⟨g, hg⟩
        · rfl
        · rw [hw.mul s (Set.mem_insert _ _) a (Set.mem_insert_of_mem _ (mem_S_of_supp ha)) b
            (Set.mem_insert_of_mem _ (mem_S_of_supp hb)) (fvec s a) g hg, hwab]
          abel
      | refl a => rfl
      | symm a b _ ih => exact ih.symm
      | trans a b c _ _ ih ih' => exact ih.trans ih'
    exact key y (root y) (hr₄ y hy)
  have hss : u (s, s) • w s s = 0 := by
    by_cases hl : Line s s
    · have h1 : 𝟙 s ≠ 0 := by
        obtain ⟨f, hf⟩ := hl
        intro h
        obtain ⟨c, hc⟩ := hT.endo s f
        exact hf (by rw [hc, h, smul_zero])
      rw [hw.self (Set.mem_insert _ _) h1, smul_zero]
    · have : u (s, s) = 0 := by
        by_contra h
        exact hl (hu (s, s) (Finsupp.mem_support_iff.2 h)).2.2
      rw [this, zero_smul]
  conv_lhs => rw [hdec]
  rw [ev_add, ev_add, ev_single, hss, add_zero, ev_sum, ev_add, ev_sum, add_assoc]
  congr 1
  simp only [ev_single, ev_smul]
  have h1 : ∀ y ∈ supp s S, u (s, y) • w s y =
      u (s, y) • ev w (zz y) + u (s, y) • (w s (root y) - ev w (zz (root y))) := fun y hy ↦ by
    rw [← hconst y hy, ← smul_add]; congr 1; abel
  rw [Finset.sum_congr rfl h1, Finset.sum_add_distrib]
  congr 1
  rw [← Finset.sum_fiberwise_of_maps_to (g := root) (t := (supp s S).image root)
    (fun y hy ↦ Finset.mem_image_of_mem root hy)]
  refine Finset.sum_congr rfl fun r _ ↦ ?_
  rw [Finset.sum_smul]
  refine Finset.sum_congr rfl fun y hy ↦ ?_
  rw [(Finset.mem_filter.1 hy).2]

end Source

section SourceStep

theorem ev_zero_weight {M : Type*} [AddCommGroup M] (u : O × O →₀ ℤ) :
    ev (0 : O → O → M) u = 0 := by simp [ev]

theorem Supp.add {S : Set O} {u u' : O × O →₀ ℤ} (hu : Supp S u) (hu' : Supp S u') :
    Supp S (u + u') := fun p hp ↦ by
  classical
  rcases Finset.mem_union.1 (Finsupp.support_add hp) with h | h
  · exact hu p h
  · exact hu' p h

theorem Supp.smul {S : Set O} {u : O × O →₀ ℤ} (hu : Supp S u) (n : ℤ) : Supp S (n • u) :=
  fun p hp ↦ hu p (Finsupp.support_smul hp)

theorem Supp.sum {S : Set O} {ι : Type*} (t : Finset ι) {u : ι → O × O →₀ ℤ}
    (hu : ∀ i ∈ t, Supp S (u i)) : Supp S (∑ i ∈ t, u i) := by
  classical
  induction t using Finset.induction_on with
  | empty => intro p hp; simp at hp
  | insert a t ha ih =>
    rw [Finset.sum_insert ha]
    exact (hu a (Finset.mem_insert_self _ _)).add (ih fun i hi ↦ hu i (Finset.mem_insert_of_mem hi))

variable (hT : IsThin k O)

include hT in
/-- **Separation passes to the extension by a source** (`U(T) ≅ U(T') ⊕ ℤ^{π₀(R)}`). -/
theorem sep_insert_source [Infinite k] {s : O} {S : Finset O} (hsS : s ∉ S)
    (hsrc : ∀ o ∈ S, ∀ f : o ⟶ s, f = 0)
    (hrep : SupRepFinite hT (s := s) (P := supp s S) (fv := fvec s) (fun y hy ↦ fvec_ne s S hy))
    (hS : Sep.{u, v, w, z} k (S : Set O)) : Sep.{u, v, w, z} k (insert s (S : Set O)) := by
  classical
  obtain ⟨zz, hzz₁, hzz₂⟩ := exists_zz hT hrep
  obtain ⟨root, hr₁, hr₂, hr₃, hr₄⟩ := exists_root (s := s) (S := S)
  intro u hu hK M _ w hw
  set u' := toLines S u + ∑ y ∈ supp s S, u (s, y) • zz y with hu'def
  have hu' : Supp (S : Set O) u' :=
    (supp_toLines _ _).add (Supp.sum _ fun y _ ↦ (hzz₁ y).smul _)
  have hroot : ∀ r ∈ (supp s S).image root, root r = r := by
    intro r hr
    obtain ⟨y, hy, rfl⟩ := Finset.mem_image.1 hr
    exact hr₃ y hy
  have hc : ∀ (w₀ : O → O → Additive kˣ) (a : O → Additive kˣ),
      ∀ r ∈ (supp s S).image root, extW s S zz root w₀ a s r - ev (extW s S zz root w₀ a) (zz r) =
        a r := by
    intro w₀ a r hr
    obtain ⟨y, hy, rfl⟩ := Finset.mem_image.1 hr
    have hrP := hr₁ y hy
    simp only [extW, if_true, if_pos hrP, ev_extW hsS w₀ a (hzz₁ _), hr₃ y hy]
    abel
  -- the coefficients of the free constants vanish
  have hm : ∀ r ∈ (supp s S).image root, (∑ y ∈ supp s S with root y = r, u (s, y)) = 0 := by
    intro r hr
    by_contra hne
    obtain ⟨t, ht⟩ := exists_zpow_ne_one (k := k) hne
    let a : O → Additive kˣ := fun y ↦ if y = r then Additive.ofMul t else 0
    have hw0 : IsAddWeight (S : Set O) (0 : O → O → Additive kˣ) :=
      ⟨fun _ _ _ _ _ _ _ _ _ ↦ by simp⟩
    have hwa := extW_isAddWeight hT hsS hsrc hzz₁ hzz₂ hr₂ hw0 a
    have h := hK _ hwa
    rw [ev_insert_source hT hsS hsrc hzz₁ hzz₂ hr₄ hwa hu, ev_extW hsS _ _ hu',
      ev_zero_weight, zero_add, Finset.sum_congr rfl (fun r' hr' ↦ by rw [hc 0 a r' hr']),
      Finset.sum_eq_single r (fun r' _ hr' ↦ by simp only [a, if_neg hr', smul_zero])
        (fun h ↦ absurd hr h)] at h
    simp only [a, if_true] at h
    apply ht
    rw [← ofMul_zpow] at h
    exact Additive.ofMul.injective (h.trans ofMul_one.symm)
  have hK' : KillsK k (S : Set O) u' := by
    intro w₀ hw₀
    have hwe := extW_isAddWeight hT hsS hsrc hzz₁ hzz₂ hr₂ hw₀ 0
    have h := hK _ hwe
    rw [ev_insert_source hT hsS hsrc hzz₁ hzz₂ hr₄ hwe hu, ev_extW hsS _ _ hu',
      Finset.sum_eq_zero (fun r hr ↦ by rw [hm r hr, zero_smul]), add_zero] at h
    exact h
  have h0 := hS u' hu' hK' M w (hw.mono (Set.subset_insert _ _))
  rw [ev_insert_source hT hsS hsrc hzz₁ hzz₂ hr₄ hw hu, h0, zero_add]
  exact Finset.sum_eq_zero fun r hr ↦ by rw [hm r hr, zero_smul]

end SourceStep


/-! ### Opposites and the sink step -/

section Op

attribute [local instance] opLinear

/-- The reversed combination of lines in `Oᵒᵖ`. -/
def uop (u : O × O →₀ ℤ) : Oᵒᵖ × Oᵒᵖ →₀ ℤ := Finsupp.mapDomain (fun p ↦ (op p.2, op p.1)) u

/-- The reversed weight. -/
def wop {M : Type*} (w : O → O → M) : Oᵒᵖ → Oᵒᵖ → M := fun X Y ↦ w (unop Y) (unop X)

/-- The weight on `O` of a weight on `Oᵒᵖ`. -/
def wunop {M : Type*} (W : Oᵒᵖ → Oᵒᵖ → M) : O → O → M := fun o o' ↦ W (op o') (op o)

theorem wop_wunop {M : Type*} (W : Oᵒᵖ → Oᵒᵖ → M) : wop (wunop W) = W := rfl

theorem ev_uop {M : Type*} [AddCommGroup M] (w : O → O → M) (u : O × O →₀ ℤ) :
    ev (wop w) (uop u) = ev w u := by
  unfold ev uop
  rw [Finsupp.sum_mapDomain_index]
  · rfl
  · intro p; exact zero_smul ℤ _
  · intro p a b; exact add_smul _ _ _

theorem line_op_iff {X Y : Oᵒᵖ} : Line X Y ↔ Line (unop Y) (unop X) := by
  constructor
  · rintro ⟨f, hf⟩
    exact ⟨f.unop, fun h ↦ hf (Quiver.Hom.unop_inj (by rw [h]; rfl))⟩
  · rintro ⟨f, hf⟩
    exact ⟨f.op, fun h ↦ hf (Quiver.Hom.op_inj (by rw [h]; rfl))⟩

theorem isAddWeight_wop {M : Type*} [AddCommGroup M] {S : Set O} {w : O → O → M}
    (hw : IsAddWeight S w) : IsAddWeight (unop ⁻¹' S) (wop w) := by
  refine ⟨fun X hX Y hY Z hZ f g hfg ↦ ?_⟩
  have : g.unop ≫ f.unop ≠ 0 := fun h ↦ hfg (Quiver.Hom.unop_inj (by rw [unop_comp, h]; rfl))
  simp only [wop]
  rw [hw.mul _ hZ _ hY _ hX g.unop f.unop this, add_comm]

theorem isAddWeight_wunop {M : Type*} [AddCommGroup M] {S : Set O} {W : Oᵒᵖ → Oᵒᵖ → M}
    (hW : IsAddWeight (unop ⁻¹' S) W) : IsAddWeight S (wunop W) := by
  refine ⟨fun o ho o' ho' o'' ho'' f g hfg ↦ ?_⟩
  have : g.op ≫ f.op ≠ 0 := fun h ↦ hfg (Quiver.Hom.op_inj (by rw [op_comp, h]; rfl))
  simp only [wunop]
  rw [hW.mul (op o'') ho'' (op o') ho' (op o) ho g.op f.op this, add_comm]

theorem supp_uop {S : Set O} {u : O × O →₀ ℤ} (hu : Supp S u) : Supp (unop ⁻¹' S) (uop u) := by
  classical
  intro P hP
  obtain ⟨p, hp, rfl⟩ := Finset.mem_image.1 (Finsupp.mapDomain_support hP)
  obtain ⟨h1, h2, hl⟩ := hu p hp
  exact ⟨h2, h1, line_op_iff.2 hl⟩

theorem sep_of_sep_op {S : Set O} (h : Sep.{u, v, w, z} k (unop ⁻¹' S : Set Oᵒᵖ)) :
    Sep.{u, v, w, z} k S := by
  intro u hu hK M _ w hw
  rw [← ev_uop]
  refine h (uop u) (supp_uop hu) (fun W hW ↦ ?_) M (wop w) (isAddWeight_wop hw)
  rw [← wop_wunop W, ev_uop]
  exact hK _ (isAddWeight_wunop hW)

/-- The reversed combination of lines of `O` from `Oᵒᵖ`. -/
def uunop (U : Oᵒᵖ × Oᵒᵖ →₀ ℤ) : O × O →₀ ℤ := Finsupp.mapDomain (fun P ↦ (unop P.2, unop P.1)) U

theorem ev_uunop {M : Type*} [AddCommGroup M] (W : Oᵒᵖ → Oᵒᵖ → M) (U : Oᵒᵖ × Oᵒᵖ →₀ ℤ) :
    ev (wunop W) (uunop U) = ev W U := by
  unfold ev uunop
  rw [Finsupp.sum_mapDomain_index]
  · rfl
  · intro p; exact zero_smul ℤ _
  · intro p a b; exact add_smul _ _ _

theorem supp_uunop {S : Set O} {U : Oᵒᵖ × Oᵒᵖ →₀ ℤ} (hU : Supp (unop ⁻¹' S) U) :
    Supp S (uunop U) := by
  classical
  intro p hp
  obtain ⟨P, hP, rfl⟩ := Finset.mem_image.1 (Finsupp.mapDomain_support hp)
  obtain ⟨h1, h2, hl⟩ := hU P hP
  exact ⟨h2, h1, line_op_iff.1 hl⟩

theorem sep_op_of_sep {S : Set O} (h : Sep.{u, v, w, z} k S) :
    Sep.{u, v, w, z} k (unop ⁻¹' S : Set Oᵒᵖ) := by
  intro U hU hK M _ W hW
  rw [← ev_uunop]
  refine h (uunop U) (supp_uunop hU) (fun w hw ↦ ?_) M (wunop W) (isAddWeight_wunop hW)
  have : wunop (wop w) = w := rfl
  rw [← this, ev_uunop]
  exact hK _ (isAddWeight_wop hw)

variable (hT : IsThin k O)

include hT in
/-- **Separation passes to the extension by a sink**, by opposites. -/
theorem sep_insert_sink [Infinite k] {t : O} {S : Finset O} (htS : t ∉ S)
    (hsnk : ∀ o ∈ S, ∀ f : t ⟶ o, f = 0)
    (hrep : SupRepFinite (isThin_op hT) (s := op t) (P := supp (op t) (S.map opEmb))
      (fv := fvec (op t)) (fun y hy ↦ fvec_ne (op t) (S.map opEmb) hy))
    (hS : Sep.{u, v, w, z} k (S : Set O)) : Sep.{u, v, w, z} k (insert t (S : Set O)) := by
  apply sep_of_sep_op
  have htS' : op t ∉ S.map opEmb := by
    intro h; rw [Finset.mem_map] at h
    obtain ⟨o, ho, ho'⟩ := h
    exact htS (op_injective ho' ▸ ho)
  have hsrc : ∀ X ∈ S.map opEmb, ∀ f : X ⟶ op t, f = 0 := by
    intro X hX f
    rw [Finset.mem_map] at hX
    obtain ⟨o, ho, rfl⟩ := hX
    exact Quiver.Hom.unop_inj (hsnk o ho f.unop)
  have hS' : Sep.{u, v, w, z} k ((S.map opEmb : Finset Oᵒᵖ) : Set Oᵒᵖ) := by
    rw [coe_map_op]; exact sep_op_of_sep hS
  have := sep_insert_source (isThin_op hT) htS' hsrc hrep hS'
  have hset : (insert (op t) ((S.map opEmb : Finset Oᵒᵖ) : Set Oᵒᵖ)) =
      unop ⁻¹' (insert t (S : Set O)) := by
    rw [coe_map_op]; ext X; simp [Set.mem_insert_iff, unop_eq_iff_eq_op]
  rwa [hset] at this

end Op

/-! ### Extension of weights over one step -/

section ExtStep

variable (hT : IsThin k O)

include hT in
theorem ext_insert_source [Infinite k] {s : O} {S : Finset O} (hsS : s ∉ S)
    (hsrc : ∀ o ∈ S, ∀ f : o ⟶ s, f = 0)
    (hrep : SupRepFinite hT (s := s) (P := supp s S) (fv := fvec s) (fun y hy ↦ fvec_ne s S hy))
    {M : Type*} [AddCommGroup M] {w₀ : O → O → M} (hw₀ : IsAddWeight (S : Set O) w₀) :
    ∃ w : O → O → M, IsAddWeight (insert s (S : Set O)) w ∧
      ∀ o ∈ S, ∀ o' ∈ S, w o o' = w₀ o o' := by
  obtain ⟨zz, hzz₁, hzz₂⟩ := exists_zz hT hrep
  obtain ⟨root, -, hr₂, -, -⟩ := exists_root (s := s) (S := S)
  refine ⟨extW s S zz root w₀ 0, extW_isAddWeight hT hsS hsrc hzz₁ hzz₂ hr₂ hw₀ 0,
    fun o ho o' _ ↦ ?_⟩
  have : o ≠ s := fun h ↦ hsS (h ▸ ho)
  simp only [extW, if_neg this]

attribute [local instance] opLinear in
include hT in
theorem ext_insert_sink [Infinite k] {t : O} {S : Finset O} (htS : t ∉ S)
    (hsnk : ∀ o ∈ S, ∀ f : t ⟶ o, f = 0)
    (hrep : SupRepFinite (isThin_op hT) (s := op t) (P := supp (op t) (S.map opEmb))
      (fv := fvec (op t)) (fun y hy ↦ fvec_ne (op t) (S.map opEmb) hy))
    {M : Type*} [AddCommGroup M] {w₀ : O → O → M} (hw₀ : IsAddWeight (S : Set O) w₀) :
    ∃ w : O → O → M, IsAddWeight (insert t (S : Set O)) w ∧
      ∀ o ∈ S, ∀ o' ∈ S, w o o' = w₀ o o' := by
  have htS' : op t ∉ S.map opEmb := by
    intro h; rw [Finset.mem_map] at h
    obtain ⟨o, ho, ho'⟩ := h
    exact htS (op_injective ho' ▸ ho)
  have hsrc : ∀ X ∈ S.map opEmb, ∀ f : X ⟶ op t, f = 0 := by
    intro X hX f
    rw [Finset.mem_map] at hX
    obtain ⟨o, ho, rfl⟩ := hX
    exact Quiver.Hom.unop_inj (hsnk o ho f.unop)
  have hw₀' : IsAddWeight ((S.map opEmb : Finset Oᵒᵖ) : Set Oᵒᵖ) (wop w₀) := by
    rw [coe_map_op]; exact isAddWeight_wop hw₀
  obtain ⟨W, hW, hagree⟩ := ext_insert_source (isThin_op hT) htS' hsrc hrep hw₀'
  have hset : (insert (op t) ((S.map opEmb : Finset Oᵒᵖ) : Set Oᵒᵖ)) =
      unop ⁻¹' (insert t (S : Set O)) := by
    rw [coe_map_op]; ext X; simp [Set.mem_insert_iff, unop_eq_iff_eq_op]
  rw [hset] at hW
  refine ⟨wunop W, isAddWeight_wunop hW, fun o ho o' ho' ↦ ?_⟩
  exact hagree (op o') (Finset.mem_map_of_mem _ ho') (op o) (Finset.mem_map_of_mem _ ho)

end ExtStep

/-! ### Filling and the exhaustion -/

section Fill

attribute [local instance] opLinear

variable [Infinite k] (hT : IsThin k O) (hgt : O → ℤ) (hR : ∀ o o', Rl o o' → hgt o < hgt o')
  (hsrcRep : ∀ (s : O) (S : Finset O), SupRepFinite hT (s := s) (P := supp s S)
    (fv := fvec s) (fun y hy ↦ fvec_ne s S hy))
  (hsnkRep : ∀ (t : O) (S : Finset O), SupRepFinite (isThin_op hT) (s := op t)
    (P := supp (op t) (S.map opEmb)) (fv := fvec (op t)) (fun y hy ↦ fvec_ne (op t) (S.map opEmb) hy))

include hR hsrcRep hsnkRep in
/-- Filling a convex set: separation and extension of weights. -/
theorem fill_sep [DecidableEq O] : ∀ (n : ℕ) (T T' : Finset O), (T' \ T).card = n → T ⊆ T' →
    Convex (T : Set O) → Convex (T' : Set O) →
      (Sep.{u, v, w, z} k (T : Set O) → Sep.{u, v, w, z} k (T' : Set O)) ∧
      ∀ (M : Type z₂) [AddCommGroup M] (w₀ : O → O → M), IsAddWeight (T : Set O) w₀ →
        ∃ w : O → O → M, IsAddWeight (T' : Set O) w ∧ ∀ o ∈ T, ∀ o' ∈ T, w o o' = w₀ o o' := by
  intro n
  induction n with
  | zero =>
      intro T T' hcard hTT' _ _
      have : T = T' := Finset.Subset.antisymm hTT' (Finset.sdiff_eq_empty_iff_subset.1
        (Finset.card_eq_zero.1 hcard))
      subst this
      exact ⟨id, fun M _ w₀ hw₀ ↦ ⟨w₀, hw₀, fun _ _ _ _ ↦ rfl⟩⟩
  | succ n ih =>
      intro T T' hcard hTT' hT1 hT2
      have hne : T ≠ T' := by rintro rfl; simp at hcard
      obtain ⟨c, hcT', hcT, hconv, hsrc | hsnk⟩ := step_obj hgt hR T T' hTT' hne hT1 hT2
      all_goals
        have hcard' : (T' \ insert c T).card = n := by
          rw [Finset.sdiff_insert, Finset.card_erase_of_mem (Finset.mem_sdiff.2 ⟨hcT', hcT⟩),
            hcard]
          simp
        obtain ⟨ih1, ih2⟩ := ih (insert c T) T' hcard' (Finset.insert_subset hcT' hTT')
          (by rw [Finset.coe_insert]; exact hconv) hT2
      · refine ⟨fun h ↦ ih1 ?_, fun M _ w₀ hw₀ ↦ ?_⟩
        · rw [Finset.coe_insert]
          exact sep_insert_source hT hcT hsrc (hsrcRep c T) h
        obtain ⟨w₁, hw₁, hag₁⟩ := ext_insert_source hT hcT hsrc (hsrcRep c T) hw₀
        obtain ⟨w, hw, hag⟩ := ih2 M w₁ (by rw [Finset.coe_insert]; exact hw₁)
        exact ⟨w, hw, fun o ho o' ho' ↦ by
          rw [hag o (Finset.mem_insert_of_mem ho) o' (Finset.mem_insert_of_mem ho'),
            hag₁ o ho o' ho']⟩
      · refine ⟨fun h ↦ ih1 ?_, fun M _ w₀ hw₀ ↦ ?_⟩
        · rw [Finset.coe_insert]
          exact sep_insert_sink hT hcT hsnk (hsnkRep c T) h
        obtain ⟨w₁, hw₁, hag₁⟩ := ext_insert_sink hT hcT hsnk (hsnkRep c T) hw₀
        obtain ⟨w, hw, hag⟩ := ih2 M w₁ (by rw [Finset.coe_insert]; exact hw₁)
        exact ⟨w, hw, fun o ho o' ho' ↦ by
          rw [hag o (Finset.mem_insert_of_mem ho) o' (Finset.mem_insert_of_mem ho'),
            hag₁ o ho o' ho']⟩

variable (hsucc : ∀ o : O, {o' | Rl o o'}.Finite) (e : ℕ → O)

include hsrcRep hsnkRep in
theorem sep_exT [DecidableEq O] (n : ℕ) : Sep.{u, v, w, z} k (exT hgt hR hsucc e n : Set O) := by
  induction n with
  | zero =>
    exact (fill_sep.{u, v, w, z, z} hT hgt hR hsrcRep hsnkRep _ ∅ _ rfl (Finset.empty_subset _)
      (by intro a ha; simp at ha) (exT_convex hgt hR hsucc e 0)).1 (by simpa using sep_empty)
  | succ n ih =>
    exact (fill_sep.{u, v, w, z, z} hT hgt hR hsrcRep hsnkRep _ _ _ rfl (exT_mono hgt hR hsucc e n)
      (exT_convex hgt hR hsucc e n) (exT_convex hgt hR hsucc e (n + 1))).1 ih

/-- The sequence of extensions of a weight along the exhaustion. -/
def extSeq [DecidableEq O] (n : ℕ) (M : Type z₂) [AddCommGroup M] (w₀ : O → O → M)
    (hw₀ : IsAddWeight (exT hgt hR hsucc e n : Set O) w₀) :
    (j : ℕ) → {w' : O → O → M // IsAddWeight (exT hgt hR hsucc e (n + j) : Set O) w'}
  | 0 => ⟨w₀, hw₀⟩
  | j + 1 => ⟨Classical.choose ((fill_sep.{u, v, w, z₂, z₂} hT hgt hR hsrcRep hsnkRep _ _ _ rfl
      (exT_mono hgt hR hsucc e (n + j)) (exT_convex hgt hR hsucc e (n + j))
      (exT_convex hgt hR hsucc e (n + j + 1))).2 M (extSeq n M w₀ hw₀ j).1
      (extSeq n M w₀ hw₀ j).2),
    (Classical.choose_spec ((fill_sep.{u, v, w, z₂, z₂} hT hgt hR hsrcRep hsnkRep _ _ _ rfl
      (exT_mono hgt hR hsucc e (n + j)) (exT_convex hgt hR hsucc e (n + j))
      (exT_convex hgt hR hsucc e (n + j + 1))).2 M (extSeq n M w₀ hw₀ j).1
      (extSeq n M w₀ hw₀ j).2)).1⟩

theorem extSeq_succ [DecidableEq O] (n : ℕ) (M : Type z₂) [AddCommGroup M] (w₀ : O → O → M)
    (hw₀ : IsAddWeight (exT hgt hR hsucc e n : Set O) w₀) (j : ℕ) :
    ∀ o ∈ exT hgt hR hsucc e (n + j), ∀ o' ∈ exT hgt hR hsucc e (n + j),
      (extSeq hT hgt hR hsrcRep hsnkRep hsucc e n M w₀ hw₀ (j + 1)).1 o o' =
        (extSeq hT hgt hR hsrcRep hsnkRep hsucc e n M w₀ hw₀ j).1 o o' :=
  (Classical.choose_spec ((fill_sep.{u, v, w, z₂, z₂} hT hgt hR hsrcRep hsnkRep _ _ _ rfl
      (exT_mono hgt hR hsucc e (n + j)) (exT_convex hgt hR hsucc e (n + j))
      (exT_convex hgt hR hsucc e (n + j + 1))).2 M
      (extSeq hT hgt hR hsrcRep hsnkRep hsucc e n M w₀ hw₀ j).1
      (extSeq hT hgt hR hsrcRep hsnkRep hsucc e n M w₀ hw₀ j).2)).2

theorem extSeq_agree [DecidableEq O] (n : ℕ) (M : Type z₂) [AddCommGroup M] (w₀ : O → O → M)
    (hw₀ : IsAddWeight (exT hgt hR hsucc e n : Set O) w₀) {i j : ℕ} (hij : i ≤ j) :
    ∀ o ∈ exT hgt hR hsucc e (n + i), ∀ o' ∈ exT hgt hR hsucc e (n + i),
      (extSeq hT hgt hR hsrcRep hsnkRep hsucc e n M w₀ hw₀ j).1 o o' =
        (extSeq hT hgt hR hsrcRep hsnkRep hsucc e n M w₀ hw₀ i).1 o o' := by
  induction hij with
  | refl => exact fun _ _ _ _ ↦ rfl
  | @step m hij ih =>
    intro o ho o' ho'
    have hmono := exT_mono' hgt hR hsucc e (Nat.add_le_add_left hij n)
    rw [extSeq_succ hT hgt hR hsrcRep hsnkRep hsucc e n M w₀ hw₀ _ o (hmono ho) o' (hmono ho'),
      ih o ho o' ho']

include hsrcRep hsnkRep in
/-- **Weights on a stage of the exhaustion extend to all objects.** -/
theorem exists_ext_univ [DecidableEq O] (he : Function.Surjective e) (n : ℕ) (M : Type z₂)
    [AddCommGroup M] (w₀ : O → O → M) (hw₀ : IsAddWeight (exT hgt hR hsucc e n : Set O) w₀) :
    ∃ w' : O → O → M, IsAddWeight Set.univ w' ∧
      ∀ o ∈ exT hgt hR hsucc e n, ∀ o' ∈ exT hgt hR hsucc e n, w' o o' = w₀ o o' := by
  let idx : O → ℕ := fun o ↦ Classical.choose (he o)
  have hidx : ∀ o, e (idx o) = o := fun o ↦ Classical.choose_spec (he o)
  have hmem : ∀ o j, idx o ≤ j → o ∈ exT hgt hR hsucc e (n + j) := fun o j h ↦ by
    have := exT_mono' hgt hR hsucc e (show idx o ≤ n + j by omega) (mem_exT hgt hR hsucc e (idx o))
    rwa [hidx] at this
  let F := extSeq hT hgt hR hsrcRep hsnkRep hsucc e n M w₀ hw₀
  refine ⟨fun o o' ↦ (F (max (idx o) (idx o'))).1 o o', ⟨fun o _ o' _ o'' _ f g hfg ↦ ?_⟩,
    fun o ho o' ho' ↦ ?_⟩
  · let N := max (idx o) (max (idx o') (idx o''))
    have h1 : (F (max (idx o) (idx o'))).1 o o' = (F N).1 o o' :=
      (extSeq_agree hT hgt hR hsrcRep hsnkRep hsucc e n M w₀ hw₀ (by omega) o
        (hmem o _ (le_max_left _ _)) o' (hmem o' _ (le_max_right _ _))).symm
    have h2 : (F (max (idx o') (idx o''))).1 o' o'' = (F N).1 o' o'' :=
      (extSeq_agree hT hgt hR hsrcRep hsnkRep hsucc e n M w₀ hw₀ (by omega) o'
        (hmem o' _ (le_max_left _ _)) o'' (hmem o'' _ (le_max_right _ _))).symm
    have h3 : (F (max (idx o) (idx o''))).1 o o'' = (F N).1 o o'' :=
      (extSeq_agree hT hgt hR hsrcRep hsnkRep hsucc e n M w₀ hw₀ (by omega) o
        (hmem o _ (le_max_left _ _)) o'' (hmem o'' _ (le_max_right _ _))).symm
    change (F (max (idx o) (idx o''))).1 o o'' =
      (F (max (idx o) (idx o'))).1 o o' + (F (max (idx o') (idx o''))).1 o' o''
    rw [h1, h2, h3]
    exact (F N).2.mul o (hmem o N (by omega)) o' (hmem o' N (by omega)) o''
      (hmem o'' N (by omega)) f g hfg
  · change (F (max (idx o) (idx o'))).1 o o' = w₀ o o'
    rw [extSeq_agree hT hgt hR hsrcRep hsnkRep hsucc e n M w₀ hw₀ (Nat.zero_le _) o
      (by simpa using ho) o' (by simpa using ho')]
    rfl

end Fill

/-! ### Boundaries and the main theorem -/

section Boundary

/-- The boundary `∂[o → o'] = e_{o'} − e_o`. -/
def bd (u : O × O →₀ ℤ) : O →₀ ℤ := u.sum fun p n ↦ Finsupp.single p.2 n - Finsupp.single p.1 n

theorem bd_add (u u' : O × O →₀ ℤ) : bd (u + u') = bd u + bd u' := by
  unfold bd
  rw [Finsupp.sum_add_index'] <;> intros <;> simp only [Finsupp.single_zero, Finsupp.single_add,
    sub_self]; abel

@[simp] theorem bd_single (p : O × O) (n : ℤ) :
    bd (Finsupp.single p n) = Finsupp.single p.2 n - Finsupp.single p.1 n := by
  simp [bd]

theorem bd_zero : bd (0 : O × O →₀ ℤ) = 0 := by simp [bd]

theorem bd_neg (u : O × O →₀ ℤ) : bd (-u) = -bd u := by
  have := bd_add u (-u)
  rw [add_neg_cancel, bd_zero] at this
  exact (neg_eq_of_add_eq_zero_right this.symm).symm

theorem bd_sub (u u' : O × O →₀ ℤ) : bd (u - u') = bd u - bd u' := by
  rw [sub_eq_add_neg, bd_add, bd_neg, ← sub_eq_add_neg]

/-- A weight of object differences evaluates through the boundary. -/
theorem ev_diff {M : Type*} [AddCommGroup M] (ζ : O → M) (u : O × O →₀ ℤ) :
    ev (fun o o' ↦ ζ o' - ζ o) u = (bd u).sum fun o n ↦ n • ζ o := by
  induction u using Finsupp.induction_linear with
  | zero => simp [bd_zero]
  | add u u' h h' =>
    rw [ev_add, bd_add, h, h', Finsupp.sum_add_index']
    · intro; exact zero_smul ℤ _
    · intros; exact add_smul _ _ _
  | single p n =>
    rw [ev_single, bd_single, Finsupp.sum_sub_index (fun _ _ _ ↦ sub_smul _ _ _)]
    rw [Finsupp.sum_single_index (by simp), Finsupp.sum_single_index (by simp), smul_sub]

theorem exists_zigzag {a b : O} (h : Relation.EqvGen (fun o o' : O ↦ Line o o') a b) :
    ∃ u : O × O →₀ ℤ, Supp Set.univ u ∧ bd u = Finsupp.single b 1 - Finsupp.single a 1 := by
  classical
  induction h with
  | rel a b h =>
    refine ⟨Finsupp.single (a, b) 1, fun p hp ↦ ?_, by simp⟩
    rw [Finsupp.mem_support_iff, Finsupp.single_apply] at hp
    split_ifs at hp with hpe
    · subst hpe; exact ⟨trivial, trivial, h⟩
    · exact absurd rfl hp
  | refl a => exact ⟨0, fun p hp ↦ by simp at hp, by simp [bd_zero]⟩
  | symm a b _ ih =>
    obtain ⟨u, hu, hbd⟩ := ih
    refine ⟨-u, fun p hp ↦ hu p (by simpa using hp), ?_⟩
    rw [bd_neg, hbd, neg_sub]
  | trans a b c _ _ ih ih' =>
    obtain ⟨u, hu, hbd⟩ := ih
    obtain ⟨u', hu', hbd'⟩ := ih'
    refine ⟨u + u', hu.add hu', ?_⟩
    rw [bd_add, hbd, hbd']
    abel

end Boundary

section Main

attribute [local instance] opLinear

variable [Infinite k] (hT : IsThin k O) (hgt : O → ℤ) (hR : ∀ o o', Rl o o' → hgt o < hgt o')
  (hsrcRep : ∀ (s : O) (S : Finset O), SupRepFinite hT (s := s) (P := supp s S)
    (fv := fvec s) (fun y hy ↦ fvec_ne s S hy))
  (hsnkRep : ∀ (t : O) (S : Finset O), SupRepFinite (isThin_op hT) (s := op t)
    (P := supp (op t) (S.map opEmb)) (fv := fvec (op t)) (fun y hy ↦ fvec_ne (op t) (S.map opEmb) hy))
  (hsucc : ∀ o : O, {o' | Rl o o'}.Finite) (e : ℕ → O) (he : Function.Surjective e)

include hT hR hsrcRep hsnkRep hsucc he in
/-- **Proposition 7.2(2)** (`prop:integral-ray-weights`), in the generic form: if
every `k*`-weight on the whole category is a ratio of object values (Lemma 4.13),
then every additive weight with values in any abelian group is a difference of
object values. -/
theorem addWeight_eq_diff
    (hratio : ∀ w' : O → O → Additive kˣ, IsAddWeight Set.univ w' →
      ∃ ζ : O → Additive kˣ, ∀ o o', Line o o' → w' o o' = ζ o' - ζ o)
    {M : Type z} [AddCommGroup M] (w' : O → O → M) (hw : IsAddWeight Set.univ w') :
    ∃ ζ : O → M, ∀ o o', Line o o' → w' o o' = ζ o' - ζ o := by
  classical
  let st : Setoid O := Relation.EqvGen.setoid (fun o o' : O ↦ Line o o')
  let root : O → O := fun o ↦ (Quotient.mk st o).out
  have hroot : ∀ o, Relation.EqvGen (fun o o' : O ↦ Line o o') (root o) o := fun o ↦
    Quotient.exact (Quotient.out_eq (Quotient.mk st o))
  have hroot_eq : ∀ o o', Line o o' → root o = root o' := fun o o' h ↦ by
    simp only [root]
    rw [Quotient.sound (show st.r o o' from Relation.EqvGen.rel _ _ h)]
  let zg : O → O × O →₀ ℤ := fun o ↦ Classical.choose (exists_zigzag (hroot o))
  have hzg : ∀ o, Supp Set.univ (zg o) ∧
      bd (zg o) = Finsupp.single o 1 - Finsupp.single (root o) 1 := fun o ↦
    Classical.choose_spec (exists_zigzag (hroot o))
  refine ⟨fun o ↦ ev w' (zg o), fun o o' hl ↦ ?_⟩
  -- the cycle `zg o + [o o'] − zg o'`
  set c : O × O →₀ ℤ := zg o + Finsupp.single (o, o') 1 - zg o' with hcdef
  have hcS : Supp Set.univ c := by
    have h1 : Supp Set.univ (Finsupp.single (o, o') (1 : ℤ)) := fun p hp ↦ by
      rw [Finsupp.mem_support_iff, Finsupp.single_apply] at hp
      split_ifs at hp with hpe
      · subst hpe; exact ⟨trivial, trivial, hl⟩
      · exact absurd rfl hp
    rw [hcdef, sub_eq_add_neg]
    exact ((hzg o).1.add h1).add (fun p hp ↦ (hzg o').1 p (by simpa using hp))
  have hbd : bd c = 0 := by
    rw [hcdef, bd_sub, bd_add, (hzg o).2, (hzg o').2, bd_single, hroot_eq o o' hl]
    abel
  -- a stage containing the support of `c`
  let idx : O → ℕ := fun o ↦ Classical.choose (he o)
  have hidx : ∀ o, e (idx o) = o := fun o ↦ Classical.choose_spec (he o)
  let N := c.support.sup fun p ↦ max (idx p.1) (idx p.2)
  have hmemN : ∀ p ∈ c.support, p.1 ∈ exT hgt hR hsucc e N ∧ p.2 ∈ exT hgt hR hsucc e N := by
    intro p hp
    have hle : max (idx p.1) (idx p.2) ≤ N := Finset.le_sup (f := fun p ↦ max (idx p.1) (idx p.2)) hp
    have h1 := exT_mono' hgt hR hsucc e (le_trans (le_max_left _ _) hle)
      (mem_exT hgt hR hsucc e (idx p.1))
    have h2 := exT_mono' hgt hR hsucc e (le_trans (le_max_right _ _) hle)
      (mem_exT hgt hR hsucc e (idx p.2))
    rw [hidx] at h1 h2
    exact ⟨h1, h2⟩
  have hcN : Supp (exT hgt hR hsucc e N : Set O) c := fun p hp ↦
    ⟨(hmemN p hp).1, (hmemN p hp).2, (hcS p hp).2.2⟩
  have hK : KillsK k (exT hgt hR hsucc e N : Set O) c := by
    intro W hW
    obtain ⟨W', hW', hag⟩ := exists_ext_univ.{u, v, w, u} hT hgt hR hsrcRep hsnkRep hsucc e he N
      (Additive kˣ) W hW
    obtain ⟨ζ, hζ⟩ := hratio W' hW'
    have h1 : ev W c = ev W' c := ev_congr fun p hp ↦ (hag p.1 (hmemN p hp).1 p.2 (hmemN p hp).2).symm
    have h2 : ev W' c = ev (fun o o' ↦ ζ o' - ζ o) c := ev_congr fun p hp ↦ hζ p.1 p.2 (hcS p hp).2.2
    rw [h1, h2, ev_diff, hbd, Finsupp.sum_zero_index]
  have hc0 := sep_exT.{u, v, w, z} hT hgt hR hsrcRep hsnkRep hsucc e N c hcN hK M w'
    (hw.mono (Set.subset_univ _))
  rw [hcdef, ev_sub, ev_add, ev_single, one_smul] at hc0
  rw [← sub_eq_zero, ← hc0]
  abel

end Main

end Thin

end MultiplicativeBasisDeformations
