import MultiplicativeBasisDeformations.Foundations.ExtUnique

/-!
# Graded `Ext` from graded projective resolutions (Lemma 6.3)

`positive-deformations.tex:85`: "Internal degree `t` in `Hom` or `Ext` means maps from a graded
projective resolution to the target which raise degree by `t`." This file defines that `Ext`
and compares it with the bar `Ext` (`ExtVanish`) used in the rest of the formalization.

* `GProj`: a graded projective module (degree-zero graded module maps lift along graded
  surjections). Finitely generated ones are retracts of finite sums of shifted regular modules
  (`exists_free_cover`), so their bar `Ext` vanishes (`GProj.extVanish`).
* `GRes`: a graded projective resolution `⋯ → P₁ → P₀ → M → 0` (finitely generated graded
  projectives, maps of degree `0`, exact). `GRes.ExtVanish`: `Ext^{n+1}(M, N)_t = 0` computed
  from it, i.e. every degree-`t` graded module map `P_{n+1} → N` vanishing on the image of
  `P_{n+2}` factors through `P_{n+1} → P_n` by a degree-`t` graded module map.
* `GRes.extVanish_iff`: for every graded projective resolution, this vanishing is the bar
  vanishing. In particular it does not depend on the resolution. Over a commutative ring `R`
  (a field, or `ℤ/4` in Lemma 6.6) it assumes the graded pieces of `Λ` and `M` projective over `R`
  (for the free modules of Lemma 6.6, and automatically over a field: `GRes.extVanish_iff_field`).
* `exists_gres`: a finitely generated graded module over a module-finite graded algebra over a
  noetherian ring has a graded projective resolution.

So every `Ext` vanishing hypothesis or conclusion stated in the bar form (Lemma 6.3,
Propositions 6.5, 10.1, Lemma 6.6) is equivalent to the manuscript's form for any graded
projective resolution.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

noncomputable section

namespace MultiplicativeBasisDeformations

namespace GExt

universe u v w

section General

variable {R : Type v} [CommRing R] {Λ : Type u} [Ring Λ] [Algebra R Λ] {GΛ : GAlg (R := R) Λ}

/-- A graded module map of degree `t`. -/
structure IsGMap {X Y : Type*} [AddCommGroup X] [Module R X] [AddCommGroup Y] [Module R Y]
    (XX : GMod GΛ X) (YY : GMod GΛ Y) (t : ℤ) (f : X →ₗ[R] Y) : Prop where
  act : ∀ x a, f (XX.act x a) = YY.act (f x) a
  deg : ∀ p x, XX.gr.IsHom p x → YY.gr.IsHom (p + t) (f x)

variable (GΛ) in
/-- The regular graded module `Λ`. -/
def GMod.reg : GMod GΛ Λ where
  act := LinearMap.mul R Λ
  act_one m := by simp
  act_mul m a b := by simp [mul_assoc]
  gr := GΛ.gr
  act_hom p q m a hm ha := by simpa using GΛ.mul_hom p q m a hm ha

theorem GMod.reg_act (m a : Λ) : (GMod.reg GΛ).act m a = m * a := rfl

/-- The regular module is cyclic projective, generated by `1`. -/
def regCyc : CycProj (GMod.reg GΛ) where
  e := 1
  g := 1
  b := 0
  hg := GΛ.one_hom
  ψ := LinearMap.id
  ψ_act m a := rfl
  act_ψ m := one_mul m
  ψ_deg p m hm := by rw [sub_zero]; exact hm

variable (GΛ) in
/-- The finite free graded module `⊕_i Λ⟨b_i⟩`. -/
def GMod.free {ι : Type} [Fintype ι] [DecidableEq ι] (b : ι → ℤ) : GMod GΛ (ι → Λ) :=
  GMod.pi (fun _ ↦ GMod.reg GΛ) b

theorem GMod.free_act {ι : Type} [Fintype ι] [DecidableEq ι] (b : ι → ℤ) (x : ι → Λ) (a : Λ)
    (i : ι) : (GMod.free GΛ b).act x a i = x i * a := rfl

theorem GMod.free_isHom {ι : Type} [Fintype ι] [DecidableEq ι] (b : ι → ℤ) (p : ℤ) (x : ι → Λ) :
    (GMod.free GΛ b).gr.IsHom p x ↔ ∀ i, GΛ.gr.IsHom (p - b i) (x i) :=
  ZGr.piShift_isHom _ _ _ _

/-- **`Ext` out of a finite free graded module vanishes.** -/
theorem extVanish_free {ι : Type} [Fintype ι] [DecidableEq ι] (b : ι → ℤ) {N : Type*}
    [AddCommGroup N] [Module R N] (NN : GMod GΛ N) (n : ℕ) (t : ℤ) :
    ExtVanish (GMod.free GΛ b) NN n t :=
  extVanish_pi _ _ n t fun a ↦ regCyc.extVanish NN n (t + b a)

/-- **A graded projective module**: graded module maps of degree `0` lift along graded
surjections from graded modules in the universe of `Λ` onto graded modules in the universe of `P`. -/
def GProj {P : Type w} [AddCommGroup P] [Module R P] (PP : GMod GΛ P) : Prop :=
  ∀ (E : Type u) (X : Type w) [AddCommGroup E] [Module R E] [AddCommGroup X] [Module R X]
    (EE : GMod GΛ E) (XX : GMod GΛ X) (π : E →ₗ[R] X), IsGMap EE XX 0 π →
    Function.Surjective π → ∀ f : P →ₗ[R] X, IsGMap PP XX 0 f →
      ∃ g : P →ₗ[R] E, IsGMap PP EE 0 g ∧ π ∘ₗ g = f

/-- A cover of a graded module by a finite free graded module. -/
structure Cover {X : Type*} [AddCommGroup X] [Module R X] (XX : GMod GΛ X) where
  ι : Type
  [fi : Fintype ι]
  [de : DecidableEq ι]
  b : ι → ℤ
  c : (ι → Λ) →ₗ[R] X
  hc : IsGMap (GMod.free GΛ b) XX 0 c
  surj : Function.Surjective c

attribute [instance] Cover.fi Cover.de

/-- **A finitely generated graded module has a finite free graded cover**: the homogeneous
components of a finite generating set, as generators of shifted copies of `Λ`. -/
theorem exists_free_cover {X : Type*} [AddCommGroup X] [Module R X] (XX : GMod GΛ X)
    [Module.Finite R X] : Nonempty (Cover XX) := by
  classical
  obtain ⟨m, x, hx⟩ := Module.Finite.exists_fin (R := R) (M := X)
  let ι := XX.gr.supp × Fin m
  let g : ι → X := fun i ↦ XX.gr.proj i.1 (x i.2)
  let b : ι → ℤ := fun i ↦ i.1
  let c : (ι → Λ) →ₗ[R] X := ∑ i, XX.act (g i) ∘ₗ LinearMap.proj i
  have hc : ∀ f, c f = ∑ i, XX.act (g i) (f i) := fun f ↦ by
    simp [c, LinearMap.sum_apply]
  refine ⟨⟨ι, b, c, ⟨fun f a ↦ ?_, fun p f hf ↦ ?_⟩, ?_⟩⟩
  · rw [hc, hc, map_sum, LinearMap.sum_apply]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [GMod.free_act, XX.act_mul]
  · rw [GMod.free_isHom] at hf
    rw [hc]
    refine XX.gr.isHom_sum _ _ fun i _ ↦ ?_
    have := XX.act_hom _ _ _ _ (XX.gr.isHom_proj i.1 (x i.2)) (hf i)
    rwa [show (i.1 : ℤ) + (p - b i) = p + 0 by simp [b]] at this
  · rw [← LinearMap.range_eq_top, eq_top_iff, ← hx, Submodule.span_le]
    rintro _ ⟨j, rfl⟩
    refine ⟨fun i ↦ if i.2 = j then 1 else 0, ?_⟩
    rw [hc, Fintype.sum_prod_type]
    simp only [g]
    rw [Finset.sum_congr rfl fun p _ ↦ Finset.sum_eq_single j
      (fun j' _ hj' ↦ by rw [if_neg hj', map_zero])
      (fun h ↦ absurd (Finset.mem_univ j) h)]
    simp only [↓reduceIte, XX.act_one]
    rw [Finset.sum_coe_sort XX.gr.supp (fun p ↦ XX.gr.proj p (x j))]
    exact (XX.gr.sum (x j)).symm

/-- **Finite free graded modules are graded projective.** -/
theorem gProj_free {ι : Type} [Fintype ι] [DecidableEq ι] (b : ι → ℤ) :
    GProj (GMod.free GΛ b) := by
  classical
  intro E X _ _ _ _ EE XX π hπ hs f hf
  -- homogeneous preimages of the images of the generators
  have he : ∀ i, ∃ e, EE.gr.IsHom (b i) e ∧ π e = f (Pi.single i 1) := by
    intro i
    obtain ⟨e, he⟩ := hs (f (Pi.single i 1))
    have h1 : (GMod.free GΛ b).gr.IsHom (b i) (Pi.single i 1) := by
      rw [GMod.free_isHom]
      intro j
      by_cases hj : j = i
      · subst hj; simpa using GΛ.one_hom
      · rw [Pi.single_eq_of_ne hj]; exact GΛ.gr.isHom_zero _
    have h2 := hf.deg _ _ h1
    rw [add_zero] at h2
    refine ⟨EE.gr.proj (b i) e, EE.gr.isHom_proj _ _, ?_⟩
    have := ZGr.map_proj' EE.gr XX.gr π (fun p x hx ↦ by simpa using hπ.deg p x hx) (b i) e
    rw [this, he]; exact h2
  choose e he1 he2 using he
  let g : (ι → Λ) →ₗ[R] E := ∑ i, EE.act (e i) ∘ₗ LinearMap.proj i
  have hg : ∀ y, g y = ∑ i, EE.act (e i) (y i) := fun y ↦ by
    simp [g, LinearMap.sum_apply]
  -- every element is the combination of the generators
  have hy : ∀ y : ι → Λ, y = ∑ i, (GMod.free GΛ b).act (Pi.single i 1) (y i) := fun y ↦ by
    funext j
    rw [Finset.sum_apply, Finset.sum_eq_single j]
    · rw [GMod.free_act]; simp
    · intro i _ hij; rw [GMod.free_act, Pi.single_eq_of_ne (Ne.symm hij), zero_mul]
    · simp
  refine ⟨g, ⟨fun y a ↦ ?_, fun p y hy' ↦ ?_⟩, LinearMap.ext fun y ↦ ?_⟩
  · rw [hg, hg, map_sum, LinearMap.sum_apply]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [GMod.free_act, EE.act_mul]
  · rw [GMod.free_isHom] at hy'
    rw [hg]
    refine EE.gr.isHom_sum _ _ fun i _ ↦ ?_
    have := EE.act_hom _ _ _ _ (he1 i) (hy' i)
    rwa [show b i + (p - b i) = p + 0 by ring] at this
  · rw [LinearMap.comp_apply, hg, map_sum]
    conv_rhs => rw [hy y, map_sum]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [hf.act, ← he2, hπ.act]

/-- **`Ext` out of a finitely generated graded projective vanishes**: it is a retract of a
finite free graded module. -/
theorem GProj.extVanish {P : Type w} [AddCommGroup P] [Module R P] {PP : GMod GΛ P}
    (hP : GProj PP) [Module.Finite R P] {N : Type*} [AddCommGroup N] [Module R N]
    (NN : GMod GΛ N) (n : ℕ) (t : ℤ) : ExtVanish PP NN n t := by
  obtain ⟨C⟩ := exists_free_cover PP
  obtain ⟨σ, hσ, hcσ⟩ := hP (C.ι → Λ) P (GMod.free GΛ C.b) PP C.c C.hc C.surj LinearMap.id
    ⟨fun _ _ ↦ rfl, fun p x hx ↦ by rwa [add_zero]⟩
  have := extVanish_of_retract (MM := GMod.free GΛ C.b) (MM' := PP) σ C.c 0 hσ.act C.hc.act
    hσ.deg (fun p m hm ↦ by simpa using C.hc.deg p m hm) hcσ (extVanish_free C.b NN n t)
  rwa [add_zero] at this

/-- A degree-`0` graded retract of a module with projective graded pieces has projective graded
pieces. -/
theorem proj_of_retract {X Y : Type*} [AddCommGroup X] [Module R X] [AddCommGroup Y] [Module R Y]
    (gX : ZGr (R := R) X) (gY : ZGr (R := R) Y) (i : X →ₗ[R] Y) (s : Y →ₗ[R] X)
    (hi : ∀ p x, gX.IsHom p x → gY.IsHom p (i x)) (hs : ∀ p y, gY.IsHom p y → gX.IsHom p (s y))
    (hsi : s ∘ₗ i = LinearMap.id) (q : ℤ) [Module.Projective R (LinearMap.range (gY.proj q))] :
    Module.Projective R (LinearMap.range (gX.proj q)) := by
  let i' : LinearMap.range (gX.proj q) →ₗ[R] LinearMap.range (gY.proj q) :=
    LinearMap.codRestrict _ (i ∘ₗ (LinearMap.range (gX.proj q)).subtype) fun x ↦
      (ZGr.mem_range_proj' gY).2 (hi q _ ((ZGr.mem_range_proj' gX).1 x.2))
  let s' : LinearMap.range (gY.proj q) →ₗ[R] LinearMap.range (gX.proj q) :=
    LinearMap.codRestrict _ (s ∘ₗ (LinearMap.range (gY.proj q)).subtype) fun y ↦
      (ZGr.mem_range_proj' gX).2 (hs q _ ((ZGr.mem_range_proj' gY).1 y.2))
  exact Module.Projective.of_split i' s' (LinearMap.ext fun x ↦ Subtype.ext
    (LinearMap.congr_fun hsi (x : X)))

/-- The graded pieces of a finite free graded module are projective when those of `Λ` are. -/
theorem proj_free (hΛ : ∀ q, Module.Projective R (LinearMap.range (GΛ.gr.proj q)))
    {ι : Type} [Fintype ι] [DecidableEq ι] (b : ι → ℤ) (q : ℤ) :
    Module.Projective R (LinearMap.range ((GMod.free GΛ b).gr.proj q)) := by
  classical
  have : ∀ i, Module.Projective R (LinearMap.range (GΛ.gr.proj (q - b i))) := fun i ↦ hΛ _
  let e := DFinsupp.linearEquivFunOnFintype (R := R)
    (M := fun i ↦ LinearMap.range (GΛ.gr.proj (q - b i)))
  have : Module.Projective R (∀ i, LinearMap.range (GΛ.gr.proj (q - b i))) :=
    Module.Projective.of_split e.symm.toLinearMap e.toLinearMap (LinearMap.ext fun x ↦ by simp)
  let i' : LinearMap.range ((GMod.free GΛ b).gr.proj q) →ₗ[R]
      ∀ i, LinearMap.range (GΛ.gr.proj (q - b i)) :=
    LinearMap.pi fun i ↦ LinearMap.codRestrict _
      (LinearMap.proj i ∘ₗ (LinearMap.range ((GMod.free GΛ b).gr.proj q)).subtype) fun x ↦
        (ZGr.mem_range_proj' GΛ.gr).2
          (((GMod.free_isHom b q _).1 ((ZGr.mem_range_proj' _).1 x.2)) i)
  let s' : (∀ i, LinearMap.range (GΛ.gr.proj (q - b i))) →ₗ[R]
      LinearMap.range ((GMod.free GΛ b).gr.proj q) :=
    LinearMap.codRestrict _ (LinearMap.pi fun i ↦ (LinearMap.range (GΛ.gr.proj (q - b i))).subtype ∘ₗ
      LinearMap.proj i) fun y ↦
        (ZGr.mem_range_proj' _).2 ((GMod.free_isHom b q _).2 fun i ↦
          (ZGr.mem_range_proj' GΛ.gr).1 (y i).2)
  exact Module.Projective.of_split i' s' (LinearMap.ext fun x ↦ Subtype.ext (funext fun i ↦ rfl))

/-- **The graded pieces of a finitely generated graded projective module are projective** when
those of `Λ` are. -/
theorem GProj.proj_pieces {P : Type w} [AddCommGroup P] [Module R P] {PP : GMod GΛ P}
    (hP : GProj PP) [Module.Finite R P]
    (hΛ : ∀ q, Module.Projective R (LinearMap.range (GΛ.gr.proj q))) (q : ℤ) :
    Module.Projective R (LinearMap.range (PP.gr.proj q)) := by
  obtain ⟨C⟩ := exists_free_cover PP
  obtain ⟨σ, hσ, hcσ⟩ := hP (C.ι → Λ) P (GMod.free GΛ C.b) PP C.c C.hc C.surj LinearMap.id
    ⟨fun _ _ ↦ rfl, fun p x hx ↦ by rwa [add_zero]⟩
  have := proj_free hΛ C.b q
  exact proj_of_retract PP.gr (GMod.free GΛ C.b).gr σ C.c (fun p x hx ↦ by simpa using hσ.deg p x hx)
    (fun p x hx ↦ by simpa using C.hc.deg p x hx) hcσ q

end General

section Ring

variable {R : Type v} [CommRing R] {Λ : Type u} [Ring Λ] [Algebra R Λ] {GΛ : GAlg (R := R) Λ}
  {M N : Type*} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]

/-! ### `Ext¹` and extensions of maps from the syzygy -/

section Extend

variable {P : Type*} [AddCommGroup P] [Module R P] (PP : GMod GΛ P) (MM : GMod GΛ M)
  {π : P →ₗ[R] M} (hπ : IsGMap PP MM 0 π)

include hπ in
/-- A graded `R`-linear section of a graded surjection. -/
theorem exists_gsection (hs : Function.Surjective π)
    (hM : ∀ q, Module.Projective R (LinearMap.range (MM.gr.proj q))) :
    ∃ s : M →ₗ[R] P, π ∘ₗ s = LinearMap.id ∧ ∀ p m, MM.gr.IsHom p m → PP.gr.IsHom (p + 0) (s m) := by
  obtain ⟨s, hs1, hs2⟩ := exists_graded_section PP.gr π hs
    (fun q e he ↦ by simpa using hπ.deg q e he) hM
  exact ⟨s, LinearMap.ext hs1, fun p m hm ↦ by rw [add_zero]; exact hs2 p m hm⟩

/-- **`Ext¹(M, N)_t` (bar) vanishes iff every degree-`t` graded module map out of the kernel
extends to `P`**, along `0 → K → P → M → 0` with `Ext¹(P, N)_t = 0`. -/
theorem extVanish_zero_iff_extend (hs : Function.Surjective π)
    (hM : ∀ q, Module.Projective R (LinearMap.range (MM.gr.proj q))) (NN : GMod GΛ N) (t : ℤ)
    (hP : ExtVanish PP NN 0 t) :
    ExtVanish MM NN 0 t ↔ ∀ h : LinearMap.ker π →ₗ[R] N,
      IsGMap (GMod.ker PP MM hπ.act hπ.deg) NN t h →
        ∃ g : P →ₗ[R] N, IsGMap PP NN t g ∧ g ∘ₗ (LinearMap.ker π).subtype = h := by
  classical
  obtain ⟨s, hπs, hsdeg⟩ := exists_gsection PP MM hπ hs hM
  have hπs' : ∀ m, π (s m) = m := fun m ↦ LinearMap.congr_fun hπs m
  set KK := GMod.ker PP MM hπ.act hπ.deg
  have hmemK : ∀ x, x - s (π x) ∈ LinearMap.ker π := fun x ↦ by
    rw [LinearMap.mem_ker, map_sub, hπs', sub_self]
  -- the retraction onto the kernel
  let ρ : P →ₗ[R] LinearMap.ker π :=
    (LinearMap.id - s ∘ₗ π).codRestrict _ fun x ↦ hmemK x
  have hρ : ∀ x, (ρ x : P) = x - s (π x) := fun _ ↦ rfl
  have hρK : ∀ y : LinearMap.ker π, ρ y = y := fun y ↦ Subtype.ext (by
    rw [hρ, LinearMap.mem_ker.1 y.2, map_zero, sub_zero])
  have hρdeg : ∀ p x, PP.gr.IsHom p x → KK.gr.IsHom p (ρ x) := fun p x hx ↦ by
    refine (ZGr.ker_isHom PP MM hπ.deg _ _).2 ?_
    rw [hρ, sub_eq_add_neg]
    have h2 := hsdeg _ _ (hπ.deg p x hx)
    simp only [add_zero] at h2
    exact PP.gr.isHom_add hx (PP.gr.isHom_neg h2)
  have hKact : ∀ (y : LinearMap.ker π) a, (KK.act y a : P) = PP.act (y : P) a := fun _ _ ↦ rfl
  -- constant `0`-cochains
  have hd0 : ∀ (Q : P →ₗ[R] N) (a : ℕ → Λ) (x : P),
      Bar.d (homAct PP NN) 0 (fun _ ↦ Q) a x = Q (PP.act x (a 0)) - NN.act (Q x) (a 0) := by
    intro Q a x
    simp only [Bar.d_zero_apply, LinearMap.sub_apply, homAct_l, homAct_r]
  have hd0M : ∀ (Q : M →ₗ[R] N) (a : ℕ → Λ) (m : M),
      Bar.d (homAct MM NN) 0 (fun _ ↦ Q) a m = Q (MM.act m (a 0)) - NN.act (Q m) (a 0) := by
    intro Q a m
    simp only [Bar.d_zero_apply, LinearMap.sub_apply, homAct_l, homAct_r]
  have hconstP : ∀ Q : P →ₗ[R] N, (∀ p x, PP.gr.IsHom p x → NN.gr.IsHom (p + t) (Q x)) →
      Good PP NN 0 t (fun _ ↦ Q) := by
    intro Q hQ
    refine ⟨fun _ ↦ rfl, fun _ i _ _ hi ↦ absurd hi (by omega),
      fun _ i _ _ hi ↦ absurd hi (by omega), fun a ds p m _ hm ↦ ?_⟩
    simpa using hQ p m hm
  have hconstM : ∀ Q : M →ₗ[R] N, (∀ p m, MM.gr.IsHom p m → NN.gr.IsHom (p + t) (Q m)) →
      Good MM NN 0 t (fun _ ↦ Q) := by
    intro Q hQ
    refine ⟨fun _ ↦ rfl, fun _ i _ _ hi ↦ absurd hi (by omega),
      fun _ i _ _ hi ↦ absurd hi (by omega), fun a ds p m _ hm ↦ ?_⟩
    simpa using hQ p m hm
  have hpinj : ∀ G G' : Bar.Cochain Λ (M →ₗ[R] N), (∀ a x, G a (π x) = G' a (π x)) → G = G' := by
    intro G G' h
    funext a; ext m
    rw [← hπs' m]; exact h a (s m)
  constructor
  · -- bar vanishing gives extensions
    intro hM h hh
    set G : Bar.Cochain Λ (P →ₗ[R] N) := fun _ ↦ h ∘ₗ ρ
    have hG : Good PP NN 0 t G := hconstP _ fun p x hx ↦ hh.deg p _ (hρdeg p x hx)
    have hDK : ∀ a (y : P), y ∈ LinearMap.ker π → Bar.d (homAct PP NN) 0 G a y = 0 := by
      intro a y hy
      rw [hd0]
      simp only [LinearMap.comp_apply]
      have e1 : ρ (PP.act y (a 0)) = KK.act ⟨y, hy⟩ (a 0) := by
        rw [show PP.act y (a 0) = ((KK.act ⟨y, hy⟩ (a 0) : LinearMap.ker π) : P) from rfl, hρK]
      rw [e1, hh.act, hρK ⟨y, hy⟩, sub_self]
    have hDs : ∀ a x, Bar.d (homAct PP NN) 0 G a x = Bar.d (homAct PP NN) 0 G a (s (π x)) := by
      intro a x
      have := hDK a _ (hmemK x)
      rw [map_sub, sub_eq_zero] at this
      exact this
    set c : Bar.Cochain Λ (M →ₗ[R] N) := pull s (Bar.d (homAct PP NN) 0 G)
    have hc : Good MM NN 1 t c := by
      have := hG.d.pull hsdeg
      rwa [add_zero] at this
    have hpc : pull π c = Bar.d (homAct PP NN) 0 G := by
      funext a; ext x
      exact (hDs a x).symm
    have hdc : Bar.d (homAct MM NN) 1 c = 0 := by
      apply hpinj
      intro a x
      have := congrArg (fun F : Bar.Cochain Λ (P →ₗ[R] N) ↦ F a x)
        (d_pull (MM' := PP) (MM := MM) (NN := NN) hπ.act 1 c)
      simp only [pull_apply] at this
      rw [← this, hpc, Bar.d_d]; rfl
    obtain ⟨H, hH, hdH⟩ := hM c hc hdc
    set hh0 := H (fun _ ↦ 0)
    have hH0 : ∀ a, H a = hh0 := fun a ↦ by rw [hH.tr a]; congr 1
    have hH0deg : ∀ p m, MM.gr.IsHom p m → NN.gr.IsHom (p + t) (hh0 m) := fun p m hm ↦ by
      have := hH.deg (fun _ ↦ 0) (fun _ ↦ 0) p m (fun i hi ↦ absurd hi (by omega)) hm
      simpa using this
    have hdef : ∀ m (a : ℕ → Λ), hh0 (MM.act m (a 0)) - NN.act (hh0 m) (a 0) = c a m := by
      intro m a
      have := congrArg (fun F : Bar.Cochain Λ (M →ₗ[R] N) ↦ F a m) hdH
      simp only [Bar.d_zero_apply, LinearMap.sub_apply, homAct_l, homAct_r, hH0] at this
      exact this
    refine ⟨h ∘ₗ ρ - hh0 ∘ₗ π, ⟨fun x a ↦ ?_, fun p x hx ↦ ?_⟩, LinearMap.ext fun y ↦ ?_⟩
    · have e1 := hdef (π x) (fun _ ↦ a)
      have e2 := hd0 (h ∘ₗ ρ) (fun _ ↦ a) x
      have e3 := hDs (fun _ ↦ a) x
      simp only [c, pull_apply] at e1
      simp only [LinearMap.sub_apply, LinearMap.comp_apply, map_sub, hπ.act]
      simp only [G] at e3
      rw [← e3, e2] at e1
      simp only [LinearMap.comp_apply] at e1
      rw [sub_eq_iff_eq_add] at e1 ⊢
      rw [e1]; abel
    · simp only [LinearMap.sub_apply, LinearMap.comp_apply]
      rw [sub_eq_add_neg]
      have h1 := hh.deg p _ (hρdeg p x hx)
      have h2 := hH0deg _ _ (hπ.deg p x hx)
      rw [add_zero] at h2
      exact NN.gr.isHom_add h1 (NN.gr.isHom_neg h2)
    · simp only [LinearMap.comp_apply, LinearMap.sub_apply, Submodule.subtype_apply]
      rw [hρK, LinearMap.mem_ker.1 y.2, map_zero, sub_zero]
  · -- extensions give bar vanishing
    intro hext c hc hdc
    have hc' : Good PP NN 1 t (pull π c) := by
      have := hc.pull hπ.deg; rwa [add_zero] at this
    have hdc' : Bar.d (homAct PP NN) 1 (pull π c) = 0 := by
      rw [d_pull hπ.act, hdc]; rfl
    obtain ⟨G, hG, hdG⟩ := hP (pull π c) hc' hdc'
    set G0 := G (fun _ ↦ 0)
    have hG0 : ∀ a, G a = G0 := fun a ↦ by rw [hG.tr a]; congr 1
    have hG0deg : ∀ p x, PP.gr.IsHom p x → NN.gr.IsHom (p + t) (G0 x) := fun p x hx ↦ by
      have := hG.deg (fun _ ↦ 0) (fun _ ↦ 0) p x (fun i hi ↦ absurd hi (by omega)) hx
      simpa using this
    have hdG' : ∀ (a : ℕ → Λ) x, G0 (PP.act x (a 0)) - NN.act (G0 x) (a 0) = c a (π x) := by
      intro a x
      have := congrArg (fun F : Bar.Cochain Λ (P →ₗ[R] N) ↦ F a x) hdG
      simp only [Bar.d_zero_apply, LinearMap.sub_apply, homAct_l, homAct_r, hG0, pull_apply] at this
      exact this
    have hc0 : ∀ a, c a 0 = 0 := fun a ↦ map_zero _
    obtain ⟨g, hg, hgh⟩ := hext (G0 ∘ₗ (LinearMap.ker π).subtype)
      ⟨fun y a ↦ by
        have := hdG' (fun _ ↦ a) y
        rw [LinearMap.mem_ker.1 y.2, hc0, sub_eq_zero] at this
        exact this,
       fun p y hy ↦ hG0deg p _ ((ZGr.ker_isHom PP MM hπ.deg _ _).1 hy)⟩
    have hgK : ∀ y ∈ LinearMap.ker π, g y = G0 y := fun y hy ↦
      LinearMap.congr_fun hgh ⟨y, hy⟩
    have hQ : ∀ x, (G0 - g) (s (π x)) = (G0 - g) x := by
      intro x
      have := hgK _ (hmemK x)
      rw [map_sub, map_sub] at this
      simp only [LinearMap.sub_apply]
      rw [← sub_eq_zero]
      rw [← sub_eq_zero] at this
      rw [← this]; abel
    refine ⟨fun _ ↦ (G0 - g) ∘ₗ s, hconstM _ fun p m hm ↦ ?_, ?_⟩
    · simp only [LinearMap.comp_apply, LinearMap.sub_apply]
      have h1 := hsdeg p m hm
      rw [add_zero] at h1
      rw [sub_eq_add_neg]
      exact NN.gr.isHom_add (hG0deg _ _ h1) (NN.gr.isHom_neg (hg.deg _ _ h1))
    · apply hpinj
      intro a x
      rw [hd0M]
      simp only [LinearMap.comp_apply]
      rw [← hπ.act, hQ, hQ, ← hdG' a x]
      simp only [LinearMap.sub_apply, map_sub, hg.act]
      abel

end Extend

/-! ### Graded projective resolutions -/

/-- **A graded projective resolution** `⋯ → P₁ → P₀ → M → 0` of a graded module `M`: finitely
generated graded projective modules (in the universe of `M`), maps of degree `0`, exact. -/
structure GRes {M : Type w} [AddCommGroup M] [Module R M] (MM : GMod GΛ M) where
  P : ℕ → Type w
  [acg : ∀ n, AddCommGroup (P n)]
  [mod : ∀ n, Module R (P n)]
  PP : ∀ n, GMod GΛ (P n)
  d : ∀ n, P (n + 1) →ₗ[R] P n
  ε : P 0 →ₗ[R] M
  d_map : ∀ n, IsGMap (PP (n + 1)) (PP n) 0 (d n)
  ε_map : IsGMap (PP 0) MM 0 ε
  ε_surj : Function.Surjective ε
  exact_zero : LinearMap.ker ε = LinearMap.range (d 0)
  exact : ∀ n, LinearMap.ker (d n) = LinearMap.range (d (n + 1))
  proj : ∀ n, GProj (PP n)
  fin : ∀ n, Module.Finite R (P n)

attribute [instance] GRes.acg GRes.mod

namespace GRes

variable {M : Type w} [AddCommGroup M] [Module R M] {MM : GMod GΛ M} (Rs : GRes MM)

/-- **`Ext^{n+1}(M, N)_t = 0` computed from the resolution**: every degree-`t` graded module map
`P_{n+1} → N` that vanishes on the image of `P_{n+2}` is `g ∘ d` for a degree-`t` graded module
map `g : P_n → N` (the cocycles of `Hom_t(P_•, N)` in degree `n+1` are coboundaries). -/
def ExtVanish (NN : GMod GΛ N) (n : ℕ) (t : ℤ) : Prop :=
  ∀ f : Rs.P (n + 1) →ₗ[R] N, IsGMap (Rs.PP (n + 1)) NN t f → f ∘ₗ Rs.d (n + 1) = 0 →
    ∃ g : Rs.P n →ₗ[R] N, IsGMap (Rs.PP n) NN t g ∧ f = g ∘ₗ Rs.d n

/-- The first syzygy `ker ε` as a graded module. -/
def kerMod : GMod GΛ (LinearMap.ker Rs.ε) := GMod.ker (Rs.PP 0) MM Rs.ε_map.act Rs.ε_map.deg

/-- `P₁ → ker ε`. -/
def ε' : Rs.P 1 →ₗ[R] LinearMap.ker Rs.ε :=
  (Rs.d 0).codRestrict _ fun x ↦ by rw [Rs.exact_zero]; exact LinearMap.mem_range_self _ x

theorem ε'_apply (x : Rs.P 1) : (Rs.ε' x : Rs.P 0) = Rs.d 0 x := rfl

theorem ε'_surj : Function.Surjective Rs.ε' := by
  rintro ⟨y, hy⟩
  rw [Rs.exact_zero] at hy
  obtain ⟨x, rfl⟩ := hy
  exact ⟨x, rfl⟩

theorem ε'_map : IsGMap (Rs.PP 1) Rs.kerMod 0 Rs.ε' :=
  ⟨fun x a ↦ Subtype.ext ((Rs.d_map 0).act x a),
    fun p x hx ↦ (ZGr.ker_isHom (Rs.PP 0) MM Rs.ε_map.deg _ _).2 ((Rs.d_map 0).deg p x hx)⟩

theorem ker_ε' : LinearMap.ker Rs.ε' = LinearMap.range (Rs.d 1) := by
  rw [ε', LinearMap.ker_codRestrict, Rs.exact 0]

/-- **The truncated resolution** `⋯ → P₂ → P₁ → ker ε → 0`. -/
def trunc : GRes Rs.kerMod where
  P n := Rs.P (n + 1)
  PP n := Rs.PP (n + 1)
  d n := Rs.d (n + 1)
  ε := Rs.ε'
  d_map n := Rs.d_map (n + 1)
  ε_map := Rs.ε'_map
  ε_surj := Rs.ε'_surj
  exact_zero := Rs.ker_ε'
  exact n := Rs.exact (n + 1)
  proj n := Rs.proj (n + 1)
  fin n := Rs.fin (n + 1)

theorem trunc_extVanish (NN : GMod GΛ N) (n : ℕ) (t : ℤ) :
    Rs.trunc.ExtVanish NN n t ↔ Rs.ExtVanish NN (n + 1) t := Iff.rfl

/-- **`Ext¹` from the resolution vanishes iff every degree-`t` graded module map out of
`ker ε` extends to `P₀`.** -/
theorem extVanish_zero_iff (NN : GMod GΛ N) (t : ℤ) :
    Rs.ExtVanish NN 0 t ↔ ∀ h : LinearMap.ker Rs.ε →ₗ[R] N, IsGMap Rs.kerMod NN t h →
      ∃ g : Rs.P 0 →ₗ[R] N, IsGMap (Rs.PP 0) NN t g ∧ g ∘ₗ (LinearMap.ker Rs.ε).subtype = h := by
  have hdd : ∀ y, Rs.ε' (Rs.d 1 y) = 0 := fun y ↦ by
    rw [← LinearMap.mem_ker, Rs.ker_ε']; exact LinearMap.mem_range_self _ y
  constructor
  · intro hR h hh
    obtain ⟨g, hg, hfg⟩ := hR (h ∘ₗ Rs.ε')
      ⟨fun x a ↦ by rw [LinearMap.comp_apply, Rs.ε'_map.act, hh.act]; rfl,
       fun p x hx ↦ by
        have := hh.deg _ _ (Rs.ε'_map.deg p x hx)
        rwa [add_zero] at this⟩
      (LinearMap.ext fun y ↦ by simp [hdd])
    refine ⟨g, hg, LinearMap.ext fun y ↦ ?_⟩
    obtain ⟨x, rfl⟩ := Rs.ε'_surj y
    have := LinearMap.congr_fun hfg x
    simp only [LinearMap.comp_apply, Submodule.subtype_apply] at this ⊢
    rw [ε'_apply, ← this]
  · intro hext f hf hfd
    have hle : LinearMap.ker Rs.ε' ≤ LinearMap.ker f := by
      rw [Rs.ker_ε']
      rintro _ ⟨y, rfl⟩
      exact LinearMap.congr_fun hfd y
    let h : LinearMap.ker Rs.ε →ₗ[R] N :=
      (LinearMap.ker Rs.ε').liftQ f hle ∘ₗ
        (Rs.ε'.quotKerEquivOfSurjective Rs.ε'_surj).symm.toLinearMap
    have hε : ∀ x, h (Rs.ε' x) = f x := fun x ↦ by
      simp only [h, LinearMap.comp_apply, LinearEquiv.coe_coe]
      rw [show (Rs.ε'.quotKerEquivOfSurjective Rs.ε'_surj).symm (Rs.ε' x) =
          Submodule.Quotient.mk x from (LinearEquiv.symm_apply_eq _).2
            (LinearMap.quotKerEquivOfSurjective_apply_mk _ _ x).symm,
        Submodule.liftQ_apply]
    obtain ⟨g, hg, hgh⟩ := hext h
      ⟨fun y a ↦ by
        obtain ⟨x, rfl⟩ := Rs.ε'_surj y
        rw [← Rs.ε'_map.act, hε, hε, hf.act],
       fun p y hy ↦ by
        obtain ⟨x, rfl⟩ := Rs.ε'_surj y
        have hx : Rs.ε' ((Rs.PP 1).gr.proj p x) = Rs.ε' x := by
          apply Subtype.ext
          rw [ε'_apply, ε'_apply, ZGr.map_proj' _ _ _
            (fun q z hz ↦ by simpa using (Rs.d_map 0).deg q z hz)]
          have := (ZGr.ker_isHom (Rs.PP 0) MM Rs.ε_map.deg _ _).1 hy
          exact this
        rw [← hx, hε]
        exact hf.deg p _ ((Rs.PP 1).gr.isHom_proj p x)⟩
    refine ⟨g, hg, LinearMap.ext fun x ↦ ?_⟩
    rw [LinearMap.comp_apply, ← ε'_apply, ← hε]
    exact (LinearMap.congr_fun hgh (Rs.ε' x)).symm

/-- The degree-`0` graded `R`-split sequence `0 → ker ε → P₀ → M → 0`, and dimension shifting
of the bar `Ext` along it. -/
theorem extVanish_kerMod_iff (hM : ∀ q, Module.Projective R (LinearMap.range (MM.gr.proj q)))
    (NN : GMod GΛ N) (n : ℕ) (t : ℤ) :
    GExt.ExtVanish Rs.kerMod NN n t ↔ GExt.ExtVanish MM NN (n + 1) t := by
  have := Rs.fin 0
  obtain ⟨s, hπs, hsdeg⟩ := exists_gsection (Rs.PP 0) MM Rs.ε_map Rs.ε_surj hM
  have hπs' : ∀ m, Rs.ε (s m) = m := fun m ↦ LinearMap.congr_fun hπs m
  let ρ : Rs.P 0 →ₗ[R] LinearMap.ker Rs.ε :=
    (LinearMap.id - s ∘ₗ Rs.ε).codRestrict _ fun x ↦ by
      rw [LinearMap.mem_ker, LinearMap.sub_apply, map_sub, LinearMap.id_apply,
        LinearMap.comp_apply, hπs', sub_self]
  have hρdeg : ∀ p x, (Rs.PP 0).gr.IsHom p x → Rs.kerMod.gr.IsHom (p + 0) (ρ x) := by
    intro p x hx
    rw [add_zero]
    refine (ZGr.ker_isHom (Rs.PP 0) MM Rs.ε_map.deg _ _).2 ?_
    change (Rs.PP 0).gr.IsHom p (x - s (Rs.ε x))
    have h2 := hsdeg _ _ (Rs.ε_map.deg p x hx)
    simp only [add_zero] at h2
    rw [sub_eq_add_neg]
    exact (Rs.PP 0).gr.isHom_add hx ((Rs.PP 0).gr.isHom_neg h2)
  have hρι : ρ ∘ₗ (LinearMap.ker Rs.ε).subtype = LinearMap.id :=
    LinearMap.ext fun x ↦ Subtype.ext (by
      change (x : Rs.P 0) - s (Rs.ε x) = x
      rw [LinearMap.mem_ker.1 x.2, map_zero, sub_zero])
  have hsplit : (LinearMap.ker Rs.ε).subtype ∘ₗ ρ + s ∘ₗ Rs.ε = LinearMap.id :=
    LinearMap.ext fun x ↦ by
      change (x - s (Rs.ε x)) + s (Rs.ε x) = x
      rw [sub_add_cancel]
  have hπι : Rs.ε ∘ₗ (LinearMap.ker Rs.ε).subtype = 0 := LinearMap.ext fun x ↦ x.2
  have hιdeg : ∀ p (x : LinearMap.ker Rs.ε), Rs.kerMod.gr.IsHom p x →
      (Rs.PP 0).gr.IsHom (p + 0) ((LinearMap.ker Rs.ε).subtype x) :=
    fun p x hx ↦ by rw [add_zero]; exact (ZGr.ker_isHom (Rs.PP 0) MM Rs.ε_map.deg _ _).1 hx
  have hP := (Rs.proj 0).extVanish NN
  constructor
  · intro hK
    exact extVanish_shift (KK := Rs.kerMod) (PP := Rs.PP 0) _ Rs.ε s ρ (fun _ _ ↦ rfl)
      Rs.ε_map.act hιdeg Rs.ε_map.deg hsdeg hρdeg hπs hρι hsplit hπι (hP _ _) hK
  · intro hM
    exact extVanish_unshift (KK := Rs.kerMod) (PP := Rs.PP 0) _ Rs.ε s ρ (fun _ _ ↦ rfl)
      Rs.ε_map.act hιdeg Rs.ε_map.deg hsdeg hρdeg hπs hρι hsplit hπι (hP _ _) hM

/-- The graded pieces of the first syzygy are projective. -/
theorem kerMod_proj (hΛ : ∀ q, Module.Projective R (LinearMap.range (GΛ.gr.proj q)))
    (hM : ∀ q, Module.Projective R (LinearMap.range (MM.gr.proj q))) (q : ℤ) :
    Module.Projective R (LinearMap.range (Rs.kerMod.gr.proj q)) := by
  have := Rs.fin 0
  obtain ⟨s, hπs, hsdeg⟩ := exists_gsection (Rs.PP 0) MM Rs.ε_map Rs.ε_surj hM
  have hπs' : ∀ m, Rs.ε (s m) = m := fun m ↦ LinearMap.congr_fun hπs m
  let ρ : Rs.P 0 →ₗ[R] LinearMap.ker Rs.ε :=
    (LinearMap.id - s ∘ₗ Rs.ε).codRestrict _ fun x ↦ by
      rw [LinearMap.mem_ker, LinearMap.sub_apply, map_sub, LinearMap.id_apply,
        LinearMap.comp_apply, hπs', sub_self]
  have := (Rs.proj 0).proj_pieces hΛ q
  refine proj_of_retract Rs.kerMod.gr (Rs.PP 0).gr (LinearMap.ker Rs.ε).subtype ρ
    (fun p x hx ↦ (ZGr.ker_isHom (Rs.PP 0) MM Rs.ε_map.deg _ _).1 hx) (fun p x hx ↦ ?_)
    (LinearMap.ext fun x ↦ Subtype.ext (by
      change (x : Rs.P 0) - s (Rs.ε x) = x
      rw [LinearMap.mem_ker.1 x.2, map_zero, sub_zero])) q
  refine (ZGr.ker_isHom (Rs.PP 0) MM Rs.ε_map.deg _ _).2 ?_
  change (Rs.PP 0).gr.IsHom p (x - s (Rs.ε x))
  have h2 := hsdeg _ _ (Rs.ε_map.deg p x hx)
  simp only [add_zero] at h2
  rw [sub_eq_add_neg]
  exact (Rs.PP 0).gr.isHom_add hx ((Rs.PP 0).gr.isHom_neg h2)

end GRes

/-- **The `Ext` of a graded projective resolution is the bar `Ext`**: for every graded
projective resolution of `M`, `Ext^{n+1}(M, N)_t` computed from it vanishes iff the bar
`Ext^{n+1}(M, N)_t` vanishes. In particular the vanishing does not depend on the resolution.
Over a commutative ring, assuming the graded pieces of `Λ` and of `M` projective (automatic over a
field, `GRes.extVanish_iff_field`; true for the free modules over `ℤ/4` of Lemma 6.6). -/
theorem GRes.extVanish_iff (hΛ : ∀ q, Module.Projective R (LinearMap.range (GΛ.gr.proj q)))
    (NN : GMod GΛ N) :
    ∀ (n : ℕ) {M : Type w} [AddCommGroup M] [Module R M] {MM : GMod GΛ M} (Rs : GRes MM)
      (_ : ∀ q, Module.Projective R (LinearMap.range (MM.gr.proj q))) (t : ℤ),
      Rs.ExtVanish NN n t ↔ GExt.ExtVanish MM NN n t
  | 0, M, _, _, MM, Rs, hM, t => by
    have := Rs.fin 0
    rw [Rs.extVanish_zero_iff, extVanish_zero_iff_extend (Rs.PP 0) MM Rs.ε_map Rs.ε_surj hM NN t
      ((Rs.proj 0).extVanish NN 0 t)]
    rfl
  | n + 1, M, _, _, MM, Rs, hM, t => by
    rw [← Rs.trunc_extVanish, GRes.extVanish_iff hΛ NN n Rs.trunc (Rs.kerMod_proj hΛ hM) t,
      Rs.extVanish_kerMod_iff hM]

/-! ### Existence of graded projective resolutions -/

section Exists

variable [IsNoetherianRing R] [Module.Finite R Λ]

/-- A finite-dimensional graded module. -/
structure FinGMod where
  X : Type u
  [acg : AddCommGroup X]
  [mod : Module R X]
  XX : GMod GΛ X
  [fin : Module.Finite R X]

attribute [instance] FinGMod.acg FinGMod.mod FinGMod.fin

variable (GΛ) in
/-- A chosen finite free cover. -/
def FinGMod.cov (S : FinGMod (R := R) (GΛ := GΛ)) : Cover S.XX :=
  Classical.choice (exists_free_cover S.XX)

variable (GΛ) in
/-- The kernel of the chosen cover. -/
def FinGMod.next (S : FinGMod (R := R) (GΛ := GΛ)) : FinGMod (R := R) (GΛ := GΛ) where
  X := LinearMap.ker (S.cov GΛ).c
  XX := GMod.ker (GMod.free GΛ (S.cov GΛ).b) S.XX (S.cov GΛ).hc.act (S.cov GΛ).hc.deg

variable (GΛ) in
/-- The syzygies. -/
def syz (S : FinGMod (R := R) (GΛ := GΛ)) : ℕ → FinGMod (R := R) (GΛ := GΛ)
  | 0 => S
  | n + 1 => (syz S n).next GΛ

/-- **Every finite-dimensional graded module over a finite-dimensional graded algebra has a
graded projective resolution** (by finite free graded modules). -/
theorem exists_gres {M : Type u} [AddCommGroup M] [Module R M] [Module.Finite R M]
    (MM : GMod GΛ M) : Nonempty (GRes MM) := by
  classical
  let S : FinGMod (R := R) (GΛ := GΛ) := ⟨M, MM⟩
  let C : ∀ n, Cover (syz GΛ S n).XX := fun n ↦ (syz GΛ S n).cov GΛ
  have hsucc : ∀ n, syz GΛ S (n + 1) = (syz GΛ S n).next GΛ := fun n ↦ rfl
  -- `P_n = ⊕ Λ⟨b⟩` covering the `n`-th syzygy; `d_n` is the next cover followed by inclusion
  let d : ∀ n, ((C (n + 1)).ι → Λ) →ₗ[R] ((C n).ι → Λ) := fun n ↦
    (LinearMap.ker (C n).c).subtype ∘ₗ (C (n + 1)).c
  have hd : ∀ n x, d n x = (LinearMap.ker (C n).c).subtype ((C (n + 1)).c x) := fun _ _ ↦ rfl
  refine ⟨{
    P := fun n ↦ (C n).ι → Λ
    PP := fun n ↦ GMod.free GΛ (C n).b
    d := d
    ε := (C 0).c
    d_map := fun n ↦ ⟨fun x a ↦ by rw [hd, hd, (C (n + 1)).hc.act]; rfl,
      fun p x hx ↦ (ZGr.ker_isHom (GMod.free GΛ (C n).b) (syz GΛ S n).XX (C n).hc.deg _ _).1
        ((C (n + 1)).hc.deg p x hx)⟩
    ε_map := (C 0).hc
    ε_surj := (C 0).surj
    exact_zero := ?_
    exact := fun n ↦ ?_
    proj := fun n ↦ gProj_free _
    fin := fun n ↦ inferInstance }⟩
  · ext y
    constructor
    · intro hy
      obtain ⟨x, hx⟩ := (C 1).surj ⟨y, hy⟩
      exact ⟨x, by rw [hd, hx]; rfl⟩
    · rintro ⟨x, rfl⟩
      exact ((C 1).c x).2
  · ext y
    constructor
    · intro hy
      have hy' : (C (n + 1)).c y = 0 := Subtype.ext (by
        have := hy
        rw [LinearMap.mem_ker, hd] at this
        exact this)
      obtain ⟨x, hx⟩ := (C (n + 2)).surj ⟨y, hy'⟩
      exact ⟨x, by rw [hd, hx]; rfl⟩
    · rintro ⟨x, rfl⟩
      have h0 : (C (n + 1)).c (d (n + 1) x) = 0 := LinearMap.mem_ker.1 ((C (n + 2)).c x).2
      rw [LinearMap.mem_ker, hd, h0]; rfl

end Exists

end Ring

section FieldCase

variable {k : Type v} [Field k] {Λ : Type u} [Ring Λ] [Algebra k Λ] {GΛ : GAlg (R := k) Λ}
  {N : Type*} [AddCommGroup N] [Module k N]

/-- **The comparison over a field**: no projectivity hypotheses. -/
theorem GRes.extVanish_iff_field (NN : GMod GΛ N) (n : ℕ) {M : Type w} [AddCommGroup M]
    [Module k M] {MM : GMod GΛ M} (Rs : GRes MM) (t : ℤ) :
    Rs.ExtVanish NN n t ↔ GExt.ExtVanish MM NN n t :=
  GRes.extVanish_iff (fun _ ↦ inferInstance) NN n Rs (fun _ ↦ inferInstance) t

end FieldCase

end GExt

end MultiplicativeBasisDeformations
