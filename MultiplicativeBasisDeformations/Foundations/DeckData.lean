module

public import MultiplicativeBasisDeformations.Foundations.ModelDeck
public import MultiplicativeBasisDeformations.Foundations.StarGaugeQ

/-!
# Deck data of a periodic star model

From Proposition 4.1 (`periodic-mesh-calculations.tex`): for a
covering `π : ℤΔ → Q` of a finite quiver by a star model, the deck group is
generated by a transformation of height form `g (v, t) = (ρ v, t + c₀)` with
`c₀ > 0`, and the fibres of `π` are the `g`-orbits. We restate this in the form
used by the gauge and trace arguments: `π ∘ g = π`, and two vertices with the
same image differ by a power of `g` or its inverse.
-/

@[expose] public section

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option backward.isDefEq.respectTransparency false

noncomputable section

open CategoryTheory

namespace MultiplicativeBasisDeformations

universe u w

namespace StarDeck

variable {t : ℕ} {L : Fin t → ℕ}
  {V : Type u} [Quiver.{w} V] [∀ x y : V, Subsingleton (x ⟶ y)] {Q : TranslationQuiver V}
  (hQ : Q.IsStable) (π : (starTree L).ZVert ⥤q V) (hπ : π.IsCovering)
  (hτ : ∀ Y, π.obj ((starTree L).ztau Y) = hQ.tauE (π.obj Y))

include hτ in
/-- A covering of a finite quiver by `ℤΔ` identifies two distinct vertices. -/
theorem exists_ne_same_image [Finite V] : ∃ X Y : (starTree L).ZVert, X ≠ Y ∧ π.obj X = π.obj Y := by
  let f : ℕ → V := fun n ↦ π.obj (((starTree L).ztau)^[n] (o L))
  obtain ⟨n, n', hne, hnn⟩ := Finite.exists_ne_map_eq_of_infinite f
  have ht : ∀ n : ℕ, ((((starTree L).ztau)^[n] (o L))).t = (o L).t - 2 * n := by
    intro n; induction n with
    | zero => simp
    | succ n ih => rw [Function.iterate_succ_apply']; simp only [OrientedTree.ztau, ih]; push_cast; ring
  refine ⟨_, _, fun h ↦ hne ?_, hnn⟩
  have := congrArg OrientedTree.ZVert.t h
  rw [ht, ht] at this
  omega

include hπ hτ in
/-- **The deck data of a periodic star model** (Proposition 4.1(3)). -/
theorem deck_data [Finite V] (ht : 0 < t) (hcl : t = 1 ∨ t = 3) :
    ∃ (ρ : StarV L ≃ StarV L)
      (hρ : ∀ a b, (starTree L).G.Adj (ρ a) (ρ b) ↔ (starTree L).G.Adj a b) (c0 : ℕ)
      (hρp : ∀ v, (starTree L).par (ρ v) = (starTree L).par v + ((c0 : ℤ) : ZMod 2)),
      0 < c0 ∧ (∀ a b, starAdj a b ↔ starAdj (ρ a) (ρ b)) ∧
      (∀ Z, π.obj (((starTree L).zAct ρ hρ (c0 : ℤ) hρp).obj Z) = π.obj Z) ∧
      ∀ X Y, π.obj X = π.obj Y → ∃ n : ℕ,
        Y = (StarGauge.gZ ρ hρ c0 hρp)^[n] X ∨ X = (StarGauge.gZ ρ hρ c0 hρp)^[n] Y := by
  obtain ⟨z₀, hz₀, hpos, horb⟩ := deck_cyclic L hQ π hπ hτ ht hcl
    (exists_ne_same_image hQ π hτ)
  obtain ⟨ρ, hρ', hF⟩ := deck_height_form L hQ π hπ hτ ht z₀ hz₀
  obtain ⟨c0, hc0⟩ : ∃ c0 : ℕ, (c0 : ℤ) = z₀.t := ⟨z₀.t.toNat, by omega⟩
  have hρ : ∀ a b, (starTree L).G.Adj (ρ a) (ρ b) ↔ (starTree L).G.Adj a b :=
    fun a b ↦ (hρ' a b).symm
  have hρp : ∀ v, (starTree L).par (ρ v) = (starTree L).par v + ((c0 : ℤ) : ZMod 2) := by
    intro v
    have h1 := (Hz L π hπ z₀ hz₀ (B L v)).ht
    rw [(hF (B L v)).1, (hF (B L v)).2, ← hc0] at h1
    change ((((starDepth v : ℕ) : ℤ) + (c0 : ℤ) : ℤ) : ZMod 2) = (starTree L).par (ρ v) at h1
    rw [← h1]; push_cast; rfl
  have hzA : ∀ Z, ((starTree L).zAct ρ hρ (c0 : ℤ) hρp).obj Z = Hz L π hπ z₀ hz₀ Z := by
    intro Z
    apply OrientedTree.ZVert.ext
    · exact (hF Z).1.symm
    · rw [(hF Z).2, ← hc0]; rfl
  have hdeck : ∀ Z, π.obj (((starTree L).zAct ρ hρ (c0 : ℤ) hρp).obj Z) = π.obj Z := by
    intro Z; rw [hzA]; exact π_Hz L hQ π hπ hτ z₀ hz₀ Z
  have hpow : ∀ (n : ℕ) (X : (starTree L).ZVert),
      ((deck L hQ π hπ hτ ht z₀ hz₀) ^ n) X = (StarGauge.gZ ρ hρ c0 hρp)^[n] X := by
    intro n; induction n with
    | zero => intro X; rfl
    | succ n ih =>
        intro X
        rw [pow_succ', Equiv.Perm.mul_apply, ih, Function.iterate_succ_apply', deck_apply,
          ← hzA]
  refine ⟨ρ, hρ, c0, hρp, by omega, hρ', hdeck, fun X Y hXY ↦ ?_⟩
  obtain ⟨l, hl⟩ := (horb X Y).1 hXY
  rcases le_or_gt 0 l with hl0 | hl0
  · obtain ⟨n, rfl⟩ := Int.eq_ofNat_of_zero_le hl0
    refine ⟨n, Or.inl ?_⟩
    rw [← hl, zpow_natCast, hpow]
  · obtain ⟨n, hn⟩ : ∃ n : ℕ, (n : ℤ) = -l := ⟨(-l).toNat, by omega⟩
    refine ⟨n, Or.inr ?_⟩
    rw [← hpow, ← hl, ← Equiv.Perm.mul_apply, ← zpow_natCast, hn, ← zpow_add, neg_add_cancel,
      zpow_zero, Equiv.Perm.one_apply]

end StarDeck

end MultiplicativeBasisDeformations
