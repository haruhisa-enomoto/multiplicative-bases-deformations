import Mathlib
import MBDVendor.QSE.Foundation.RingTheory.KrullSchmidt.Indecomposable

/-!
# Lemma 2.9 for an arbitrary finite-dimensional algebra

`lem:projective-evaluation-criterion` (`graded-category.tex:443–487`): "Let `Λ` be a
finite-dimensional algebra over any field, let `e` be an idempotent, and put `Λ_e = eΛe`. Assume
`Hom_Λ(T, Λ) = Ext¹_Λ(T, Λ) = 0` whenever `Te = 0`. Then `P ↦ Pe` is fully faithful on `proj Λ`.
If `gl.dim Λ ≤ 2` and every finite-dimensional injective `Λ_e`-module is `Qe` for some projective
`Λ`-module `Q`, this functor is an equivalence `proj Λ ≃ mod Λ_e`. In particular, `Λ_e` is
representation-finite. It suffices to check the two vanishings on the simple `Λ`-modules killed
by `e`."

Conventions. The manuscript's right `Λ`-modules are the left modules over `R = Λᵐᵒᵖ`, and `Me` is
`ε M` for `ε = op e`; so we work with left modules over an arbitrary finite-dimensional algebra
`R` and an idempotent `ε`. `Λ_e` is Mathlib's corner ring `hε.Corner` (`ε R ε`, with unit `ε`),
and `ε M` is a `Λ_e`-module (`EP`); evaluation is `EPmap`. `Ext¹_R(T, Q) = 0` is taken in Yoneda
form: every extension `0 → Q → E → T → 0` splits (`ExtVan`). `gl.dim R ≤ 2` is used, as in the
proof, through "a second syzygy is projective": the kernel of a map between finitely generated
projectives is projective.

The proof is the source's, without tensor products (as in `ProjectiveEvaluation.lean`): a map
`g : εM → εQ` is defined on the submodule generated by `εM` by `∑ λ_i m_i ↦ ∑ λ_i g(m_i)`, well
defined because the discrepancy is a submodule of `Q` killed by `ε`; it extends to `M` because
`M / R εM` is killed by `ε` (`Ext¹`); injectivity is the Hom-vanishing for `M / R εM`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

noncomputable section

namespace MultiplicativeBasisDeformations

namespace EvalCriterion

universe u

variable (k : Type u) [Field k] {R : Type u} [Ring R]

section Defs

variable [Algebra k R] {ε : R}

/-- A module killed by `ε`. -/
def Killed (ε : R) (M : Type*) [AddCommGroup M] [Module R M] : Prop := ∀ m : M, ε • m = 0

/-- `Hom_R(T, Q) = 0` for every finite-dimensional `T` killed by `ε`. -/
def HomVan (ε : R) (Q : Type u) [AddCommGroup Q] [Module R Q] : Prop :=
  ∀ (T : Type u) [AddCommGroup T] [Module k T] [Module R T] [IsScalarTower k R T]
    [FiniteDimensional k T], Killed ε T → ∀ f : T →ₗ[R] Q, f = 0

/-- `Ext¹_R(T, Q) = 0` in Yoneda form: every extension `0 → Q → E → T → 0` of
finite-dimensional modules splits. -/
def SplitsFor (R : Type u) [Ring R] [Algebra k R] (T Q : Type u) [AddCommGroup T] [Module R T]
    [AddCommGroup Q] [Module R Q] : Prop :=
  ∀ (E : Type u) [AddCommGroup E] [Module k E] [Module R E] [IsScalarTower k R E]
    [FiniteDimensional k E] (i : Q →ₗ[R] E) (p : E →ₗ[R] T),
    Function.Injective i → Function.Surjective p → LinearMap.range i = LinearMap.ker p →
    ∃ r : E →ₗ[R] Q, r ∘ₗ i = LinearMap.id

/-- `Ext¹_R(T, Q) = 0` for every finite-dimensional `T` killed by `ε`. -/
def ExtVan (ε : R) (Q : Type u) [AddCommGroup Q] [Module R Q] : Prop :=
  ∀ (T : Type u) [AddCommGroup T] [Module k T] [Module R T] [IsScalarTower k R T]
    [FiniteDimensional k T], Killed ε T → SplitsFor k R T Q

/-- The extension form of `Ext¹`-vanishing: maps into `Q` extend from a submodule with quotient
killed by `ε`. -/
def ExtExt (ε : R) (Q : Type u) [AddCommGroup Q] [Module R Q] : Prop :=
  ∀ (M : Type u) [AddCommGroup M] [Module k M] [Module R M] [IsScalarTower k R M]
    [FiniteDimensional k M] (N : Submodule R M), Killed ε (M ⧸ N) →
    ∀ g : N →ₗ[R] Q, ∃ g' : M →ₗ[R] Q, ∀ n : N, g' n = g n

end Defs

/-! ### Yoneda splitting gives the extension form (pushout) -/

section Pushout

variable {k} [Algebra k R] {ε : R} {Q : Type u} [AddCommGroup Q] [Module R Q]
  {M : Type u} [AddCommGroup M] [Module R M]
  (N : Submodule R M) (g : N →ₗ[R] Q)

/-- The pushout relations `(g n, -n)`. -/
def pushRel : Submodule R (Q × M) :=
  LinearMap.range (LinearMap.prod g (-N.subtype))

/-- The pushout `E = (Q ⊕ M) / {(g n, -n)}`. -/
abbrev Push := (Q × M) ⧸ pushRel N g

/-- `Q → E`. -/
def pushI : Q →ₗ[R] Push N g := (pushRel N g).mkQ ∘ₗ LinearMap.inl R Q M

/-- `E → M/N`. -/
def pushP : Push N g →ₗ[R] M ⧸ N :=
  (pushRel N g).liftQ (N.mkQ ∘ₗ LinearMap.snd R Q M) (by
    rintro _ ⟨n, rfl⟩
    simp)

theorem pushI_injective : Function.Injective (pushI N g) := by
  rw [← LinearMap.ker_eq_bot, eq_bot_iff]
  intro q hq
  rw [LinearMap.mem_ker, pushI, LinearMap.comp_apply, Submodule.mkQ_apply,
    Submodule.Quotient.mk_eq_zero] at hq
  obtain ⟨n, hn⟩ := hq
  have h1 := congrArg Prod.fst hn
  have h2 := congrArg Prod.snd hn
  simp only [LinearMap.prod_apply, LinearMap.inl_apply] at h1 h2
  have : n = 0 := Subtype.ext (by
    have := neg_eq_zero.1 (h2.trans rfl)
    simpa using this)
  rw [this] at h1
  simpa using h1.symm

theorem pushP_surjective : Function.Surjective (pushP N g) := by
  intro y
  obtain ⟨m, rfl⟩ := N.mkQ_surjective y
  exact ⟨Submodule.Quotient.mk (0, m), rfl⟩

theorem push_exact : LinearMap.range (pushI N g) = LinearMap.ker (pushP N g) := by
  apply le_antisymm
  · rintro _ ⟨q, rfl⟩
    rw [LinearMap.mem_ker]
    rfl
  · intro x hx
    obtain ⟨⟨q, m⟩, rfl⟩ := (pushRel N g).mkQ_surjective x
    rw [LinearMap.mem_ker] at hx
    change N.mkQ m = 0 at hx
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hx
    refine ⟨q + g ⟨m, hx⟩, ?_⟩
    rw [pushI, LinearMap.comp_apply, Submodule.mkQ_apply, Submodule.mkQ_apply,
      ← sub_eq_zero, ← Submodule.Quotient.mk_sub, Submodule.Quotient.mk_eq_zero]
    refine ⟨⟨m, hx⟩, ?_⟩
    simp

end Pushout

section Splits

variable {k} [Algebra k R]

/-- **Splitting of the pushout extends maps**. -/
theorem extend_of_splits {Q : Type u} [AddCommGroup Q] [Module k Q] [Module R Q]
    [IsScalarTower k R Q] [FiniteDimensional k Q]
    {M : Type u} [AddCommGroup M] [Module k M] [Module R M] [IsScalarTower k R M]
    [FiniteDimensional k M] (N : Submodule R M) (h : SplitsFor k R (M ⧸ N) Q) (g : N →ₗ[R] Q) :
    ∃ g' : M →ₗ[R] Q, ∀ n : N, g' n = g n := by
  obtain ⟨r, hr⟩ := h (Push N g) (pushI N g) (pushP N g) (pushI_injective N g)
    (pushP_surjective N g) (push_exact N g)
  refine ⟨r ∘ₗ (pushRel N g).mkQ ∘ₗ LinearMap.inr R Q M, fun n ↦ ?_⟩
  have e : (pushRel N g).mkQ (LinearMap.inr R Q M n) = pushI N g (g n) := by
    rw [pushI, LinearMap.comp_apply, Submodule.mkQ_apply, Submodule.mkQ_apply,
      ← sub_eq_zero, ← Submodule.Quotient.mk_sub, Submodule.Quotient.mk_eq_zero]
    exact ⟨-n, by simp⟩
  simp only [LinearMap.comp_apply]
  rw [e, ← LinearMap.comp_apply r, hr, LinearMap.id_apply]

theorem extExt_of_extVan {ε : R} {Q : Type u} [AddCommGroup Q] [Module k Q]
    [Module R Q] [IsScalarTower k R Q] [FiniteDimensional k Q]
    (h : ExtVan k ε Q) : ExtExt k ε Q := fun M _ _ _ _ _ N hN g ↦
  extend_of_splits N (h (M ⧸ N) hN) g

end Splits

/-! ### Transfer to finitely generated projectives -/

section Transfer

variable {k} [Algebra k R] {ε : R}

theorem homVan_pi {n : ℕ} (h : HomVan k ε R) : HomVan k ε (Fin n → R) := by
  intro T _ _ _ _ _ hT f
  ext t i
  have := h T hT (LinearMap.proj i ∘ₗ f)
  exact congrArg (fun φ : T →ₗ[R] R ↦ φ t) this

theorem extExt_pi {n : ℕ} (h : ExtExt k ε R) : ExtExt k ε (Fin n → R) := by
  intro M _ _ _ _ _ N hN g
  choose G hG using fun i : Fin n ↦ h M N hN (LinearMap.proj i ∘ₗ g)
  refine ⟨LinearMap.pi G, fun x ↦ ?_⟩
  ext i
  simp only [LinearMap.pi_apply]
  exact hG i x

variable {F Q : Type u} [AddCommGroup F] [Module R F] [AddCommGroup Q] [Module R Q]
  (s : Q →ₗ[R] F) (r : F →ₗ[R] Q) (hrs : r ∘ₗ s = LinearMap.id)

include hrs in
theorem homVan_retract (h : HomVan k ε F) : HomVan k ε Q := by
  intro T _ _ _ _ _ hT f
  have := h T hT (s ∘ₗ f)
  calc f = (r ∘ₗ s) ∘ₗ f := by rw [hrs, LinearMap.id_comp]
    _ = r ∘ₗ (s ∘ₗ f) := rfl
    _ = 0 := by rw [this, LinearMap.comp_zero]

include hrs in
theorem extExt_retract (h : ExtExt k ε F) : ExtExt k ε Q := by
  intro M _ _ _ _ _ N hN g
  obtain ⟨G, hG⟩ := h M N hN (s ∘ₗ g)
  refine ⟨r ∘ₗ G, fun x ↦ ?_⟩
  rw [LinearMap.comp_apply, hG, LinearMap.comp_apply, ← LinearMap.comp_apply r s, hrs,
    LinearMap.id_apply]

/-- A finitely generated projective module is a retract of some `R^n`. -/
theorem exists_retract [Module.Finite R Q] [Module.Projective R Q] :
    ∃ (n : ℕ) (s : Q →ₗ[R] (Fin n → R)) (r : (Fin n → R) →ₗ[R] Q), r ∘ₗ s = LinearMap.id := by
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R Q
  obtain ⟨h, hh⟩ := Module.projective_lifting_property f LinearMap.id hf
  exact ⟨n, h, f, hh⟩

/-- **The vanishings transfer from `R` to every finitely generated projective.** -/
theorem van_proj [FiniteDimensional k R] [Module.Finite R Q] [Module.Projective R Q] (h0 : HomVan k ε R)
    (h1 : ExtVan k ε R) : HomVan k ε Q ∧ ExtExt k ε Q := by
  obtain ⟨n, s, r, hrs⟩ := exists_retract (R := R) (Q := Q)
  exact ⟨homVan_retract s r hrs (homVan_pi h0),
    extExt_retract s r hrs (extExt_pi (extExt_of_extVan h1))⟩

end Transfer

/-! ### The corner `Λ_e` and the evaluation `M ↦ εM` -/

section Corner

variable {ε : R} (hε : IsIdempotentElem ε)

theorem corner_left (c : hε.Corner) : ε * c.1 = c.1 :=
  ((Subsemigroup.mem_corner_iff hε).1 c.2).1

theorem corner_right (c : hε.Corner) : c.1 * ε = c.1 :=
  ((Subsemigroup.mem_corner_iff hε).1 c.2).2

@[simp] theorem corner_one : (1 : hε.Corner).1 = ε := rfl

@[simp] theorem corner_mul (a b : hε.Corner) : (a * b).1 = a.1 * b.1 := rfl

@[simp] theorem corner_add (a b : hε.Corner) : (a + b).1 = a.1 + b.1 := rfl

@[simp] theorem corner_zero : (0 : hε.Corner).1 = 0 := rfl

/-- The corner element `ε r ε`. -/
def cor (r : R) : hε.Corner := ⟨ε * r * ε, r, rfl⟩

@[simp] theorem cor_val (r : R) : (cor hε r).1 = ε * r * ε := rfl

variable (M : Type u) [AddCommGroup M] [Module R M]

/-- `εM` as an additive group. -/
def EPsub (ε : R) (M : Type u) [AddCommGroup M] [Module R M] : AddSubgroup M where
  carrier := {m | ε • m = m}
  add_mem' {a b} ha hb := by simp only [Set.mem_ofPred_eq, smul_add] at *; rw [ha, hb]
  zero_mem' := smul_zero ε
  neg_mem' {a} ha := by simp only [Set.mem_ofPred_eq, smul_neg] at *; rw [ha]

/-- **`εM` as a `Λ_e`-module**: the evaluation of `M`. -/
def EP (_hε : IsIdempotentElem ε) (M : Type u) [AddCommGroup M] [Module R M] : Type u :=
  EPsub ε M

instance : AddCommGroup (EP hε M) := inferInstanceAs (AddCommGroup (EPsub ε M))

variable {M}

theorem EP_spec (m : EP hε M) : ε • (m.1 : M) = m.1 := m.2

instance : Module hε.Corner (EP hε M) where
  smul c m := ⟨c.1 • m.1, by
    change ε • (c.1 • m.1) = c.1 • m.1
    rw [← mul_smul, corner_left]⟩
  one_smul m := Subtype.ext (EP_spec hε m)
  mul_smul a b m := Subtype.ext (mul_smul a.1 b.1 m.1)
  smul_zero c := Subtype.ext (smul_zero c.1)
  smul_add c a b := Subtype.ext (smul_add c.1 a.1 b.1)
  add_smul a b m := Subtype.ext (add_smul a.1 b.1 m.1)
  zero_smul m := Subtype.ext (zero_smul R m.1)

@[simp] theorem EP_smul_val (c : hε.Corner) (m : EP hε M) : (c • m).1 = c.1 • m.1 := rfl

@[simp] theorem EP_add_val (a b : EP hε M) : (a + b).1 = a.1 + b.1 := rfl

@[simp] theorem EP_zero_val : (0 : EP hε M).1 = 0 := rfl

/-- The element `ε m` of `εM`. -/
def epOf (m : M) : EP hε M := ⟨ε • m, by change ε • ε • m = ε • m; rw [← mul_smul, hε.eq]⟩

variable {N : Type u} [AddCommGroup N] [Module R N]

/-- **Evaluation** of a map: restriction to `εM`. -/
def EPmap (f : M →ₗ[R] N) : EP hε M →ₗ[hε.Corner] EP hε N where
  toFun m := ⟨f m.1, by change ε • f m.1 = f m.1; rw [← map_smul, EP_spec hε m]⟩
  map_add' a b := Subtype.ext (map_add f a.1 b.1)
  map_smul' c m := Subtype.ext (map_smul f c.1 m.1)

@[simp] theorem EPmap_val (f : M →ₗ[R] N) (m : EP hε M) : (EPmap hε f m).1 = f m.1 := rfl

end Corner

/-! ### Full faithfulness on projectives -/

section FullyFaithful

variable [Algebra k R] {ε : R} (hε : IsIdempotentElem ε)

theorem fd_sub {Q : Type u} [AddCommGroup Q] [Module k Q] [Module R Q] [IsScalarTower k R Q]
    [FiniteDimensional k Q] (L : Submodule R Q) : FiniteDimensional k L :=
  inferInstanceAs (FiniteDimensional k (L.restrictScalars k))

variable {M Q : Type u} [AddCommGroup M] [Module k M] [Module R M] [IsScalarTower k R M]
  [FiniteDimensional k M] [AddCommGroup Q] [Module k Q] [Module R Q] [IsScalarTower k R Q]
  [FiniteDimensional k Q]

/-- A submodule containing `εM` has quotient killed by `ε`. -/
theorem killed_quot (N : Submodule R M) (hN : ∀ m : M, ε • m ∈ N) : Killed ε (M ⧸ N) := by
  intro x
  obtain ⟨m, rfl⟩ := N.mkQ_surjective x
  rw [Submodule.mkQ_apply, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
  exact hN m

/-- The submodule generated by `εM`. -/
def genE (M : Type u) [AddCommGroup M] [Module R M] (ε : R) : Submodule R M :=
  Submodule.span R {m | ε • m = m}

include hε in
theorem smul_mem_genE (m : M) : ε • m ∈ genE M ε :=
  Submodule.subset_span (show ε • ε • m = ε • m by rw [← mul_smul, hε.eq])

include hε in
/-- **Evaluation is faithful** when `Hom_R(T, Q) = 0` for `T` killed by `ε`. -/
theorem EPmap_injective (hQ0 : HomVan k ε Q) :
    Function.Injective (fun f : M →ₗ[R] Q ↦ EPmap hε f) := by
  intro f g hfg
  have hv : ∀ m : M, ε • m = m → (f - g) m = 0 := fun m hm ↦ by
    have := congrArg (fun φ : EP hε M →ₗ[hε.Corner] EP hε Q ↦ (φ ⟨m, hm⟩).1) hfg
    change f m = g m at this
    rw [LinearMap.sub_apply, this, sub_self]
  have hle : genE M ε ≤ LinearMap.ker (f - g) :=
    Submodule.span_le.2 fun m hm ↦ hv m hm
  have := hQ0 (M ⧸ genE M ε) (killed_quot (genE M ε) (smul_mem_genE hε))
    ((genE M ε).liftQ (f - g) hle)
  rw [← sub_eq_zero]
  ext m
  have h2 := congrArg (fun φ : M ⧸ genE M ε →ₗ[R] Q ↦ φ (Submodule.Quotient.mk m)) this
  simpa using h2

include hε in
/-- **Evaluation is full** when moreover `Ext¹_R(T, Q) = 0` for `T` killed by `ε`
(`graded-category.tex:458–470`, without the tensor product). -/
theorem EPmap_surjective (hQ0 : HomVan k ε Q) (hQ1 : ExtExt k ε Q)
    (g : EP hε M →ₗ[hε.Corner] EP hε Q) : ∃ f : M →ₗ[R] Q, EPmap hε f = g := by
  classical
  let Φ : (EP hε M →₀ R) →ₗ[R] M := Finsupp.linearCombination R (fun m : EP hε M ↦ m.1)
  let Ψ : (EP hε M →₀ R) →ₗ[R] Q := Finsupp.linearCombination R (fun m : EP hε M ↦ (g m).1)
  -- `ε Ψ(x) = g(ε Φ(x))`
  have key : ∀ x, ε • Ψ x = (g (epOf hε (Φ x))).1 := by
    intro x
    induction x using Finsupp.induction_linear with
    | zero =>
        have : epOf hε (Φ 0) = 0 := Subtype.ext (by simp [epOf])
        rw [map_zero, smul_zero, this, map_zero]; rfl
    | add x y hx hy =>
        have : epOf hε (Φ (x + y)) = epOf hε (Φ x) + epOf hε (Φ y) :=
          Subtype.ext (by simp [epOf, smul_add]; rfl)
        rw [map_add, smul_add, hx, hy, this, map_add]; rfl
    | single m r =>
        have h1 : epOf hε (Φ (Finsupp.single m r)) = cor hε r • m := by
          apply Subtype.ext
          simp only [epOf, Φ, Finsupp.linearCombination_single, EP_smul_val, cor_val]
          change ε • r • m.1 = (ε * r * ε) • m.1
          rw [mul_smul, mul_smul, EP_spec hε m, ← mul_smul]
        rw [h1, map_smul, EP_smul_val, cor_val]
        simp only [Ψ, Finsupp.linearCombination_single]
        rw [mul_smul, mul_smul, EP_spec hε (g m), ← mul_smul]
  -- the discrepancy is killed by `ε`, hence zero
  have hker : LinearMap.ker Φ ≤ LinearMap.ker Ψ := by
    have hL : Killed ε ((LinearMap.ker Φ).map Ψ) := by
      rintro ⟨_, x, hx, rfl⟩
      apply Subtype.ext
      change ε • Ψ x = 0
      rw [key, LinearMap.mem_ker.1 hx]
      have : epOf hε (0 : M) = 0 := Subtype.ext (smul_zero ε)
      rw [this, map_zero]; rfl
    have := fd_sub (k := k) ((LinearMap.ker Φ).map Ψ)
    have h0 := hQ0 _ hL ((LinearMap.ker Φ).map Ψ).subtype
    intro x hx
    have := congrArg (fun φ : ((LinearMap.ker Φ).map Ψ) →ₗ[R] Q ↦ φ ⟨Ψ x, x, hx, rfl⟩) h0
    simpa using this
  -- the map on the submodule generated by `εM`
  let g₀ : LinearMap.range Φ →ₗ[R] Q :=
    (LinearMap.ker Φ).liftQ Ψ hker ∘ₗ (Φ.quotKerEquivRange).symm.toLinearMap
  have hg₀ : ∀ x, g₀ ⟨Φ x, LinearMap.mem_range_self Φ x⟩ = Ψ x := by
    intro x
    show (LinearMap.ker Φ).liftQ Ψ hker
      ((Φ.quotKerEquivRange).symm ⟨Φ x, LinearMap.mem_range_self Φ x⟩) = Ψ x
    rw [LinearMap.quotKerEquivRange_symm_apply_image]
    rfl
  have hN : ∀ m : M, ε • m ∈ LinearMap.range Φ := fun m ↦
    ⟨Finsupp.single (epOf hε m) 1, by
      simp only [Φ, Finsupp.linearCombination_single, one_smul]; rfl⟩
  obtain ⟨f, hf⟩ := hQ1 M (LinearMap.range Φ) (killed_quot _ hN) g₀
  refine ⟨f, LinearMap.ext fun m ↦ Subtype.ext ?_⟩
  have hm : (m.1 : M) = Φ (Finsupp.single m 1) := by
    simp only [Φ, Finsupp.linearCombination_single, one_smul]
  have := hf ⟨Φ (Finsupp.single m 1), LinearMap.mem_range_self Φ _⟩
  rw [hg₀] at this
  change f m.1 = (g m).1
  rw [hm]
  change f ((⟨Φ (Finsupp.single m 1), LinearMap.mem_range_self Φ _⟩ : LinearMap.range Φ) : M) = _
  rw [this]
  simp only [Ψ, Finsupp.linearCombination_single, one_smul]

end FullyFaithful

/-! ### It suffices to check the simples -/

section Simples

variable [Algebra k R] [FiniteDimensional k R]

/-- The two vanishings on the simple modules killed by `ε`. -/
def SimpleVan (ε : R) : Prop :=
  ∀ (S : Type u) [AddCommGroup S] [Module k S] [Module R S] [IsScalarTower k R S]
    [FiniteDimensional k S], IsSimpleModule R S → Killed ε S →
    (∀ f : S →ₗ[R] R, f = 0) ∧ SplitsFor k R S R

variable {k} {ε : R}

theorem homVan_of_simple (h : SimpleVan k ε) : HomVan k ε R := by
  intro T _ _ _ _ _ hT f
  have : IsArtinianRing R := IsArtinianRing.of_finite k R
  by_contra hf
  rcases IsAtomic.eq_bot_or_exists_atom_le (LinearMap.range f) with h0 | ⟨a, ha, hle⟩
  · exact hf (LinearMap.range_eq_bot.1 h0)
  have : IsSimpleModule R a := isSimpleModule_iff_isAtom.2 ha
  have := fd_sub (k := k) a
  have hk : Killed ε a := by
    rintro ⟨x, hx⟩
    obtain ⟨t, rfl⟩ := hle hx
    apply Subtype.ext
    change ε • f t = 0
    rw [← map_smul, hT t, map_zero]
  have h0 := (h a inferInstance hk).1 a.subtype
  apply ha.1
  rw [eq_bot_iff]
  intro x hx
  have := congrArg (fun φ : a →ₗ[R] R ↦ φ ⟨x, hx⟩) h0
  simpa using this

/-- **Extension from submodules with quotient killed by `ε`**, by induction on the codimension:
extend to a maximal submodule (induction), then across the simple quotient. -/
theorem extExt_of_simple (h : SimpleVan k ε) : ∀ (d : ℕ) (M : Type u) [AddCommGroup M]
    [Module k M] [Module R M] [IsScalarTower k R M] [FiniteDimensional k M] (N : Submodule R M),
    Module.finrank k M - Module.finrank k N = d → Killed ε (M ⧸ N) →
    ∀ g : N →ₗ[R] R, ∃ g' : M →ₗ[R] R, ∀ n : N, g' n = g n := by
  intro d
  induction d using Nat.strong_induction_on with
  | _ d ih =>
  intro M _ _ _ _ _ N hd hN g
  rcases eq_or_ne N ⊤ with rfl | hNt
  · refine ⟨g ∘ₗ LinearMap.codRestrict ⊤ LinearMap.id (fun _ ↦ trivial), fun n ↦ ?_⟩
    rfl
  have : IsNoetherian R M := isNoetherian_of_tower k inferInstance
  obtain ⟨N'', hco, hle⟩ := (eq_top_or_exists_le_coatom N).resolve_left hNt
  -- extend to `N''` by induction
  set N₀ : Submodule R N'' := N.comap N''.subtype
  let e₀ : N₀ ≃ₗ[R] N := Submodule.comapSubtypeEquivOfLe hle
  have := fd_sub (k := k) N''
  have hf0 : Module.finrank k N₀ = Module.finrank k N := (e₀.restrictScalars k).finrank_eq
  have hlt : Module.finrank k N'' < Module.finrank k M := by
    have : N''.restrictScalars k ≠ ⊤ := by
      intro htop
      apply hco.1
      ext x
      have := congrArg (fun L : Submodule k M ↦ x ∈ L) htop
      simpa using this
    exact Submodule.finrank_lt this
  have hmono : Module.finrank k N ≤ Module.finrank k N'' :=
    Submodule.finrank_mono (Submodule.restrictScalars_mono k hle)
  have hN₀ : Killed ε (N'' ⧸ N₀) := by
    refine killed_quot N₀ fun x ↦ ?_
    change ε • x.1 ∈ N
    have := hN (N.mkQ x.1)
    rwa [Submodule.mkQ_apply, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at this
  obtain ⟨g₁, hg₁⟩ := ih (Module.finrank k N'' - Module.finrank k N₀) (by omega) N'' N₀ rfl hN₀
    (g ∘ₗ e₀.toLinearMap)
  -- extend across the simple quotient `M / N''`
  have : IsSimpleModule R (M ⧸ N'') := (isSimpleModule_iff_isCoatom).2 hco
  have hN'' : Killed ε (M ⧸ N'') := by
    refine killed_quot N'' fun m ↦ hle ?_
    have := hN (N.mkQ m)
    rwa [Submodule.mkQ_apply, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at this
  obtain ⟨g', hg'⟩ := extend_of_splits N'' (h (M ⧸ N'') inferInstance hN'').2 g₁
  refine ⟨g', fun n ↦ ?_⟩
  rw [show (n : M) = ((⟨n, hle n.2⟩ : N'') : M) from rfl, hg']
  have := hg₁ ⟨⟨n, hle n.2⟩, n.2⟩
  rw [this]
  rfl

theorem extVan_of_simple (h : SimpleVan k ε) : ExtVan k ε R := by
  intro T _ _ _ _ _ hT E _ _ _ _ _ i p hi hp hex
  have hN : Killed ε (E ⧸ LinearMap.range i) := by
    refine killed_quot _ fun x ↦ ?_
    rw [hex, LinearMap.mem_ker, map_smul, hT]
  obtain ⟨r, hr⟩ := extExt_of_simple h _ E (LinearMap.range i) rfl hN
    (LinearEquiv.ofInjective i hi).symm.toLinearMap
  refine ⟨r, LinearMap.ext fun x ↦ ?_⟩
  have := hr ⟨i x, x, rfl⟩
  rw [LinearMap.comp_apply, LinearMap.id_apply]
  change r ((⟨i x, x, rfl⟩ : LinearMap.range i) : E) = x
  rw [this]
  exact (LinearEquiv.ofInjective i hi).symm_apply_apply x

/-- **It suffices to check the two vanishings on the simple modules killed by `ε`.** -/
theorem van_of_simple (h : SimpleVan k ε) : HomVan k ε R ∧ ExtVan k ε R :=
  ⟨homVan_of_simple h, extVan_of_simple h⟩

end Simples

/-! ### The corner over `k` and the injective module `D(Λ_e)` -/

section CornerK

variable [Algebra k R] {ε : R} (hε : IsIdempotentElem ε)

instance cornerModuleK : Module k hε.Corner where
  smul c x := ⟨c • x.1, by
    obtain ⟨r, hr⟩ := x.2
    exact ⟨c • r, by simp only at hr ⊢; rw [← hr, mul_smul_comm, smul_mul_assoc]⟩⟩
  one_smul x := Subtype.ext (one_smul k x.1)
  mul_smul a b x := Subtype.ext (mul_smul a b x.1)
  smul_zero a := Subtype.ext (smul_zero (A := R) a)
  smul_add a x y := Subtype.ext (smul_add a x.1 y.1)
  add_smul a b x := Subtype.ext (add_smul a b x.1)
  zero_smul x := Subtype.ext (zero_smul k x.1)

@[simp] theorem corner_smul_val (c : k) (x : hε.Corner) : (c • x).1 = c • x.1 := rfl

instance : IsScalarTower k hε.Corner hε.Corner :=
  ⟨fun c a b ↦ Subtype.ext (smul_mul_assoc c a.1 b.1)⟩

/-- The inclusion `Λ_e → R` over `k`. -/
def valK : hε.Corner →ₗ[k] R where
  toFun x := x.1
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

instance [FiniteDimensional k R] : FiniteDimensional k hε.Corner :=
  FiniteDimensional.of_injective (valK k hε) Subtype.val_injective

/-- Right multiplication on `Λ_e`, over `k`. -/
def mulRightK (a : hε.Corner) : hε.Corner →ₗ[k] hε.Corner where
  toFun s := s * a
  map_add' s t := add_mul s t a
  map_smul' c s := smul_mul_assoc c s a

/-- `D(Λ_e) = Hom_k(Λ_e, k)`. -/
def DC : Type u := hε.Corner →ₗ[k] k

instance : AddCommGroup (DC k hε) := inferInstanceAs (AddCommGroup (hε.Corner →ₗ[k] k))

instance : Module k (DC k hε) := inferInstanceAs (Module k (hε.Corner →ₗ[k] k))

instance : FunLike (DC k hε) hε.Corner k := inferInstanceAs (FunLike (hε.Corner →ₗ[k] k) _ _)

/-- **`D(Λ_e)` as a left `Λ_e`-module**: `(a φ)(s) = φ(s a)`. -/
instance : Module hε.Corner (DC k hε) where
  smul a φ := (show hε.Corner →ₗ[k] k from φ) ∘ₗ mulRightK k hε a
  one_smul φ := LinearMap.ext fun s ↦ congrArg (show hε.Corner →ₗ[k] k from φ) (mul_one s)
  mul_smul a b φ := LinearMap.ext fun s ↦ congrArg (show hε.Corner →ₗ[k] k from φ) (mul_assoc s a b).symm
  smul_zero a := rfl
  smul_add a φ ψ := rfl
  add_smul a b φ := LinearMap.ext fun s ↦ by
    change (show hε.Corner →ₗ[k] k from φ) (s * (a + b)) = _
    rw [mul_add, map_add]; rfl
  zero_smul φ := LinearMap.ext fun s ↦ by
    change (show hε.Corner →ₗ[k] k from φ) (s * 0) = 0
    rw [mul_zero, map_zero]

theorem DC_smul_apply (a : hε.Corner) (φ : DC k hε) (s : hε.Corner) :
    (show hε.Corner →ₗ[k] k from a • φ) s = (show hε.Corner →ₗ[k] k from φ) (s * a) := rfl

instance : IsScalarTower k hε.Corner (DC k hε) :=
  ⟨fun c a φ ↦ LinearMap.ext fun s ↦ by
    change (show hε.Corner →ₗ[k] k from φ) (s * (c • a)) = c • (show hε.Corner →ₗ[k] k from φ) (s * a)
    rw [← map_smul]
    congr 1
    exact Subtype.ext (mul_smul_comm c s.1 a.1)⟩

instance [FiniteDimensional k R] : FiniteDimensional k (DC k hε) :=
  inferInstanceAs (FiniteDimensional k (hε.Corner →ₗ[k] k))

/-- Evaluation at `1`. -/
def ev1 : DC k hε →ₗ[k] k where
  toFun φ := (show hε.Corner →ₗ[k] k from φ) 1
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- **`D(Λ_e)` is injective** (Baer's criterion: extend `x ↦ g(x)(1)` over `k`). -/
theorem DC_injective : Module.Injective hε.Corner (DC k hε) := by
  refine Module.Baer.injective fun I g ↦ ?_
  let φ₀ : (I.restrictScalars k) →ₗ[k] k := ev1 k hε ∘ₗ (g.restrictScalars k) ∘ₗ
    ((Submodule.restrictScalarsEquiv k hε.Corner hε.Corner I).restrictScalars k).toLinearMap
  obtain ⟨φ, hφ⟩ := LinearMap.exists_extend φ₀
  refine ⟨LinearMap.toSpanSingleton hε.Corner (DC k hε) (show DC k hε from φ), fun x mem ↦ ?_⟩
  apply LinearMap.ext
  intro t
  change (show hε.Corner →ₗ[k] k from (x • (show DC k hε from φ))) t = _
  rw [DC_smul_apply]
  have h1 := congrArg (fun F : (I.restrictScalars k) →ₗ[k] k ↦ F ⟨t * x, I.mul_mem_left t mem⟩) hφ
  simp only [LinearMap.comp_apply, Submodule.subtype_apply] at h1
  change φ (t * x) = _
  rw [h1]
  simp only [φ₀, LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.restrictScalars_apply,
    LinearMap.restrictScalars_apply]
  have e : (Submodule.restrictScalarsEquiv k hε.Corner hε.Corner I) ⟨t * x, I.mul_mem_left t mem⟩ =
      t • (⟨x, mem⟩ : I) := rfl
  rw [e, map_smul]
  change (show hε.Corner →ₗ[k] k from g ⟨x, mem⟩) (1 * t) = _
  rw [one_mul]

end CornerK

/-! ### Essential surjectivity -/

section EssSurj

variable [Algebra k R] [FiniteDimensional k R] {ε : R} (hε : IsIdempotentElem ε)

section Embed

variable {X : Type u} [AddCommGroup X] [Module k X] [Module hε.Corner X]
  [IsScalarTower k hε.Corner X] [FiniteDimensional k X]

/-- `s ↦ s x`, over `k`. -/
def orbK (x : X) : hε.Corner →ₗ[k] X where
  toFun s := s • x
  map_add' s t := add_smul s t x
  map_smul' c s := smul_assoc c s x

/-- **Every finite-dimensional `Λ_e`-module embeds in some `D(Λ_e)ⁿ`.** -/
theorem exists_embed : ∃ (n : ℕ) (ι : X →ₗ[hε.Corner] (Fin n → DC k hε)), Function.Injective ι := by
  let b := Module.finBasis k X
  refine ⟨Module.finrank k X,
    { toFun x i := (show DC k hε from b.coord i ∘ₗ orbK k hε x)
      map_add' x y := by
        funext i
        apply LinearMap.ext; intro s
        change b.coord i (s • (x + y)) = b.coord i (s • x) + b.coord i (s • y)
        rw [smul_add, map_add]
      map_smul' a x := by
        funext i
        apply LinearMap.ext; intro s
        change b.coord i (s • a • x) = b.coord i ((s * a) • x)
        rw [mul_smul] }, ?_⟩
  intro x y hxy
  apply b.ext_elem
  intro i
  have h := congrArg (fun F : Fin _ → DC k hε ↦ (show hε.Corner →ₗ[k] k from F i) 1) hxy
  change b.coord i ((1 : hε.Corner) • x) = b.coord i ((1 : hε.Corner) • y) at h
  rwa [one_smul, one_smul, Module.Basis.coord_apply, Module.Basis.coord_apply] at h

end Embed

/-- **Essential surjectivity** (`graded-category.tex:470–480`): under the vanishings, if
`gl.dim R ≤ 2` (kernels of maps between finitely generated projectives are projective) and every
finite-dimensional injective `Λ_e`-module is `εQ` for a projective `Q`, every
finite-dimensional `Λ_e`-module is `εP` for a finite-dimensional projective `P`. -/
theorem essSurj (h0 : HomVan k ε R) (h1 : ExtVan k ε R)
    (hgl : ∀ (P₀ P₁ : Type u) [AddCommGroup P₀] [Module k P₀] [Module R P₀]
      [IsScalarTower k R P₀] [FiniteDimensional k P₀] [Module.Projective R P₀] [AddCommGroup P₁]
      [Module k P₁] [Module R P₁] [IsScalarTower k R P₁] [FiniteDimensional k P₁]
      [Module.Projective R P₁] (f : P₀ →ₗ[R] P₁), Module.Projective R (LinearMap.ker f))
    (hinj : ∀ (I : Type u) [AddCommGroup I] [Module k I] [Module hε.Corner I]
      [IsScalarTower k hε.Corner I] [FiniteDimensional k I], Module.Injective hε.Corner I →
      ∃ (Q : Type u) (_ : AddCommGroup Q) (_ : Module k Q) (_ : Module R Q)
        (_ : IsScalarTower k R Q) (_ : FiniteDimensional k Q) (_ : Module.Projective R Q),
        Nonempty (EP hε Q ≃ₗ[hε.Corner] I))
    (X : Type u) [AddCommGroup X] [Module k X] [Module hε.Corner X]
    [IsScalarTower k hε.Corner X] [FiniteDimensional k X] :
    ∃ (P : Type u) (_ : AddCommGroup P) (_ : Module k P) (_ : Module R P)
      (_ : IsScalarTower k R P) (_ : FiniteDimensional k P) (_ : Module.Projective R P),
      Nonempty (EP hε P ≃ₗ[hε.Corner] X) := by
  have hDinj := DC_injective k hε
  -- an injective copresentation `0 → X → I⁰ → I¹`
  obtain ⟨n, ι, hι⟩ := exists_embed k hε (X := X)
  obtain ⟨n', ι', hι'⟩ := exists_embed k hε (X := (Fin n → DC k hε) ⧸ LinearMap.range ι)
  let u := ι' ∘ₗ (LinearMap.range ι).mkQ
  have hker : LinearMap.ker u = LinearMap.range ι := by
    rw [LinearMap.ker_comp, LinearMap.ker_eq_bot.2 hι', Submodule.comap_bot, Submodule.ker_mkQ]
  obtain ⟨Q₀, _, _, _, _, _, _, ⟨e₀⟩⟩ := hinj (Fin n → DC k hε) inferInstance
  obtain ⟨Q₁, _, _, _, _, _, _, ⟨e₁⟩⟩ := hinj (Fin n' → DC k hε) inferInstance
  -- lift the map of injectives to projectives
  have : Module.Finite R Q₁ := Module.Finite.of_restrictScalars_finite k R Q₁
  obtain ⟨hQ0, hQ1⟩ := van_proj (Q := Q₁) h0 h1
  let v := e₁.symm.toLinearMap ∘ₗ u ∘ₗ e₀.toLinearMap
  obtain ⟨f, hf⟩ := EPmap_surjective k hε hQ0 hQ1 v
  -- its kernel is projective, and its evaluation is `X`
  have := hgl Q₀ Q₁ f
  have := fd_sub (k := k) (LinearMap.ker f)
  have hu : ∀ q : EP hε Q₀, (EPmap hε f q).1 = 0 ↔ u (e₀ q) = 0 := by
    intro q
    rw [hf]
    change ((e₁.symm (u (e₀ q)) : EP hε Q₁).1 = 0) ↔ _
    constructor
    · intro h
      have : e₁.symm (u (e₀ q)) = 0 := Subtype.ext h
      simpa using this
    · intro h
      rw [h, map_zero]; rfl
  let j := EPmap hε (LinearMap.ker f).subtype
  have hj : ∀ m, e₀ (j m) ∈ LinearMap.range ι := by
    intro m
    rw [← hker, LinearMap.mem_ker, ← hu]
    exact m.1.2
  let ψ : EP hε (LinearMap.ker f) →ₗ[hε.Corner] X :=
    (LinearEquiv.ofInjective ι hι).symm.toLinearMap ∘ₗ
      LinearMap.codRestrict (LinearMap.range ι) (e₀.toLinearMap ∘ₗ j) hj
  refine ⟨LinearMap.ker f, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, ⟨LinearEquiv.ofBijective ψ ⟨fun a b hab ↦ ?_, fun x ↦ ?_⟩⟩⟩
  · simp only [ψ, LinearMap.comp_apply, LinearEquiv.coe_coe, EmbeddingLike.apply_eq_iff_eq] at hab
    have := congrArg Subtype.val hab
    simp only [LinearMap.codRestrict_apply, LinearMap.comp_apply, LinearEquiv.coe_coe,
      EmbeddingLike.apply_eq_iff_eq] at this
    have h2 : (j a).1 = (j b).1 := congrArg Subtype.val this
    exact Subtype.ext (Subtype.ext h2)
  · set q := e₀.symm (ι x)
    have hq : (EPmap hε f q).1 = 0 := by
      rw [hu, LinearEquiv.apply_symm_apply]
      change ι' ((LinearMap.range ι).mkQ (ι x)) = 0
      rw [Submodule.mkQ_apply, (Submodule.Quotient.mk_eq_zero _).2 (LinearMap.mem_range_self ι x),
        map_zero]
    refine ⟨⟨⟨q.1, hq⟩, Subtype.ext (EP_spec hε q)⟩, ?_⟩
    have : j ⟨⟨q.1, hq⟩, Subtype.ext (EP_spec hε q)⟩ = q := Subtype.ext rfl
    change (LinearEquiv.ofInjective ι hι).symm ⟨e₀ (j _), hj _⟩ = x
    rw [LinearEquiv.symm_apply_eq]
    apply Subtype.ext
    change e₀ (j _) = ι x
    rw [this, LinearEquiv.apply_symm_apply]

end EssSurj

/-! ### Primitive decomposition of the unit -/

section Primitive

open MBDVendor.QSE.Foundation

variable [Algebra k R] [FiniteDimensional k R]

/-- The left ideal `R f`. -/
abbrev Rf (f : R) : Submodule R R := Submodule.span R {f}

theorem mem_Rf {f x : R} : x ∈ Rf f ↔ ∃ a, a * f = x := by
  simp [Submodule.mem_span_singleton]

theorem self_mem_Rf (f : R) : f ∈ Rf f := Submodule.mem_span_singleton_self f

variable {k}

/-- **Every idempotent is a finite orthogonal sum of idempotents `g` with `R g`
indecomposable**, by induction on the dimension of `R f`. -/
theorem exists_primitive : ∀ (d : ℕ) (f : R), IsIdempotentElem f →
    Module.finrank k (Rf f) = d →
    ∃ (n : ℕ) (g : Fin n → R), (∀ i, IsIdempotentElem (g i)) ∧
      (∀ i j, i ≠ j → g i * g j = 0) ∧ ∑ i, g i = f ∧ (∀ i, g i * f = g i ∧ f * g i = g i) ∧
      ∀ i, IsIndecomposableModule R (Rf (g i)) := by
  intro d
  induction d using Nat.strong_induction_on with
  | _ d ih =>
  intro f hf hd
  by_cases hnt : Nontrivial (Rf f)
  swap
  · -- `R f = 0`, so `f = 0`
    have : f = 0 := by
      rw [not_nontrivial_iff_subsingleton] at hnt
      have := Subsingleton.elim (⟨f, self_mem_Rf f⟩ : Rf f) 0
      exact congrArg Subtype.val this
    exact ⟨0, Fin.elim0, fun i ↦ i.elim0, fun i ↦ i.elim0, by simp [this], fun i ↦ i.elim0,
      fun i ↦ i.elim0⟩
  by_cases hind : IsIndecomposableModule R (Rf f)
  · exact ⟨1, fun _ ↦ f, fun _ ↦ hf, fun i j h ↦ absurd (Subsingleton.elim i j) h,
      by simp, fun _ ↦ ⟨hf.eq, hf.eq⟩, fun _ ↦ hind⟩
  -- a nontrivial idempotent endomorphism of `R f`
  rw [isIndecomposableModule_iff_nontrivial_and_forall_isIdempotentElem] at hind
  push Not at hind
  obtain ⟨φ, hφ, hφ0, hφ1⟩ := hind hnt
  set a : R := (φ ⟨f, self_mem_Rf f⟩ : R) with ha_def
  have haRf : a ∈ Rf f := (φ ⟨f, self_mem_Rf f⟩).2
  obtain ⟨y, hy⟩ := mem_Rf.1 haRf
  have haf : a * f = a := by rw [← hy, mul_assoc, hf.eq]
  have hfa : f * a = a := by
    have e : (⟨f, self_mem_Rf f⟩ : Rf f) = f • ⟨f, self_mem_Rf f⟩ :=
      Subtype.ext (by change f = f * f; rw [hf.eq])
    have := congrArg Subtype.val (congrArg φ e)
    rw [map_smul] at this
    exact this.symm
  -- `φ` is right multiplication by `a`
  have hφx : ∀ x : Rf f, (φ x : R) = x.1 * a := by
    intro x
    obtain ⟨c, hc⟩ := mem_Rf.1 x.2
    have e : x = c • ⟨f, self_mem_Rf f⟩ := Subtype.ext (by change x.1 = c * f; rw [hc])
    rw [e, map_smul]
    change c * a = (c * f) * a
    rw [mul_assoc, hfa]
  have hai : IsIdempotentElem a := by
    have := congrArg (fun F : Module.End R (Rf f) ↦ (F ⟨f, self_mem_Rf f⟩ : R)) hφ.eq
    simp only [Module.End.mul_apply] at this
    rw [hφx (φ _)] at this
    exact this
  set b := f - a with hb_def
  have hbi : IsIdempotentElem b := by
    change (f - a) * (f - a) = f - a
    rw [sub_mul, mul_sub, mul_sub, hf.eq, hfa, haf, hai.eq]; abel
  have hab : a * b = 0 := by rw [hb_def, mul_sub, haf, hai.eq, sub_self]
  have hba : b * a = 0 := by rw [hb_def, sub_mul, hfa, hai.eq, sub_self]
  have hbf : b * f = b := by rw [hb_def, sub_mul, hf.eq, haf]
  have hfb : f * b = b := by rw [hb_def, mul_sub, hf.eq, hfa]
  have ha0 : a ≠ 0 := by
    intro h0; apply hφ0; ext x; rw [hφx, h0, mul_zero]; rfl
  have hb0 : b ≠ 0 := by
    intro h0
    have : a = f := by rw [hb_def, sub_eq_zero] at h0; exact h0.symm
    apply hφ1; ext x
    rw [hφx, this]
    obtain ⟨c, hc⟩ := mem_Rf.1 x.2
    change x.1 * f = x.1
    rw [← hc, mul_assoc, hf.eq]
  -- both summands are smaller
  have hsmall : ∀ e : R, e * f = e → (∃ e', e * e' = 0 ∧ f * e' ≠ 0) →
      Module.finrank k (Rf e) < d := by
    intro e hef ⟨e', h1, h2⟩
    have hle : Rf e ≤ Rf f := by
      rw [Submodule.span_le, Set.singleton_subset_iff]
      exact mem_Rf.2 ⟨e, hef⟩
    have hne : Rf e ≠ Rf f := by
      intro heq
      have : f ∈ Rf e := heq ▸ self_mem_Rf f
      obtain ⟨z, hz⟩ := mem_Rf.1 this
      apply h2
      rw [← hz, mul_assoc, h1, mul_zero]
    have hlt : (Rf e).restrictScalars k < (Rf f).restrictScalars k :=
      lt_of_le_of_ne (Submodule.restrictScalars_mono k hle)
        (fun h ↦ hne (Submodule.restrictScalars_injective k R R h))
    rw [← hd]
    exact Submodule.finrank_lt_finrank_of_lt hlt
  obtain ⟨n₁, g₁, hi₁, ho₁, hs₁, hc₁, hd₁⟩ :=
    ih _ (hsmall a haf ⟨b, hab, by rw [hfb]; exact hb0⟩) a hai rfl
  obtain ⟨n₂, g₂, hi₂, ho₂, hs₂, hc₂, hd₂⟩ :=
    ih _ (hsmall b hbf ⟨a, hba, by rw [hfa]; exact ha0⟩) b hbi rfl
  refine ⟨n₁ + n₂, Fin.append g₁ g₂, fun i ↦ ?_, fun i j hij ↦ ?_, ?_, fun i ↦ ?_, fun i ↦ ?_⟩
  · refine Fin.addCases (fun i ↦ ?_) (fun i ↦ ?_) i
    · rw [Fin.append_left]; exact hi₁ i
    · rw [Fin.append_right]; exact hi₂ i
  · -- orthogonality, across the two blocks through `a b = 0 = b a`
    have c12 : ∀ i j, g₁ i * g₂ j = 0 := fun i j ↦ by
      rw [← (hc₁ i).1, ← (hc₂ j).2, mul_assoc, ← mul_assoc a, hab, zero_mul, mul_zero]
    have c21 : ∀ i j, g₂ i * g₁ j = 0 := fun i j ↦ by
      rw [← (hc₂ i).1, ← (hc₁ j).2, mul_assoc, ← mul_assoc b, hba, zero_mul, mul_zero]
    induction i using Fin.addCases with
    | left i =>
        induction j using Fin.addCases with
        | left j =>
            rw [Fin.append_left, Fin.append_left]
            exact ho₁ i j (fun h ↦ hij (by rw [h]))
        | right j => rw [Fin.append_left, Fin.append_right]; exact c12 i j
    | right i =>
        induction j using Fin.addCases with
        | left j => rw [Fin.append_right, Fin.append_left]; exact c21 i j
        | right j =>
            rw [Fin.append_right, Fin.append_right]
            exact ho₂ i j (fun h ↦ hij (by rw [h]))
  · rw [Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right]
    rw [hs₁, hs₂, hb_def, add_sub_cancel]
  · induction i using Fin.addCases with
    | left i =>
        rw [Fin.append_left]
        refine ⟨?_, ?_⟩
        · rw [← (hc₁ i).1, mul_assoc, haf]
        · rw [← (hc₁ i).2, ← mul_assoc, hfa]
    | right i =>
        rw [Fin.append_right]
        refine ⟨?_, ?_⟩
        · rw [← (hc₂ i).1, mul_assoc, hbf]
        · rw [← (hc₂ i).2, ← mul_assoc, hfb]
  · induction i using Fin.addCases with
    | left i => rw [Fin.append_left]; exact hd₁ i
    | right i => rw [Fin.append_right]; exact hd₂ i

end Primitive

/-! ### `Λ_e` is representation-finite -/

section RepFinite

open MBDVendor.QSE.Foundation

theorem exists_unit_of_sum {S : Type*} [Ring S] [IsLocalRing S] {ι : Type*} (s : Finset ι)
    (t : ι → S) (h : IsUnit (∑ i ∈ s, t i)) : ∃ i ∈ s, IsUnit (t i) := by
  classical
  by_contra hc
  push Not at hc
  have key : ∀ s' ⊆ s, (∑ i ∈ s', t i) ∈ nonunits S := by
    intro s' hs'
    induction s' using Finset.induction_on with
    | empty => rw [Finset.sum_empty]; exact zero_mem_nonunits.2 zero_ne_one
    | insert j s'' hj ih =>
        rw [Finset.sum_insert hj]
        exact IsLocalRing.nonunits_add (hc j (hs' (Finset.mem_insert_self _ _)))
          (ih (subset_trans (Finset.subset_insert _ _) hs'))
  exact key s subset_rfl h

variable [Algebra k R] [FiniteDimensional k R]

variable {k} in
/-- **Exchange**: an indecomposable finite-dimensional projective module is isomorphic to one of
the indecomposable summands `R g_i` of a decomposition of `1`. -/
theorem exchange {P : Type u} [AddCommGroup P] [Module k P] [Module R P] [IsScalarTower k R P]
    [FiniteDimensional k P] [Module.Projective R P] (hP : IsIndecomposableModule R P) {n : ℕ}
    (g : Fin n → R) (hsum : ∑ i, g i = 1) (hgd : ∀ i, IsIndecomposableModule R (Rf (g i))) :
    ∃ i, Nonempty (P ≃ₗ[R] Rf (g i)) := by
  classical
  have : Module.Finite R P := Module.Finite.of_restrictScalars_finite k R P
  have : IsNoetherian R P := isNoetherian_of_tower k inferInstance
  have : IsArtinian R P := isArtinian_of_tower k inferInstance
  have : IsLocalRing (Module.End R P) :=
    isLocalRing_end_of_isIndecomposable (isFiniteLength_iff_isNoetherian_isArtinian.2
      ⟨inferInstance, inferInstance⟩) hP
  obtain ⟨m, s, r, hrs⟩ := exists_retract (R := R) (Q := P)
  let ρ : Fin n → (R →ₗ[R] R) := fun i ↦ LinearMap.toSpanSingleton R R (g i)
  let t : Fin m × Fin n → Module.End R P := fun p ↦
    r ∘ₗ LinearMap.single R (fun _ ↦ R) p.1 ∘ₗ ρ p.2 ∘ₗ LinearMap.proj p.1 ∘ₗ s
  have hsumt : ∑ p ∈ Finset.univ, t p = 1 := by
    apply LinearMap.ext
    intro x
    rw [LinearMap.sum_apply, Module.End.one_apply]
    conv_rhs => rw [← LinearMap.id_apply (R := R) x, ← hrs, LinearMap.comp_apply]
    simp only [t, LinearMap.comp_apply, ← map_sum]
    congr 1
    funext b
    rw [Finset.sum_apply, Fintype.sum_prod_type]
    simp only [LinearMap.coe_single, Pi.single_apply, LinearMap.proj_apply, ρ,
      LinearMap.toSpanSingleton_apply, smul_eq_mul]
    rw [Finset.sum_eq_single b]
    · simp only [if_true]
      rw [← Finset.mul_sum, hsum, mul_one]
    · intro a _ hab
      exact Finset.sum_eq_zero fun i _ ↦ by rw [if_neg (Ne.symm hab)]
    · simp
  obtain ⟨⟨a, i⟩, -, hu⟩ := exists_unit_of_sum Finset.univ t (by rw [hsumt]; exact isUnit_one)
  let σ : P →ₗ[R] Rf (g i) := LinearMap.codRestrict (Rf (g i))
    (ρ i ∘ₗ LinearMap.proj a ∘ₗ s) (fun x ↦ mem_Rf.2 ⟨_, rfl⟩)
  let τ : Rf (g i) →ₗ[R] P :=
    (↑(hu.unit⁻¹) : Module.End R P) ∘ₗ r ∘ₗ LinearMap.single R (fun _ ↦ R) a ∘ₗ (Rf (g i)).subtype
  have hτσ : τ ∘ₗ σ = LinearMap.id := by
    change ((hu.unit⁻¹ : (Module.End R P)ˣ) : Module.End R P) * (hu.unit : Module.End R P) =
      LinearMap.id
    rw [Units.inv_mul]; rfl
  have hidem : IsIdempotentElem (σ ∘ₗ τ : Module.End R (Rf (g i))) := by
    change (σ ∘ₗ τ) ∘ₗ (σ ∘ₗ τ) = σ ∘ₗ τ
    rw [LinearMap.comp_assoc, ← LinearMap.comp_assoc τ, hτσ, LinearMap.id_comp]
  rcases (hgd i).eq_zero_or_eq_one_of_isIdempotentElem hidem with h0 | h1
  · exfalso
    have := hP.nontrivial
    obtain ⟨x, hx⟩ := exists_ne (0 : P)
    apply hx
    have e1 : x = τ (σ (τ (σ x))) := by
      rw [← LinearMap.comp_apply τ σ, hτσ, LinearMap.id_apply, ← LinearMap.comp_apply τ σ, hτσ,
        LinearMap.id_apply]
    rw [e1, ← LinearMap.comp_apply σ τ]
    change τ ((σ ∘ₗ τ) (σ x)) = 0
    rw [h0]; simp
  · exact ⟨i, ⟨LinearEquiv.ofLinearMap σ τ h1 hτσ⟩⟩

variable {ε : R} (hε : IsIdempotentElem ε)

/-- Evaluation of an isomorphism. -/
def EPequiv {M N : Type u} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (e : M ≃ₗ[R] N) : EP hε M ≃ₗ[hε.Corner] EP hε N :=
  LinearEquiv.ofLinearMap (EPmap hε e.toLinearMap) (EPmap hε e.symm.toLinearMap)
    (LinearMap.ext fun m ↦ Subtype.ext (by simp)) (LinearMap.ext fun m ↦ Subtype.ext (by simp))

variable {k} in
/-- **A projective whose evaluation is indecomposable is indecomposable**: a summand with zero
evaluation is projective and killed by `ε`, hence zero by the Hom-vanishing. -/
theorem indec_of_EP (h0 : HomVan k ε R) {P : Type u} [AddCommGroup P] [Module k P] [Module R P]
    [IsScalarTower k R P] [FiniteDimensional k P] [Module.Projective R P]
    {X : Type u} [AddCommGroup X] [Module hε.Corner X] (e : EP hε P ≃ₗ[hε.Corner] X)
    (hX : IsIndecomposableModule hε.Corner X) : IsIndecomposableModule R P := by
  classical
  -- the summands, evaluated
  let sub : Submodule R P → Submodule hε.Corner (EP hε P) := fun A ↦
    { carrier := {m | m.1 ∈ A}
      add_mem' := fun ha hb ↦ A.add_mem ha hb
      zero_mem' := A.zero_mem
      smul_mem' := fun c m hm ↦ A.smul_mem c.1 hm }
  have hnt : Nontrivial P := by
    have := hX.nontrivial
    obtain ⟨x, hx⟩ := exists_ne (0 : X)
    refine ⟨⟨(e.symm x).1, 0, fun h ↦ hx ?_⟩⟩
    have : e.symm x = 0 := Subtype.ext h
    simpa using this
  refine ⟨hnt, fun A B hAB ↦ ?_⟩
  have hcompl : IsCompl (sub A) (sub B) := by
    constructor
    · rw [Submodule.disjoint_def]
      intro m hA hB
      exact Subtype.ext ((Submodule.disjoint_def.1 hAB.disjoint) m.1 hA hB)
    · rw [codisjoint_iff, Submodule.eq_top_iff']
      intro m
      have hm : m.1 ∈ A ⊔ B := by rw [hAB.sup_eq_top]; trivial
      obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.1 hm
      have hεa : ε • a ∈ A := A.smul_mem ε ha
      have hεb : ε • b ∈ B := B.smul_mem ε hb
      have hsum : ε • a + ε • b = a + b := by rw [← smul_add, hab, EP_spec hε m]
      have hd : a - ε • a ∈ A ⊓ B := ⟨A.sub_mem ha hεa, by
        rw [show a - ε • a = ε • b - b by rw [sub_eq_sub_iff_add_eq_add, ← hsum]; abel]
        exact B.sub_mem hεb hb⟩
      rw [hAB.inf_eq_bot, Submodule.mem_bot, sub_eq_zero] at hd
      have hb' : ε • b = b := by
        have := hsum; rw [← hd] at this; exact add_left_cancel this
      refine Submodule.mem_sup.2 ⟨⟨a, hd.symm⟩, ha, ⟨b, hb'⟩, hb, Subtype.ext hab⟩
  have hcompl' := (Submodule.orderIsoMapComap e).isCompl hcompl
  -- a summand with zero evaluation is zero
  have hzero : ∀ A : Submodule R P, ∀ B, IsCompl A B → sub A = ⊥ → A = ⊥ := by
    intro A B hAB hA
    have hk : Killed ε A := by
      intro a
      apply Subtype.ext
      have hmem : epOf hε (a.1 : P) ∈ sub A := A.smul_mem ε a.2
      rw [hA] at hmem
      have h1 : epOf hε (a.1 : P) = 0 := (Submodule.mem_bot hε.Corner).1 hmem
      change ε • a.1 = 0
      exact congrArg Subtype.val h1
    have : Module.Projective R A := Module.Projective.of_split A.subtype
      (Submodule.projectionOnto A B hAB)
      (LinearMap.ext fun x ↦ Submodule.projectionOnto_apply_left hAB x)
    have := fd_sub (k := k) A
    have : Module.Finite R A := Module.Finite.of_restrictScalars_finite k R A
    obtain ⟨m, s, r, hrs⟩ := exists_retract (R := R) (Q := A)
    have hs : s = 0 := by
      ext x j
      have := h0 A hk (LinearMap.proj j ∘ₗ s)
      exact congrArg (fun φ : A →ₗ[R] R ↦ φ x) this
    rw [eq_bot_iff]
    intro x hx
    have := congrArg (fun φ : A →ₗ[R] A ↦ φ ⟨x, hx⟩) hrs
    simp only [hs, LinearMap.comp_zero, LinearMap.zero_apply, LinearMap.id_apply] at this
    rw [Submodule.mem_bot]
    exact congrArg Subtype.val this.symm
  rcases hX.eq_bot_or_eq_bot hcompl' with hA | hB
  · left
    refine hzero A B hAB ?_
    rw [← (Submodule.orderIsoMapComap e).map_bot] at hA
    exact (Submodule.orderIsoMapComap e).injective hA
  · right
    refine hzero B A hAB.symm ?_
    rw [← (Submodule.orderIsoMapComap e).map_bot] at hB
    exact (Submodule.orderIsoMapComap e).injective hB

end RepFinite

/-! ### Lemma 2.9 -/

section Main

variable [Algebra k R] [FiniteDimensional k R] {ε : R} (hε : IsIdempotentElem ε)

/-- `gl.dim R ≤ 2`, in the form used: kernels of maps between finite-dimensional projectives
(second syzygies) are projective. -/
def GlDimLeTwo : Prop :=
  ∀ (P₀ P₁ : Type u) [AddCommGroup P₀] [Module k P₀] [Module R P₀] [IsScalarTower k R P₀]
    [FiniteDimensional k P₀] [Module.Projective R P₀] [AddCommGroup P₁] [Module k P₁] [Module R P₁]
    [IsScalarTower k R P₁] [FiniteDimensional k P₁] [Module.Projective R P₁] (f : P₀ →ₗ[R] P₁),
    Module.Projective R (LinearMap.ker f)

/-- Every finite-dimensional injective `Λ_e`-module is `εQ` for a projective `Q`. -/
def InjLift : Prop :=
  ∀ (I : Type u) [AddCommGroup I] [Module k I] [Module hε.Corner I]
    [IsScalarTower k hε.Corner I] [FiniteDimensional k I], Module.Injective hε.Corner I →
    ∃ (Q : Type u) (_ : AddCommGroup Q) (_ : Module k Q) (_ : Module R Q)
      (_ : IsScalarTower k R Q) (_ : FiniteDimensional k Q) (_ : Module.Projective R Q),
      Nonempty (EP hε Q ≃ₗ[hε.Corner] I)

/-- **`Λ_e` is representation-finite**: finitely many left ideals `R g_i` whose evaluations
represent every finite-dimensional indecomposable `Λ_e`-module. -/
theorem repFinite (h0 : HomVan k ε R) (h1 : ExtVan k ε R) (hgl : GlDimLeTwo k (R := R))
    (hinj : InjLift k hε) :
    ∃ (n : ℕ) (L : Fin n → Submodule R R),
      ∀ (X : Type u) [AddCommGroup X] [Module k X] [Module hε.Corner X]
        [IsScalarTower k hε.Corner X] [FiniteDimensional k X],
        MBDVendor.QSE.Foundation.IsIndecomposableModule hε.Corner X →
        ∃ i, Nonempty (EP hε (L i) ≃ₗ[hε.Corner] X) := by
  obtain ⟨n, g, -, -, hsum, -, hgd⟩ := exists_primitive (k := k) _ (1 : R) (IsIdempotentElem.one (M := R)) rfl
  refine ⟨n, fun i ↦ Rf (g i), fun X _ _ _ _ _ hX ↦ ?_⟩
  obtain ⟨P, _, _, _, _, _, _, ⟨e⟩⟩ := essSurj k hε h0 h1 hgl hinj X
  have hP := indec_of_EP (k := k) hε h0 e hX
  obtain ⟨i, ⟨φ⟩⟩ := exchange (k := k) hP g hsum hgd
  exact ⟨i, ⟨(EPequiv hε φ).symm.trans e⟩⟩

/-- **Lemma 2.9** (`lem:projective-evaluation-criterion`), for any finite-dimensional algebra
`R` over any field and any idempotent `ε` (right `Λ`-modules: `R = Λᵐᵒᵖ`, `ε = op e`). Assume
`Hom_R(T, R) = Ext¹_R(T, R) = 0` for all finite-dimensional `T` with `εT = 0`. Then
(1) `P ↦ εP` is fully faithful on finite-dimensional projectives (even from any `M`);
(2) if `gl.dim R ≤ 2` and every finite-dimensional injective `Λ_e`-module is `εQ` for a
projective `Q`, it is essentially surjective onto finite-dimensional `Λ_e`-modules, and
`Λ_e = εRε` is representation-finite. -/
theorem projectiveEvaluationCriterion (h0 : HomVan k ε R) (h1 : ExtVan k ε R) :
    (∀ (M Q : Type u) [AddCommGroup M] [Module k M] [Module R M] [IsScalarTower k R M]
      [FiniteDimensional k M] [AddCommGroup Q] [Module k Q] [Module R Q] [IsScalarTower k R Q]
      [FiniteDimensional k Q] [Module.Projective R Q],
      Function.Bijective (fun f : M →ₗ[R] Q ↦ EPmap hε f)) ∧
    (GlDimLeTwo k (R := R) → InjLift k hε →
      (∀ (X : Type u) [AddCommGroup X] [Module k X] [Module hε.Corner X]
        [IsScalarTower k hε.Corner X] [FiniteDimensional k X],
        ∃ (P : Type u) (_ : AddCommGroup P) (_ : Module k P) (_ : Module R P)
          (_ : IsScalarTower k R P) (_ : FiniteDimensional k P) (_ : Module.Projective R P),
          Nonempty (EP hε P ≃ₗ[hε.Corner] X)) ∧
      ∃ (n : ℕ) (L : Fin n → Submodule R R),
        ∀ (X : Type u) [AddCommGroup X] [Module k X] [Module hε.Corner X]
          [IsScalarTower k hε.Corner X] [FiniteDimensional k X],
          MBDVendor.QSE.Foundation.IsIndecomposableModule hε.Corner X →
          ∃ i, Nonempty (EP hε (L i) ≃ₗ[hε.Corner] X)) := by
  refine ⟨fun M Q _ _ _ _ _ _ _ _ _ _ _ ↦ ?_, fun hgl hinj ↦
    ⟨fun X _ _ _ _ _ ↦ essSurj k hε h0 h1 hgl hinj X, repFinite k hε h0 h1 hgl hinj⟩⟩
  have : Module.Finite R Q := Module.Finite.of_restrictScalars_finite k R Q
  obtain ⟨hQ0, hQ1⟩ := van_proj (Q := Q) h0 h1
  exact ⟨EPmap_injective k hε hQ0, fun g ↦ EPmap_surjective k hε hQ0 hQ1 g⟩

/-- **It suffices to check the two vanishings on the simple modules killed by `ε`.** -/
theorem projectiveEvaluationCriterion_of_simple (h : SimpleVan k ε) :
    HomVan k ε R ∧ ExtVan k ε R := van_of_simple h

end Main

end EvalCriterion

