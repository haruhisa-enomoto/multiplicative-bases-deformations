import MultiplicativeBasisDeformations.Foundations.PeriodicModel

/-!
# Proposition 4.1(2): the generator of the deck group

`scalar-normalization.tex:53–75` (`prop:periodic-tree-model`(2)): "Root `Δ` at its trivalent
vertex if `Δ` has type `D` or `E`, and at its middle vertex if `Δ = A_{2n+1}`, and orient `Δ`
away from the root. Then `Θ` is generated by `τ^s ρ` for some `s ≥ 1`, where `ρ` is the
automorphism `(v, j) ↦ (ρ v, j)` of `ℤΔ` induced by an automorphism `ρ` of `Δ`; it fixes the
root. If `Δ = A_{2n}`, then `Θ` is generated by `η^r` for some `r ≥ 1`, where `η` is an
automorphism of `ℤΔ` with `η² = τ⁻¹` that exchanges the two halves of `Δ`."

The star models of `PeriodicModel.lean` use height coordinates `(v, j)`, `j ≡ depth v`
(mod 2), with `τ(v, j) = (v, j − 2)`; type `A` is a one-arm star. The deck group is infinite
cyclic, generated by `g = deck z₀` (`deck_cyclic`), and `g(v, j) = (ρ v, j + c₀)` for a tree
automorphism `ρ` (`deck_height_form`). Comparing parities: a three-arm star has `ρ` fixing the
centre (`fixes_centre_three`), so `c₀ = 2s` and `g = τ^{−s} ρ`; a path has `ρ` the identity or
the reversal (`path_aut`), which fixes the middle vertex when the number of vertices is odd; for
`A_{2n}` the reversal changes parity, and `g = η^{c₀}` with `η(v, j) = (rev v, j + 1)`.
(We state the generator `g`; its inverse `τ^s ρ⁻¹` is the form of the source.)
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option backward.isDefEq.respectTransparency false

noncomputable section

open CategoryTheory Function

namespace MultiplicativeBasisDeformations

universe u v w

namespace StarDeck

variable {t : ℕ} {L : Fin t → ℕ}

theorem par_eq (x : StarV L) : (starTree L).par x = (starDepth x : ZMod 2) := rfl

theorem natCast_zmod2_eq {a b : ℕ} (h : a % 2 = b % 2) : (a : ZMod 2) = (b : ZMod 2) := by
  rw [← ZMod.natCast_mod a, ← ZMod.natCast_mod b, h]

theorem zmod2_mod_eq {a b : ℕ} (h : (a : ZMod 2) = (b : ZMod 2)) : a % 2 = b % 2 :=
  (ZMod.natCast_eq_natCast_iff' a b 2).1 h

/-! ### The reversal of a path and `η` -/

section Path

variable {L : Fin 1 → ℕ}

/-- The reversal of a path: depth `d ↦ L₀ + 1 − d`. -/
def rev (x : StarV L) : StarV L :=
  ofDep L (L 0 + 1 - starDepth x) (by omega)

theorem depth_rev (x : StarV L) : starDepth (rev x) = L 0 + 1 - starDepth x := by
  rw [rev, starDepth_ofDep]

theorem rev_rev (x : StarV L) : rev (rev x) = x := by
  apply depth_injective
  rw [depth_rev, depth_rev]
  have := depth_le x
  omega

/-- **`η`** (for `A_{2n}`, `L₀ + 1` odd): `(v, j) ↦ (rev v, j + 1)`. -/
def eta (hodd : Odd (L 0 + 1)) (X : (starTree L).ZVert) : (starTree L).ZVert where
  v := rev X.v
  t := X.t + 1
  ht := by
    rw [par_eq, depth_rev]
    obtain ⟨m, hm⟩ := hodd
    have h1 := X.ht
    rw [par_eq] at h1
    have hle := depth_le X.v
    push_cast
    rw [h1]
    have : ((L 0 + 1 - starDepth X.v : ℕ) : ZMod 2) = (starDepth X.v : ZMod 2) + 1 := by
      rw [show (starDepth X.v : ZMod 2) + 1 = ((starDepth X.v + 1 : ℕ) : ZMod 2) by push_cast; ring]
      exact natCast_zmod2_eq (by omega)
    rw [this]

theorem eta_v (hodd : Odd (L 0 + 1)) (X : (starTree L).ZVert) : (eta hodd X).v = rev X.v := rfl

theorem eta_t (hodd : Odd (L 0 + 1)) (X : (starTree L).ZVert) : (eta hodd X).t = X.t + 1 := rfl

/-- **`η² = τ⁻¹`.** -/
theorem eta_eta (hodd : Odd (L 0 + 1)) (X : (starTree L).ZVert) :
    eta hodd (eta hodd X) = (starTree L).ztauInv X := by
  refine OrientedTree.ZVert.ext ?_ ?_
  · exact rev_rev X.v
  · simp only [eta_t, OrientedTree.ztauInv]; ring

theorem eta_iter (hodd : Odd (L 0 + 1)) (n : ℕ) (X : (starTree L).ZVert) :
    ((eta hodd)^[n] X).v = (if Even n then X.v else rev X.v) ∧ ((eta hodd)^[n] X).t = X.t + n := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Function.iterate_succ_apply', eta_v, eta_t, ih.1, ih.2]
      refine ⟨?_, by push_cast; ring⟩
      by_cases hn : Even n
      · rw [if_pos hn, if_neg (by rw [Nat.even_add_one]; exact not_not.2 hn)]
      · rw [if_neg hn, if_pos (by rw [Nat.even_add_one]; exact hn), rev_rev]

end Path

/-! ### The generator -/

section Generator

variable (L) {V : Type u} [Quiver.{w} V] [∀ x y : V, Subsingleton (x ⟶ y)] {Q : TranslationQuiver V}
  (hQ : Q.IsStable) (π : (starTree L).ZVert ⥤q V) (hπ : π.IsCovering)
  (hτ : ∀ Y, π.obj ((starTree L).ztau Y) = hQ.tauE (π.obj Y))

include hπ hτ in
/-- **Proposition 4.1(2)** (`prop:periodic-tree-model`(2)), in height coordinates: the deck
group is generated by `g` with `g(v, j) = (ρ v, j + c₀)`, `c₀ ≥ 1`, `ρ` a tree automorphism.
For a three-arm star (types `D`, `E`) `c₀` is even and `ρ` fixes the centre: `g = τ^{−c₀/2} ρ`.
For a path with an odd number of vertices (`A_{2n+1}`) `c₀` is even and `ρ` fixes the middle
vertex. For a path with an even number of vertices (`A_{2n}`) either `c₀` is even and `ρ = 1`,
or `c₀` is odd and `ρ` is the reversal; in both cases `g = η^{c₀}` (`generator_A_even`). -/
theorem periodicTreeModel_generator (ht : 0 < t) (hcl : t = 1 ∨ t = 3)
    (hnt : ∃ X Y : (starTree L).ZVert, X ≠ Y ∧ π.obj X = π.obj Y) :
    ∃ g : Equiv.Perm (starTree L).ZVert,
      (∀ X Y, π.obj X = π.obj Y ↔ ∃ l : ℤ, (g ^ l) X = Y) ∧
      ∃ (c₀ : ℕ) (ρ : StarV L ≃ StarV L), 1 ≤ c₀ ∧ (∀ a b, starAdj a b ↔ starAdj (ρ a) (ρ b)) ∧
        (∀ X, (g X).v = ρ X.v ∧ (g X).t = X.t + c₀) ∧
        (t = 3 → Even c₀ ∧ ρ none = none) ∧
        (t = 1 → Even (L ⟨0, ht⟩ + 1) →
          Even c₀ ∧ ∀ x, 2 * starDepth x = L ⟨0, ht⟩ + 1 → ρ x = x) ∧
        (t = 1 → Odd (L ⟨0, ht⟩ + 1) →
          (Even c₀ ∧ ∀ x, ρ x = x) ∨
            (Odd c₀ ∧ ∀ x, starDepth (ρ x) + starDepth x = L ⟨0, ht⟩ + 1)) := by
  obtain ⟨z₀, hz₀, hpos, hfib⟩ := deck_cyclic L hQ π hπ hτ ht hcl hnt
  obtain ⟨ρ, hρ, hF⟩ := deck_height_form L hQ π hπ hτ ht z₀ hz₀
  obtain ⟨c₀, hc⟩ : ∃ c₀ : ℕ, z₀.t = c₀ := ⟨z₀.t.toNat, by omega⟩
  have hc1 : 1 ≤ c₀ := by omega
  -- parities
  have hpar : ∀ x, (starDepth x + c₀) % 2 = starDepth (ρ x) % 2 := by
    intro x
    have h := (Hz L π hπ z₀ hz₀ (B L x)).ht
    rw [(hF (B L x)).1, (hF (B L x)).2, hc, par_eq] at h
    simp only [B] at h
    push_cast at h
    exact zmod2_mod_eq (by push_cast; exact h)
  refine ⟨deck L hQ π hπ hτ ht z₀ hz₀, hfib, c₀, ρ, hc1, hρ, fun X ↦ ?_, fun h3 ↦ ?_,
    fun h1 he ↦ ?_, fun h1 ho ↦ ?_⟩
  · rw [deck_apply, (hF X).1, (hF X).2, hc]; exact ⟨rfl, rfl⟩
  · have h0 := fixes_centre_three h3 ρ hρ
    have := hpar none
    rw [h0] at this
    simp only [starDepth] at this
    exact ⟨Nat.even_iff.2 (by omega), h0⟩
  · subst h1
    have hρ' : ∀ a b, starAdj a b ↔ starAdj (ρ a) (ρ b) := hρ
    rcases path_aut ρ hρ' with h | h
    · have := hpar none
      rw [h none] at this
      refine ⟨Nat.even_iff.2 (by simp [starDepth] at this; omega), fun x _ ↦ ?_⟩
      exact depth_injective (h x)
    · have := hpar none
      have hn := h none
      rw [show starDepth (none : StarV L) = 0 from rfl] at this hn
      obtain ⟨m, hm⟩ := he
      change L 0 + 1 = m + m at hm
      change starDepth (ρ none) + 0 = L 0 + 1 at hn
      refine ⟨Nat.even_iff.2 (by omega), fun x hx ↦ depth_injective ?_⟩
      have := h x
      change starDepth (ρ x) + starDepth x = L 0 + 1 at this
      change 2 * starDepth x = L 0 + 1 at hx
      omega
  · subst h1
    have hρ' : ∀ a b, starAdj a b ↔ starAdj (ρ a) (ρ b) := hρ
    rcases path_aut ρ hρ' with h | h
    · have := hpar none
      rw [h none] at this
      exact Or.inl ⟨Nat.even_iff.2 (by simp [starDepth] at this; omega),
        fun x ↦ depth_injective (h x)⟩
    · have := hpar none
      have hn := h none
      rw [show starDepth (none : StarV L) = 0 from rfl] at this hn
      obtain ⟨m, hm⟩ := ho
      change L 0 + 1 = 2 * m + 1 at hm
      change starDepth (ρ none) + 0 = L 0 + 1 at hn
      exact Or.inr ⟨Nat.odd_iff.2 (by omega), h⟩

end Generator

/-- **Proposition 4.1(2) for `A_{2n}`**: the generator of `generator` form is `η^{c₀}`. -/
theorem generator_A_even {L : Fin 1 → ℕ} (hodd : Odd (L 0 + 1))
    (g : (starTree L).ZVert → (starTree L).ZVert) (c₀ : ℕ) (ρ : StarV L ≃ StarV L)
    (hg : ∀ X, (g X).v = ρ X.v ∧ (g X).t = X.t + c₀)
    (h : (Even c₀ ∧ ∀ x, ρ x = x) ∨ (Odd c₀ ∧ ∀ x, starDepth (ρ x) + starDepth x = L 0 + 1)) :
    ∀ X, g X = (eta hodd)^[c₀] X := by
  intro X
  obtain ⟨h1, h2⟩ := eta_iter hodd c₀ X
  refine OrientedTree.ZVert.ext ?_ ?_
  · rw [(hg X).1, h1]
    rcases h with ⟨he, hρ⟩ | ⟨ho, hρ⟩
    · rw [if_pos he, hρ]
    · rw [if_neg (Nat.not_even_iff_odd.2 ho)]
      apply depth_injective
      rw [depth_rev]
      have := hρ X.v
      omega
  · rw [(hg X).2, h2]

end StarDeck

namespace TranslationQuiver

open StarDeck

variable {V : Type v} [Quiver.{w} V] {Q : TranslationQuiver V} {k : Type u} [Field k]

/-- `ℤΔ` is infinite. -/
theorem infinite_zvert {t : ℕ} (L : Fin t → ℕ) : Infinite (starTree L).ZVert :=
  Infinite.of_injective (fun n : ℤ ↦ (⟨none, 2 * n, by
      rw [par_eq]; push_cast; rw [show (2 : ZMod 2) = 0 from rfl, zero_mul]; rfl⟩ :
    (starTree L).ZVert)) fun a b h ↦ by
      have := congrArg OrientedTree.ZVert.t h
      simp only at this
      omega

/-- **Proposition 4.1(1)(2)** for a finite connected component: the covering `ℤΔ → Q` by a
Dynkin star model, and the generator of the deck group in the form of
`periodicTreeModel_generator`. -/
theorem periodicTreeModel [Fintype V] [DecidableEq V] [∀ x y : V, Subsingleton (x ⟶ y)]
    [∀ x y : V, Fintype (x ⟶ y)] [∀ x : V, Fintype (Σ y : V, y ⟶ x)] (hQ : Q.IsStable)
    (c : MeshCoefficients k Q)
    (hfin : ∀ x y : V, FiniteDimensional k
      (ScalarMeshCategory.obj c x ⟶ ScalarMeshCategory.obj c y))
    {x₀ y₀ : V} (a₀ : x₀ ⟶ y₀) (hconn : ∀ v, Relation.EqvGen (SecPath.ConnAdj hQ) x₀ v) :
    ∃ (t : ℕ) (L : Fin t → ℕ) (π : (starTree L).ZVert ⥤q V) (ht : 0 < t),
      (t = 1 ∨ (t = 3 ∧ ∑ i, ((L i : ℚ) + 1) / (L i + 2) < 2)) ∧ π.IsCovering ∧
      (∀ Y, π.obj ((starTree L).ztau Y) = hQ.tauE (π.obj Y)) ∧ Function.Surjective π.obj ∧
      ∃ g : Equiv.Perm (starTree L).ZVert,
        (∀ X Y, π.obj X = π.obj Y ↔ ∃ l : ℤ, (g ^ l) X = Y) ∧
        ∃ (c₀ : ℕ) (ρ : StarV L ≃ StarV L), 1 ≤ c₀ ∧ (∀ a b, starAdj a b ↔ starAdj (ρ a) (ρ b)) ∧
          (∀ X, (g X).v = ρ X.v ∧ (g X).t = X.t + c₀) ∧
          (t = 3 → Even c₀ ∧ ρ none = none) ∧
          (t = 1 → Even (L ⟨0, ht⟩ + 1) →
            Even c₀ ∧ ∀ x, 2 * starDepth x = L ⟨0, ht⟩ + 1 → ρ x = x) ∧
          (t = 1 → Odd (L ⟨0, ht⟩ + 1) →
            (Even c₀ ∧ ∀ x, ρ x = x) ∨
              (Odd c₀ ∧ ∀ x, starDepth (ρ x) + starDepth x = L ⟨0, ht⟩ + 1)) := by
  obtain ⟨t, L, π, hcl, hπ, hτ, hsurj⟩ := periodic_model hQ c hfin a₀ hconn
  have ht : 0 < t := by rcases hcl with h | ⟨h, -⟩ <;> omega
  have hcl' : t = 1 ∨ t = 3 := by rcases hcl with h | ⟨h, -⟩ <;> [left; right] <;> exact h
  have := infinite_zvert L
  obtain ⟨X, Y, hXY, he⟩ := Finite.exists_ne_map_eq_of_infinite π.obj
  exact ⟨t, L, π, ht, hcl, hπ, hτ, hsurj,
    periodicTreeModel_generator L hQ π hπ hτ ht hcl' ⟨X, Y, hXY, he⟩⟩

end TranslationQuiver

end MultiplicativeBasisDeformations
